import { ScrollView } from "std-widgets.slint";
import { SnippetRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
import { SnippetGroupContentItem, SnippetStatCard } from "./snippet_detail_parts.slint";
export component SnippetDetailPage inherits Rectangle {
    in property <string> title-label;
    in property <string> selected-id;
    in property <string> selected-name;
    in property <string> selected-description;
    in property <string> selected-command-template;
    in property <string> selected-scope;
    in property <string> selected-scope-key;
    in property <string> selected-variables;
    in property <string> selected-arguments;
    in property <string> selected-meta;
    in property <string> selected-icon-key;
    in property <string> selected-node-kind;
    in property <int> selected-accent-index;
    in property <[SnippetRow]> snippet-rows;
    in property <[SnippetRow]> snippet-target-options;
    in property <string> empty-title-label;
    in property <string> empty-caption-label;
    in property <string> field-scope-label;
    in property <string> field-variables-label;
    in property <string> field-arguments-label;
    in property <string> command-template-label;
    in property <string> group-caption-label;
    in property <string> description-empty-label;
    in property <string> edit-label;
    in property <string> new-target-label;
    in property <string> split-target-label;
    in property <string> group-contents-title-label;
    in property <string> target-variant-title-label;
    in property <string> script-relation-label;
    in property <string> script-shared-label;
    in property <string> script-independent-label;
    in property <string> delete-label;
    in property <string> copy-label;
    in property <string> copy-success-label;
    in property <string> copy-failed-label;
    in property <string> run-label;
    in property <string> move-label;
    callback edit-selected();
    callback create-target();
    callback split-target();
    callback delete-selected();
    callback move-selected();
    callback copy-command(content: string) -> bool;
    callback run-selected();
    callback select-snippet(id: string, parent-id: string, name: string, description: string, command-template: string, scope: string, scope-key: string, variables: string, variable-names: string, arguments: string, argument-values: string, meta: string, target-linux-selected: bool, target-debian-selected: bool, target-rhel-selected: bool, target-alpine-selected: bool, target-fedora-selected: bool, target-arch-selected: bool, target-suse-selected: bool, target-freebsd-selected: bool, target-macos-selected: bool, target-powershell-selected: bool, target-cmd-selected: bool, target-linux-disabled: bool, target-debian-disabled: bool, target-rhel-disabled: bool, target-alpine-disabled: bool, target-fedora-disabled: bool, target-arch-disabled: bool, target-suse-disabled: bool, target-freebsd-disabled: bool, target-macos-disabled: bool, target-powershell-disabled: bool, target-cmd-disabled: bool, icon-key: string, node-kind: string, accent-index: int);

    property <bool> selected: root.selected-id != "";
    property <bool> group-selected: root.selected-node-kind == "Group";
    property <bool> snippet-only-selected: root.selected-node-kind == "Snippet";
    property <bool> snippet-selected: root.snippet-only-selected || root.selected-node-kind == "SnippetTarget";
    property <bool> target-selected: root.selected-node-kind == "SnippetTarget";
    property <bool> shared-target-selected: root.selected-scope-key == "SupportTargetShared";
    property <bool> root-folder-selected: root.selected-id == "snippet-folder:all";
    property <string> description-text: root.selected-description == "" ? root.description-empty-label : root.selected-description;
    property <string> detail-title: root.target-selected ? root.target-variant-title-label : root.group-selected ? root.group-contents-title-label : root.title-label;
    property <string> relation-text: root.shared-target-selected ? root.script-shared-label : root.script-independent-label;
    property <string> copy-status: "";

    changed selected-id => {
        root.copy-status = "";
    }

    background: AppTheme.window-bg;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: root.title-label;
            color: AppTheme.text-strong;
            font-size: 15px;
            font-weight: 700;
        }

        if !root.selected: Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.card-bg;

            VerticalLayout {
                padding: 18px;
                spacing: 6px;

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.empty-title-label;
                    color: AppTheme.text-strong;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.empty-caption-label;
                    color: AppTheme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        if root.selected: Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.card-bg;
            clip: true;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                HorizontalLayout {
                    height: 42px;
                    spacing: 10px;

                    HostIcon {
                        icon-key: root.selected-icon-key;
                        accent-index: root.selected-accent-index;
                        status-key: "Created";
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;

                        Text {
                            text: root.selected-name;
                            color: AppTheme.text-strong;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: root.target-selected ? root.selected-scope : root.snippet-selected ? root.description-text : root.group-caption-label;
                            color: AppTheme.text-muted;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 92px;
                        height: 24px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppTheme.border-soft;
                        background: AppTheme.surface-bg;

                        Text {
                            x: 8px;
                            y: 0px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: root.selected-meta;
                            color: AppTheme.text-muted;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if root.selected && !root.root-folder-selected: HorizontalLayout {
                        width: root.target-selected ? (root.shared-target-selected ? 174px : 112px) : root.snippet-only-selected ? 298px : 174px;
                        height: 24px;
                        spacing: 6px;

                        if root.snippet-only-selected: CompactButton {
                            label: root.new-target-label;
                            compact: true;
                            clicked => { root.create-target(); }
                        }

                        if !root.target-selected || root.selected-node-kind == "SnippetTarget": CompactButton {
                            label: root.edit-label;
                            compact: true;
                            clicked => { root.edit-selected(); }
                        }

                        if root.shared-target-selected: CompactButton {
                            label: root.split-target-label;
                            tone: "subtle";
                            compact: true;
                            clicked => { root.split-target(); }
                        }

                        if !root.target-selected: CompactButton {
                            label: root.move-label;
                            tone: "subtle";
                            compact: true;
                            clicked => { root.move-selected(); }
                        }

                        if !root.target-selected || root.selected-node-kind == "SnippetTarget": CompactButton {
                            label: root.delete-label;
                            tone: "danger";
                            compact: true;
                            clicked => { root.delete-selected(); }
                        }
                    }
                }

                if root.snippet-selected: HorizontalLayout {
                    height: 58px;
                    spacing: 8px;

                    SnippetStatCard {
                        horizontal-stretch: 1;
                        label: root.target-selected ? root.target-variant-title-label : root.field-scope-label;
                        value: root.selected-scope;
                    }
                    SnippetStatCard {
                        horizontal-stretch: 1;
                        label: root.field-variables-label;
                        value: root.selected-variables;
                    }
                    SnippetStatCard {
                        horizontal-stretch: 1;
                        label: root.field-arguments-label;
                        value: root.selected-arguments;
                    }
                }

                if root.target-selected: HorizontalLayout {
                    height: 58px;
                    spacing: 8px;

                    SnippetStatCard {
                        horizontal-stretch: 1;
                        label: root.script-relation-label;
                        value: root.relation-text;
                    }
                    SnippetStatCard {
                        horizontal-stretch: 1;
                        label: root.command-template-label;
                        value: root.selected-meta;
                    }
                }

                if root.snippet-only-selected: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border-soft;
                    background: AppTheme.surface-bg;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            height: 18px;
                            text: root.target-variant-title-label;
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                            VerticalLayout {
                                padding-right: 4px;
                                spacing: 2px;

                                for item in root.snippet-target-options: SnippetGroupContentItem {
                                    item: item;
                                    active-parent-id: root.selected-id;
                                    selected-id: root.selected-id;
                                    selected(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index) => {
                                        root.select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.target-selected: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border-soft;
                    background: AppTheme.input-bg;
                    clip: true;

                    VerticalLayout {
                        padding-left: 0px;
                        padding-right: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 0px;

                        HorizontalLayout {
                            height: 32px;
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 6px;

                            Text {
                                text: root.command-template-label;
                                color: AppTheme.text-soft;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if root.copy-status != "": Text {
                                text: root.copy-status;
                                color: root.copy-status == root.copy-success-label ? AppTheme.success-text : AppTheme.danger-text;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            CompactButton {
                                label: root.copy-label;
                                tone: "subtle";
                                compact: true;
                                clicked => {
                                    root.copy-status = root.copy-command(root.selected-command-template) ? root.copy-success-label : root.copy-failed-label;
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                            Rectangle {
                                min-width: parent.width;
                                min-height: parent.height;
                                background: AppTheme.transparent;

                                Text {
                                    x: 14px;
                                    y: 12px;
                                    width: max(parent.width - 28px, 420px);
                                    text: root.selected-command-template;
                                    wrap: word-wrap;
                                    color: AppTheme.text;
                                    font-size: 11px;
                                    horizontal-alignment: left;
                                    vertical-alignment: top;
                                }
                            }
                        }
                    }
                }

                if root.group-selected: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border-soft;
                    background: AppTheme.surface-bg;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            height: 18px;
                            text: root.group-contents-title-label;
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                            VerticalLayout {
                                padding-right: 4px;
                                spacing: 2px;

                                for item in root.snippet-rows: SnippetGroupContentItem {
                                    item: item;
                                    active-parent-id: root.selected-id;
                                    selected-id: root.selected-id;
                                    selected(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index) => {
                                        root.select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
