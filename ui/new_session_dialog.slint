import { ScrollView } from "std-widgets.slint";
import { HostRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
import { WorkspaceListItem } from "./workspace_common.slint";

component NewSessionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> meta;
    in property <string> detail;
    in property <string> tags;
    in property <string> status;
    in property <string> kind-label;
    in property <string> icon-key: "server";
    in property <bool> local;
    in property <int> accent-index: 0;
    callback clicked();

    property <color> accent-color: root.local
        ? AppTheme.accent-blue
        : root.accent-index == 0 ? AppTheme.accent
        : root.accent-index == 1 ? AppTheme.accent-violet
        : root.accent-index == 2 ? AppTheme.warning
        : root.accent-index == 3 ? AppTheme.info-text
        : AppTheme.danger-text-soft;
    property <color> accent-bg: root.local
        ? AppTheme.badge-info-bg
        : root.accent-index == 0 ? AppTheme.badge-success-bg
        : root.accent-index == 1 ? AppTheme.badge-pending-bg
        : root.accent-index == 2 ? AppTheme.badge-warning-bg
        : root.accent-index == 3 ? AppTheme.badge-info-bg
        : AppTheme.button-danger-bg;

    height: 74px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;

        Rectangle {
            width: 36px;
            height: 36px;
            background: AppTheme.transparent;

            if root.local: Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.accent-color;
                background: root.accent-bg;

                Text {
                    text: ">";
                    color: root.accent-color;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !root.local: HostIcon {
                x: 7px;
                y: 7px;
                icon-key: root.icon-key;
                accent-index: root.accent-index;
                status-key: "Created";
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    color: AppTheme.text-strong;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    width: 74px;
                    height: 20px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.accent-color;
                    background: root.accent-bg;

                    Text {
                        text: root.kind-label;
                        color: root.accent-color;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: root.subtitle;
                color: AppTheme.text-muted;
                font-size: 11px;
                overflow: elide;
            }

            Text {
                text: root.detail + (root.tags == "" ? "" : " · " + root.tags);
                color: AppTheme.text-soft;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

export component NewSessionDialog inherits Rectangle {
    in property <[HostRow]> hosts;
    in property <string> search-query: "";
    in property <bool> local-visible: true;
    in property <string> title-label: "";
    in property <string> search-placeholder: "";
    in property <string> local-title: "";
    in property <string> local-subtitle: "";
    in property <string> local-detail: "";
    in property <string> local-tags: "";
    in property <string> local-status: "";
    in property <string> local-kind: "";
    in property <string> remote-kind: "";
    in property <string> ungrouped-detail: "";
    in property <string> empty-title: "";
    in property <string> empty-caption: "";
    callback close();
    callback search-changed(query: string);
    callback open-local-terminal();
    callback open-host(host-id: string);

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 640px);
        height: min(root.height - 96px, 560px);
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 15px;
                    font-weight: 700;
                }
                Rectangle { horizontal-stretch: 1; }
                CompactButton {
                    label: "x";
                    tone: "subtle";
                    compact: true;
                    clicked => { root.close(); }
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.inset-bg;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: AppTheme.transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.search-placeholder;
                            color: AppTheme.input-placeholder;
                            font-size: 10px;
                            vertical-alignment: center;
                            visible: search-input.text == "";
                            overflow: elide;
                        }

                        search-input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.search-query;
                            single-line: true;
                            color: AppTheme.text;
                            font-size: 10px;
                            text-cursor-width: 1px;
                            selection-background-color: AppTheme.selection-bg;
                            selection-foreground-color: AppTheme.text-strong;
                            vertical-alignment: center;
                            edited => { root.search-changed(self.text); }
                            accepted => { root.search-changed(self.text); }
                        }
                    }
                }
            }

            if root.local-visible: NewSessionRow {
                title: root.local-title;
                subtitle: root.local-subtitle;
                detail: root.local-detail;
                tags: root.local-tags;
                meta: "local";
                status: root.local-status;
                kind-label: root.local-kind;
                icon-key: "linux";
                local: true;
                accent-index: 1;
                clicked => { root.open-local-terminal(); }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 7px;
                    if root.hosts.length == 0 && !root.local-visible: WorkspaceListItem {
                        title: root.empty-title;
                        subtitle: root.empty-caption;
                        meta: "";
                    }
                    for host in root.hosts: NewSessionRow {
                        title: host.name;
                        subtitle: host.endpoint;
                        meta: host.auth;
                        detail: host.group == "" ? root.ungrouped-detail : host.group;
                        tags: host.tags;
                        status: host.status;
                        kind-label: host.auth == "" ? root.remote-kind : host.auth;
                        icon-key: host.icon_key;
                        local: false;
                        accent-index: host.accent_index;
                        clicked => { root.open-host(host.id); }
                    }
                }
            }
        }
    }
}
