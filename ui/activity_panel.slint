import { ScrollView } from "std-widgets.slint";
import { ActivityRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton, ToolRow } from "./common.slint";

export component ActivityPanel inherits Rectangle {
    in property <bool> collapsed;
    in property <string> tab-count;
    in property <string> host-count;
    in property <int> panel-width;
    in property <[ActivityRow]> activity;
    in property <[string]> recent;
    callback toggle();
    callback next-background();

    width: root.collapsed ? 34px : root.panel-width * 1px;
    background: AppTheme.topbar-bg;
    border-width: 1px;
    border-color: AppTheme.border;

    if root.collapsed: VerticalLayout {
        padding-top: 8px;
        padding-left: 5px;
        padding-right: 5px;
        spacing: 6px;
        CompactButton {
            label: ">";
            clicked => { root.toggle(); }
        }
        Text { text: root.tab-count; color: AppTheme.accent-blue; font-size: 10px; horizontal-alignment: center; }
        Text { text: root.host-count; color: AppTheme.accent; font-size: 10px; horizontal-alignment: center; }
    }

    if !root.collapsed: VerticalLayout {
        padding: 9px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: "Activity";
                color: AppTheme.text;
                font-size: 13px;
                font-weight: 700;
            }
            Rectangle { horizontal-stretch: 1; }
            CompactButton {
                label: "<";
                clicked => { root.toggle(); }
            }
        }

        for metric in root.activity: ToolRow { label: metric.label; value: metric.value; }

        CompactButton {
            label: "Next background";
            clicked => { root.next-background(); }
        }

        Text { text: "RECENT"; color: #5b6776; font-size: 9px; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if root.recent.length == 0: Text { text: "Recent connections appear here."; color: AppTheme.text-muted; font-size: 10px; }
                for recent-item in root.recent: Text { text: recent-item; color: #c7d0db; font-size: 11px; }
            }
        }
    }
}
