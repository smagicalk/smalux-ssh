import { Button, ScrollView } from "std-widgets.slint";
import { SftpEntryRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { ToolRow } from "./common.slint";

export component SftpEntryItem inherits Rectangle {
    in property <SftpEntryRow> entry;
    callback select(path: string);

    height: 30px;
    border-radius: 5px;
    background: entry.selected ? AppTheme.selection-bg : AppTheme.transparent;

    TouchArea {
        clicked => { root.select(root.entry.path); }
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        Text {
            text: entry.kind;
            color: entry.kind == "Dir" ? AppTheme.accent-blue : AppTheme.text-muted;
            font-size: 9px;
            width: 30px;
            vertical-alignment: center;
        }
        Text {
            text: entry.name;
            color: AppTheme.text;
            font-size: 10px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: entry.size;
            color: AppTheme.text-muted;
            font-size: 9px;
            width: 68px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component SftpPane inherits Rectangle {
    in property <string> host-id;
    in property <string> title;
    in property <string> current-dir;
    in property <string> selected-path;
    in property <bool> loading;
    in property <string> error;
    in property <[SftpEntryRow]> entries;
    in property <string> loading-label: "";
    in property <string> refresh-label: "";
    in property <string> local-title: "";
    in property <string> remote-title: "";
    in property <string> workspace-label: "";
    in property <string> queue-label: "";
    in property <string> selected-label: "";
    in property <string> path-label: "";
    in property <string> entries-label: "";
    in property <string> loading-entries-label: "";
    in property <string> empty-entries-label: "";
    callback refresh(host-id: string);
    callback select-entry(host-id: string, path: string);

    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border-strong;
    background: AppTheme.card-bg;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        padding: 9px;
        spacing: 7px;
        HorizontalLayout {
            Text { text: title; color: AppTheme.text-strong; font-size: 12px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.loading ? root.loading-label : root.current-dir; color: AppTheme.text-muted; font-size: 10px; vertical-alignment: center; }
            Button { text: root.refresh-label; height: 22px; enabled: root.host-id != ""; clicked => { root.refresh(root.host-id); } }
        }
        HorizontalLayout {
            spacing: 7px;
            Rectangle {
                border-radius: 6px;
                border-width: 1px;
                border-color: AppTheme.border;
                background: AppTheme.inset-bg;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text { text: root.local-title; color: AppTheme.info-text; font-size: 11px; font-weight: 700; }
                    ToolRow { label: root.workspace-label; value: "C:/"; }
                    ToolRow { label: root.queue-label; value: "0"; }
                    ToolRow { label: root.selected-label; value: root.selected-path == "" ? "-" : root.selected-path; }
                }
            }
            Rectangle {
                border-radius: 6px;
                border-width: 1px;
                border-color: AppTheme.border;
                background: AppTheme.inset-bg;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text { text: root.remote-title; color: AppTheme.success-text; font-size: 11px; font-weight: 700; }
                    ToolRow { label: root.path-label; value: root.current-dir; }
                    ToolRow { label: root.entries-label; value: root.entries.length; }
                    if root.error != "": Text {
                        text: root.error;
                        color: AppTheme.danger-text;
                        font-size: 10px;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 3px;
                            if root.entries.length == 0: Text {
                                text: root.loading ? root.loading-entries-label : root.empty-entries-label;
                                color: AppTheme.text-muted;
                                font-size: 10px;
                            }
                            for entry in root.entries: SftpEntryItem {
                                entry: entry;
                                select(path) => { root.select-entry(root.host-id, path); }
                            }
                        }
                    }
                }
            }
        }
    }
}
