                open-tool-panel(mode) => { root.open-tool-panel(mode); }
                close-tool-panel => { root.close-tool-panel(); }
                update-new-session-search(query) => { root.update-new-session-search(query); }
                open-local-terminal => { root.open-local-terminal(); }
                open-command-palette => { root.open-command-palette(); }
                open-shell(host-id) => { root.open-shell(host-id); }
                create-snippet-target => {
                    if root.selected-snippet-id != "" && root.selected-snippet-node-kind == "Snippet" {
                        root.quick-snippet-dialog-kind = "Target";
                        root.quick-snippet-edit-mode = false;
                        root.quick-snippet-edit-id = root.selected-snippet-id;
                        root.quick-snippet-name = "";
                        root.quick-snippet-description = "linux";
                        root.quick-snippet-command = "";
                        root.quick-snippet-target-mode = "New";
                        root.quick-snippet-share-target-id = "";
                        root.quick-snippet-group-id = root.selected-snippet-parent-id == "snippet-folder:all" ? "" : root.selected-snippet-parent-id;
                        root.quick-snippet-group-name = root.snippet-group-name(root.quick-snippet-group-id);
                        root.quick-snippet-target-linux-selected = true;
                        root.quick-snippet-target-debian-selected = false;
                        root.quick-snippet-target-rhel-selected = false;
                        root.quick-snippet-target-alpine-selected = false;
                        root.quick-snippet-target-fedora-selected = false;
                        root.quick-snippet-target-arch-selected = false;
                        root.quick-snippet-target-suse-selected = false;
                        root.quick-snippet-target-freebsd-selected = false;
                        root.quick-snippet-target-macos-selected = false;
                        root.quick-snippet-target-powershell-selected = false;
                        root.quick-snippet-target-cmd-selected = false;
                        root.create-snippet-dialog-open = true;
                    }
                }
                split-snippet-target(snippet-row-id) => {
                    root.split-snippet-target(snippet-row-id);
                }
                edit-selected-snippet => {
                    if root.selected-snippet-id != "" {
                        root.create-snippet-dialog-open = false;
                        if root.selected-snippet-node-kind == "Snippet" {
                            root.quick-snippet-dialog-kind = "Snippet";
                            root.quick-snippet-edit-mode = true;
                            root.quick-snippet-edit-id = root.selected-snippet-id;
                            root.quick-snippet-name = root.selected-snippet-name;
                            root.quick-snippet-description = root.selected-snippet-description;
                            root.quick-snippet-command = root.selected-snippet-command-template;
                            root.quick-snippet-target-mode = "New";
                            root.quick-snippet-share-target-id = "";
                            root.quick-snippet-group-id = root.selected-snippet-parent-id == "snippet-folder:all" ? "" : root.selected-snippet-parent-id;
