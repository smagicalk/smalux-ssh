        remove-cancel => {
            root.remove-snippet-dialog-open = false;
            root.remove-snippet-dialog-id = "";
            root.remove-snippet-dialog-name = "";
            root.remove-snippet-dialog-kind = "";
        }
        remove-confirm(id, kind) => {
            root.delete-snippet-node(id, kind);
            if root.selected-snippet-id == id {
                root.selected-snippet-id = "";
                root.selected-snippet-parent-id = "snippet-folder:all";
                root.selected-snippet-name = "";
                root.selected-snippet-description = "";
                root.selected-snippet-command-template = "";
                root.selected-snippet-scope = "";
                root.selected-snippet-scope-key = "";
                root.selected-snippet-variables = "";
                root.selected-snippet-variable-names = "";
                root.selected-snippet-arguments = "";
                root.selected-snippet-argument-values = "";
                root.selected-snippet-meta = "";
                root.selected-snippet-target-linux-selected = false;
                root.selected-snippet-target-debian-selected = false;
                root.selected-snippet-target-rhel-selected = false;
                root.selected-snippet-target-alpine-selected = false;
                root.selected-snippet-target-fedora-selected = false;
                root.selected-snippet-target-arch-selected = false;
                root.selected-snippet-target-suse-selected = false;
                root.selected-snippet-target-freebsd-selected = false;
                root.selected-snippet-target-macos-selected = false;
                root.selected-snippet-target-powershell-selected = false;
                root.selected-snippet-target-cmd-selected = false;
                root.selected-snippet-target-linux-disabled = false;
                root.selected-snippet-target-debian-disabled = false;
                root.selected-snippet-target-rhel-disabled = false;
                root.selected-snippet-target-alpine-disabled = false;
                root.selected-snippet-target-fedora-disabled = false;
                root.selected-snippet-target-arch-disabled = false;
                root.selected-snippet-target-suse-disabled = false;
                root.selected-snippet-target-freebsd-disabled = false;
                root.selected-snippet-target-macos-disabled = false;
                root.selected-snippet-target-powershell-disabled = false;
                root.selected-snippet-target-cmd-disabled = false;
                root.selected-snippet-icon-key = "code";
                root.selected-snippet-node-kind = "";
                root.selected-snippet-accent-index = 0;
            }
            root.remove-snippet-dialog-open = false;
            root.remove-snippet-dialog-id = "";
            root.remove-snippet-dialog-name = "";
            root.remove-snippet-dialog-kind = "";
        }
        select-run-host(host-id) => { root.run-snippet-dialog-host-id = host-id; }
        run-arguments-edited(value) => { root.run-snippet-dialog-arguments = value; }
        run-close => {
            root.run-snippet-dialog-open = false;
            root.run-snippet-dialog-host-id = "";
            root.run-snippet-dialog-arguments = "";
        }
        run-snippet(snippet-row-id, host-id, arguments-text) => { root.run-snippet-with-arguments(snippet-row-id, host-id, arguments-text) }
        select-move-group(group-id) => { root.move-snippet-target-group-id = group-id; }
        move-close => {
            root.move-snippet-dialog-open = false;
            root.move-snippet-target-group-id = "";
        }
        move-snippet(node-id, node-kind, target-group-id) => { root.move-snippet-node(node-id, node-kind, target-group-id) }
        create-choice-close => {
            root.create-snippet-choice-dialog-open = false;
            root.quick-snippet-choice-parent-node-id = "snippet-folder:all";
        }
        open-create-snippet(parent-node-id) => {
            root.create-snippet-dialog-open = false;
            root.quick-snippet-parent-node-id = parent-node-id;
            root.quick-snippet-dialog-kind = "Snippet";
            root.quick-snippet-edit-mode = false;
            root.quick-snippet-edit-id = "";
            root.quick-snippet-name = "";
            root.quick-snippet-description = "";
            root.quick-snippet-command = "";
            root.quick-snippet-target-mode = "New";
            root.quick-snippet-share-target-id = "";
            root.quick-snippet-group-id = parent-node-id == "snippet-folder:all" ? "" : parent-node-id;
            root.quick-snippet-group-name = root.snippet-group-name(root.quick-snippet-group-id);
            root.quick-snippet-target-linux-selected = !root.selected-snippet-target-linux-disabled;
            root.quick-snippet-target-debian-selected = root.selected-snippet-target-linux-disabled && !root.selected-snippet-target-debian-disabled;
            root.quick-snippet-target-rhel-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && !root.selected-snippet-target-rhel-disabled;
            root.quick-snippet-target-alpine-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && !root.selected-snippet-target-alpine-disabled;
            root.quick-snippet-target-fedora-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && !root.selected-snippet-target-fedora-disabled;
            root.quick-snippet-target-arch-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && !root.selected-snippet-target-arch-disabled;
            root.quick-snippet-target-suse-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && !root.selected-snippet-target-suse-disabled;
            root.quick-snippet-target-freebsd-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && !root.selected-snippet-target-freebsd-disabled;
            root.quick-snippet-target-macos-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && !root.selected-snippet-target-macos-disabled;
            root.quick-snippet-target-powershell-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && root.selected-snippet-target-macos-disabled && !root.selected-snippet-target-powershell-disabled;
            root.quick-snippet-target-cmd-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && root.selected-snippet-target-macos-disabled && root.selected-snippet-target-powershell-disabled && !root.selected-snippet-target-cmd-disabled;
            root.create-snippet-dialog-open = true;
        }
        open-create-target(parent-node-id) => {
            root.create-snippet-dialog-open = false;
            root.quick-snippet-parent-node-id = parent-node-id;
            root.quick-snippet-dialog-kind = "Target";
            root.quick-snippet-edit-mode = false;
            root.quick-snippet-edit-id = parent-node-id;
            root.quick-snippet-name = "";
            root.quick-snippet-description = "linux";
            root.quick-snippet-command = "";
            root.quick-snippet-target-mode = "New";
            root.quick-snippet-share-target-id = "";
            root.quick-snippet-group-id = "";
            root.quick-snippet-group-name = root.snippets-move-root-label;
            root.quick-snippet-target-linux-selected = true;
            root.quick-snippet-target-debian-selected = false;
            root.quick-snippet-target-rhel-selected = false;
            root.quick-snippet-target-alpine-selected = false;
            root.quick-snippet-target-fedora-selected = false;
            root.quick-snippet-target-arch-selected = false;
            root.quick-snippet-target-suse-selected = false;
            root.quick-snippet-target-freebsd-selected = false;
            root.quick-snippet-target-macos-selected = false;
            root.quick-snippet-target-powershell-selected = false;
            root.quick-snippet-target-cmd-selected = false;
            root.create-snippet-dialog-open = true;
        }
        open-create-group(parent-node-id) => {
            root.quick-snippet-parent-node-id = parent-node-id;
            root.quick-snippet-parent-group-name = parent-node-id == "snippet-folder:all" ? root.snippets-move-root-label : root.snippet-group-name(parent-node-id);
            root.quick-snippet-edit-mode = false;
            root.quick-snippet-edit-id = "";
            root.quick-snippet-group-name = "";
            root.create-snippet-group-dialog-open = true;
        }
        name-edited(value) => { root.quick-snippet-name = value; }
        description-edited(value) => { root.quick-snippet-description = value; }
        command-edited(value) => { root.quick-snippet-command = value; }
        target-mode-selected(value) => {
            root.quick-snippet-target-mode = value;
            if value == "New" {
                root.quick-snippet-share-target-id = "";
            }
        }
        share-target-selected(value) => { root.quick-snippet-share-target-id = value; }
        snippet-group-selected(value, name) => {
            root.quick-snippet-group-id = value;
            root.quick-snippet-group-name = name;
        }
        create-close => {
            root.create-snippet-dialog-open = false;
            root.quick-snippet-edit-mode = false;
            root.quick-snippet-edit-id = "";
            root.quick-snippet-name = "";
            root.quick-snippet-description = "";
            root.quick-snippet-command = "";
            root.quick-snippet-target-mode = "New";
            root.quick-snippet-share-target-id = "";
            root.quick-snippet-group-id = "";
            root.quick-snippet-group-name = root.snippets-move-root-label;
            root.quick-snippet-target-linux-selected = true;
            root.quick-snippet-target-debian-selected = false;
            root.quick-snippet-target-rhel-selected = false;
            root.quick-snippet-target-alpine-selected = false;
            root.quick-snippet-target-fedora-selected = false;
            root.quick-snippet-target-arch-selected = false;
            root.quick-snippet-target-suse-selected = false;
            root.quick-snippet-target-freebsd-selected = false;
            root.quick-snippet-target-macos-selected = false;
            root.quick-snippet-target-powershell-selected = false;
            root.quick-snippet-target-cmd-selected = false;
        }
        save-snippet(dialog-kind, edit-mode, edit-id, parent-node-id, name, description, command-template, share-target-id, group-id) => {
            if dialog-kind == "Target" {
                if edit-mode {
                    if root.update-snippet-target(edit-id, description, name, command-template) {
                        if root.selected-snippet-id == edit-id {
                            root.selected-snippet-name = name;
                            root.selected-snippet-description = description;
                            root.selected-snippet-command-template = command-template;
                            root.selected-snippet-target-linux-selected = root.quick-snippet-target-linux-selected;
                            root.selected-snippet-target-debian-selected = root.quick-snippet-target-debian-selected;
                            root.selected-snippet-target-rhel-selected = root.quick-snippet-target-rhel-selected;
                            root.selected-snippet-target-alpine-selected = root.quick-snippet-target-alpine-selected;
                            root.selected-snippet-target-fedora-selected = root.quick-snippet-target-fedora-selected;
                            root.selected-snippet-target-arch-selected = root.quick-snippet-target-arch-selected;
                            root.selected-snippet-target-suse-selected = root.quick-snippet-target-suse-selected;
                            root.selected-snippet-target-freebsd-selected = root.quick-snippet-target-freebsd-selected;
                            root.selected-snippet-target-macos-selected = root.quick-snippet-target-macos-selected;
                            root.selected-snippet-target-powershell-selected = root.quick-snippet-target-powershell-selected;
                            root.selected-snippet-target-cmd-selected = root.quick-snippet-target-cmd-selected;
                        }
                        return true;
                    }
                    return false;
                }
                return root.create-snippet-target(edit-id, description, name, command-template, share-target-id);
            }
            if edit-mode {
                if root.update-snippet(edit-id, group-id, name, description, command-template) {
                    if root.selected-snippet-id == edit-id {
                        root.selected-snippet-name = name;
                        root.selected-snippet-description = description;
                        root.selected-snippet-command-template = command-template;
                        root.selected-snippet-parent-id = group-id == "" ? "snippet-folder:all" : group-id;
                    }
                    return true;
                }
                return false;
            }
            return root.create-snippet(parent-node-id, group-id, name, description, command-template);
        }
        group-name-edited(value) => { root.quick-snippet-group-name = value; }
        group-parent-selected(value, name) => {
            root.quick-snippet-parent-node-id = value == "" ? "snippet-folder:all" : value;
            root.quick-snippet-parent-group-name = name;
        }
        create-group-close => { root.create-snippet-group-dialog-open = false; }
        save-snippet-group(edit-mode, edit-id, parent-node-id, name) => {
            edit-mode
                ? (root.move-snippet-node(edit-id, "Group", parent-node-id) && root.rename-snippet-group(edit-id, name))
                : root.create-snippet-group(parent-node-id, name)
        }
    }
}
