        group-caption: root.create-choice-group-caption;
        cancel-label: root.create-choice-cancel-label;
        create-host => {
            root.create-choice-dialog-open = false;
            root.open-create-host-dialog();
        }
        create-group => {
            root.create-choice-dialog-open = false;
            root.open-create-group-parent-dialog("");
        }
        close => { root.create-choice-dialog-open = false; }
    }

    if root.create-group-parent-dialog-open: CreateGroupParentDialog {
