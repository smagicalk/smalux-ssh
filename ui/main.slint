                    root.create-certificate-credential-dialog-open = true;
                }
            }

            if !root.security-page && !root.snippets-page && !root.right-sidebar-collapsed: VerticalSplitter {
                x: parent.width - root.right-panel-width - root.splitter-width;
                y: 0px;
                height: parent.height;
