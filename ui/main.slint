    callback save-network-proxy(asset-id: string, name: string, proxy-kind: string, host: string, port: string, tags: string) -> bool;
    callback save-network-jump-chain(asset-id: string, name: string, host-ids: string) -> bool;
    callback save-network-forward(asset-id: string, name: string, kind: string, bind-host: string, bind-port: string, target-host: string, target-port: string, tags: string, auto-start: bool) -> bool;
    callback remove-network-asset(kind-key: string, asset-id: string);
    callback dismiss-ui-error();

    title: root.brand-name-label + " - " + root.active-page;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 940px;
    min-height: 600px;
    background: AppTheme.window-bg;

    Timer {
        interval: 160ms;
        running: root.quick-security-credential-busy;
        triggered => {
            root.quick-security-credential-busy-frame = root.quick-security-credential-busy-frame >= 2 ? 0 : root.quick-security-credential-busy-frame + 1;
        }
    }

    Timer {
        interval: 60ms;
        running: root.quick-security-credential-generate-pending;
        triggered => {
            root.quick-security-credential-generate-pending = false;
            root.quick-security-credential-save-ok = root.generate-private-key-credential(
                root.quick-security-credential-name,
                root.quick-security-credential-group-id,
                root.quick-security-credential-algorithm,
            );
            root.quick-security-credential-busy = false;
            root.quick-security-credential-busy-frame = 0;
            if !root.quick-security-credential-save-ok {
                return;
            }
            root.create-security-credential-dialog-open = false;
            root.security-credential-group-picker-open = false;
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-credential-import-mode = false;
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-edit-id = "";
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

        NavRail {
                x: 0px;
                y: 0px;
                height: parent.height;
                active-page: root.active-page-key;
                hosts-label: root.nav-hosts-label;
                terminal-label: root.nav-terminal-label;
                sftp-label: root.nav-sftp-label;
                tunnels-label: root.nav-tunnels-label;
                snippets-label: root.nav-snippets-label;
                history-label: root.nav-history-label;
                security-label: root.nav-security-label;
                proxy-label: root.nav-proxy-label;
                settings-label: root.nav-settings-label;
                find-label: root.nav-find-label;
                open-hosts => { root.open-hosts(); }
                open-terminal => { root.open-terminal(); }
                open-sftp => { root.open-sftp(); }
                open-tunnels => { root.open-tunnels(); }
                open-snippets => { root.open-snippets(); }
                open-history => { root.open-history(); }
                open-security => { root.open-security(); }
                open-proxy => { root.open-proxy(); }
                open-settings => { root.open-settings(); }
                open-command-palette => { root.open-command-palette(); }
            }

            HostsPanel {
                x: root.rail-width;
                y: 0px;
                visible: !root.security-page && !root.snippets-page && !root.proxy-page && !root.hosts-panel-collapsed;
                height: parent.height;
                active-page: root.active-page;
                host-list-mode: root.host-list-mode;
                host-list-mode-key: root.host-list-mode-key;
                host-search-query: root.host-search-query;
                new-label: root.host-new-label;
                open-label: root.host-open-label;
                files-label: root.host-files-label;
                edit-label: root.host-edit-label;
                delete-label: root.host-delete-label;
                duplicate-label: root.host-duplicate-label;
                group-create-host-label: root.group-create-host-label;
                group-create-group-label: root.group-create-group-label;
                search-placeholder: root.host-search-placeholder;
                section-title: root.hosts-section-title;
                empty-title: root.hosts-empty-title;
                empty-caption: root.hosts-empty-caption;
                new-host-label: root.create-host-dialog-title;
                new-group-label: root.create-group-dialog-title;
                open-create-choice => { root.create-choice-dialog-open = true; }
                panel-width: root.hosts-panel-width;
                hosts: root.hosts;
                host-tree: root.host-tree;
                toggle-host-list-mode => { root.toggle-host-list-mode(); }
                toggle-host-tree-group(group-id) => { root.toggle-host-tree-group(group-id); }
                update-host-search(query) => { root.update-host-search(query); }
                open-create-host-dialog => { root.open-create-host-dialog(); }
                open-create-host-dialog-in-group(group-id) => { root.open-create-host-dialog-in-group(group-id); }
                open-create-group-parent-dialog(parent-id) => { root.open-create-group-parent-dialog(parent-id); }
                open-create-group-dialog(parent-id) => { root.open-create-group-dialog(parent-id); }
                open-shell(host-id) => { root.open-shell(host-id); }
                open-host-sftp(host-id) => { root.open-host-sftp(host-id); }
                open-edit-host-dialog(host-id) => { root.open-edit-host-dialog(host-id); }
                duplicate-host(host-id) => { root.duplicate-host(host-id); }
                remove-host(host-id) => { root.remove-host(host-id); }
                remove-group(group-id) => { root.remove-group(group-id); }
            }

            if root.security-page: CredentialsPanel {
                x: root.rail-width;
                y: 0px;
                height: parent.height;
                title-label: root.security-tree-title-label;
                search-query: root.credential-search-query;
                search-placeholder: root.security-search-placeholder-label;
                new-label: root.security-new-label;
                new-group-label: root.security-group-new-label;
                edit-group-label: root.security-group-edit-label;
                delete-group-label: root.security-group-delete-label;
                private-keys-label: root.security-private-keys-label;
                certificates-label: root.security-certificates-label;
                passwords-label: root.security-passwords-label;
                create-private-key-label: root.security-private-key-create-label;
                import-private-key-label: root.security-private-key-import-label;
                create-certificate-label: root.security-certificate-create-label;
                import-certificate-label: root.security-certificate-import-label;
                create-password-label: root.security-password-create-label;
                create-agent-label: root.security-agent-create-label;
                edit-credential-label: root.security-credential-edit-label;
                move-credential-label: root.security-credential-move-label;
                duplicate-credential-label: root.security-credential-duplicate-label;
                export-credential-label: root.security-credential-export-label;
                delete-credential-label: root.security-credential-delete-label;
                panel-width: root.hosts-panel-width;
                credentials: root.credential-rows;
                selected-id: root.selected-credential-id;
                update-search(query) => { root.update-credential-search(query); }
                toggle-tree-node(node-id) => { root.toggle-credential-tree-node(node-id); }
                open-create-dialog => {
                    root.security-create-action-dialog-open = true;
                }
                create-credential(kind-key, group-id, group-path, import-mode) => {
                    root.quick-security-credential-edit-id = "";
                    root.quick-security-credential-kind-key = kind-key;
                    root.quick-security-credential-group-id = group-id;
                    root.quick-security-credential-group-path = group-path == "" ? root.quick-security-credential-root-group-path : group-path;
                    root.quick-security-credential-import-mode = import-mode;
                    root.quick-security-credential-import-source-key = "File";
                    root.quick-security-credential-name = "";
                    root.quick-security-credential-secret-ref = "";
                    root.quick-security-credential-algorithm = "Ed25519";
                    if kind-key == "Certificate" && !import-mode {
                        root.quick-security-certificate-ca-key-ref = "";
                        root.quick-security-certificate-ca-key-name = "";
                        root.quick-security-certificate-subject-key-ref = "";
                        root.quick-security-certificate-subject-key-name = "";
                        root.quick-security-certificate-type = "User";
                        root.quick-security-certificate-principals = "";
                        root.quick-security-certificate-valid-days = "365";
                        root.quick-security-certificate-key-id = "";
                        root.quick-security-certificate-serial = "";
                        root.create-certificate-credential-dialog-open = true;
                    } else {
                        root.create-security-credential-dialog-open = true;
                    }
                }
                edit-credential(credential-id, name, group-id, group-path, kind-key, algorithm-key) => {
                    root.quick-security-credential-edit-id = credential-id;
                    root.quick-security-credential-kind-key = kind-key;
                    root.quick-security-credential-group-id = group-id;
                    root.quick-security-credential-group-path = group-path == "" ? root.quick-security-credential-root-group-path : group-path;
                    root.quick-security-credential-import-mode = false;
                    root.quick-security-credential-import-source-key = "File";
                    root.quick-security-credential-name = name;
                    root.quick-security-credential-secret-ref = root.read-credential-secret(credential-id);
                    root.quick-security-credential-algorithm = algorithm-key;
                    root.create-security-credential-dialog-open = true;
                }
                create-group(parent-id, parent-path, kind-key) => {
                    root.quick-credential-group-name = "";
                    root.quick-credential-group-parent-id = parent-id;
                    root.quick-credential-group-parent-path = parent-path;
                    root.quick-credential-group-edit-id = "";
                    root.quick-credential-group-kind-key = kind-key;
                    root.create-credential-group-dialog-open = true;
                }
                open-move-picker(source-id, kind-key, group-id) => {
                    root.move-credential-source-id = source-id;
                    root.quick-security-credential-kind-key = kind-key;
                    root.quick-security-credential-group-id = group-id;
                    root.move-credential-group-picker-open = true;
                }
                edit-group(group-id, name) => {
                    root.quick-credential-group-name = name;
                    root.quick-credential-group-parent-id = "";
                    root.quick-credential-group-parent-path = "";
                    root.quick-credential-group-edit-id = group-id;
                    root.quick-credential-group-kind-key = "PrivateKey";
                    root.create-credential-group-dialog-open = true;
                }
                remove-group(group-id) => { root.remove-credential-group(group-id); }
                duplicate-credential(credential-id) => { root.duplicate-credential(credential-id); }
                export-credential(credential-id, name, kind-key) => {
                    root.export-security-credential-name = credential-id;
                    root.export-security-credential-kind-key = kind-key;
                    root.export-security-credential-path = kind-key == "Certificate" ? (name + "-cert.pub") : kind-key == "Password" ? (name + ".txt") : name;
                    root.export-security-credential-dialog-open = true;
                }
                request-remove-credential(credential-id, name) => {
                    root.remove-security-credential-dialog-id = credential-id;
                    root.remove-security-credential-dialog-name = name;
                    root.remove-security-credential-dialog-open = true;
                }
                remove-credential(credential-id) => { root.remove-credential(credential-id); }
                move-node(source-id, target-id) => { root.move-credential-tree-node(source-id, target-id) }
                select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index) => {
                    root.selected-credential-name = name;
                    root.selected-credential-group-id = group-id;
                    root.selected-credential-group-path = group-path;
                    root.selected-credential-kind = kind;
                    root.selected-credential-kind-key = kind-key;
                    root.selected-credential-username = username;
                    root.selected-credential-secret-ref = secret-ref;
                    root.selected-credential-secret-available = secret-available;
                    root.selected-credential-algorithm = algorithm;
                    root.selected-credential-algorithm-key = algorithm-key;
                    root.selected-credential-fingerprint = fingerprint;
                    root.selected-credential-meta = meta;
                    root.selected-credential-icon-key = icon-key;
                    root.selected-credential-node-kind = node-kind;
                    root.selected-credential-accent-index = accent-index;
                    root.selected-credential-id = id;
                }
            }

            if root.snippets-page: SnippetsPanel {
                x: root.rail-width;
                y: 0px;
                height: parent.height;
                title-label: root.snippets-tree-title-label;
                search-query: root.snippet-search-query;
                search-placeholder: root.snippets-search-placeholder-label;
                new-label: root.snippets-new-label;
                new-target-label: root.snippets-new-target-label;
                new-group-label: root.snippets-new-group-label;
                edit-label: root.snippets-edit-label;
                delete-label: root.snippets-delete-label;
                move-label: root.snippets-move-label;
                run-label: root.snippets-run-label;
                split-target-label: root.snippets-split-target-label;
                panel-width: root.hosts-panel-width;
                snippets: root.snippet-rows;
                selected-id: root.selected-snippet-id;
                selected-parent-id: root.selected-snippet-parent-id;
                selected-node-kind: root.selected-snippet-node-kind;
                update-search(query) => { root.update-snippet-search(query); }
                toggle-tree-node(node-id) => { root.toggle-snippet-tree-node(node-id); }
                open-create-choice(parent-node-id) => {
                    root.quick-snippet-choice-parent-node-id = parent-node-id;
                    root.create-snippet-choice-dialog-open = true;
                }
                open-create-target(parent-node-id) => {
                    root.create-snippet-dialog-open = false;
                    root.quick-snippet-parent-node-id = parent-node-id;
                    root.quick-snippet-dialog-kind = "Target";
                    root.quick-snippet-edit-mode = false;
                    root.quick-snippet-edit-id = parent-node-id;
                    root.quick-snippet-name = "";
                    root.quick-snippet-description = "linux";
                    root.quick-snippet-command = "";
                    root.quick-snippet-target-mode = "New";
                    root.quick-snippet-share-target-id = "";
                    root.quick-snippet-group-id = "";
                    root.quick-snippet-group-name = root.snippets-move-root-label;
                    root.quick-snippet-target-linux-selected = !root.selected-snippet-target-linux-disabled;
                    root.quick-snippet-target-debian-selected = root.selected-snippet-target-linux-disabled && !root.selected-snippet-target-debian-disabled;
                    root.quick-snippet-target-rhel-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && !root.selected-snippet-target-rhel-disabled;
                    root.quick-snippet-target-alpine-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && !root.selected-snippet-target-alpine-disabled;
                    root.quick-snippet-target-fedora-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && !root.selected-snippet-target-fedora-disabled;
                    root.quick-snippet-target-arch-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && !root.selected-snippet-target-arch-disabled;
                    root.quick-snippet-target-suse-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && !root.selected-snippet-target-suse-disabled;
                    root.quick-snippet-target-freebsd-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && !root.selected-snippet-target-freebsd-disabled;
                    root.quick-snippet-target-macos-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && !root.selected-snippet-target-macos-disabled;
                    root.quick-snippet-target-powershell-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && root.selected-snippet-target-macos-disabled && !root.selected-snippet-target-powershell-disabled;
                    root.quick-snippet-target-cmd-selected = root.selected-snippet-target-linux-disabled && root.selected-snippet-target-debian-disabled && root.selected-snippet-target-rhel-disabled && root.selected-snippet-target-alpine-disabled && root.selected-snippet-target-fedora-disabled && root.selected-snippet-target-arch-disabled && root.selected-snippet-target-suse-disabled && root.selected-snippet-target-freebsd-disabled && root.selected-snippet-target-macos-disabled && root.selected-snippet-target-powershell-disabled && !root.selected-snippet-target-cmd-disabled;
                    root.create-snippet-dialog-open = true;
                }
                open-create-group(parent-node-id) => {
                    root.quick-snippet-parent-node-id = parent-node-id;
                    root.quick-snippet-parent-group-name = parent-node-id == "snippet-folder:all" ? root.snippets-move-root-label : root.snippet-group-name(parent-node-id);
                    root.quick-snippet-edit-mode = false;
                    root.quick-snippet-edit-id = "";
                    root.quick-snippet-group-name = "";
                    root.create-snippet-group-dialog-open = true;
                }
                edit-snippet => {
                    if root.selected-snippet-id != "" {
                        root.create-snippet-dialog-open = false;
                        if root.selected-snippet-node-kind == "Snippet" {
                            root.quick-snippet-dialog-kind = "Snippet";
                            root.quick-snippet-edit-mode = true;
                            root.quick-snippet-edit-id = root.selected-snippet-id;
                            root.quick-snippet-name = root.selected-snippet-name;
                            root.quick-snippet-description = root.selected-snippet-description;
                            root.quick-snippet-command = root.selected-snippet-command-template;
                            root.quick-snippet-target-mode = "New";
                            root.quick-snippet-share-target-id = "";
                            root.quick-snippet-group-id = root.selected-snippet-parent-id == "snippet-folder:all" ? "" : root.selected-snippet-parent-id;
                            root.quick-snippet-group-name = root.snippet-group-name(root.quick-snippet-group-id);
                            root.quick-snippet-target-linux-selected = true;
                            root.quick-snippet-target-debian-selected = false;
                            root.quick-snippet-target-rhel-selected = false;
                            root.quick-snippet-target-alpine-selected = false;
                            root.quick-snippet-target-fedora-selected = false;
                            root.quick-snippet-target-arch-selected = false;
                            root.quick-snippet-target-suse-selected = false;
                            root.quick-snippet-target-freebsd-selected = false;
                            root.quick-snippet-target-macos-selected = false;
                            root.quick-snippet-target-powershell-selected = false;
                            root.quick-snippet-target-cmd-selected = false;
                            root.create-snippet-dialog-open = true;
                        } else if root.selected-snippet-node-kind == "SnippetTarget" {
                            root.quick-snippet-dialog-kind = "Target";
                            root.quick-snippet-edit-mode = true;
                            root.quick-snippet-edit-id = root.selected-snippet-id;
                            root.quick-snippet-name = root.selected-snippet-name;
                            root.quick-snippet-description = root.selected-snippet-description;
                            root.quick-snippet-command = root.selected-snippet-command-template;
                            root.quick-snippet-target-mode = "New";
                            root.quick-snippet-share-target-id = "";
                            root.quick-snippet-group-id = "";
                            root.quick-snippet-group-name = root.snippets-move-root-label;
                            root.quick-snippet-target-linux-selected = root.selected-snippet-target-linux-selected;
                            root.quick-snippet-target-debian-selected = root.selected-snippet-target-debian-selected;
                            root.quick-snippet-target-rhel-selected = root.selected-snippet-target-rhel-selected;
                            root.quick-snippet-target-alpine-selected = root.selected-snippet-target-alpine-selected;
                            root.quick-snippet-target-fedora-selected = root.selected-snippet-target-fedora-selected;
                            root.quick-snippet-target-arch-selected = root.selected-snippet-target-arch-selected;
                            root.quick-snippet-target-suse-selected = root.selected-snippet-target-suse-selected;
                            root.quick-snippet-target-freebsd-selected = root.selected-snippet-target-freebsd-selected;
                            root.quick-snippet-target-macos-selected = root.selected-snippet-target-macos-selected;
                            root.quick-snippet-target-powershell-selected = root.selected-snippet-target-powershell-selected;
                            root.quick-snippet-target-cmd-selected = root.selected-snippet-target-cmd-selected;
                            root.create-snippet-dialog-open = true;
                        } else if root.selected-snippet-node-kind == "Group" {
                            root.quick-snippet-edit-mode = true;
                            root.quick-snippet-edit-id = root.selected-snippet-id;
                            root.quick-snippet-parent-node-id = root.selected-snippet-parent-id;
                            root.quick-snippet-parent-group-name = root.selected-snippet-parent-id == "snippet-folder:all" ? root.snippets-move-root-label : root.snippet-group-name(root.selected-snippet-parent-id);
                            root.quick-snippet-group-name = root.selected-snippet-name;
                            root.create-snippet-group-dialog-open = true;
                        }
                    }
                }
                delete-snippet => {
                    if root.selected-snippet-id != "" && root.selected-snippet-id != "snippet-folder:all" {
                        root.remove-snippet-dialog-id = root.selected-snippet-id;
                        root.remove-snippet-dialog-name = root.selected-snippet-name;
                        root.remove-snippet-dialog-kind = root.selected-snippet-node-kind;
                        root.remove-snippet-dialog-open = true;
                    }
                }
                move-snippet => {
                    if root.selected-snippet-id != "" && root.selected-snippet-id != "snippet-folder:all" && root.selected-snippet-node-kind != "SnippetTarget" {
                        root.move-snippet-target-group-id = root.selected-snippet-parent-id;
                        root.move-snippet-dialog-open = true;
                    }
                }
                run-snippet => {
                    if root.selected-snippet-id != "" && (root.selected-snippet-node-kind == "Snippet" || root.selected-snippet-node-kind == "SnippetTarget") {
                        root.run-snippet-dialog-host-id = root.hosts.length > 0 ? root.hosts[0].id : "";
                        root.run-snippet-dialog-arguments = root.selected-snippet-argument-values;
                        root.run-snippet-dialog-open = true;
                    }
                }
                split-target => { root.split-snippet-target(root.selected-snippet-id); }
                move-node(source-id, source-kind, target-id) => { root.move-snippet-node(source-id, source-kind, target-id) }
