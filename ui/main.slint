                            root.quick-snippet-parent-group-name = root.selected-snippet-parent-id == "snippet-folder:all" ? root.snippets-move-root-label : root.snippet-group-name(root.selected-snippet-parent-id);
                            root.quick-snippet-group-name = root.selected-snippet-name;
                            root.create-snippet-group-dialog-open = true;
                        }
                    }
                }
                delete-selected-snippet => {
                    if root.selected-snippet-id != "" && root.selected-snippet-id != "snippet-folder:all" {
                        root.remove-snippet-dialog-id = root.selected-snippet-id;
