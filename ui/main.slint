    title: root.brand-name-label + " - " + root.active-page;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 940px;
    min-height: 600px;
    background: AppTheme.window-bg;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

        NavRail {
                x: 0px;
                y: 0px;
                height: parent.height;
                active-page: root.active-page-key;
                hosts-label: root.nav-hosts-label;
                terminal-label: root.nav-terminal-label;
                sftp-label: root.nav-sftp-label;
                tunnels-label: root.nav-tunnels-label;
                snippets-label: root.nav-snippets-label;
                history-label: root.nav-history-label;
                security-label: root.nav-security-label;
                settings-label: root.nav-settings-label;
                find-label: root.nav-find-label;
                open-hosts => { root.open-hosts(); }
                open-terminal => { root.open-terminal(); }
                open-sftp => { root.open-sftp(); }
                open-tunnels => { root.open-tunnels(); }
                open-snippets => { root.open-snippets(); }
                open-history => { root.open-history(); }
                open-security => { root.open-security(); }
                open-settings => { root.open-settings(); }
                open-command-palette => { root.open-command-palette(); }
            }

            HostsPanel {
                x: root.rail-width;
                y: 0px;
                visible: !root.hosts-panel-collapsed;
                height: parent.height;
                active-page: root.active-page;
                host-list-mode: root.host-list-mode;
                host-list-mode-key: root.host-list-mode-key;
                host-search-query: root.host-search-query;
                new-label: root.host-new-label;
                open-label: root.host-open-label;
                files-label: root.host-files-label;
                edit-label: root.host-edit-label;
                delete-label: root.host-delete-label;
                duplicate-label: root.host-duplicate-label;
                group-create-host-label: root.group-create-host-label;
                group-create-group-label: root.group-create-group-label;
                search-placeholder: root.host-search-placeholder;
                section-title: root.hosts-section-title;
                empty-title: root.hosts-empty-title;
                empty-caption: root.hosts-empty-caption;
                new-host-label: root.create-host-dialog-title;
                new-group-label: root.create-group-dialog-title;
                open-create-choice => { root.create-choice-dialog-open = true; }
                panel-width: root.hosts-panel-width;
                hosts: root.hosts;
                host-tree: root.host-tree;
                toggle-host-list-mode => { root.toggle-host-list-mode(); }
                toggle-host-tree-group(group-id) => { root.toggle-host-tree-group(group-id); }
                update-host-search(query) => { root.update-host-search(query); }
                open-create-host-dialog => { root.open-create-host-dialog(); }
                open-create-host-dialog-in-group(group-id) => { root.open-create-host-dialog-in-group(group-id); }
                open-create-group-parent-dialog(parent-id) => { root.open-create-group-parent-dialog(parent-id); }
                open-create-group-dialog(parent-id) => { root.open-create-group-dialog(parent-id); }
                open-shell(host-id) => { root.open-shell(host-id); }
                open-host-sftp(host-id) => { root.open-host-sftp(host-id); }
                open-edit-host-dialog(host-id) => { root.open-edit-host-dialog(host-id); }
                duplicate-host(host-id) => { root.duplicate-host(host-id); }
                remove-host(host-id) => { root.remove-host(host-id); }
                remove-group(group-id) => { root.remove-group(group-id); }
            }

            VerticalSplitter {
                x: root.rail-width + root.visible-hosts-panel-width;
                y: 0px;
                visible: !root.hosts-panel-collapsed;
                height: parent.height;
                base-width: root.hosts-panel-width;
                resize(width) => { root.resize-hosts-panel(width); }
            }

        MainWorkspace {
                x: root.left-content-width;
                y: 0px;
                width: max(0px, parent.width - root.left-content-width - root.right-panel-width - root.right-splitter-width);
                height: parent.height;
                active-page: root.active-page-key;
                active-session-id: root.active-session-id;
                active-tab-title: root.active-tab-title;
                active-tab-kind: root.active-tab-kind;
                active-tab-status: root.active-tab-status;
                terminal-input: root.terminal-input;
                terminal-prompt: root.terminal-prompt;
                terminal-output: root.terminal-output;
                terminal-can-send-input: root.terminal-can-send-input;
                terminal-can-reconnect-shell: root.terminal-can-reconnect-shell;
                sftp-host-id: root.sftp-host-id;
                sftp-title: root.sftp-title;
                sftp-current-dir: root.sftp-current-dir;
                sftp-selected-path: root.sftp-selected-path;
                sftp-loading: root.sftp-loading;
                sftp-error: root.sftp-error;
                sftp-entries: root.sftp-entries;
                tool-panel-width: root.tool-panel-width;
                tool-panel-mode: root.tool-panel-mode;
                tool-panel-mode-key: root.tool-panel-mode-key;
                last-error: root.last-error;
                history-count: root.history.length;
                tabs: root.tabs;
                hosts: root.hosts;
                new-session-hosts: root.new-session-hosts;
                new-session-search-query: root.new-session-search-query;
                new-session-local-visible: root.new-session-local-visible;
                history: root.history;
                snippets: root.snippets;
                tunnels: root.tunnels;
                credentials: root.credentials;
                known-hosts: root.known-hosts;
                settings-language-options: root.settings-language-options;
                settings-theme-options: root.settings-theme-options;
                settings-theme-profiles: root.settings-theme-profiles;
                settings-storage-summary: root.settings-storage-summary;
                settings-file-actions: root.settings-file-actions;
                settings-title-label: root.settings-title-label;
                settings-language-title-label: root.settings-language-title-label;
                settings-theme-title-label: root.settings-theme-title-label;
                settings-custom-theme-title-label: root.settings-custom-theme-title-label;
                settings-storage-title-label: root.settings-storage-title-label;
