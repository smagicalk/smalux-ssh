            if !root.right-sidebar-collapsed: VerticalSplitter {
                x: parent.width - root.right-panel-width - root.splitter-width;
                y: 0px;
                height: parent.height;
                base-width: root.activity-panel-width;
                reverse: true;
                resize(width) => { root.resize-activity-panel(width); }
            }

            ActivityPanel {
                x: parent.width - root.right-panel-width;
                y: 0px;
                height: parent.height;
                collapsed: root.right-sidebar-collapsed;
                tab-count: root.tab-count;
                host-count: root.host-count;
                panel-width: root.activity-panel-width;
                activity: root.activity;
                recent: root.recent;
                title-label: root.activity-title-label;
                recent-title-label: root.recent-title-label;
                recent-empty-label: root.recent-empty-label;
                toggle => { root.toggle-right-sidebar(); }
            }
        }
