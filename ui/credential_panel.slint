import { ScrollView } from "std-widgets.slint";
import { CredentialRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CredentialContextMenuItem, CredentialPanelButton, CredentialSearchField, CredentialTreeItem } from "./credential_panel_parts.slint";
export component CredentialsPanel inherits Rectangle {
    in property <string> title-label;
    in property <string> search-query;
    in property <string> search-placeholder;
    in property <string> new-label;
    in property <string> new-group-label;
    in property <string> edit-group-label;
    in property <string> delete-group-label;
    in property <string> private-keys-label;
    in property <string> certificates-label;
    in property <string> passwords-label;
    in property <string> create-private-key-label;
    in property <string> import-private-key-label;
    in property <string> create-certificate-label;
    in property <string> import-certificate-label;
    in property <string> create-password-label;
    in property <string> create-agent-label;
    in property <string> edit-credential-label;
    in property <string> move-credential-label;
    in property <string> duplicate-credential-label;
    in property <string> export-credential-label;
    in property <string> delete-credential-label;
    in property <[CredentialRow]> credentials;
    in property <string> selected-id;
    in property <int> panel-width: 276;
    callback select-credential(id: string, name: string, group-id: string, group-path: string, kind: string, kind-key: string, username: string, secret-ref: string, secret-available: bool, algorithm: string, algorithm-key: string, fingerprint: string, meta: string, icon-key: string, node-kind: string, accent-index: int);
    callback update-search(query: string);
    callback toggle-tree-node(node-id: string);
    callback open-create-dialog();
    callback create-group(parent-id: string, parent-path: string, kind-key: string);
    callback create-credential(kind-key: string, group-id: string, group-path: string, import-mode: bool);
    callback open-move-picker(source-id: string, kind-key: string, group-id: string);
    callback edit-credential(credential-id: string, name: string, group-id: string, group-path: string, kind-key: string, algorithm-key: string);
    callback edit-group(group-id: string, name: string);
    callback remove-group(group-id: string);
    callback duplicate-credential(credential-id: string);
    callback export-credential(credential-id: string, name: string, kind-key: string);
    callback request-remove-credential(credential-id: string, name: string);
    callback remove-credential(credential-id: string);
    callback move-node(source-id: string, target-id: string) -> bool;

    property <bool> context-menu-open: false;
    property <length> context-menu-x: 12px;
    property <length> context-menu-y: 54px;
    property <string> context-node-kind: "Group";
    property <string> context-node-id: "";
    property <string> context-node-name: "";
    property <string> context-node-group-id: "";
    property <string> context-node-group-path: "";
    property <string> context-node-algorithm-key: "";
    property <string> context-kind-key: "";
    property <bool> context-custom-group: root.context-node-kind == "CredentialGroup";
    property <int> context-kind-action-count: root.context-kind-key == "PrivateKey" ? 2 : root.context-kind-key == "Certificate" ? 2 : root.context-kind-key == "Password" ? 1 : 0;
    property <int> context-group-action-count: (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") ? (1 + root.context-kind-action-count + (root.context-custom-group ? 3 : 0)) : 0;
    property <int> context-credential-action-count: root.context-node-kind == "Credential" ? 5 : 0;
    property <int> context-menu-item-count: root.context-node-kind == "Credential" ? root.context-credential-action-count : root.context-group-action-count;
    property <length> context-menu-height: (10 + root.context-menu-item-count * 32 + (root.context-menu-item-count > 0 ? (root.context-menu-item-count - 1) * 3 : 0)) * 1px;

    width: root.panel-width * 1px;
    background: AppTheme.panel-bg;
    border-width: 1px;
    border-color: AppTheme.border-soft;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 6px;
        spacing: 6px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;

            Rectangle { width: 9px; }

            Text {
                horizontal-stretch: 1;
                text: root.title-label;
                color: AppTheme.text;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }

            CredentialPanelButton {
                label: root.new-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-create-dialog();
                }
            }
        }

        CredentialSearchField {
            value: root.search-query;
            placeholder: root.search-placeholder;
            edited(query) => { root.update-search(query); }
            accepted(query) => { root.update-search(query); }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            background: AppTheme.dialog-section-bg;
            clip: true;

            ScrollView {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;

                VerticalLayout {
                    spacing: 1px;

                    for credential in root.credentials: CredentialTreeItem {
                        credential: credential;
                        selected-id: root.selected-id;
                        toggle-node(id) => { root.toggle-tree-node(id); }
                        move-node(source-id, target-id) => { root.move-node(source-id, target-id) }
                        selected(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index) => {
                            root.context-menu-open = false;
                            root.select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index);
                        }
                        open-context-menu(abs-x, abs-y, id, name, group-id, group-path, kind, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index, kind-key) => {
                            root.select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index);
                            root.context-node-kind = node-kind;
                            root.context-node-id = id;
                            root.context-node-name = name;
                            root.context-node-group-id = group-id;
                            root.context-node-group-path = group-path;
                            root.context-node-algorithm-key = algorithm-key;
                            root.context-kind-key = kind-key;
                            root.context-menu-x = min(max(10px, abs-x - root.absolute-position.x), max(10px, root.width - 154px));
                            root.context-menu-y = min(max(10px, abs-y - root.absolute-position.y), max(10px, root.height - root.context-menu-height - 10px));
                            root.context-menu-open = true;
                        }
                    }
                }
            }
        }
    }

    if root.context-menu-open: Rectangle {
        x: root.context-menu-x;
        y: root.context-menu-y;
        width: 144px;
        height: root.context-menu-height;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 5px;
            spacing: 3px;

            if root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup": CredentialContextMenuItem {
                label: root.new-group-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-group(
                        root.context-custom-group ? root.context-node-id : "",
                        root.context-kind-key == "Root" ? "" : root.context-node-group-path,
                        root.context-kind-key == "Root" ? "PrivateKey" : root.context-kind-key,
                    );
                }
            }

            if (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") && root.context-kind-key == "PrivateKey": CredentialContextMenuItem {
                label: root.create-private-key-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-credential("PrivateKey", root.context-custom-group ? root.context-node-id : "", root.context-node-group-path, false);
                }
            }

            if (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") && root.context-kind-key == "PrivateKey": CredentialContextMenuItem {
                label: root.import-private-key-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-credential("PrivateKey", root.context-custom-group ? root.context-node-id : "", root.context-node-group-path, true);
                }
            }

            if (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") && root.context-kind-key == "Certificate": CredentialContextMenuItem {
                label: root.create-certificate-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-credential("Certificate", root.context-custom-group ? root.context-node-id : "", root.context-node-group-path, false);
                }
            }

            if (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") && root.context-kind-key == "Certificate": CredentialContextMenuItem {
                label: root.import-certificate-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-credential("Certificate", root.context-custom-group ? root.context-node-id : "", root.context-node-group-path, true);
                }
            }

            if (root.context-node-kind == "Group" || root.context-node-kind == "CredentialGroup") && root.context-kind-key == "Password": CredentialContextMenuItem {
                label: root.create-password-label;
                clicked => {
                    root.context-menu-open = false;
                    root.create-credential("Password", root.context-custom-group ? root.context-node-id : "", root.context-node-group-path, false);
                }
            }

            if root.context-custom-group: CredentialContextMenuItem {
                label: root.edit-group-label;
                clicked => {
                    root.context-menu-open = false;
                    root.edit-group(root.context-node-id, root.context-node-name);
                }
            }

            if root.context-custom-group: CredentialContextMenuItem {
                label: root.move-credential-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-move-picker(root.context-node-id, root.context-kind-key, root.context-node-group-id);
                }
            }

            if root.context-custom-group: CredentialContextMenuItem {
                label: root.delete-group-label;
                danger: true;
                clicked => {
                    root.context-menu-open = false;
                    root.remove-group(root.context-node-id);
                }
            }

            if root.context-node-kind == "Credential": CredentialContextMenuItem {
                label: root.edit-credential-label;
                clicked => {
                    root.context-menu-open = false;
                    root.edit-credential(
                        root.context-node-id,
                        root.context-node-name,
                        root.context-node-group-id,
                        root.context-node-group-path,
                        root.context-kind-key,
                        root.context-node-algorithm-key,
                    );
                }
            }

            if root.context-node-kind == "Credential": CredentialContextMenuItem {
                label: root.move-credential-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-move-picker(root.context-node-id, root.context-kind-key, root.context-node-group-id);
                }
            }

            if root.context-node-kind == "Credential": CredentialContextMenuItem {
                label: root.duplicate-credential-label;
                clicked => {
                    root.context-menu-open = false;
                    root.duplicate-credential(root.context-node-id);
                }
            }

            if root.context-node-kind == "Credential": CredentialContextMenuItem {
                label: root.export-credential-label;
                clicked => {
                    root.context-menu-open = false;
                    root.export-credential(root.context-node-id, root.context-node-name, root.context-kind-key);
                }
            }

            if root.context-node-kind == "Credential": CredentialContextMenuItem {
                label: root.delete-credential-label;
                danger: true;
                clicked => {
                    root.context-menu-open = false;
                    root.request-remove-credential(root.context-node-id, root.context-node-name);
                }
            }
        }
    }
}
