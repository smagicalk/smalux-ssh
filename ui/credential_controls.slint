import { ScrollView } from "std-widgets.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";

export component CredentialAlgorithmOption inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> selected-value;
    callback selected(value: string);

    property <bool> active: root.value == root.selected-value;

    height: 28px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-soft : AppTheme.transparent;
    background: root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.selected(root.value); }
    }

    Text {
        text: root.label;
        color: root.active ? AppTheme.text-strong : AppTheme.text-muted;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CredentialTextArea inherits Rectangle {
    in property <string> label;
    in property <string> field-value;
    in property <string> placeholder;
    callback edited(value: string);

    height: 132px;
    background: AppTheme.transparent;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
        }
        Rectangle {
            height: 108px;
            border-radius: 7px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.input-bg;

            Text {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                text: root.placeholder;
                color: AppTheme.input-placeholder;
                font-size: 11px;
                wrap: word-wrap;
                visible: input.text == "";
            }

            scroll := ScrollView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, input.preferred-height);

                input := TextInput {
                    width: scroll.visible-width;
                    height: max(scroll.visible-height, self.preferred-height);
                    text: root.field-value;
                    single-line: false;
                    wrap: word-wrap;
                    color: AppTheme.text;
                    font-size: 11px;
                    text-cursor-width: 1px;
                    selection-background-color: AppTheme.input-selection;
                    selection-foreground-color: AppTheme.text-strong;
                    page-height: scroll.visible-height;
                    edited => { root.edited(self.text); }

                    cursor-position-changed(cpos) => {
                        if cpos.y + scroll.viewport-y < 8px {
                            scroll.viewport-y = min(0px, -cpos.y + 8px);
                        } else if cpos.y + scroll.viewport-y > scroll.visible-height - 18px {
                            scroll.viewport-y = min(0px, scroll.visible-height - cpos.y - 18px);
                        }
                    }
                }
            }
        }
    }
}

export component CredentialPathField inherits Rectangle {
    in property <string> label;
    in property <string> field-value;
    in property <string> placeholder;
    in property <string> choose-label;
    callback edited(value: string);
    callback accepted(value: string);
    callback choose();

    height: 50px;
    background: AppTheme.transparent;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
        }
        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: 7px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.input-bg;

                Text {
                    x: 8px;
                    y: 0px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.placeholder;
                    color: AppTheme.input-placeholder;
                    font-size: 11px;
                    vertical-alignment: center;
                    visible: input.text == "";
                    overflow: elide;
                }

                input := TextInput {
                    x: 8px;
                    y: 0px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.field-value;
                    single-line: true;
                    color: AppTheme.text;
                    font-size: 11px;
                    text-cursor-width: 1px;
                    selection-background-color: AppTheme.input-selection;
                    selection-foreground-color: AppTheme.text-strong;
                    vertical-alignment: center;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
            }
            Rectangle {
                width: 74px;
                height: 30px;
                background: AppTheme.transparent;

                CompactButton {
                    x: 0px;
                    y: 3px;
                    width: parent.width;
                    label: root.choose-label;
                    compact: false;
                    clicked => { root.choose(); }
                }
            }
        }
    }
}

export component CredentialPasswordField inherits Rectangle {
    in property <string> label;
    in property <string> field-value;
    in property <string> placeholder;
    in property <string> show-label;
    in property <string> hide-label;
    callback edited(value: string);
    callback accepted(value: string);

    property <bool> revealed: false;

    height: 50px;
    background: AppTheme.transparent;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
        }
        Rectangle {
            height: 30px;
            border-radius: 7px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.input-bg;

            Text {
                x: 8px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;
                text: root.placeholder;
                color: AppTheme.input-placeholder;
                font-size: 11px;
                vertical-alignment: center;
                visible: input.text == "";
            }

            input := TextInput {
                x: 8px;
                y: 0px;
                width: parent.width - 72px;
                height: parent.height;
                text: root.field-value;
                single-line: true;
                input-type: root.revealed ? InputType.text : InputType.password;
                color: AppTheme.text;
                font-size: 11px;
                text-cursor-width: 1px;
                selection-background-color: AppTheme.input-selection;
                selection-foreground-color: AppTheme.text-strong;
                vertical-alignment: center;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }

            reveal-touch := TouchArea {
                x: parent.width - 60px;
                y: 3px;
                width: 52px;
                height: 24px;
                clicked => { root.revealed = !root.revealed; }
            }

            Text {
                x: parent.width - 60px;
                y: 0px;
                width: 52px;
                height: parent.height;
                text: root.revealed ? root.hide-label : root.show-label;
                color: reveal-touch.has-hover ? AppTheme.text-strong : AppTheme.text-soft;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component CredentialAlgorithmField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback selected(value: string);

    property <bool> open: false;
    property <string> display-value: root.value == "Rsa" ? "RSA" : root.value == "Ecdsa" ? "ECDSA" : "Ed25519";

    height: root.open ? 150px : 50px;
    background: AppTheme.transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 15px;
        text: root.label;
        color: AppTheme.text-soft;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
    }

    Rectangle {
        x: 0px;
        y: 18px;
        width: parent.width;
        height: 32px;
        border-radius: 7px;
        border-width: 1px;
        border-color: AppTheme.border-soft;
        background: AppTheme.input-bg;

        touch := TouchArea {
            clicked => { root.open = !root.open; }
        }

        Text {
            x: 10px;
            y: 0px;
            width: parent.width - 42px;
            height: parent.height;
            text: root.display-value;
            color: AppTheme.text;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - 28px;
            y: 0px;
            width: 18px;
            height: parent.height;
            text: root.open ? "^" : "v";
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.open: Rectangle {
        x: 0px;
        y: 56px;
        width: parent.width;
        height: 90px;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-soft;
        background: AppTheme.dialog-section-bg;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            CredentialAlgorithmOption {
                label: "Ed25519";
                value: "Ed25519";
                selected-value: root.value;
                selected(value) => {
                    root.selected(value);
                    root.open = false;
                }
            }
            CredentialAlgorithmOption {
                label: "RSA";
                value: "Rsa";
                selected-value: root.value;
                selected(value) => {
                    root.selected(value);
                    root.open = false;
                }
            }
            CredentialAlgorithmOption {
                label: "ECDSA";
                value: "Ecdsa";
                selected-value: root.value;
                selected(value) => {
                    root.selected(value);
                    root.open = false;
                }
            }
        }
    }
}

export component CredentialGroupField inherits Rectangle {
    in property <string> label;
    in property <string> group-path;
    callback open();

    height: 50px;
    background: AppTheme.transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 15px;
        text: root.label;
        color: AppTheme.text-soft;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
    }

    Rectangle {
        x: 0px;
        y: 17px;
        width: parent.width;
        height: 32px;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-soft;
        background: AppTheme.input-bg;

        touch := TouchArea {
            clicked => { root.open(); }
        }

        Text {
            x: 10px;
            y: 0px;
            width: parent.width - 40px;
            height: parent.height;
            text: root.group-path == "" ? root.label : root.group-path;
            color: root.group-path == "" ? AppTheme.input-placeholder : AppTheme.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - 28px;
            y: 0px;
            width: 18px;
            height: parent.height;
            text: ">";
            color: AppTheme.text-soft;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
