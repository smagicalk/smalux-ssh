import { CredentialRow } from "./models.slint";
import { CreateCredentialGroupDialog, CredentialGroupPickerDialog } from "./credential_group_dialogs.slint";

export component CredentialGroupFlow inherits Rectangle {
    in-out property <bool> create-credential-group-dialog-open;
    in-out property <bool> credential-group-parent-picker-open;
    in-out property <string> quick-credential-group-name;
    in-out property <string> quick-credential-group-parent-id;
    in-out property <string> quick-credential-group-parent-path;
    in-out property <string> quick-credential-group-edit-id;
    in-out property <string> quick-credential-group-kind-key;
    in property <string> quick-credential-group-root-path;
    in property <[CredentialRow]> credential-rows;
    in property <string> security-group-new-label;
    in property <string> security-group-edit-label;
    in property <string> create-group-name-label;
    in property <string> create-group-name-placeholder;
    in property <string> security-field-type-label;
    in property <string> security-private-keys-label;
    in property <string> security-certificates-label;
    in property <string> security-passwords-label;
    in property <string> security-field-group-label;
    in property <string> create-group-cancel-label;
    in property <string> create-group-save-label;
    callback create-credential-group(name: string, parent-id: string, kind-key: string) -> bool;
    callback rename-credential-group(group-id: string, name: string) -> bool;

    if root.create-credential-group-dialog-open: CreateCredentialGroupDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.quick-credential-group-edit-id == "" ? root.security-group-new-label : root.security-group-edit-label;
        name-label: root.create-group-name-label;
        name-placeholder: root.create-group-name-placeholder;
        kind-label: root.security-field-type-label;
        private-keys-label: root.security-private-keys-label;
        certificates-label: root.security-certificates-label;
        passwords-label: root.security-passwords-label;
        kind-key: root.quick-credential-group-kind-key;
        parent-label: root.security-field-group-label;
        parent-path: root.quick-credential-group-parent-path == "" ? root.quick-credential-group-root-path : root.quick-credential-group-parent-path;
        group-name: root.quick-credential-group-name;
        edit-mode: root.quick-credential-group-edit-id != "";
        cancel-label: root.create-group-cancel-label;
        save-label: root.create-group-save-label;
        update-name(value) => { root.quick-credential-group-name = value; }
        update-kind(value) => {
            root.quick-credential-group-kind-key = value;
            root.quick-credential-group-parent-id = "";
            root.quick-credential-group-parent-path = "";
        }
        open-parent-picker => { root.credential-group-parent-picker-open = true; }
        save => {
            if root.quick-credential-group-edit-id == "" {
                if !root.create-credential-group(root.quick-credential-group-name, root.quick-credential-group-parent-id, root.quick-credential-group-kind-key) {
                    return;
                }
            } else {
                if !root.rename-credential-group(root.quick-credential-group-edit-id, root.quick-credential-group-name) {
                    return;
                }
            }
            root.create-credential-group-dialog-open = false;
            root.credential-group-parent-picker-open = false;
            root.quick-credential-group-name = "";
            root.quick-credential-group-parent-id = "";
            root.quick-credential-group-parent-path = "";
            root.quick-credential-group-edit-id = "";
            root.quick-credential-group-kind-key = "PrivateKey";
        }
        close => {
            root.create-credential-group-dialog-open = false;
            root.credential-group-parent-picker-open = false;
            root.quick-credential-group-name = "";
            root.quick-credential-group-parent-id = "";
            root.quick-credential-group-parent-path = "";
            root.quick-credential-group-edit-id = "";
            root.quick-credential-group-kind-key = "PrivateKey";
        }
    }

    if root.credential-group-parent-picker-open: CredentialGroupPickerDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-field-group-label;
        current-kind-key: root.quick-credential-group-kind-key;
        selected-group-id: root.quick-credential-group-parent-id;
        credentials: root.credential-rows;
        close-label: root.create-group-cancel-label;
        select-group(id, path) => {
            root.quick-credential-group-parent-id = id;
            root.quick-credential-group-parent-path = path;
            root.credential-group-parent-picker-open = false;
        }
        close => { root.credential-group-parent-picker-open = false; }
    }
}
