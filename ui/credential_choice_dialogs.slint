import { AppTheme } from "./theme.slint";
import { DialogCloseButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
component CredentialCreateActionItem inherits Rectangle {
    in property <string> label;
    in property <string> meta-label;
    in property <string> icon-key: "key";
    in property <int> accent-index: 0;
    callback clicked();

    height: 42px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HostIcon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        icon-key: root.icon-key;
        accent-index: root.accent-index;
        status-key: "Created";
    }

    Text {
        x: 40px;
        y: 7px;
        width: parent.width - 48px;
        height: 15px;
        text: root.label;
        color: AppTheme.text-strong;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 40px;
        y: 23px;
        width: parent.width - 48px;
        height: 13px;
        text: root.meta-label;
        color: AppTheme.text-muted;
        font-size: 9px;
        overflow: elide;
        vertical-alignment: center;
    }
}

export component SecurityCredentialActionChoiceDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> create-label;
    in property <string> create-caption-label;
    in property <string> import-label;
    in property <string> import-caption-label;
    in property <string> group-label;
    in property <string> group-caption-label;
    callback create-content();
    callback import-content();
    callback create-group();
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 420px);
        height: 260px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            CredentialCreateActionItem {
                label: root.create-label;
                meta-label: root.create-caption-label;
                icon-key: "key";
                accent-index: 0;
                clicked => { root.create-content(); }
            }

            CredentialCreateActionItem {
                label: root.import-label;
                meta-label: root.import-caption-label;
                icon-key: "terminal";
                accent-index: 1;
                clicked => { root.import-content(); }
            }

            CredentialCreateActionItem {
                label: root.group-label;
                meta-label: root.group-caption-label;
                icon-key: "cluster";
                accent-index: 3;
                clicked => { root.create-group(); }
            }
        }
    }
}

export component SecurityCredentialTypeChoiceDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> caption-label;
    in property <bool> import-mode;
    in property <string> private-key-label;
    in property <string> certificate-label;
    in property <string> password-label;
    in property <string> private-keys-label;
    in property <string> certificates-label;
    in property <string> passwords-label;
    callback choose-private-key();
    callback choose-certificate();
    callback choose-password();
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 420px);
        height: root.import-mode ? 238px : 300px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            Text {
                height: 16px;
                text: root.caption-label;
                color: AppTheme.text-muted;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }

            CredentialCreateActionItem {
                label: root.private-key-label;
                meta-label: root.private-keys-label;
                icon-key: "key";
                accent-index: 0;
                clicked => { root.choose-private-key(); }
            }

            CredentialCreateActionItem {
                label: root.certificate-label;
                meta-label: root.certificates-label;
                icon-key: "shield";
                accent-index: 2;
                clicked => { root.choose-certificate(); }
            }

            if !root.import-mode: CredentialCreateActionItem {
                label: root.password-label;
                meta-label: root.passwords-label;
                icon-key: "shield";
                accent-index: 4;
                clicked => { root.choose-password(); }
            }
        }
    }
}
