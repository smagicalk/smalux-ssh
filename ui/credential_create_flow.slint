import { SecurityCredentialActionChoiceDialog, SecurityCredentialTypeChoiceDialog } from "./credential_choice_dialogs.slint";

export component CredentialCreateChoiceFlow inherits Rectangle {
    in-out property <bool> security-create-action-dialog-open;
    in-out property <bool> security-create-type-dialog-open;
    in-out property <string> security-create-flow-action;
    in-out property <bool> create-credential-group-dialog-open;
    in-out property <bool> create-security-credential-dialog-open;
    in-out property <bool> create-certificate-credential-dialog-open;
    in-out property <string> quick-credential-group-name;
    in-out property <string> quick-credential-group-parent-id;
    in-out property <string> quick-credential-group-parent-path;
    in-out property <string> quick-credential-group-edit-id;
    in-out property <string> quick-credential-group-kind-key;
    in-out property <string> quick-security-credential-edit-id;
    in-out property <string> quick-security-credential-kind-key;
    in-out property <string> quick-security-credential-group-id;
    in-out property <string> quick-security-credential-group-path;
    in-out property <bool> quick-security-credential-import-mode;
    in-out property <string> quick-security-credential-import-source-key;
    in-out property <string> quick-security-credential-name;
    in-out property <string> quick-security-credential-secret-ref;
    in-out property <string> quick-security-credential-algorithm;
    in-out property <string> quick-security-certificate-ca-key-ref;
    in-out property <string> quick-security-certificate-ca-key-name;
    in-out property <string> quick-security-certificate-subject-key-ref;
    in-out property <string> quick-security-certificate-subject-key-name;
    in-out property <string> quick-security-certificate-type;
    in-out property <string> quick-security-certificate-principals;
    in-out property <string> quick-security-certificate-valid-days;
    in-out property <string> quick-security-certificate-key-id;
    in-out property <string> quick-security-certificate-serial;
    in property <string> quick-security-credential-root-group-path;
    in property <string> security-create-action-title-label;
    in property <string> security-create-action-create-label;
    in property <string> security-create-action-create-caption-label;
    in property <string> security-create-action-import-label;
    in property <string> security-create-action-import-caption-label;
    in property <string> security-create-action-group-caption-label;
    in property <string> security-create-type-title-label;
    in property <string> security-create-type-import-caption-label;
    in property <string> security-create-type-create-caption-label;
    in property <string> security-group-new-label;
    in property <string> security-private-key-import-label;
    in property <string> security-private-key-create-label;
    in property <string> security-certificate-import-label;
    in property <string> security-certificate-create-label;
    in property <string> security-password-create-label;
    in property <string> security-private-keys-label;
    in property <string> security-certificates-label;
    in property <string> security-passwords-label;

    if root.security-create-action-dialog-open: SecurityCredentialActionChoiceDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-create-action-title-label;
        create-label: root.security-create-action-create-label;
        create-caption-label: root.security-create-action-create-caption-label;
        import-label: root.security-create-action-import-label;
        import-caption-label: root.security-create-action-import-caption-label;
        group-label: root.security-group-new-label;
        group-caption-label: root.security-create-action-group-caption-label;
        create-content => {
            root.security-create-action-dialog-open = false;
            root.security-create-flow-action = "Create";
            root.security-create-type-dialog-open = true;
        }
        import-content => {
            root.security-create-action-dialog-open = false;
            root.security-create-flow-action = "Import";
            root.security-create-type-dialog-open = true;
        }
        create-group => {
            root.security-create-action-dialog-open = false;
            root.quick-credential-group-name = "";
            root.quick-credential-group-parent-id = "";
            root.quick-credential-group-parent-path = "";
            root.quick-credential-group-edit-id = "";
            root.quick-credential-group-kind-key = "PrivateKey";
            root.create-credential-group-dialog-open = true;
        }
        close => { root.security-create-action-dialog-open = false; }
    }

    if root.security-create-type-dialog-open: SecurityCredentialTypeChoiceDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-create-type-title-label;
        caption-label: root.security-create-flow-action == "Import" ? root.security-create-type-import-caption-label : root.security-create-type-create-caption-label;
        import-mode: root.security-create-flow-action == "Import";
        private-key-label: root.security-create-flow-action == "Import" ? root.security-private-key-import-label : root.security-private-key-create-label;
        certificate-label: root.security-create-flow-action == "Import" ? root.security-certificate-import-label : root.security-certificate-create-label;
        password-label: root.security-password-create-label;
        private-keys-label: root.security-private-keys-label;
        certificates-label: root.security-certificates-label;
        passwords-label: root.security-passwords-label;
        choose-private-key => {
            root.security-create-type-dialog-open = false;
            root.quick-security-credential-edit-id = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = root.quick-security-credential-root-group-path;
            root.quick-security-credential-import-mode = root.security-create-flow-action == "Import";
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            root.create-security-credential-dialog-open = true;
        }
        choose-certificate => {
            root.security-create-type-dialog-open = false;
            root.quick-security-credential-edit-id = "";
            root.quick-security-credential-kind-key = "Certificate";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = root.quick-security-credential-root-group-path;
            root.quick-security-credential-import-mode = root.security-create-flow-action == "Import";
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            if root.quick-security-credential-import-mode {
                root.create-security-credential-dialog-open = true;
            } else {
                root.quick-security-certificate-ca-key-ref = "";
                root.quick-security-certificate-ca-key-name = "";
                root.quick-security-certificate-subject-key-ref = "";
                root.quick-security-certificate-subject-key-name = "";
                root.quick-security-certificate-type = "User";
                root.quick-security-certificate-principals = "";
                root.quick-security-certificate-valid-days = "365";
                root.quick-security-certificate-key-id = "";
                root.quick-security-certificate-serial = "";
                root.create-certificate-credential-dialog-open = true;
            }
        }
        choose-password => {
            root.security-create-type-dialog-open = false;
            root.quick-security-credential-edit-id = "";
            root.quick-security-credential-kind-key = "Password";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = root.quick-security-credential-root-group-path;
            root.quick-security-credential-import-mode = false;
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            root.create-security-credential-dialog-open = true;
        }
        close => { root.security-create-type-dialog-open = false; }
    }
}
