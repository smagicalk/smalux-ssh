import { ScrollView } from "std-widgets.slint";
import { CredentialGroupContentRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
export component CredentialDetailField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> active: true;
    callback copy-value(value: string) -> bool;

    visible: root.active;
    height: root.active ? 60px : 0px;
    horizontal-stretch: 1;
    border-radius: 0px;
    border-width: 0px;
    background: AppTheme.transparent;
    clip: true;

    Rectangle {
        width: parent.width;
        height: 52px;
        border-radius: 7px;
        border-width: 1px;
        border-color: AppTheme.border-soft;
        background: AppTheme.card-bg;

        value-touch := TouchArea {
            enabled: root.value != "";
            clicked => { root.copy-value(root.value); }
        }

        Rectangle {
            x: 0px;
            y: 6px;
            width: 3px;
            height: parent.height - 12px;
            border-radius: 2px;
            background: AppTheme.accent;
        }

        Text {
            x: 14px;
            y: 5px;
            width: parent.width - 28px;
            height: 14px;
            text: root.label;
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 14px;
            y: 24px;
            width: parent.width - 28px;
            height: 18px;
            text: root.value;
            color: AppTheme.text-strong;
            font-size: 12px;
            font-weight: 650;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component CredentialSecretActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 58px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.enabled ? AppTheme.border-soft : root.primary ? (touch.pressed ? AppTheme.button-primary-border-pressed : touch.has-hover ? AppTheme.button-primary-border-hover : AppTheme.button-primary-border) : touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: !root.enabled ? AppTheme.panel-bg : root.primary ? (touch.pressed ? AppTheme.button-primary-pressed : touch.has-hover ? AppTheme.button-primary-hover : AppTheme.button-primary-bg) : touch.pressed ? AppTheme.button-secondary-pressed : touch.has-hover ? AppTheme.button-secondary-hover : AppTheme.raised-bg;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        color: !root.enabled ? AppTheme.text-muted : root.primary ? AppTheme.button-primary-text : AppTheme.text;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CredentialSecretContentBlock inherits Rectangle {
    in property <string> label;
    in property <string> content;
    in property <string> hidden-label: "••••••••";
    in property <string> show-label;
    in property <string> hide-label;
    in property <string> copy-label;
    in property <string> copy-success-label;
    in property <string> copy-failed-label;
    in property <string> edit-label;
    in property <bool> revealed;
    in property <bool> missing;
    in property <bool> toggle-enabled;
    in property <bool> copy-enabled;
    in property <bool> edit-enabled;
    callback toggle-secret();
    callback copy-content(content: string) -> bool;
    callback edit-content();

    property <string> copy-status: "";
    property <string> display-content: root.missing ? root.content : (root.revealed ? root.content : root.hidden-label);
    property <length> content-scroll-y: 0px;
    property <length> content-scroll-height: max(1px, secret-text.preferred-height + 28px);
    property <bool> compact-content: !root.revealed || root.missing;

    changed display-content => {
        root.content-scroll-y = 0px;
    }

    min-height: root.compact-content ? 150px : 230px;
    vertical-stretch: 1;
    border-radius: 0px;
    border-width: 0px;
    background: AppTheme.transparent;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 26px;
            spacing: 6px;

            Text {
                text: root.label;
                color: AppTheme.text-strong;
                font-size: 12px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.copy-status != "": Text {
                text: root.copy-status;
                color: root.copy-status == root.copy-success-label ? AppTheme.success-text : AppTheme.danger-text;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
            CompactButton {
                label: root.revealed ? ("👁 " + root.hide-label) : ("👁 " + root.show-label);
                tone: "subtle";
                compact: false;
                enabled: root.toggle-enabled;
                clicked => { root.toggle-secret(); }
            }
            CredentialSecretActionButton {
                label: root.copy-label;
                primary: true;
                enabled: root.copy-enabled;
                clicked => {
                    root.copy-status = root.copy-content(root.content) ? root.copy-success-label : root.copy-failed-label;
                }
            }
            CredentialSecretActionButton {
                label: root.edit-label;
                primary: false;
                enabled: root.edit-enabled;
                clicked => { root.edit-content(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.input-bg;
            clip: true;

            secret-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width - 14px;
                viewport-height: max(self.height, root.content-scroll-height);
                viewport-y <=> root.content-scroll-y;
                vertical-scrollbar-policy: root.compact-content ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-on;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                content-surface := Rectangle {
                    width: parent.width - 14px;
                    height: max(secret-scroll.height, root.content-scroll-height);
                    background: AppTheme.transparent;

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 0px;

                        secret-text := Text {
                            horizontal-stretch: 1;
                            text: root.display-content;
                            wrap: word-wrap;
                            color: AppTheme.text;
                            font-size: 11px;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}

export component SecurityGroupContentItem inherits Rectangle {
    in property <CredentialGroupContentRow> content;
    in property <string> active-parent-id;
    in property <string> selected-id;
    callback selected(id: string, name: string, group-id: string, group-path: string, kind: string, kind-key: string, username: string, secret-ref: string, secret-available: bool, algorithm: string, algorithm-key: string, fingerprint: string, meta: string, icon-key: string, node-kind: string, accent-index: int);

    property <bool> content-visible: root.content.parent_id == root.active-parent-id;
    property <length> card-height: root.content.node_kind == "Empty" ? 76px : 48px;
    property <color> marker-color: root.content.node_kind == "CredentialGroup" || root.content.node_kind == "Group"
        ? AppTheme.accent-blue
        : root.content.kind_key == "Password"
            ? AppTheme.warning
            : root.content.kind_key == "Certificate"
                ? AppTheme.accent-violet
                : AppTheme.accent;
    height: root.content-visible ? root.card-height + 5px : 0px;
    background: AppTheme.transparent;
    border-width: 0px;

    Rectangle {
        visible: root.content-visible;
        width: parent.width;
        height: root.card-height;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.content.id == root.selected-id ? AppTheme.border-strong : AppTheme.border-soft;
        background: root.content.id == root.selected-id ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.surface-bg;

        touch := TouchArea {
            clicked => {
                if root.content.node_kind != "Empty" {
                    root.selected(
                        root.content.id,
                        root.content.name,
                        root.content.group_id,
                        root.content.group_path,
                        root.content.kind,
                        root.content.kind_key,
                        root.content.username,
                        root.content.secret_ref,
                        root.content.secret_available,
                        root.content.algorithm,
                        root.content.algorithm_key,
                        root.content.fingerprint,
                        root.content.meta,
                        root.content.icon_key,
                        root.content.node_kind,
                        root.content.accent_index,
                    );
                }
            }
        }

        if root.content.node_kind == "Empty": HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;

            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.content.name;
                color: AppTheme.text-muted;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.content.node_kind != "Empty": HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 9px;

            Rectangle {
                width: 3px;
                height: parent.height;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 3px;
                    height: 24px;
                    border-radius: 2px;
                    background: root.marker-color;
                }
            }

            Rectangle {
                width: 22px;
                height: parent.height;

                HostIcon {
                    y: (parent.height - self.height) / 2;
                    icon-key: root.content.icon_key;
                    accent-index: root.content.accent_index;
                    status-key: "Created";
                }
            }

            Text {
                horizontal-stretch: 1;
                height: parent.height;
                text: root.content.name;
                color: AppTheme.text-strong;
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                width: 82px;
                height: parent.height;
                text: root.content.meta;
                color: AppTheme.text-soft;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
