import { ScrollView } from "std-widgets.slint";
import { SnippetRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";
import { CredentialSearchField, CredentialTreeBranch } from "./credential_panel_parts.slint";
import { HostIcon } from "./hosts.slint";
component SnippetContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? (root.danger ? AppTheme.button-danger-bg : AppTheme.surface-hover) : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: root.danger ? AppTheme.danger-text-soft : AppTheme.text-secondary;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

component SnippetTreeItem inherits Rectangle {
    in property <SnippetRow> snippet;
    in property <string> selected-id;
    in property <length> visible-row-width;
    callback selected(id: string, parent-id: string, name: string, description: string, command-template: string, scope: string, scope-key: string, variables: string, variable-names: string, arguments: string, argument-values: string, meta: string, target-linux-selected: bool, target-debian-selected: bool, target-rhel-selected: bool, target-alpine-selected: bool, target-fedora-selected: bool, target-arch-selected: bool, target-suse-selected: bool, target-freebsd-selected: bool, target-macos-selected: bool, target-powershell-selected: bool, target-cmd-selected: bool, target-linux-disabled: bool, target-debian-disabled: bool, target-rhel-disabled: bool, target-alpine-disabled: bool, target-fedora-disabled: bool, target-arch-disabled: bool, target-suse-disabled: bool, target-freebsd-disabled: bool, target-macos-disabled: bool, target-powershell-disabled: bool, target-cmd-disabled: bool, icon-key: string, node-kind: string, accent-index: int);
    callback toggle-node(id: string);
    callback move-node(source-id: string, source-kind: string, target-id: string) -> bool;
    callback open-context-menu(abs-x: length, abs-y: length, id: string, parent-id: string, name: string, description: string, command-template: string, scope: string, scope-key: string, variables: string, variable-names: string, arguments: string, argument-values: string, meta: string, target-linux-selected: bool, target-debian-selected: bool, target-rhel-selected: bool, target-alpine-selected: bool, target-fedora-selected: bool, target-arch-selected: bool, target-suse-selected: bool, target-freebsd-selected: bool, target-macos-selected: bool, target-powershell-selected: bool, target-cmd-selected: bool, target-linux-disabled: bool, target-debian-disabled: bool, target-rhel-disabled: bool, target-alpine-disabled: bool, target-fedora-disabled: bool, target-arch-disabled: bool, target-suse-disabled: bool, target-freebsd-disabled: bool, target-macos-disabled: bool, target-powershell-disabled: bool, target-cmd-disabled: bool, icon-key: string, node-kind: string, accent-index: int);

    property <bool> active: root.snippet.id == root.selected-id;
    property <color> marker-color: root.snippet.node_kind == "Group"
        ? AppTheme.accent-blue
        : root.snippet.node_kind == "SnippetTarget"
            ? AppTheme.accent-violet
        : root.snippet.scope_key == "Host"
            ? AppTheme.warning
            : AppTheme.accent;
    property <bool> group-node: root.snippet.node_kind == "Group";
    property <bool> snippet-node: root.snippet.node_kind == "Snippet";
    property <bool> target-node: root.snippet.node_kind == "SnippetTarget";
    property <string> badge-text: root.target-node ? root.snippet.scope : root.snippet.meta;
    property <bool> root-group: root.snippet.id == "snippet-folder:all";
    property <bool> drag-enabled: root.snippet-node || (root.group-node && !root.root-group);
    property <bool> drop-enabled: root.group-node;
    property <string> drag-mime-type: root.group-node ? "application/x-smagical-snippet-group-row" : "application/x-smagical-snippet-row";

    height: root.target-node ? 30px : 34px;
    border-radius: 7px;
    background: drop-target.contains-drag ? AppTheme.selection-bg : root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => {
            root.selected(
                root.snippet.id,
                root.snippet.parent_id,
                root.snippet.name,
                root.snippet.description,
                root.snippet.command_template,
                root.snippet.scope,
                root.snippet.scope_key,
                root.snippet.variables,
                root.snippet.variable_names,
                root.snippet.arguments,
                root.snippet.argument_values,
                root.snippet.meta,
                root.snippet.target_linux_selected,
                root.snippet.target_debian_selected,
                root.snippet.target_rhel_selected,
                root.snippet.target_alpine_selected,
                root.snippet.target_fedora_selected,
                root.snippet.target_arch_selected,
                root.snippet.target_suse_selected,
                root.snippet.target_freebsd_selected,
                root.snippet.target_macos_selected,
                root.snippet.target_powershell_selected,
                root.snippet.target_cmd_selected,
                root.snippet.target_linux_disabled,
                root.snippet.target_debian_disabled,
                root.snippet.target_rhel_disabled,
                root.snippet.target_alpine_disabled,
                root.snippet.target_fedora_disabled,
                root.snippet.target_arch_disabled,
                root.snippet.target_suse_disabled,
                root.snippet.target_freebsd_disabled,
                root.snippet.target_macos_disabled,
                root.snippet.target_powershell_disabled,
                root.snippet.target_cmd_disabled,
                root.snippet.icon_key,
                root.snippet.node_kind,
                root.snippet.accent_index,
            );
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.selected(
                    root.snippet.id,
                    root.snippet.parent_id,
                    root.snippet.name,
                    root.snippet.description,
                    root.snippet.command_template,
                    root.snippet.scope,
                    root.snippet.scope_key,
                    root.snippet.variables,
                    root.snippet.variable_names,
                    root.snippet.arguments,
                    root.snippet.argument_values,
                    root.snippet.meta,
                    root.snippet.target_linux_selected,
                    root.snippet.target_debian_selected,
                    root.snippet.target_rhel_selected,
                    root.snippet.target_alpine_selected,
                    root.snippet.target_fedora_selected,
                    root.snippet.target_arch_selected,
                    root.snippet.target_suse_selected,
                    root.snippet.target_freebsd_selected,
                    root.snippet.target_macos_selected,
                    root.snippet.target_powershell_selected,
                    root.snippet.target_cmd_selected,
                    root.snippet.target_linux_disabled,
                    root.snippet.target_debian_disabled,
                    root.snippet.target_rhel_disabled,
                    root.snippet.target_alpine_disabled,
                    root.snippet.target_fedora_disabled,
                    root.snippet.target_arch_disabled,
                    root.snippet.target_suse_disabled,
                    root.snippet.target_freebsd_disabled,
                    root.snippet.target_macos_disabled,
                    root.snippet.target_powershell_disabled,
                    root.snippet.target_cmd_disabled,
                    root.snippet.icon_key,
                    root.snippet.node_kind,
                    root.snippet.accent_index,
                );
                root.open-context-menu(
                    root.absolute-position.x + touch.mouse-x,
                    root.absolute-position.y + touch.mouse-y,
                    root.snippet.id,
                    root.snippet.parent_id,
                    root.snippet.name,
                    root.snippet.description,
                    root.snippet.command_template,
                    root.snippet.scope,
                    root.snippet.scope_key,
                    root.snippet.variables,
                    root.snippet.variable_names,
                    root.snippet.arguments,
                    root.snippet.argument_values,
                    root.snippet.meta,
                    root.snippet.target_linux_selected,
                    root.snippet.target_debian_selected,
                    root.snippet.target_rhel_selected,
                    root.snippet.target_alpine_selected,
                    root.snippet.target_fedora_selected,
                    root.snippet.target_arch_selected,
                    root.snippet.target_suse_selected,
                    root.snippet.target_freebsd_selected,
                    root.snippet.target_macos_selected,
                    root.snippet.target_powershell_selected,
                    root.snippet.target_cmd_selected,
                    root.snippet.target_linux_disabled,
                    root.snippet.target_debian_disabled,
                    root.snippet.target_rhel_disabled,
                    root.snippet.target_alpine_disabled,
                    root.snippet.target_fedora_disabled,
                    root.snippet.target_arch_disabled,
                    root.snippet.target_suse_disabled,
                    root.snippet.target_freebsd_disabled,
                    root.snippet.target_macos_disabled,
                    root.snippet.target_powershell_disabled,
                    root.snippet.target_cmd_disabled,
                    root.snippet.icon_key,
                    root.snippet.node_kind,
                    root.snippet.accent_index,
                );
            }
        }
    }

    CredentialTreeBranch {
        width: parent.width;
        height: parent.height;
        depth: root.snippet.depth;
        has-next-sibling: root.snippet.has_next_sibling;
        guide0: root.snippet.guide_0;
        guide1: root.snippet.guide_1;
        guide2: root.snippet.guide_2;
        guide3: root.snippet.guide_3;
        guide4: root.snippet.guide_4;
        guide5: root.snippet.guide_5;
        guide6: root.snippet.guide_6;
        guide7: root.snippet.guide_7;
    }

    Rectangle {
        x: 4px + root.snippet.depth * 18px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 18px;
        border-radius: 4px;
        background: arrow-touch.has-hover && root.snippet.expandable ? AppTheme.surface-hover : AppTheme.transparent;
        visible: root.group-node || root.snippet-node;

        arrow-touch := TouchArea {
            clicked => {
                if root.snippet.expandable {
                    root.toggle-node(root.snippet.id);
                }
            }
        }

        Text {
            text: root.snippet.expandable ? (root.snippet.expanded ? "-" : "+") : "";
            color: AppTheme.text-soft;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HostIcon {
        x: (root.target-node ? 26px : 22px) + root.snippet.depth * 18px;
        y: (parent.height - self.height) / 2;
        icon-key: root.snippet.icon_key;
        accent-index: root.snippet.accent_index;
        status-key: "Created";
    }

    Text {
        x: (root.target-node ? 50px : 48px) + root.snippet.depth * 18px;
        y: 0px;
        width: max(0px, min(parent.width, root.visible-row-width) - ((root.target-node ? 50px : 48px) + root.snippet.depth * 18px) - (root.drag-enabled ? 32px : 12px));
        height: parent.height;
        text: root.snippet.name;
        color: root.active ? AppTheme.text-strong : AppTheme.text;
        font-size: root.group-node ? 11px : root.snippet-node ? 10px : 9px;
        font-weight: root.group-node || root.snippet-node ? 700 : 600;
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 70px;
        y: (parent.height - self.height) / 2;
        width: 54px;
        height: 18px;
        border-radius: 6px;
        border-width: 1px;
        visible: false;
        border-color: root.target-node ? root.marker-color : AppTheme.border-soft;
        background: root.target-node ? AppTheme.dialog-section-bg : AppTheme.transparent;

        Text {
            x: 6px;
            y: 0px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.badge-text;
            color: root.target-node ? root.marker-color : AppTheme.text-soft;
            font-size: 9px;
            font-weight: 700;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.active: Rectangle {
        x: 2px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        border-radius: 2px;
        background: root.marker-color;
    }

    if drop-target.contains-drag: Rectangle {
        x: 2px;
        y: 2px;
        width: 3px;
        height: parent.height - 4px;
        border-radius: 2px;
        background: AppTheme.accent;
    }

    drop-target := DropArea {
        width: parent.width;
        height: parent.height;
        enabled: root.drop-enabled;
        can-drop(event) => {
            root.drop-enabled
                && (event.mime_type == "application/x-smagical-snippet-row" || event.mime_type == "application/x-smagical-snippet-group-row")
                && event.data != root.snippet.id
        }
        dropped(event) => {
            if root.drop-enabled && event.data != root.snippet.id {
                if event.mime_type == "application/x-smagical-snippet-row" {
                    root.move-node(event.data, "Snippet", root.snippet.id);
                }
                if event.mime_type == "application/x-smagical-snippet-group-row" {
                    root.move-node(event.data, "Group", root.snippet.id);
                }
            }
        }
    }

    DragArea {
        x: max(0px, min(parent.width - 24px, root.visible-row-width - 24px));
        y: 0px;
        width: 22px;
        height: parent.height;
        enabled: root.drag-enabled;
        visible: root.drag-enabled;
        mime-type: root.drag-mime-type;
        data: root.snippet.id;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 5px;
            background: drag-touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

            drag-touch := TouchArea {}

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: drag-touch.has-hover ? AppTheme.text-soft : AppTheme.border-soft;
            }
        }
    }
}

export component SnippetsPanel inherits Rectangle {
    in property <string> title-label;
    in property <string> search-query;
    in property <string> search-placeholder;
    in property <string> new-label;
    in property <string> new-target-label;
    in property <string> new-group-label;
    in property <string> edit-label;
    in property <string> delete-label;
    in property <string> move-label;
    in property <string> run-label;
    in property <string> split-target-label;
    in property <[SnippetRow]> snippets;
    in property <string> selected-id;
    in property <string> selected-parent-id;
    in property <string> selected-node-kind;
    in property <int> panel-width: 276;
    callback update-search(query: string);
    callback toggle-tree-node(node-id: string);
    callback open-create-choice(parent-node-id: string);
    callback open-create-target(parent-node-id: string);
    callback open-create-group(parent-node-id: string);
    callback edit-snippet();
    callback delete-snippet();
    callback move-snippet();
    callback run-snippet();
    callback split-target();
    callback move-node(source-id: string, source-kind: string, target-id: string) -> bool;
    callback select-snippet(id: string, parent-id: string, name: string, description: string, command-template: string, scope: string, scope-key: string, variables: string, variable-names: string, arguments: string, argument-values: string, meta: string, target-linux-selected: bool, target-debian-selected: bool, target-rhel-selected: bool, target-alpine-selected: bool, target-fedora-selected: bool, target-arch-selected: bool, target-suse-selected: bool, target-freebsd-selected: bool, target-macos-selected: bool, target-powershell-selected: bool, target-cmd-selected: bool, target-linux-disabled: bool, target-debian-disabled: bool, target-rhel-disabled: bool, target-alpine-disabled: bool, target-fedora-disabled: bool, target-arch-disabled: bool, target-suse-disabled: bool, target-freebsd-disabled: bool, target-macos-disabled: bool, target-powershell-disabled: bool, target-cmd-disabled: bool, icon-key: string, node-kind: string, accent-index: int);

    property <string> create-parent-id: root.selected-id == "" ? "snippet-folder:all" : root.selected-node-kind == "Group" ? root.selected-id : root.selected-parent-id;

    property <length> tree-visible-width: max(root.panel-width * 1px - 36px, 0px);
    property <length> tree-content-width: max(root.tree-visible-width, 344px);
    property <bool> context-menu-open: false;
    property <length> context-menu-x: 12px;
    property <length> context-menu-y: 64px;
    property <string> context-node-kind: "";
    property <string> context-node-id: "";
    property <string> context-parent-id: "";
    property <bool> context-root-group: root.context-node-id == "snippet-folder:all";
    property <int> context-menu-item-count: root.context-node-kind == "Group"
        ? (root.context-root-group ? 2 : 5)
        : root.context-node-kind == "Snippet"
            ? 4
            : root.context-node-kind == "SnippetTarget"
                ? (root.context-node-id == "" ? 0 : 3)
                : 0;
    property <length> context-menu-height: (10 + root.context-menu-item-count * 32 + (root.context-menu-item-count > 0 ? (root.context-menu-item-count - 1) * 3 : 0)) * 1px;

    width: root.panel-width * 1px;
    background: AppTheme.panel-bg;
    border-width: 0px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 9px;

        HorizontalLayout {
            height: 24px;
            spacing: 6px;

            Text {
                text: root.title-label;
                color: AppTheme.text-strong;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            CompactButton {
                label: root.new-label;
                tone: "primary";
                compact: true;
                clicked => { root.open-create-choice(root.create-parent-id); }
            }
        }

        CredentialSearchField {
            value: root.search-query;
            placeholder: root.search-placeholder;
            edited(query) => { root.update-search(query); }
            accepted(query) => { root.update-search(query); }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.inset-bg;
            clip: true;

            ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: root.tree-content-width + 16px;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                VerticalLayout {
                    width: root.tree-content-width + 16px;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;

                    for snippet in root.snippets: SnippetTreeItem {
                        width: root.tree-content-width;
                        visible-row-width: root.tree-visible-width;
                        snippet: snippet;
                        selected-id: root.selected-id;
                        toggle-node(node-id) => { root.toggle-tree-node(node-id); }
                        move-node(source-id, source-kind, target-id) => { root.move-node(source-id, source-kind, target-id) }
                        selected(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index) => {
                            root.context-menu-open = false;
                            root.select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index);
                        }
                        open-context-menu(abs-x, abs-y, id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index) => {
                            root.select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index);
                            root.context-node-kind = node-kind;
                            root.context-node-id = id;
                            root.context-parent-id = parent-id;
                            root.context-menu-x = min(max(10px, abs-x - root.absolute-position.x), max(10px, root.width - 154px));
                            root.context-menu-y = min(max(10px, abs-y - root.absolute-position.y), max(10px, root.height - root.context-menu-height - 10px));
                            root.context-menu-open = true;
                        }
                    }
                }
            }
        }
    }

    if root.context-menu-open: Rectangle {
        x: root.context-menu-x;
        y: root.context-menu-y;
        width: 144px;
        height: root.context-menu-height;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 5px;
            spacing: 3px;

            if root.context-node-kind == "Group": SnippetContextMenuItem {
                label: root.new-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-create-choice(root.context-node-id);
                }
            }

            if root.context-node-kind == "Group": SnippetContextMenuItem {
                label: root.new-group-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-create-group(root.context-node-id);
                }
            }

            if root.context-node-kind == "Group" && !root.context-root-group: SnippetContextMenuItem {
                label: root.edit-label;
                clicked => {
                    root.context-menu-open = false;
                    root.edit-snippet();
                }
            }

            if root.context-node-kind == "Group" && !root.context-root-group: SnippetContextMenuItem {
                label: root.move-label;
                clicked => {
                    root.context-menu-open = false;
                    root.move-snippet();
                }
            }

            if root.context-node-kind == "Group" && !root.context-root-group: SnippetContextMenuItem {
                label: root.delete-label;
                danger: true;
                clicked => {
                    root.context-menu-open = false;
                    root.delete-snippet();
                }
            }

            if root.context-node-kind == "Snippet": SnippetContextMenuItem {
                label: root.new-target-label;
                clicked => {
                    root.context-menu-open = false;
                    root.open-create-target(root.context-node-id);
                }
            }

            if root.context-node-kind == "Snippet": SnippetContextMenuItem {
                label: root.edit-label;
                clicked => {
                    root.context-menu-open = false;
                    root.edit-snippet();
                }
            }

            if root.context-node-kind == "Snippet": SnippetContextMenuItem {
                label: root.move-label;
                clicked => {
                    root.context-menu-open = false;
                    root.move-snippet();
                }
            }

            if root.context-node-kind == "Snippet": SnippetContextMenuItem {
                label: root.delete-label;
                danger: true;
                clicked => {
                    root.context-menu-open = false;
                    root.delete-snippet();
                }
            }

            if root.context-node-kind == "SnippetTarget": SnippetContextMenuItem {
                label: root.edit-label;
                clicked => {
                    root.context-menu-open = false;
                    root.edit-snippet();
                }
            }

            if root.context-node-kind == "SnippetTarget": SnippetContextMenuItem {
                label: root.split-target-label;
                clicked => {
                    root.context-menu-open = false;
                    root.split-target();
                }
            }

            if root.context-node-kind == "SnippetTarget": SnippetContextMenuItem {
                label: root.delete-label;
                danger: true;
                clicked => {
                    root.context-menu-open = false;
                    root.delete-snippet();
                }
            }
        }
    }
}
