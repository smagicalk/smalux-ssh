import { CredentialOptionRow } from "./models.slint";
import { CertificateKeyPickerDialog, CreateCertificateCredentialDialog } from "./credential_certificate_dialogs.slint";

export component CredentialCertificateFlow inherits Rectangle {
    in-out property <bool> create-certificate-credential-dialog-open;
    in-out property <bool> security-credential-group-picker-open;
    in-out property <bool> certificate-key-picker-open;
    in-out property <string> certificate-key-picker-target;
    in-out property <string> quick-security-credential-name;
    in-out property <string> quick-security-credential-group-id;
    in-out property <string> quick-security-credential-group-path;
    in-out property <string> quick-security-credential-kind-key;
    in-out property <string> quick-security-certificate-ca-key-ref;
    in-out property <string> quick-security-certificate-ca-key-name;
    in-out property <string> quick-security-certificate-subject-key-ref;
    in-out property <string> quick-security-certificate-subject-key-name;
    in-out property <string> quick-security-certificate-type;
    in-out property <string> quick-security-certificate-principals;
    in-out property <string> quick-security-certificate-valid-days;
    in-out property <string> quick-security-certificate-key-id;
    in-out property <string> quick-security-certificate-serial;
    in property <[CredentialOptionRow]> quick-host-private-key-options;
    in property <string> security-certificate-create-title-label;
    in property <string> security-credential-name-label;
    in property <string> security-credential-name-placeholder;
    in property <string> security-field-group-label;
    in property <string> security-certificate-ca-key-label;
    in property <string> security-certificate-ca-key-placeholder;
    in property <string> security-certificate-subject-key-label;
    in property <string> security-certificate-subject-key-placeholder;
    in property <string> security-certificate-type-label;
    in property <string> security-certificate-type-user-label;
    in property <string> security-certificate-type-host-label;
    in property <string> security-certificate-principals-label;
    in property <string> security-certificate-principals-placeholder;
    in property <string> security-certificate-valid-days-label;
    in property <string> security-certificate-valid-days-placeholder;
    in property <string> security-certificate-key-id-label;
    in property <string> security-certificate-key-id-placeholder;
    in property <string> security-certificate-serial-label;
    in property <string> security-certificate-serial-placeholder;
    in property <string> create-group-cancel-label;
    in property <string> security-credential-save-label;
    in property <string> security-certificate-key-picker-title-label;
    in property <string> security-certificate-empty-private-keys-label;
    callback generate-certificate-credential(name: string, group-id: string, ca-private-key-ref: string, subject-private-key-ref: string, cert-type: string, principals: string, valid-days: string, key-id: string, serial: string) -> bool;

    if root.create-certificate-credential-dialog-open: CreateCertificateCredentialDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-certificate-create-title-label;
        name-label: root.security-credential-name-label;
        name-placeholder: root.security-credential-name-placeholder;
        group-label: root.security-field-group-label;
        group-path: root.quick-security-credential-group-path;
        ca-key-label: root.security-certificate-ca-key-label;
        ca-key-name: root.quick-security-certificate-ca-key-name;
        ca-key-placeholder: root.security-certificate-ca-key-placeholder;
        subject-key-label: root.security-certificate-subject-key-label;
        subject-key-name: root.quick-security-certificate-subject-key-name;
        subject-key-placeholder: root.security-certificate-subject-key-placeholder;
        type-label: root.security-certificate-type-label;
        type-value: root.quick-security-certificate-type;
        user-type-label: root.security-certificate-type-user-label;
        host-type-label: root.security-certificate-type-host-label;
        principals-label: root.security-certificate-principals-label;
        principals-placeholder: root.security-certificate-principals-placeholder;
        valid-days-label: root.security-certificate-valid-days-label;
        valid-days-placeholder: root.security-certificate-valid-days-placeholder;
        key-id-label: root.security-certificate-key-id-label;
        key-id-placeholder: root.security-certificate-key-id-placeholder;
        serial-label: root.security-certificate-serial-label;
        serial-placeholder: root.security-certificate-serial-placeholder;
        credential-name: root.quick-security-credential-name;
        principals: root.quick-security-certificate-principals;
        valid-days: root.quick-security-certificate-valid-days;
        key-id: root.quick-security-certificate-key-id;
        serial: root.quick-security-certificate-serial;
        cancel-label: root.create-group-cancel-label;
        save-label: root.security-credential-save-label;
        update-name(value) => { root.quick-security-credential-name = value; }
        open-group-picker => { root.security-credential-group-picker-open = true; }
        open-ca-key-picker => {
            root.certificate-key-picker-target = "Ca";
            root.certificate-key-picker-open = true;
        }
        open-subject-key-picker => {
            root.certificate-key-picker-target = "Subject";
            root.certificate-key-picker-open = true;
        }
        update-type(value) => { root.quick-security-certificate-type = value; }
        update-principals(value) => { root.quick-security-certificate-principals = value; }
        update-valid-days(value) => { root.quick-security-certificate-valid-days = value; }
        update-key-id(value) => { root.quick-security-certificate-key-id = value; }
        update-serial(value) => { root.quick-security-certificate-serial = value; }
        save => {
            if !root.generate-certificate-credential(
                root.quick-security-credential-name,
                root.quick-security-credential-group-id,
                root.quick-security-certificate-ca-key-ref,
                root.quick-security-certificate-subject-key-ref,
                root.quick-security-certificate-type,
                root.quick-security-certificate-principals,
                root.quick-security-certificate-valid-days,
                root.quick-security-certificate-key-id,
                root.quick-security-certificate-serial,
            ) {
                return;
            }
            root.create-certificate-credential-dialog-open = false;
            root.security-credential-group-picker-open = false;
            root.certificate-key-picker-open = false;
            root.quick-security-credential-name = "";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-certificate-ca-key-ref = "";
            root.quick-security-certificate-ca-key-name = "";
            root.quick-security-certificate-subject-key-ref = "";
            root.quick-security-certificate-subject-key-name = "";
            root.quick-security-certificate-type = "User";
            root.quick-security-certificate-principals = "";
            root.quick-security-certificate-valid-days = "365";
            root.quick-security-certificate-key-id = "";
            root.quick-security-certificate-serial = "";
        }
        close => {
            root.create-certificate-credential-dialog-open = false;
            root.security-credential-group-picker-open = false;
            root.certificate-key-picker-open = false;
            root.quick-security-credential-name = "";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-certificate-ca-key-ref = "";
            root.quick-security-certificate-ca-key-name = "";
            root.quick-security-certificate-subject-key-ref = "";
            root.quick-security-certificate-subject-key-name = "";
            root.quick-security-certificate-type = "User";
            root.quick-security-certificate-principals = "";
            root.quick-security-certificate-valid-days = "365";
            root.quick-security-certificate-key-id = "";
            root.quick-security-certificate-serial = "";
        }
    }

    if root.certificate-key-picker-open: CertificateKeyPickerDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-certificate-key-picker-title-label;
        selected-value: root.certificate-key-picker-target == "Ca" ? root.quick-security-certificate-ca-key-ref : root.quick-security-certificate-subject-key-ref;
        empty-label: root.security-certificate-empty-private-keys-label;
        close-label: root.create-group-cancel-label;
        options: root.quick-host-private-key-options;
        select-key(value, label) => {
            if root.certificate-key-picker-target == "Ca" {
                root.quick-security-certificate-ca-key-ref = value;
                root.quick-security-certificate-ca-key-name = label;
            } else {
                root.quick-security-certificate-subject-key-ref = value;
                root.quick-security-certificate-subject-key-name = label;
            }
            root.certificate-key-picker-open = false;
        }
        close => { root.certificate-key-picker-open = false; }
    }
}
