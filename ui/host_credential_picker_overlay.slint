import { ScrollView } from "std-widgets.slint";
import { CredentialOptionRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { DialogCloseButton } from "./common.slint";
import { CredentialAddItem, CredentialOptionItem } from "./host_dialog_parts.slint";
export component HostCredentialPickerOverlay inherits Rectangle {
    in-out property <bool> open;
    in-out property <bool> credential-create-open;
    in-out property <string> credential-create-kind;
    in-out property <string> credential-create-name;
    in-out property <string> credential-create-secret-ref;
    in-out property <string> credential-create-algorithm;
    in property <string> credential-kind;
    in property <string> title-label;
    in property <string> add-label;
    in property <string> add-caption;
    in property <string> empty-label;
    in property <[CredentialOptionRow]> options;
    callback select-credential(value: string);

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 72px, 440px);
        height: min(root.height - 72px, 310px);
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                DialogCloseButton {
                    clicked => { root.open = false; }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.dialog-section-bg;

                ScrollView {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;

                    VerticalLayout {
                        spacing: 4px;
                        CredentialAddItem {
                            label: root.add-label;
                            caption: root.add-caption;
                            clicked => {
                                root.credential-create-kind = root.credential-kind;
                                root.credential-create-name = "";
                                root.credential-create-secret-ref = "";
                                root.credential-create-algorithm = "Ed25519";
                                root.credential-create-open = true;
                            }
                        }
                        if root.options.length == 0: Text {
                            height: 54px;
                            text: root.empty-label;
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        for option in root.options: CredentialOptionItem {
                            option: option;
                            selected(value) => {
                                root.select-credential(value);
                                root.open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}

