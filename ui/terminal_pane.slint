import { AppTheme } from "./theme.slint";

export component TerminalPane inherits Rectangle {
    in property <string> session-id;
    in property <string> title;
    in property <string> status;
    in property <string> kind;
    in-out property <string> input;
    in property <string> prompt;
    in property <[string]> output-lines;
    in property <bool> can-send-input;
    property <length> content-padding: 9px;
    property <length> terminal-line-height: 19px;
    property <length> viewport-height: 0px;
    property <length> content-height: max(
        root.viewport-height,
        (root.content-padding * 2) + ((root.output-lines.length + 1) * root.terminal-line-height),
    );
    in-out property <length> terminal-scroll-y: min(0px, root.viewport-height - root.content-height);
    callback append-input(session-id: string, text: string);
    callback backspace-input(session-id: string);
    callback update-input(session-id: string, text: string);
    callback send-input(session-id: string, text: string);

    border-radius: 7px;
    border-width: 1px;
    border-color: #182724;
    background: AppTheme.terminal-bg;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: input-editor;

    changed output-lines => {
        root.terminal-scroll-y = min(0px, root.viewport-height - root.content-height);
    }

    VerticalLayout {
        padding: 9px;
        spacing: 6px;
        HorizontalLayout {
            Text { text: title; color: AppTheme.terminal-text; font-size: 12px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: kind + " / " + status; color: AppTheme.terminal-muted; font-size: 10px; }
        }
        Rectangle {
            border-radius: 5px;
            background: #03070a;
            vertical-stretch: 1;
            clip: true;

            terminal-scroll := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                changed height => {
                    root.viewport-height = self.height;
                    root.terminal-scroll-y = min(0px, root.viewport-height - root.content-height);
                }
                viewport-width: self.width;
                viewport-height: root.content-height;
                viewport-y <=> root.terminal-scroll-y;

                for line[index] in root.output-lines: Text {
                    x: root.content-padding;
                    y: root.content-padding + (index * root.terminal-line-height);
                    width: parent.width - (root.content-padding * 2);
                    height: root.terminal-line-height;
                    text: line;
                    color: AppTheme.terminal-text;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    x: root.content-padding;
                    y: root.content-padding + (root.output-lines.length * root.terminal-line-height);
                    width: parent.width - (root.content-padding * 2);
                    height: root.terminal-line-height;
                    spacing: 7px;
                    Text {
                        text: root.can-send-input ? root.prompt : ">";
                        color: root.can-send-input ? AppTheme.terminal-text : AppTheme.terminal-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    input-editor := TextInput {
                        text <=> root.input;
                        enabled: root.can-send-input;
                        single-line: true;
                        color: root.can-send-input ? AppTheme.terminal-text : AppTheme.terminal-muted;
                        font-size: 11px;
                        text-cursor-width: 1px;
                        selection-background-color: #2c7068;
                        selection-foreground-color: AppTheme.terminal-text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        edited => {
                            root.update-input(root.session-id, self.text);
                        }
                        accepted => {
                            root.update-input(root.session-id, self.text);
                            root.send-input(root.session-id, self.text);
                            self.text = "";
                        }
                    }
                }
            }
            TouchArea {
                width: parent.width;
                height: max(
                    0px,
                    min(
                        parent.height,
                        root.content-padding
                            + (root.output-lines.length * root.terminal-line-height)
                            + terminal-scroll.viewport-y,
                    ),
                );
                clicked => {
                    input-editor.focus();
                }
            }
            TouchArea {
                y: max(
                    0px,
                    min(
                        parent.height,
                        root.content-padding
                            + (root.output-lines.length * root.terminal-line-height)
                            + root.terminal-line-height
                            + terminal-scroll.viewport-y,
                    ),
                );
                width: parent.width;
                height: max(0px, parent.height - self.y);
                clicked => {
                    input-editor.focus();
                }
            }
        }
    }
}
