import { ScrollView } from "std-widgets.slint";
import { KnownHostRow, SftpEntryRow, ToolItemRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton, FilterChip, ToolRow } from "./common.slint";
import { SftpPane } from "./sftp_pane.slint";

export component ToolDock inherits Rectangle {
    in property <string> files-label: "";
    in property <string> snippets-label: "";
    in property <string> tunnels-label: "";
    callback open-tool(mode: string);

    width: 134px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.dock-bg;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;

        CompactButton { label: root.files-label; tone: "subtle"; compact: true; clicked => { root.open-tool("SFTP"); } }
        CompactButton { label: root.snippets-label; tone: "subtle"; compact: true; clicked => { root.open-tool("Snippets"); } }
        CompactButton { label: root.tunnels-label; tone: "subtle"; compact: true; clicked => { root.open-tool("Tunnels"); } }
    }
}

export component ToolPanel inherits Rectangle {
    in property <int> panel-width;
    in property <string> mode-key: "Closed";
    in property <string> mode;
    in property <int> history-count;
    in property <string> sftp-host-id;
    in property <string> sftp-title;
    in property <string> sftp-current-dir;
    in property <string> sftp-selected-path;
    in property <bool> sftp-loading;
    in property <string> sftp-error;
    in property <[SftpEntryRow]> sftp-entries;
    in property <[string]> history;
    in property <[ToolItemRow]> snippets;
    in property <[ToolItemRow]> tunnels;
    in property <[KnownHostRow]> known-hosts;
    in property <string> loading-label: "";
    in property <string> refresh-label: "";
    in property <string> local-title: "";
    in property <string> remote-title: "";
    in property <string> workspace-label: "";
    in property <string> queue-label: "";
    in property <string> selected-label: "";
    in property <string> path-label: "";
    in property <string> entries-label: "";
    in property <string> loading-entries-label: "";
    in property <string> empty-entries-label: "";
    in property <string> pinned-label: "";
    in property <string> empty-value-label: "";
    in property <string> snippets-empty-label: "";
    in property <string> history-commands-label: "";
    in property <string> history-saved-suffix-label: "";
    in property <string> history-empty-label: "";
    in property <string> history-run-label: "";
    in property <string> tunnels-empty-label: "";
    in property <string> known-hosts-empty-label: "";
    in property <string> known-hosts-trust-label: "";
    in property <string> known-hosts-delete-label: "";
    callback close();
    callback refresh-sftp(host-id: string);
    callback select-sftp-entry(host-id: string, path: string);
    callback trust-known-host(host: string, port: int);
    callback remove-known-host(host: string, port: int);

    width: root.panel-width * 1px;
    background: AppTheme.raised-bg;
    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border;

    VerticalLayout {
        padding: 9px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: root.mode; color: AppTheme.text; font-size: 12px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; }
            FilterChip { label: root.pinned-label; active: true; }
            CompactButton { label: "x"; tone: "subtle"; compact: true; clicked => { root.close(); } }
        }
        if root.mode-key == "SFTP": SftpPane {
            host-id: root.sftp-host-id;
            title: root.sftp-title;
            current-dir: root.sftp-current-dir;
            selected-path: root.sftp-selected-path;
            loading: root.sftp-loading;
            error: root.sftp-error;
            entries: root.sftp-entries;
            loading-label: root.loading-label;
            refresh-label: root.refresh-label;
            local-title: root.local-title;
            remote-title: root.remote-title;
            workspace-label: root.workspace-label;
            queue-label: root.queue-label;
            selected-label: root.selected-label;
            path-label: root.path-label;
            entries-label: root.entries-label;
            loading-entries-label: root.loading-entries-label;
            empty-entries-label: root.empty-entries-label;
            refresh(host-id) => { root.refresh-sftp(host-id); }
            select-entry(host-id, path) => { root.select-sftp-entry(host-id, path); }
        }
        if root.mode-key == "Snippets": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if root.snippets.length == 0: ToolRow { label: root.snippets-empty-label; value: root.empty-value-label; }
                for item in root.snippets: ToolRow {
                    label: item.title;
                    value: item.subtitle == "" ? item.meta : item.subtitle + " · " + item.meta;
                }
            }
        }
        if root.mode-key == "History": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                ToolRow { label: root.history-commands-label; value: root.history-count + root.history-saved-suffix-label; }
                if root.history.length == 0: ToolRow { label: root.history-empty-label; value: root.empty-value-label; }
                for command in root.history: ToolRow { label: command; value: root.history-run-label; }
            }
        }
        if root.mode-key == "Tunnels": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if root.tunnels.length == 0: ToolRow { label: root.tunnels-empty-label; value: root.empty-value-label; }
                for item in root.tunnels: ToolRow {
                    label: item.title;
                    value: item.subtitle == "" ? item.meta : item.subtitle + " · " + item.meta;
                }
            }
        }
        if root.mode-key == "KnownHosts": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if root.known-hosts.length == 0: ToolRow { label: root.known-hosts-empty-label; value: root.empty-value-label; }
                for item in root.known-hosts: Rectangle {
                    height: 58px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    background: AppTheme.surface-bg;

                    HorizontalLayout {
                        padding: 7px;
                        spacing: 6px;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: item.host + ":" + item.port;
                                color: AppTheme.text;
                                font-size: 11px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: item.fingerprint;
                                color: AppTheme.text-muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                            Text {
                                text: item.status;
                                color: item.status_key == "trusted" ? AppTheme.accent : AppTheme.warning;
                                font-size: 10px;
                            }
                        }
                        VerticalLayout {
                            width: 72px;
                            spacing: 4px;
                            CompactButton {
                                label: root.known-hosts-trust-label;
                                tone: "primary";
                                clicked => { root.trust-known-host(item.host, item.port); }
                            }
                            CompactButton {
                                label: root.known-hosts-delete-label;
                                tone: "danger";
                                clicked => { root.remove-known-host(item.host, item.port); }
                            }
                        }
                    }
                }
            }
        }
    }
}
