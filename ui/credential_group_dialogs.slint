import { ScrollView } from "std-widgets.slint";
import { CredentialRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton, DialogField } from "./common.slint";
import { HostIcon } from "./hosts.slint";
export component CredentialSourceToggleButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 26px;
    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border-soft;
    background: active ? AppTheme.button-secondary-bg : AppTheme.button-secondary-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: active ? AppTheme.button-primary-text : AppTheme.button-secondary-text;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CreateCredentialGroupDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> name-label;
    in property <string> name-placeholder;
    in property <string> kind-label;
    in property <string> private-keys-label;
    in property <string> certificates-label;
    in property <string> passwords-label;
    in property <string> kind-key;
    in property <string> parent-label;
    in property <string> parent-path;
    in property <string> group-name;
    in property <bool> edit-mode;
    in property <string> cancel-label;
    in property <string> save-label;
    callback update-name(value: string);
    callback update-kind(value: string);
    callback open-parent-picker();
    callback save();
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 460px);
        height: root.edit-mode ? 230px : 380px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            DialogField {
                label: root.name-label;
                field-value: root.group-name;
                placeholder: root.name-placeholder;
                edited(value) => { root.update-name(value); }
                accepted(value) => { root.update-name(value); }
            }

            if !root.edit-mode: VerticalLayout {
                spacing: 5px;

                Text {
                    text: root.kind-label;
                    color: AppTheme.text-soft;
                    font-size: 10px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;

                    CredentialSourceToggleButton {
                        horizontal-stretch: 1;
                        label: root.private-keys-label;
                        active: root.kind-key == "PrivateKey";
                        clicked => { root.update-kind("PrivateKey"); }
                    }

                    CredentialSourceToggleButton {
                        horizontal-stretch: 1;
                        label: root.certificates-label;
                        active: root.kind-key == "Certificate";
                        clicked => { root.update-kind("Certificate"); }
                    }

                    CredentialSourceToggleButton {
                        horizontal-stretch: 1;
                        label: root.passwords-label;
                        active: root.kind-key == "Password";
                        clicked => { root.update-kind("Password"); }
                    }
                }
            }

            if !root.edit-mode: Rectangle {
                height: 50px;
                background: AppTheme.transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 15px;
                    text: root.parent-label;
                    color: AppTheme.text-soft;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                    Rectangle {
                        x: 0px;
                        y: 17px;
                        width: parent.width;
                        height: 32px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-soft;
                        background: AppTheme.input-bg;

                    parent-touch := TouchArea {
                        clicked => { root.open-parent-picker(); }
                    }

                    Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: root.parent-path == "" ? root.parent-label : root.parent-path;
                        color: root.parent-path == "" ? AppTheme.input-placeholder : AppTheme.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - 28px;
                        y: 0px;
                        width: 18px;
                        height: parent.height;
                        text: ">";
                        color: AppTheme.text-soft;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.save-label;
                    primary: true;
                    enabled: root.group-name != "";
                    clicked => { root.save(); }
                }
            }
        }
    }
}

component CredentialGroupPickerItem inherits Rectangle {
    in property <CredentialRow> credential;
    in property <string> current-kind-key;
    in property <string> selected-group-id;
    in property <string> blocked-group-id: "";
    in property <bool> emit-root-row-id: false;
    callback selected(id: string, path: string);

    property <bool> row-visible: (root.credential.node_kind == "Group" || root.credential.node_kind == "CredentialGroup") && root.credential.kind_key == root.current-kind-key && root.credential.id != root.blocked-group-id;
    property <bool> root-kind-row: root.credential.node_kind == "Group";
    property <string> emitted-id: root.root-kind-row ? (root.emit-root-row-id ? root.credential.id : "") : root.credential.id;
    property <bool> active: root.selected-group-id == root.emitted-id;
    property <int> indent-depth: root.credential.depth > 0 ? root.credential.depth - 1 : 0;

    visible: root.row-visible;
    height: root.row-visible ? 36px : 0px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-soft : AppTheme.transparent;
    background: root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.selected(root.emitted-id, root.credential.group_path); }
    }

    HostIcon {
        x: 8px + root.indent-depth * 16px;
        y: (parent.height - self.height) / 2;
        icon-key: root.credential.icon_key;
        accent-index: root.credential.accent_index;
        status-key: "Created";
    }

    Text {
        x: 34px + root.indent-depth * 16px;
        y: 3px;
        width: parent.width - self.x - 10px;
        height: 15px;
        text: root.credential.name;
        color: root.active ? AppTheme.text-strong : AppTheme.text;
        font-size: 11px;
        font-weight: 700;
        overflow: elide;
    }

    Text {
        x: 34px + root.indent-depth * 16px;
        y: 18px;
        width: parent.width - self.x - 10px;
        height: 13px;
        text: root.credential.group_path;
        color: AppTheme.text-muted;
        font-size: 9px;
        overflow: elide;
    }
}

export component CredentialGroupPickerDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> current-kind-key;
    in property <string> selected-group-id;
    in property <string> blocked-group-id: "";
    in property <bool> emit-root-row-id: false;
    in property <[CredentialRow]> credentials;
    in property <string> close-label;
    callback select-group(id: string, path: string);
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 500px);
        height: min(root.height - 36px, 520px);
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.dialog-section-bg;

                ScrollView {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;

                    VerticalLayout {
                        spacing: 2px;
                        for credential in root.credentials: CredentialGroupPickerItem {
                            credential: credential;
                            current-kind-key: root.current-kind-key;
                            selected-group-id: root.selected-group-id;
                            blocked-group-id: root.blocked-group-id;
                            emit-root-row-id: root.emit-root-row-id;
                            selected(id, path) => {
                                root.select-group(id, path);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.close-label;
                    primary: false;
                    clicked => { root.close(); }
                }
            }
        }
    }
}
