import { CredentialRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { HostIcon } from "./hosts.slint";

export component CredentialSearchField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    callback edited(value: string);
    callback accepted(value: string);

    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppTheme.border-soft;
    background: AppTheme.input-bg;

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: AppTheme.input-placeholder;
        font-size: 10px;
        vertical-alignment: center;
        visible: input.text == "";
    }

    input := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.value;
        single-line: true;
        color: AppTheme.text;
        font-size: 10px;
        text-cursor-width: 1px;
        selection-background-color: AppTheme.input-selection;
        selection-foreground-color: AppTheme.text-strong;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

export component CredentialPanelButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 26px;
    min-width: 58px;
    border-radius: 7px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.button-primary-border-hover : AppTheme.button-primary-border;
    background: touch.pressed ? AppTheme.button-primary-pressed : touch.has-hover ? AppTheme.button-primary-hover : AppTheme.button-primary-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: AppTheme.button-primary-text;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CredentialContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? (root.danger ? AppTheme.button-danger-bg : AppTheme.surface-hover) : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: root.danger ? AppTheme.danger-text-soft : AppTheme.text-secondary;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

component CredentialTreeGuides inherits Rectangle {
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;

    background: AppTheme.transparent;

    if root.guide0: Rectangle { x: 14px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide1: Rectangle { x: 32px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide2: Rectangle { x: 50px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide3: Rectangle { x: 68px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide4: Rectangle { x: 86px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide5: Rectangle { x: 104px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide6: Rectangle { x: 122px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide7: Rectangle { x: 140px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
}

export component CredentialTreeBranch inherits Rectangle {
    in property <int> depth: 0;
    in property <bool> has-next-sibling: false;
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;

    background: AppTheme.transparent;

    CredentialTreeGuides {
        width: parent.width;
        height: parent.height;
        guide0: root.guide0;
        guide1: root.guide1;
        guide2: root.guide2;
        guide3: root.guide3;
        guide4: root.guide4;
        guide5: root.guide5;
        guide6: root.guide6;
        guide7: root.guide7;
    }

    if root.depth > 0: Rectangle {
        x: 14px + (root.depth - 1) * 18px;
        y: 0px;
        width: 1px;
        height: root.has-next-sibling ? parent.height : parent.height / 2;
        background: AppTheme.border-soft;
    }

    if root.depth > 0: Rectangle {
        x: 14px + (root.depth - 1) * 18px;
        y: parent.height / 2;
        width: 10px;
        height: 1px;
        background: AppTheme.border-soft;
    }
}

export component CredentialTreeItem inherits Rectangle {
    in property <CredentialRow> credential;
    in property <string> selected-id;
    callback selected(id: string, name: string, group-id: string, group-path: string, kind: string, kind-key: string, username: string, secret-ref: string, secret-available: bool, algorithm: string, algorithm-key: string, fingerprint: string, meta: string, icon-key: string, node-kind: string, accent-index: int);
    callback toggle-node(id: string);
    callback move-node(source-id: string, target-id: string) -> bool;
    callback open-context-menu(abs-x: length, abs-y: length, id: string, name: string, group-id: string, group-path: string, kind: string, username: string, secret-ref: string, secret-available: bool, algorithm: string, algorithm-key: string, fingerprint: string, meta: string, icon-key: string, node-kind: string, accent-index: int, kind-key: string);

    property <bool> active: root.credential.id == root.selected-id;
    property <bool> drag-enabled: root.credential.node_kind == "Credential" || root.credential.node_kind == "CredentialGroup";
    property <bool> drop-enabled: (root.credential.node_kind == "CredentialGroup") || (root.credential.node_kind == "Group" && root.credential.kind_key != "Root");
    property <string> drag-mime-type: "application/x-smagical-credential-row";

    height: 32px;
    border-radius: 6px;
    background: drop-target.contains-drag ? AppTheme.selection-bg : root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => {
            root.selected(
                root.credential.id,
                root.credential.name,
                root.credential.group_id,
                root.credential.group_path,
                root.credential.kind,
                root.credential.kind_key,
                root.credential.username,
                root.credential.secret_ref,
                root.credential.secret_available,
                root.credential.algorithm,
                root.credential.algorithm_key,
                root.credential.fingerprint,
                root.credential.meta,
                root.credential.icon_key,
                root.credential.node_kind,
                root.credential.accent_index,
            );
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.selected(
                    root.credential.id,
                    root.credential.name,
                    root.credential.group_id,
                    root.credential.group_path,
                    root.credential.kind,
                    root.credential.kind_key,
                    root.credential.username,
                    root.credential.secret_ref,
                    root.credential.secret_available,
                    root.credential.algorithm,
                    root.credential.algorithm_key,
                    root.credential.fingerprint,
                    root.credential.meta,
                    root.credential.icon_key,
                    root.credential.node_kind,
                    root.credential.accent_index,
                );
                root.open-context-menu(
                    root.absolute-position.x + touch.mouse-x,
                    root.absolute-position.y + touch.mouse-y,
                    root.credential.id,
                    root.credential.name,
                    root.credential.group_id,
                    root.credential.group_path,
                    root.credential.kind,
                    root.credential.username,
                    root.credential.secret_ref,
                    root.credential.secret_available,
                    root.credential.algorithm,
                    root.credential.algorithm_key,
                    root.credential.fingerprint,
                    root.credential.meta,
                    root.credential.icon_key,
                    root.credential.node_kind,
                    root.credential.accent_index,
                    root.credential.kind_key,
                );
            }
        }
    }

    CredentialTreeBranch {
        width: parent.width;
        height: parent.height;
        depth: root.credential.depth;
        has-next-sibling: root.credential.has_next_sibling;
        guide0: root.credential.guide_0;
        guide1: root.credential.guide_1;
        guide2: root.credential.guide_2;
        guide3: root.credential.guide_3;
        guide4: root.credential.guide_4;
        guide5: root.credential.guide_5;
        guide6: root.credential.guide_6;
        guide7: root.credential.guide_7;
    }

    Rectangle {
        x: 4px + root.credential.depth * 18px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 18px;
        border-radius: 4px;
        background: arrow-touch.has-hover && root.credential.expandable ? AppTheme.surface-hover : AppTheme.transparent;
        visible: root.credential.node_kind == "Group" || root.credential.node_kind == "CredentialGroup";

        arrow-touch := TouchArea {
            clicked => {
                if root.credential.expandable {
                    root.toggle-node(root.credential.id);
                }
            }
        }

        Text {
            text: root.credential.expandable ? (root.credential.expanded ? "-" : "+") : "";
            color: AppTheme.text-soft;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HostIcon {
        x: 22px + root.credential.depth * 18px;
        y: (parent.height - self.height) / 2;
        icon-key: root.credential.icon_key;
        accent-index: root.credential.accent_index;
        status-key: "Created";
    }

    Text {
        x: 48px + root.credential.depth * 18px;
        y: 0px;
        width: parent.width - (100px + root.credential.depth * 18px);
        height: parent.height;
        text: root.credential.name;
        color: root.active ? AppTheme.text-strong : AppTheme.text;
        font-size: root.credential.node_kind == "Group" ? 11px : 10px;
        font-weight: root.credential.node_kind == "Group" ? 700 : 600;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 60px;
        y: 0px;
        width: 36px;
        height: parent.height;
        text: root.credential.meta;
        color: AppTheme.text-soft;
        font-size: 9px;
        overflow: elide;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    if drop-target.contains-drag: Rectangle {
        x: 2px;
        y: 2px;
        width: 3px;
        height: parent.height - 4px;
        border-radius: 2px;
        background: AppTheme.accent;
    }

    drop-target := DropArea {
        width: parent.width;
        height: parent.height;
        enabled: root.drop-enabled;
        can-drop(event) => {
            event.mime_type == root.drag-mime-type && event.data != root.credential.id
        }
        dropped(event) => {
            if event.mime_type == root.drag-mime-type && event.data != root.credential.id {
                root.move-node(event.data, root.credential.id);
            }
        }
    }

    DragArea {
        x: parent.width - 24px;
        y: 0px;
        width: 22px;
        height: parent.height;
        enabled: root.drag-enabled;
        mime-type: root.drag-mime-type;
        data: root.credential.id;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 5px;
            background: drag-touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

            drag-touch := TouchArea {}

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: drag-touch.has-hover ? AppTheme.text-soft : AppTheme.border-soft;
            }
        }
    }
}
