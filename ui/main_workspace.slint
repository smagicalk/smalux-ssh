            set-built-in-theme(theme) => { root.set-built-in-theme(theme); }
            copy-current-built-in-theme => { root.copy-current-built-in-theme(); }
            apply-theme-profile(name) => { root.apply-theme-profile(name); }
            remove-theme-profile(name) => { root.remove-theme-profile(name); }
            choose-file-action-path(key, current-path, direction, extension) => {
                root.choose-file-action-path(key, current-path, direction, extension)
            }
            export-current-theme(target-path, format) => {
                root.export-current-theme(target-path, format);
            }
            import-theme(source-path) => {
                root.import-theme(source-path);
            }
            backup-storage(target-path) => {
                root.backup-storage(target-path);
            }
            export-storage-snapshot(target-path) => {
                root.export-storage-snapshot(target-path);
            }
            import-storage-snapshot(source-path) => {
                root.import-storage-snapshot(source-path);
            }
            import-sqlite-backup(source-path) => {
                root.import-sqlite-backup(source-path);
            }
        }

        if root.active-page != "SFTP" && root.active-page != "History" && root.active-page != "Snippets" && root.active-page != "Tunnels" && root.active-page != "Security" && root.active-page != "Proxy" && root.active-page != "Settings": TerminalWorkspacePage {
            active-session-id: root.active-session-id;
            active-tab-title: root.active-tab-title;
            active-tab-kind: root.active-tab-kind;
