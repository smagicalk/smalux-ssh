            }
            remove-asset(kind-key, asset-id) => { root.remove-network-asset(kind-key, asset-id); }
        }

        if root.active-page == "Security": SecurityWorkspacePage {
            title-label: root.tool-keys-label;
            selected-credential-id: root.selected-credential-id;
            selected-credential-name: root.selected-credential-name;
            selected-credential-group-id: root.selected-credential-group-id;
