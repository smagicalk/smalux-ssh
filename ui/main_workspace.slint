            selected-id: root.selected-snippet-id;
            selected-name: root.selected-snippet-name;
            selected-description: root.selected-snippet-description;
            selected-command-template: root.selected-snippet-command-template;
            selected-scope: root.selected-snippet-scope;
            selected-scope-key: root.selected-snippet-scope-key;
            selected-variables: root.selected-snippet-variables;
            selected-arguments: root.selected-snippet-arguments;
            selected-meta: root.selected-snippet-meta;
            selected-icon-key: root.selected-snippet-icon-key;
            selected-node-kind: root.selected-snippet-node-kind;
            selected-accent-index: root.selected-snippet-accent-index;
            snippet-rows: root.snippet-rows;
            snippet-target-options: root.snippet-target-options;
            empty-title-label: root.snippets-detail-empty-title-label;
