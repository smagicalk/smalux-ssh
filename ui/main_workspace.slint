            field-fingerprint-label: root.security-field-fingerprint-label;
            field-secret-ref-label: root.security-field-secret-ref-label;
            field-group-label: root.security-field-group-label;
            group-caption-label: root.security-group-caption-label;
            view-content-label: root.security-view-content-label;
            view-private-key-label: root.security-view-private-key-label;
            view-certificate-label: root.security-view-certificate-label;
            view-password-label: root.security-view-password-label;
            secret-content: root.credential-secret-content;
            secret-content-missing-label: root.security-secret-content-missing-label;
            secret-copy-enabled: root.credential-secret-copyable;
            secret-copy-label: root.security-secret-copy-label;
            secret-copy-success-label: root.security-secret-copy-success-label;
            secret-copy-failed-label: root.security-secret-copy-failed-label;
            edit-label: root.security-credential-edit-label;
            edit-private-key-label: root.security-credential-edit-private-key-label;
            edit-certificate-label: root.security-credential-edit-certificate-label;
            edit-password-label: root.security-credential-edit-password-label;
            compile-label: root.security-certificate-create-label;
            select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index) => {
                root.select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index);
            }
            copy-secret-content(content) => { root.copy-secret-content(content) }
            edit-credential(credential-id, name, group-id, group-path, kind-key, algorithm-key) => {
                root.edit-credential(credential-id, name, group-id, group-path, kind-key, algorithm-key);
            }
            compile-certificate(group-id, group-path) => { root.create-certificate(group-id, group-path); }
        }

        if root.active-page == "Settings": SettingsWorkspacePage {
            title: root.settings-title-label;
            language-options: root.settings-language-options;
            theme-options: root.settings-theme-options;
            theme-profiles: root.settings-theme-profiles;
            storage-summary: root.settings-storage-summary;
            file-actions: root.settings-file-actions;
            language-title-label: root.settings-language-title-label;
            theme-title-label: root.settings-theme-title-label;
            custom-theme-title-label: root.settings-custom-theme-title-label;
            storage-title-label: root.settings-storage-title-label;
            file-actions-title-label: root.settings-file-actions-title-label;
            security-title-label: root.settings-security-title-label;
            apply-label: root.settings-apply-label;
            copy-label: root.settings-copy-label;
            remove-label: root.settings-remove-label;
            run-label: root.settings-run-label;
            choose-file-label: root.settings-choose-file-label;
            selected-label: root.settings-selected-label;
            unavailable-label: root.settings-unavailable-label;
            empty-custom-themes-label: root.settings-empty-custom-themes-label;
