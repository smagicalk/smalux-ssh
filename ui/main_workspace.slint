            local-title: root.sftp-local-title;
            remote-title: root.sftp-remote-title;
            workspace-label: root.sftp-workspace-label;
            queue-label: root.sftp-queue-label;
            selected-label: root.sftp-selected-label;
            path-label: root.sftp-path-label;
            entries-label: root.sftp-entries-label;
            loading-entries-label: root.sftp-loading-entries-label;
            empty-entries-label: root.sftp-empty-entries-label;
            refresh(host-id) => { root.refresh-sftp(host-id); }
            select-entry(host-id, path) => { root.select-sftp-entry(host-id, path); }
        }

        if root.active-page == "History": HistoryListPage {
            title: root.history-commands-label;
            empty-label: root.history-empty-label;
            history: root.history;
        }

        if root.active-page == "Snippets": SnippetWorkspacePage {
