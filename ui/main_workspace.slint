    property <bool> new-session-dialog-open: false;
    property <string> credential-secret-content: "";
    property <bool> credential-secret-copyable: false;

    changed selected-credential-id => {
        root.credential-secret-content = "";
        root.credential-secret-copyable = false;
        if root.selected-credential-id != "" && root.selected-credential-node-kind == "Credential" {
            root.credential-secret-content = root.read-credential-secret(root.selected-credential-id);
            root.credential-secret-copyable = root.credential-secret-content != "";
            if root.credential-secret-content == "" {
                root.credential-secret-content = root.security-secret-content-missing-label;
            }
        }
    }

    background: AppTheme.window-bg;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-left: root.active-page == "Security" ? 0px : 8px;
        padding-right: root.active-page == "Security" ? 4px : 8px;
        padding-top: root.active-page == "Security" ? 0px : 8px;
        padding-bottom: root.active-page == "Security" ? 4px : 8px;
        spacing: 7px;

        if root.active-page != "Security" && root.active-page != "Snippets": WorkspaceTabStrip {
            tabs: root.tabs;
            ready-label: root.tab-ready-label;
            activate-session(session-id) => { root.activate-session(session-id); }
            close-session(session-id) => { root.close-session(session-id); }
            open-new-session => {
                root.update-new-session-search("");
                root.new-session-dialog-open = true;
            }
        }

        if root.active-page == "SFTP": SftpPane {
            host-id: root.sftp-host-id;
            title: root.sftp-title;
            current-dir: root.sftp-current-dir;
            selected-path: root.sftp-selected-path;
            loading: root.sftp-loading;
            error: root.sftp-error;
            entries: root.sftp-entries;
            loading-label: root.sftp-loading-label;
