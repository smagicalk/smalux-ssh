            known-hosts-empty-label: root.known-hosts-empty-label;
            known-hosts-trust-label: root.known-hosts-trust-label;
            known-hosts-delete-label: root.known-hosts-delete-label;
            history: root.history;
            snippets: root.snippets;
            tunnels: root.tunnels;
            known-hosts: root.known-hosts;
            append-terminal-input(session-id, text) => { root.append-terminal-input(session-id, text); }
            backspace-terminal-input(session-id) => { root.backspace-terminal-input(session-id); }
            update-terminal-input(session-id, text) => { root.update-terminal-input(session-id, text); }
            send-terminal-input(session-id, text) => { root.send-terminal-input(session-id, text); }
            reconnect-shell(session-id) => { root.reconnect-shell(session-id); }
            resize-tool-panel(width) => { root.resize-tool-panel(width); }
            close-tool-panel => { root.close-tool-panel(); }
            refresh-sftp(host-id) => { root.refresh-sftp(host-id); }
            select-sftp-entry(host-id, path) => { root.select-sftp-entry(host-id, path); }
            trust-known-host(host, port) => { root.trust-known-host(host, port); }
            remove-known-host(host, port) => { root.remove-known-host(host, port); }
        }

        if root.last-error != "" && root.active-page != "Terminal": Rectangle {
            height: 34px;
            border-radius: 7px;
            border-width: 1px;
            border-color: AppTheme.danger;
            background: AppTheme.dialog-error-bg;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: root.last-error;
                    color: AppTheme.danger-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                CompactButton {
                    label: "x";
                    tone: "danger";
                    clicked => { root.dismiss-ui-error(); }
                }
            }
        }
    }

    if root.new-session-dialog-open: NewSessionDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        hosts: root.new-session-hosts;
        search-query: root.new-session-search-query;
        local-visible: root.new-session-local-visible;
        title-label: root.new-session-title-label;
        search-placeholder: root.new-session-search-placeholder;
        local-title: root.new-session-local-title;
        local-subtitle: root.new-session-local-subtitle;
        local-detail: root.new-session-local-detail;
        local-tags: root.new-session-local-tags;
        local-status: root.new-session-local-status;
        local-kind: root.new-session-local-kind;
        remote-kind: root.new-session-remote-kind;
        ungrouped-detail: root.new-session-ungrouped-detail;
        empty-title: root.new-session-empty-title;
        empty-caption: root.new-session-empty-caption;
        search-changed(query) => { root.update-new-session-search(query); }
        close => { root.new-session-dialog-open = false; }
        open-local-terminal => {
            root.new-session-dialog-open = false;
            root.open-local-terminal();
        }
        open-host(host-id) => {
            root.new-session-dialog-open = false;
            root.open-shell(host-id);
        }
    }

}
