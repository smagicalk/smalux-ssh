            selected-edit-target-port: root.network-selected-edit-target-port;
            selected-edit-auto-start: root.network-selected-edit-auto-start;
            selected-edit-host-ids: root.network-selected-edit-host-ids;
            select-network-item(item) => {
                root.network-selected-id = item.id;
                root.network-selected-title = item.title;
                root.network-selected-caption = item.subtitle;
                root.network-selected-kind = item.kind_label;
                root.network-selected-kind-key = item.kind_key;
                root.network-selected-meta = item.meta;
                root.network-selected-note = item.note;
                root.network-selected-icon-key = item.icon_key;
                root.network-selected-accent-index = item.accent_index;
                root.network-primary-action-key = item.primary_action_key;
                root.network-primary-action-label = item.primary_action_label;
                root.network-primary-action-enabled = item.primary_action_enabled;
                root.network-action-session-id = item.session_id;
                root.network-action-rule-name = item.title;
                root.network-stats = [
                    { label: item.stat_primary_label, value: item.stat_primary_value },
                    { label: item.stat_secondary_label, value: item.stat_secondary_value },
                ];
                root.network-detail-fields = [
                    { label: item.detail_primary_label, value: item.detail_primary_value },
                    { label: item.detail_secondary_label, value: item.detail_secondary_value },
                ];
                root.network-related-items = [
                    { title: item.body_label, subtitle: item.body_value, meta: item.meta },
                ];
                root.network-selected-asset-id = item.asset_id;
                root.network-selected-edit-kind-key = item.edit_kind_key;
                root.network-selected-edit-host = item.edit_host;
                root.network-selected-edit-port = item.edit_port;
                root.network-selected-edit-tags = item.edit_tags;
                root.network-selected-edit-bind-host = item.edit_bind_host;
                root.network-selected-edit-bind-port = item.edit_bind_port;
                root.network-selected-edit-target-host = item.edit_target_host;
                root.network-selected-edit-target-port = item.edit_target_port;
                root.network-selected-edit-auto-start = item.edit_auto_start;
                root.network-selected-edit-host-ids = item.edit_host_ids;
            }
            stop-tunnel(session-id, rule-name) => { root.stop-network-tunnel(session-id, rule-name); }
            save-proxy(asset-id, name, proxy-kind, host, port, tags) => {
                root.save-network-proxy(asset-id, name, proxy-kind, host, port, tags)
            }
            save-jump-chain(asset-id, name, host-ids) => {
                root.save-network-jump-chain(asset-id, name, host-ids)
            }
            save-forward(asset-id, name, kind, bind-host, bind-port, target-host, target-port, tags, auto-start) => {
