            copy-failed-label: root.snippets-copy-failed-label;
            run-label: root.snippets-run-label;
            move-label: root.snippets-move-label;
            create-target => { root.create-snippet-target(); }
            split-target => { root.split-snippet-target(root.selected-snippet-id); }
            edit-selected => { root.edit-selected-snippet(); }
            delete-selected => { root.delete-selected-snippet(); }
            move-selected => { root.move-selected-snippet(); }
            copy-command(content) => { root.copy-snippet-command(content) }
            run-selected => { root.run-selected-snippet(); }
            select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index) => {
                root.select-snippet(id, parent-id, name, description, command-template, scope, scope-key, variables, variable-names, arguments, argument-values, meta, target-linux-selected, target-debian-selected, target-rhel-selected, target-alpine-selected, target-fedora-selected, target-arch-selected, target-suse-selected, target-freebsd-selected, target-macos-selected, target-powershell-selected, target-cmd-selected, target-linux-disabled, target-debian-disabled, target-rhel-disabled, target-alpine-disabled, target-fedora-disabled, target-arch-disabled, target-suse-disabled, target-freebsd-disabled, target-macos-disabled, target-powershell-disabled, target-cmd-disabled, icon-key, node-kind, accent-index);
            }
        }

        if root.active-page == "Tunnels": WorkspaceListPage {
            title: root.tool-tunnels-label;
            empty-label: root.tunnels-empty-label;
            items: root.tunnels;
        }

        if root.active-page == "Proxy": NetworkWorkspacePage {
            title: root.tool-proxy-label;
            runtime-section-label: root.proxy-runtime-section-label;
            saved-section-label: root.proxy-resources-section-label;
            runtime-empty-label: root.proxy-runtime-empty-label;
            resources-empty-label: root.proxy-resources-empty-label;
            proxy-section-label: "";
