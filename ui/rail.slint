import { AppTheme } from "./theme.slint";
import { RailButton } from "./nav.slint";

export component NavRail inherits Rectangle {
    in property <string> active-page;
    callback open-hosts();
    callback open-terminal();
    callback open-sftp();
    callback open-tunnels();
    callback open-snippets();
    callback open-history();
    callback open-settings();

    width: 44px;
    background: AppTheme.rail-bg;
    border-width: 1px;
    border-color: AppTheme.border-soft;

    VerticalLayout {
        padding-top: 8px;
        padding-left: 5px;
        padding-right: 5px;
        spacing: 5px;

        RailButton { label: "H"; active: root.active-page == "Hosts"; clicked => { root.open-hosts(); } }
        RailButton { label: "T"; active: root.active-page == "Terminal"; clicked => { root.open-terminal(); } }
        RailButton { label: "F"; active: root.active-page == "SFTP"; clicked => { root.open-sftp(); } }
        RailButton { label: "P"; active: root.active-page == "Tunnels"; clicked => { root.open-tunnels(); } }
        RailButton { label: "S"; active: root.active-page == "Snippets"; clicked => { root.open-snippets(); } }
        RailButton { label: "R"; active: root.active-page == "History"; clicked => { root.open-history(); } }
        Rectangle { vertical-stretch: 1; }
        RailButton { label: "*"; active: root.active-page == "Settings"; clicked => { root.open-settings(); } }
    }
}
