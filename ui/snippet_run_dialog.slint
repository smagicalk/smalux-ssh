import { ScrollView } from "std-widgets.slint";
import { HostRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton, DialogField } from "./common.slint";
import { HostIcon } from "./hosts.slint";
component SnippetRunHostRow inherits Rectangle {
    in property <HostRow> host;
    in property <string> selected-host-id;
    callback selected(host-id: string);

    property <bool> active: root.host.id == root.selected-host-id;

    height: 42px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-soft : AppTheme.transparent;
    background: root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.selected(root.host.id); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        HostIcon {
            icon-key: root.host.icon_key;
            accent-index: root.host.accent_index;
            status-key: root.host.status_key;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.host.name;
                color: AppTheme.text-strong;
                font-size: 11px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.host.endpoint;
                color: AppTheme.text-muted;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

export component RunSnippetDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> command-label;
    in property <string> command-template;
    in property <string> host-label;
    in property <string> arguments-label;
    in property <string> arguments-placeholder;
    in property <string> variable-names;
    in property <string> no-hosts-label;
    in property <string> cancel-label;
    in property <string> run-label;
    in property <[HostRow]> hosts;
    in property <string> selected-host-id;
    in property <string> arguments-text;
    callback select-host(host-id: string);
    callback arguments-edited(value: string);
    callback close();
    callback run() -> bool;

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 64px, 560px);
        height: min(root.height - 80px, 520px);
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                height: 28px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            Rectangle {
                height: 68px;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.input-bg;
                clip: true;

                VerticalLayout {
                    padding: 9px;
                    spacing: 4px;
                    Text {
                        text: root.command-label;
                        color: AppTheme.text-soft;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.command-template;
                        color: AppTheme.text;
                        font-size: 11px;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }

            Text {
                height: 16px;
                text: root.host-label;
                color: AppTheme.text-soft;
                font-size: 10px;
                font-weight: 700;
            }

            Rectangle {
                height: 132px;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.inset-bg;
                clip: true;

                ScrollView {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        padding: 5px;
                        spacing: 2px;
                        if root.hosts.length == 0: Text {
                            height: 34px;
                            text: root.no-hosts-label;
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for host in root.hosts: SnippetRunHostRow {
                            host: host;
                            selected-host-id: root.selected-host-id;
                            selected(host-id) => { root.select-host(host-id); }
                        }
                    }
                }
            }

            DialogField {
                label: root.arguments-label;
                field-value: root.arguments-text;
                placeholder: root.arguments-placeholder;
                edited(value) => { root.arguments-edited(value); }
                accepted(value) => { root.arguments-edited(value); }
            }

            if root.variable-names != "": Rectangle {
                height: 34px;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.surface-bg;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: root.arguments-label;
                        color: AppTheme.text-soft;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.variable-names;
                        color: AppTheme.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.run-label;
                    primary: true;
                    clicked => {
                        if root.run() {
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
