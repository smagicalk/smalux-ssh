import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton, DialogField } from "./common.slint";
import { CredentialAlgorithmOption } from "./credential_controls.slint";
export component HostInlineCredentialOverlay inherits Rectangle {
    in-out property <bool> open;
    in-out property <bool> private-key-picker-open;
    in-out property <bool> certificate-picker-open;
    in property <string> credential-create-kind;
    in-out property <string> credential-create-name;
    in-out property <string> credential-create-secret-ref;
    in-out property <string> credential-create-algorithm;
    in property <string> add-private-key-label;
    in property <string> add-private-key-caption;
    in property <string> add-certificate-label;
    in property <string> add-certificate-caption;
    in property <string> credential-name-label;
    in property <string> credential-name-placeholder;
    in property <string> credential-secret-label;
    in property <string> credential-secret-placeholder;
    in property <string> credential-algorithm-label;
    in property <string> cancel-label;
    in property <string> save-label;
    callback create-credential(kind: string, name: string, secret-ref: string, algorithm: string);

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 72px, 460px);
        height: 360px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: root.credential-create-kind == "Certificate" ? root.add-certificate-label : root.add-private-key-label;
                        color: AppTheme.text-strong;
                        font-size: 14px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: root.credential-create-kind == "Certificate" ? root.add-certificate-caption : root.add-private-key-caption;
                        color: AppTheme.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }

                DialogCloseButton {
                    clicked => { root.open = false; }
                }
            }

            DialogField {
                label: root.credential-name-label;
                field-value: root.credential-create-name;
                placeholder: root.credential-name-placeholder;
                edited(value) => { root.credential-create-name = value; }
                accepted(value) => { root.credential-create-name = value; }
            }

            DialogField {
                label: root.credential-secret-label;
                field-value: root.credential-create-secret-ref;
                placeholder: root.credential-secret-placeholder;
                edited(value) => { root.credential-create-secret-ref = value; }
                accepted(value) => { root.credential-create-secret-ref = value; }
            }

            Rectangle {
                height: 54px;
                background: AppTheme.transparent;

                VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: root.credential-algorithm-label;
                        color: AppTheme.text-soft;
                        font-size: 10px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        CredentialAlgorithmOption {
                            label: "Ed25519";
                            value: "Ed25519";
                            selected-value: root.credential-create-algorithm;
                            horizontal-stretch: 1;
                            selected(value) => { root.credential-create-algorithm = value; }
                        }
                        CredentialAlgorithmOption {
                            label: "RSA";
                            value: "Rsa";
                            selected-value: root.credential-create-algorithm;
                            horizontal-stretch: 1;
                            selected(value) => { root.credential-create-algorithm = value; }
                        }
                        CredentialAlgorithmOption {
                            label: "ECDSA";
                            value: "Ecdsa";
                            selected-value: root.credential-create-algorithm;
                            horizontal-stretch: 1;
                            selected(value) => { root.credential-create-algorithm = value; }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.open = false; }
                }
                DialogButton {
                    label: root.save-label;
                    primary: true;
                    enabled: root.credential-create-name != "" && root.credential-create-secret-ref != "";
                    clicked => {
                        root.create-credential(
                            root.credential-create-kind,
                            root.credential-create-name,
                            root.credential-create-secret-ref,
                            root.credential-create-algorithm,
                        );
                        root.open = false;
                        root.private-key-picker-open = false;
                        root.certificate-picker-open = false;
                    }
                }
            }
        }
    }
}

