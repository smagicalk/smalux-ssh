import { ScrollView } from "std-widgets.slint";
import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton, DialogField } from "./common.slint";
import { CredentialAlgorithmField, CredentialGroupField, CredentialPasswordField, CredentialPathField, CredentialTextArea } from "./credential_controls.slint";
import { CredentialSourceToggleButton } from "./credential_group_dialogs.slint";
component DialogBusyOverlay inherits Rectangle {
    in property <string> label;
    in property <int> frame;

    border-radius: 10px;
    background: AppTheme.overlay-bg;

    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 300px);
        height: 104px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 12px;
            alignment: center;

            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.frame == 0 ? AppTheme.accent : AppTheme.border-strong;
                }
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.frame == 1 ? AppTheme.accent : AppTheme.border-strong;
                }
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.frame == 2 ? AppTheme.accent : AppTheme.border-strong;
                }
            }

            Text {
                text: root.label;
                color: AppTheme.text-strong;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component CreateSecurityCredentialDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> name-label;
    in property <string> name-placeholder;
    in property <string> group-label;
    in property <string> group-path;
    in property <string> secret-label;
    in property <string> secret-placeholder;
    in property <string> algorithm-label;
    in property <string> credential-name;
    in property <string> secret-ref;
    in property <string> algorithm;
    in property <bool> edit-mode;
    in property <bool> import-mode;
    in property <bool> text-import-mode;
    in property <bool> certificate-mode;
    in property <string> import-source-key;
    in property <string> import-file-label;
    in property <string> import-text-label;
    in property <string> private-key-text-label;
    in property <string> private-key-text-placeholder;
    in property <string> certificate-text-label;
    in property <string> certificate-text-placeholder;
    in property <bool> show-algorithm;
    in property <bool> password-mode;
    in property <string> password-show-label;
    in property <string> password-hide-label;
    in property <bool> generated-private-key-mode;
    in property <string> choose-file-label;
    in property <string> cancel-label;
    in property <string> save-label;
    in property <bool> busy;
    in property <string> busy-label;
    in property <int> busy-frame;
    callback update-name(value: string);
    callback open-group-picker();
    callback update-secret-ref(value: string);
    callback update-algorithm(value: string);
    callback update-import-source(value: string);
    callback choose-file();
    callback save();
    callback close();

    property <bool> text-import-source: root.text-import-mode && root.import-source-key == "Text";
    property <bool> requires-secret-input: !root.edit-mode && !root.generated-private-key-mode;

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 560px);
        height: min(root.height - 32px, root.edit-mode ? 440px : root.text-import-source ? 600px : root.text-import-mode ? 500px : 450px);
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton {
                    clicked => {
                        if !root.busy {
                            root.close();
                        }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 12px;

                    DialogField {
                        label: root.name-label;
                        field-value: root.credential-name;
                        placeholder: root.name-placeholder;
                        edited(value) => { root.update-name(value); }
                        accepted(value) => { root.update-name(value); }
                    }

                    CredentialGroupField {
                        label: root.group-label;
                        group-path: root.group-path;
                        open => { root.open-group-picker(); }
                    }

                    if !root.edit-mode && root.text-import-mode: HorizontalLayout {
                        height: 26px;
                        spacing: 8px;
                        CredentialSourceToggleButton {
                            horizontal-stretch: 1;
                            label: root.import-file-label;
                            active: root.import-source-key == "File";
                            clicked => { root.update-import-source("File"); }
                        }
                        CredentialSourceToggleButton {
                            horizontal-stretch: 1;
                            label: root.import-text-label;
                            active: root.import-source-key == "Text";
                            clicked => { root.update-import-source("Text"); }
                        }
                    }

                    if !root.edit-mode && root.text-import-source: CredentialTextArea {
                        label: root.certificate-mode ? root.certificate-text-label : root.private-key-text-label;
                        field-value: root.secret-ref;
                        placeholder: root.certificate-mode ? root.certificate-text-placeholder : root.private-key-text-placeholder;
                        edited(value) => { root.update-secret-ref(value); }
                    }

                    if !root.edit-mode && root.import-mode && !root.text-import-source: CredentialPathField {
                        label: root.secret-label;
                        field-value: root.secret-ref;
                        placeholder: root.secret-placeholder;
                        choose-label: root.choose-file-label;
                        edited(value) => { root.update-secret-ref(value); }
                        accepted(value) => { root.update-secret-ref(value); }
                        choose => { root.choose-file(); }
                    }

                    if root.password-mode: CredentialPasswordField {
                        label: root.secret-label;
                        field-value: root.secret-ref;
                        placeholder: root.secret-placeholder;
                        show-label: root.password-show-label;
                        hide-label: root.password-hide-label;
                        edited(value) => { root.update-secret-ref(value); }
                        accepted(value) => { root.update-secret-ref(value); }
                    }

                    if root.edit-mode && !root.password-mode: CredentialTextArea {
                        label: root.secret-label;
                        field-value: root.secret-ref;
                        placeholder: root.secret-placeholder;
                        edited(value) => { root.update-secret-ref(value); }
                    }

                    if !root.edit-mode && !root.generated-private-key-mode && !root.import-mode && !root.text-import-source && !root.password-mode: DialogField {
                        label: root.secret-label;
                        field-value: root.secret-ref;
                        placeholder: root.secret-placeholder;
                        edited(value) => { root.update-secret-ref(value); }
                        accepted(value) => { root.update-secret-ref(value); }
                    }

                    if root.show-algorithm: CredentialAlgorithmField {
                        label: root.algorithm-label;
                        value: root.algorithm;
                        selected(value) => { root.update-algorithm(value); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.busy ? root.busy-label : root.save-label;
                    primary: true;
                    enabled: !root.busy && root.credential-name != "" && (!root.requires-secret-input || root.secret-ref != "");
                    clicked => {
                        if !root.busy {
                            root.save();
                        }
                    }
                }
            }
        }

        if root.busy: DialogBusyOverlay {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            label: root.busy-label;
            frame: root.busy-frame;
        }
    }
}

export component ExportSecurityCredentialDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> path-label;
    in property <string> path-placeholder;
    in property <string> target-path;
    in property <string> choose-label;
    in property <string> cancel-label;
    in property <string> save-label;
    callback update-path(value: string);
    callback choose-path();
    callback save();
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 500px);
        height: 260px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 12px;

                    CredentialPathField {
                        label: root.path-label;
                        field-value: root.target-path;
                        placeholder: root.path-placeholder;
                        choose-label: root.choose-label;
                        edited(value) => { root.update-path(value); }
                        accepted(value) => { root.update-path(value); }
                        choose => { root.choose-path(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.save-label;
                    primary: true;
                    enabled: root.target-path != "";
                    clicked => { root.save(); }
                }
            }
        }
    }
}
