import { CredentialDetailFieldRow, CredentialGroupContentRow } from "./models.slint";
import { SecurityCredentialDetailPage } from "./security_credential_detail_page.slint";

// 凭据工作区页面包装层：隔离凭据详情页的大量展示字段和操作回调。
export component SecurityWorkspacePage inherits Rectangle {
    in property <string> title-label: "";
    in property <string> selected-credential-id: "";
    in property <string> selected-credential-name: "";
    in property <string> selected-credential-group-id: "";
    in property <string> selected-credential-group-path: "";
    in property <string> selected-credential-kind: "";
    in property <string> selected-credential-kind-key: "";
    in property <string> selected-credential-username: "";
    in property <string> selected-credential-secret-ref: "";
    in property <bool> selected-credential-secret-available: false;
    in property <string> selected-credential-algorithm: "";
    in property <string> selected-credential-algorithm-key: "";
    in property <string> selected-credential-fingerprint: "";
    in property <string> selected-credential-meta: "";
    in property <string> selected-credential-icon-key: "";
    in property <string> selected-credential-node-kind: "";
    in property <int> selected-credential-accent-index: 0;
    in property <[CredentialGroupContentRow]> credential-group-contents: [];
    in property <[CredentialDetailFieldRow]> credential-detail-fields: [];
    in property <string> empty-title-label: "";
    in property <string> empty-caption-label: "";
    in property <string> field-type-label: "";
    in property <string> field-username-label: "";
    in property <string> field-algorithm-label: "";
    in property <string> field-fingerprint-label: "";
    in property <string> field-secret-ref-label: "";
    in property <string> field-group-label: "";
    in property <string> group-caption-label: "";
    in property <string> view-content-label: "";
    in property <string> view-private-key-label: "";
    in property <string> view-certificate-label: "";
    in property <string> view-password-label: "";
    in property <string> secret-content: "";
    in property <string> secret-content-missing-label: "";
    in property <bool> secret-copy-enabled: false;
    in property <string> secret-copy-label: "";
    in property <string> secret-copy-success-label: "";
    in property <string> secret-copy-failed-label: "";
    in property <string> edit-label: "";
    in property <string> edit-private-key-label: "";
    in property <string> edit-certificate-label: "";
    in property <string> edit-password-label: "";
    in property <string> compile-label: "";

    callback select-credential(
        id: string,
        name: string,
        group-id: string,
        group-path: string,
        kind: string,
        kind-key: string,
        username: string,
        secret-ref: string,
        secret-available: bool,
        algorithm: string,
        algorithm-key: string,
        fingerprint: string,
        meta: string,
        icon-key: string,
        node-kind: string,
        accent-index: int,
    );
    callback copy-secret-content(content: string) -> bool;
    callback edit-credential(credential-id: string, name: string, group-id: string, group-path: string, kind-key: string, algorithm-key: string);
    callback compile-certificate(group-id: string, group-path: string);

    vertical-stretch: 1;
    horizontal-stretch: 1;

    SecurityCredentialDetailPage {
        width: root.width;
        height: root.height;
        title-label: root.title-label;
        selected-credential-id: root.selected-credential-id;
        selected-credential-name: root.selected-credential-name;
        selected-credential-group-id: root.selected-credential-group-id;
        selected-credential-group-path: root.selected-credential-group-path;
        selected-credential-kind: root.selected-credential-kind;
        selected-credential-kind-key: root.selected-credential-kind-key;
        selected-credential-username: root.selected-credential-username;
        selected-credential-secret-ref: root.selected-credential-secret-ref;
        selected-credential-secret-available: root.selected-credential-secret-available;
        selected-credential-algorithm: root.selected-credential-algorithm;
        selected-credential-algorithm-key: root.selected-credential-algorithm-key;
        selected-credential-fingerprint: root.selected-credential-fingerprint;
        selected-credential-meta: root.selected-credential-meta;
        selected-credential-icon-key: root.selected-credential-icon-key;
        selected-credential-node-kind: root.selected-credential-node-kind;
        selected-credential-accent-index: root.selected-credential-accent-index;
        credential-group-contents: root.credential-group-contents;
        credential-detail-fields: root.credential-detail-fields;
        empty-title-label: root.empty-title-label;
        empty-caption-label: root.empty-caption-label;
        field-type-label: root.field-type-label;
        field-username-label: root.field-username-label;
        field-algorithm-label: root.field-algorithm-label;
        field-fingerprint-label: root.field-fingerprint-label;
        field-secret-ref-label: root.field-secret-ref-label;
        field-group-label: root.field-group-label;
        group-caption-label: root.group-caption-label;
        view-content-label: root.view-content-label;
        view-private-key-label: root.view-private-key-label;
        view-certificate-label: root.view-certificate-label;
        view-password-label: root.view-password-label;
        secret-content: root.secret-content;
        secret-content-missing-label: root.secret-content-missing-label;
        secret-copy-enabled: root.secret-copy-enabled;
        secret-copy-label: root.secret-copy-label;
        secret-copy-success-label: root.secret-copy-success-label;
        secret-copy-failed-label: root.secret-copy-failed-label;
        edit-label: root.edit-label;
        edit-private-key-label: root.edit-private-key-label;
        edit-certificate-label: root.edit-certificate-label;
        edit-password-label: root.edit-password-label;
        compile-label: root.compile-label;
        select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index) => {
            root.select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index);
        }
        copy-secret-content(content) => { root.copy-secret-content(content) }
        edit-credential(credential-id, name, group-id, group-path, kind-key, algorithm-key) => {
            root.edit-credential(credential-id, name, group-id, group-path, kind-key, algorithm-key);
        }
        compile-certificate(group-id, group-path) => { root.compile-certificate(group-id, group-path); }
    }
}
