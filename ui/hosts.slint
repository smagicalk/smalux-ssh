import { AppTheme } from "./theme.slint";

export component HostActionButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 24px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: AppTheme.text;
        font-size: 9px;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HostTreeMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    border-radius: 5px;
    background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? (root.danger ? AppTheme.button-danger-bg : AppTheme.surface-hover) : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: root.danger ? AppTheme.danger-text-soft : AppTheme.text-secondary;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
}

component HostTreeGuides inherits Rectangle {
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;

    background: AppTheme.transparent;

    if root.guide0: Rectangle { x: 11px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide1: Rectangle { x: 29px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide2: Rectangle { x: 47px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide3: Rectangle { x: 65px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide4: Rectangle { x: 83px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide5: Rectangle { x: 101px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide6: Rectangle { x: 119px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
    if root.guide7: Rectangle { x: 137px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border-soft; }
}

component HostTreeBranch inherits Rectangle {
    in property <int> depth: 0;
    in property <bool> has-next-sibling: false;
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;

    background: AppTheme.transparent;

    HostTreeGuides {
        width: parent.width;
        height: parent.height;
        guide0: root.guide0;
        guide1: root.guide1;
        guide2: root.guide2;
        guide3: root.guide3;
        guide4: root.guide4;
        guide5: root.guide5;
        guide6: root.guide6;
        guide7: root.guide7;
    }

    if root.depth > 0: Rectangle {
        x: root.depth * 18px + 11px;
        y: 0px;
        width: 1px;
        height: root.has-next-sibling ? parent.height : parent.height / 2;
        background: AppTheme.border-soft;
    }

    if root.depth > 0: Rectangle {
        x: root.depth * 18px + 11px;
        y: parent.height / 2;
        width: 11px;
        height: 1px;
        background: AppTheme.border-soft;
    }
}

export component HostIcon inherits Rectangle {
    in property <string> icon-key: "server";
    in property <string> status-key: "";
    in property <int> accent-index: 0;

    property <bool> connected: root.status-key == "Connected";
    property <color> accent-color: root.accent-index == 0 ? AppTheme.accent : root.accent-index == 1 ? AppTheme.accent-violet : root.accent-index == 2 ? AppTheme.warning : root.accent-index == 3 ? AppTheme.info-text : root.accent-index == 4 ? AppTheme.danger-text-soft : AppTheme.success-text;
    property <color> accent-bg: root.accent-index == 0 ? AppTheme.badge-success-bg : root.accent-index == 1 ? AppTheme.badge-pending-bg : root.accent-index == 2 ? AppTheme.badge-warning-bg : root.accent-index == 3 ? AppTheme.badge-info-bg : root.accent-index == 4 ? AppTheme.button-danger-bg : AppTheme.dialog-success-icon-bg;
    property <color> status-color: root.connected ? AppTheme.accent : root.status-key == "Connecting" ? AppTheme.warning : root.status-key == "Failed" ? AppTheme.danger : AppTheme.status-muted;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.accent-color;
    background: root.accent-bg;

    if root.icon-key == "database": Rectangle {
        x: 5px;
        y: 5px;
        width: 12px;
        height: 4px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.accent-color;
        background: AppTheme.transparent;
    }

    if root.icon-key == "database": Rectangle {
        x: 5px;
        y: 9px;
        width: 12px;
        height: 7px;
        border-width: 1px;
        border-color: root.accent-color;
        background: AppTheme.transparent;
    }

    if root.icon-key == "cloud": Rectangle {
        x: 5px;
        y: 10px;
        width: 12px;
        height: 5px;
        border-radius: 3px;
        background: root.accent-color;
    }

    if root.icon-key == "cloud": Rectangle {
        x: 8px;
        y: 6px;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.accent-color;
    }

    if root.icon-key == "linux": Text {
        x: 0px;
        y: 1px;
        width: parent.width;
        height: parent.height;
        text: ">";
        color: root.accent-color;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon-key == "container": Rectangle {
        x: 5px;
        y: 6px;
        width: 12px;
        height: 11px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.accent-color;
        background: AppTheme.transparent;
    }

    if root.icon-key == "container": Rectangle {
        x: 9px;
        y: 3px;
        width: 8px;
        height: 6px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.accent-color;
        background: AppTheme.transparent;
    }

    if root.icon-key == "shield": Rectangle {
        x: 7px;
        y: 4px;
        width: 8px;
        height: 12px;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.accent-color;
        background: AppTheme.transparent;
    }

    if root.icon-key != "database" && root.icon-key != "cloud" && root.icon-key != "linux" && root.icon-key != "container" && root.icon-key != "shield": Rectangle {
        x: 5px;
        y: 5px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.accent-color;
        background: AppTheme.transparent;

        Rectangle {
            x: 3px;
            y: 3px;
            width: 6px;
            height: 2px;
            border-radius: 2px;
            background: root.accent-color;
        }

        Rectangle {
            x: 3px;
            y: 7px;
            width: 4px;
            height: 2px;
            border-radius: 2px;
            background: root.accent-color;
        }
    }

    Rectangle {
        x: 15px;
        y: 15px;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        border-width: 1px;
        border-color: AppTheme.panel-bg;
        background: root.status-color;
    }
}

export component HostNodeIcon inherits Rectangle {
    in property <string> kind: "Host";
    in property <string> icon-key: "server";
    in property <string> status-key: "";
    in property <bool> expanded: true;
    in property <int> accent-index: 0;

    property <color> accent-color: root.accent-index == 0 ? AppTheme.accent : root.accent-index == 1 ? AppTheme.accent-violet : root.accent-index == 2 ? AppTheme.warning : root.accent-index == 3 ? AppTheme.info-text : root.accent-index == 4 ? AppTheme.danger-text-soft : AppTheme.success-text;
    property <color> icon-bg: root.kind == "Group" ? AppTheme.badge-warning-bg : AppTheme.card-bg;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.kind == "Group" ? AppTheme.warning : root.accent-color;
    background: root.icon-bg;

    if root.kind == "Group": Rectangle {
        x: 4px;
        y: 8px;
        width: 14px;
        height: 9px;
        border-radius: 3px;
        border-width: 1px;
        border-color: AppTheme.warning;
        background: AppTheme.transparent;
    }

    if root.kind == "Group": Rectangle {
        x: 5px;
        y: 5px;
        width: 8px;
        height: 5px;
        border-radius: 2px;
        background: AppTheme.warning;
    }

    if root.kind == "Group": Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.expanded ? "-" : "+";
        color: AppTheme.text-strong;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.kind != "Group": HostIcon {
        x: 0px;
        y: 0px;
        icon-key: root.icon-key;
        status-key: root.status-key;
        accent-index: root.accent-index;
    }
}

export component HostIconOption inherits Rectangle {
    in property <string> label;
    in property <string> icon-key: "server";
    in property <string> selected-icon-key: "server";
    in property <int> accent-index: 0;
    callback selected(key: string);

    property <bool> active: root.icon-key == root.selected-icon-key;

    height: 42px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.selected(root.icon-key); }
    }

    VerticalLayout {
        padding-top: 5px;
        padding-bottom: 5px;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;

        HostIcon {
            icon-key: root.icon-key;
            accent-index: root.accent-index;
            status-key: "Created";
        }

        Text {
            text: root.label;
            color: root.active ? AppTheme.text-strong : AppTheme.text-muted;
            font-size: 9px;
            font-weight: 700;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
}

export component HostTreeContextMenu inherits Rectangle {
    in property <string> new-group-label: "";
    in property <string> open-label: "";
    in property <string> files-label: "";
    in property <string> edit-label: "";
    in property <string> delete-label: "";
    in property <string> duplicate-label: "";
    callback open-shell();
    callback create-group();
    callback open-sftp();
    callback edit-host();
    callback duplicate-host();
    callback remove-host();

    height: 232px;
    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border-strong;
    background: AppTheme.dialog-bg;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HostTreeMenuItem { label: root.new-group-label; clicked => { root.create-group(); } }
        HostTreeMenuItem { label: root.open-label; clicked => { root.open-shell(); } }
        HostTreeMenuItem { label: root.files-label; clicked => { root.open-sftp(); } }
        HostTreeMenuItem { label: root.edit-label; clicked => { root.edit-host(); } }
        HostTreeMenuItem { label: root.duplicate-label; clicked => { root.duplicate-host(); } }
        HostTreeMenuItem { label: root.delete-label; danger: true; clicked => { root.remove-host(); } }
    }
}

export component HostTreeGroupContextMenu inherits Rectangle {
    in property <string> create-host-label: "";
    in property <string> create-group-label: "";
    in property <string> delete-label: "";
    in property <bool> show-delete: true;
    callback create-host();
    callback create-group();
    callback remove-group();

    height: root.show-delete ? 124px : 88px;
    border-radius: 7px;
    border-width: 1px;
    border-color: AppTheme.border-strong;
    background: AppTheme.dialog-bg;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HostTreeMenuItem { label: root.create-host-label; clicked => { root.create-host(); } }
        HostTreeMenuItem { label: root.create-group-label; clicked => { root.create-group(); } }
        if root.show-delete: HostTreeMenuItem { label: root.delete-label; danger: true; clicked => { root.remove-group(); } }
    }
}

export component HostCard inherits Rectangle {
    in property <string> host-id;
    in property <string> name;
    in property <string> endpoint;
    in property <string> icon-key: "server";
    in property <string> auth;
    in property <string> group;
    in property <string> tags;
    in property <string> status-key;
    in property <string> status;
    in property <string> open-label: "";
    in property <string> files-label: "";
    in property <string> edit-label: "";
    in property <string> delete-label: "";
    callback open-shell();
    callback open-sftp();
    callback edit-host();
    callback remove-host();

    height: 94px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.status-key == "Connected" ? AppTheme.accent : AppTheme.border-soft;
    background: AppTheme.card-bg;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;

        Rectangle {
            width: 28px;
            background: AppTheme.transparent;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 3px;
                height: parent.height;
                border-radius: 3px;
                background: root.status-key == "Connected" ? AppTheme.accent : root.status-key == "Connecting" ? AppTheme.warning : AppTheme.accent-blue;
            }

            HostIcon {
                x: 6px;
                y: 1px;
                icon-key: root.icon-key;
                status-key: root.status-key;
                accent-index: 0;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 7px;

            HorizontalLayout {
                spacing: 6px;

                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text { text: name; color: AppTheme.text-strong; font-size: 12px; font-weight: 700; height: 15px; overflow: elide; }
                    Text { text: endpoint; color: AppTheme.text-soft; font-size: 10px; height: 13px; overflow: elide; }
                    Text { text: tags; color: AppTheme.success-text; font-size: 9px; height: 12px; overflow: elide; }
                }

                VerticalLayout {
                    width: 62px;
                    spacing: 3px;
                    Text {
                        text: status;
                        color: root.status-key == "Connected" ? AppTheme.success-text : AppTheme.status-muted;
                        font-size: 9px;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Text {
                        text: auth;
                        color: AppTheme.accent-violet;
                        font-size: 9px;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Text {
                        text: group;
                        color: AppTheme.text-muted;
                        font-size: 9px;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                HostActionButton { label: root.open-label; horizontal-stretch: 1; clicked => { root.open-shell(); } }
                HostActionButton { label: root.files-label; horizontal-stretch: 1; clicked => { root.open-sftp(); } }
                HostActionButton { label: root.edit-label; horizontal-stretch: 1; clicked => { root.edit-host(); } }
                HostActionButton { label: root.delete-label; horizontal-stretch: 1; clicked => { root.remove-host(); } }
            }
        }
    }
}

export component HostViewModeToggle inherits Rectangle {
    in property <string> mode-key: "Tree";
    callback clicked();

    width: 66px;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
    background: touch.has-hover ? AppTheme.surface-hover : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.mode-key == "Tree" ? AppTheme.selection-bg : AppTheme.transparent;

            VerticalLayout {
                padding-left: 7px;
                padding-right: 7px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 2px;

                Rectangle {
                    height: 2px;
                    border-radius: 2px;
                    background: root.mode-key == "Tree" ? AppTheme.text-strong : AppTheme.text-muted;
                }
                Rectangle {
                    height: 2px;
                    border-radius: 2px;
                    background: root.mode-key == "Tree" ? AppTheme.text-strong : AppTheme.text-muted;
                }
                Rectangle {
                    height: 2px;
                    border-radius: 2px;
                    background: root.mode-key == "Tree" ? AppTheme.text-strong : AppTheme.text-muted;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.mode-key == "Card" ? AppTheme.selection-bg : AppTheme.transparent;

            GridLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 3px;

                Rectangle {
                    row: 0;
                    col: 0;
                    border-radius: 2px;
                    background: root.mode-key == "Card" ? AppTheme.text-strong : AppTheme.text-muted;
                }
                Rectangle {
                    row: 0;
                    col: 1;
                    border-radius: 2px;
                    background: root.mode-key == "Card" ? AppTheme.text-strong : AppTheme.text-muted;
                }
                Rectangle {
                    row: 1;
                    col: 0;
                    border-radius: 2px;
                    background: root.mode-key == "Card" ? AppTheme.text-strong : AppTheme.text-muted;
                }
                Rectangle {
                    row: 1;
                    col: 1;
                    border-radius: 2px;
                    background: root.mode-key == "Card" ? AppTheme.text-strong : AppTheme.text-muted;
                }
            }
        }
    }
}

export component HostAddButton inherits Rectangle {
    callback clicked();

    width: 30px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.button-primary-border-hover : AppTheme.button-primary-border;
    background: touch.pressed ? AppTheme.button-primary-pressed : touch.has-hover ? AppTheme.button-primary-hover : AppTheme.button-primary-bg;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: "+";
        color: AppTheme.text-strong;
        font-size: 17px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HostTreeGroup inherits Rectangle {
    in property <string> label;
    in property <bool> expanded: true;
    in property <int> depth: 0;
    in property <int> accent-index: 0;
    in property <bool> has-next-sibling: false;
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;
    callback toggle();
    callback open-context-menu(abs-x: length, abs-y: length);

    width: 260px + root.depth * 18px;
    height: 34px;
    background: AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.toggle(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-context-menu(root.absolute-position.x + touch.mouse-x, root.absolute-position.y + touch.mouse-y);
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        border-radius: 6px;
        background: touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;
    }

    HorizontalLayout {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        padding-left: 6px;
        padding-right: 8px;
        spacing: 7px;

        Rectangle {
            width: root.depth * 18px + 22px;
            height: parent.height;
            background: AppTheme.transparent;

            HostTreeBranch {
                width: parent.width;
                height: parent.height;
                depth: root.depth;
                has-next-sibling: root.has-next-sibling;
                guide0: root.guide0;
                guide1: root.guide1;
                guide2: root.guide2;
                guide3: root.guide3;
                guide4: root.guide4;
                guide5: root.guide5;
                guide6: root.guide6;
                guide7: root.guide7;
            }

            HostNodeIcon {
                x: root.depth * 18px;
                y: (parent.height - self.height) / 2;
                kind: "Group";
                expanded: root.expanded;
                accent-index: root.accent-index;
            }
        }

        Text {
            height: parent.height;
            horizontal-stretch: 1;
            text: root.label;
            color: AppTheme.text-secondary;
            font-size: 11px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component HostTreeHost inherits Rectangle {
    in property <string> name;
    in property <string> endpoint: "";
    in property <string> icon-key: "server";
    in property <string> status-key;
    in property <int> accent-index: 0;
    in property <int> depth: 0;
    in property <bool> selected: false;
    in property <bool> has-next-sibling: false;
    in property <bool> guide0: false;
    in property <bool> guide1: false;
    in property <bool> guide2: false;
    in property <bool> guide3: false;
    in property <bool> guide4: false;
    in property <bool> guide5: false;
    in property <bool> guide6: false;
    in property <bool> guide7: false;
    callback select-host();
    callback open-shell();
    callback open-context-menu(abs-x: length, abs-y: length);

    width: 260px + root.depth * 18px;
    height: 34px;
    background: AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.select-host(); }
        double-clicked => { root.open-shell(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-context-menu(root.absolute-position.x + touch.mouse-x, root.absolute-position.y + touch.mouse-y);
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.selected ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-soft : AppTheme.transparent;
        background: root.selected ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;
    }

    HorizontalLayout {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        padding-left: 6px;
        padding-right: 7px;
        spacing: 7px;

        Rectangle {
            width: root.depth * 18px + 22px;
            height: parent.height;
            background: AppTheme.transparent;

            HostTreeBranch {
                width: parent.width;
                height: parent.height;
                depth: root.depth;
                has-next-sibling: root.has-next-sibling;
                guide0: root.guide0;
                guide1: root.guide1;
                guide2: root.guide2;
                guide3: root.guide3;
                guide4: root.guide4;
                guide5: root.guide5;
                guide6: root.guide6;
                guide7: root.guide7;
            }

            HostNodeIcon {
                x: root.depth * 18px;
                y: (parent.height - self.height) / 2;
                kind: "Host";
                icon-key: root.icon-key;
                status-key: root.status-key;
                accent-index: root.accent-index;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            background: AppTheme.transparent;

            Text {
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.name;
                color: AppTheme.text-strong;
                font-size: 11px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}
