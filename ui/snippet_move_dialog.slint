import { ScrollView } from "std-widgets.slint";
import { SnippetRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
component SnippetGroupPickerItem inherits Rectangle {
    in property <SnippetRow> item;
    in property <string> selected-group-id;
    in property <string> root-label;
    callback selected(group-id: string, name: string);

    property <bool> visible-row: root.item.node_kind == "Group";
    property <string> emitted-id: root.item.id == "snippet-folder:all" ? "" : root.item.id;
    property <bool> active: root.selected-group-id == root.emitted-id;

    height: root.visible-row ? 36px : 0px;
    visible: root.visible-row;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.active ? AppTheme.border-strong : touch.has-hover ? AppTheme.border-soft : AppTheme.transparent;
    background: root.active ? AppTheme.selection-bg : touch.pressed ? AppTheme.surface-pressed : touch.has-hover ? AppTheme.surface-hover : AppTheme.transparent;

    touch := TouchArea {
        clicked => { root.selected(root.emitted-id, root.item.id == "snippet-folder:all" ? root.root-label : root.item.name); }
    }

    HostIcon {
        x: 8px + root.item.depth * 14px;
        y: (parent.height - self.height) / 2;
        icon-key: "folder";
        accent-index: root.item.accent_index;
        status-key: "Created";
    }

    Text {
        x: 34px + root.item.depth * 14px;
        y: 0px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        text: root.item.id == "snippet-folder:all" ? root.root-label : root.item.name;
        color: root.active ? AppTheme.text-strong : AppTheme.text;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MoveSnippetDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> root-label;
    in property <string> cancel-label;
    in property <string> move-label;
    in property <[SnippetRow]> groups;
    in property <string> selected-group-id;
    callback select-group(group-id: string, name: string);
    callback close();
    callback move() -> bool;

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 64px, 420px);
        height: min(root.height - 96px, 430px);
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                height: 28px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.border-soft;
                background: AppTheme.inset-bg;
                clip: true;

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 5px;
                        spacing: 2px;
                        for snippet in root.groups: SnippetGroupPickerItem {
                            item: snippet;
                            selected-group-id: root.selected-group-id;
                            root-label: root.root-label;
                            selected(group-id, name) => { root.select-group(group-id, name); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.move-label;
                    primary: true;
                    clicked => {
                        if root.move() {
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
