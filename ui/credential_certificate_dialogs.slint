import { ScrollView } from "std-widgets.slint";
import { CredentialOptionRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { DialogButton, DialogCloseButton, DialogField } from "./common.slint";
import { CredentialGroupField } from "./credential_controls.slint";
import { CredentialSourceToggleButton } from "./credential_group_dialogs.slint";
component CertificateKeyField inherits Rectangle {
    in property <string> label;
    in property <string> selected-name;
    in property <string> placeholder;
    callback open();

    height: 50px;
    background: AppTheme.transparent;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: AppTheme.text-soft;
            font-size: 10px;
            font-weight: 700;
        }
        Rectangle {
            height: 30px;
            border-radius: 7px;
            border-width: 1px;
            border-color: touch.has-hover ? AppTheme.border-strong : AppTheme.border-soft;
            background: touch.pressed ? AppTheme.surface-pressed : AppTheme.input-bg;

            touch := TouchArea {
                clicked => { root.open(); }
            }

            Text {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.selected-name == "" ? root.placeholder : root.selected-name;
                color: root.selected-name == "" ? AppTheme.input-placeholder : AppTheme.text;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component CertificateKeyPickerItem inherits Rectangle {
    in property <CredentialOptionRow> option;
    in property <string> selected-value;
    callback selected(value: string, label: string);

    property <bool> active: root.option.value == root.selected-value;

    height: 42px;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppTheme.border-soft;
    background: root.active ? AppTheme.dialog-section-bg : AppTheme.card-bg;

    touch := TouchArea {
        clicked => { root.selected(root.option.value, root.option.label); }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        Text {
            text: root.option.label;
            color: root.active ? AppTheme.text-strong : AppTheme.text;
            font-size: 11px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.option.detail;
            color: AppTheme.text-muted;
            font-size: 9px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component CertificateKeyPickerDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> selected-value;
    in property <string> empty-label;
    in property <string> close-label;
    in property <[CredentialOptionRow]> options;
    callback select-key(value: string, label: string);
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 500px);
        height: min(root.height - 36px, 480px);
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 8px;

                    if root.options.length == 0: Text {
                        height: 32px;
                        text: root.empty-label;
                        color: AppTheme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    for option in root.options: CertificateKeyPickerItem {
                        option: option;
                        selected-value: root.selected-value;
                        selected(value, label) => { root.select-key(value, label); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.close-label;
                    primary: false;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

export component CreateCertificateCredentialDialog inherits Rectangle {
    in property <string> title-label;
    in property <string> name-label;
    in property <string> name-placeholder;
    in property <string> group-label;
    in property <string> group-path;
    in property <string> ca-key-label;
    in property <string> ca-key-name;
    in property <string> ca-key-placeholder;
    in property <string> subject-key-label;
    in property <string> subject-key-name;
    in property <string> subject-key-placeholder;
    in property <string> type-label;
    in property <string> type-value;
    in property <string> user-type-label;
    in property <string> host-type-label;
    in property <string> principals-label;
    in property <string> principals-placeholder;
    in property <string> valid-days-label;
    in property <string> valid-days-placeholder;
    in property <string> key-id-label;
    in property <string> key-id-placeholder;
    in property <string> serial-label;
    in property <string> serial-placeholder;
    in property <string> credential-name;
    in property <string> principals;
    in property <string> valid-days;
    in property <string> key-id;
    in property <string> serial;
    in property <string> cancel-label;
    in property <string> save-label;
    callback update-name(value: string);
    callback open-group-picker();
    callback open-ca-key-picker();
    callback open-subject-key-picker();
    callback update-type(value: string);
    callback update-principals(value: string);
    callback update-valid-days(value: string);
    callback update-key-id(value: string);
    callback update-serial(value: string);
    callback save();
    callback close();

    background: AppTheme.overlay-bg;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(root.width - 48px, 600px);
        height: min(root.height - 32px, 680px);
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-strong;
        background: AppTheme.dialog-bg;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.title-label;
                    color: AppTheme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                DialogCloseButton { clicked => { root.close(); } }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 12px;

                    DialogField {
                        label: root.name-label;
                        field-value: root.credential-name;
                        placeholder: root.name-placeholder;
                        edited(value) => { root.update-name(value); }
                        accepted(value) => { root.update-name(value); }
                    }

                    CredentialGroupField {
                        label: root.group-label;
                        group-path: root.group-path;
                        open => { root.open-group-picker(); }
                    }

                    CertificateKeyField {
                        label: root.ca-key-label;
                        selected-name: root.ca-key-name;
                        placeholder: root.ca-key-placeholder;
                        open => { root.open-ca-key-picker(); }
                    }

                    CertificateKeyField {
                        label: root.subject-key-label;
                        selected-name: root.subject-key-name;
                        placeholder: root.subject-key-placeholder;
                        open => { root.open-subject-key-picker(); }
                    }

                    Rectangle {
                        height: 52px;
                        background: AppTheme.transparent;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.type-label;
                                color: AppTheme.text-soft;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                CredentialSourceToggleButton {
                                    horizontal-stretch: 1;
                                    label: root.user-type-label;
                                    active: root.type-value == "User";
                                    clicked => { root.update-type("User"); }
                                }
                                CredentialSourceToggleButton {
                                    horizontal-stretch: 1;
                                    label: root.host-type-label;
                                    active: root.type-value == "Host";
                                    clicked => { root.update-type("Host"); }
                                }
                            }
                        }
                    }

                    DialogField {
                        label: root.principals-label;
                        field-value: root.principals;
                        placeholder: root.principals-placeholder;
                        edited(value) => { root.update-principals(value); }
                        accepted(value) => { root.update-principals(value); }
                    }

                    HorizontalLayout {
                        height: 50px;
                        spacing: 8px;
                        DialogField {
                            horizontal-stretch: 1;
                            label: root.valid-days-label;
                            field-value: root.valid-days;
                            placeholder: root.valid-days-placeholder;
                            edited(value) => { root.update-valid-days(value); }
                            accepted(value) => { root.update-valid-days(value); }
                        }
                        DialogField {
                            horizontal-stretch: 1;
                            label: root.serial-label;
                            field-value: root.serial;
                            placeholder: root.serial-placeholder;
                            edited(value) => { root.update-serial(value); }
                            accepted(value) => { root.update-serial(value); }
                        }
                    }

                    DialogField {
                        label: root.key-id-label;
                        field-value: root.key-id;
                        placeholder: root.key-id-placeholder;
                        edited(value) => { root.update-key-id(value); }
                        accepted(value) => { root.update-key-id(value); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: root.cancel-label;
                    primary: false;
                    clicked => { root.close(); }
                }
                DialogButton {
                    label: root.save-label;
                    primary: true;
                    enabled: root.credential-name != "" && root.ca-key-name != "" && root.subject-key-name != "" && root.principals != "" && root.valid-days != "";
                    clicked => { root.save(); }
                }
            }
        }
    }
}
