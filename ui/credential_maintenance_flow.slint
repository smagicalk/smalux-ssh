import { CredentialRow } from "./models.slint";
import { ConfirmDialog } from "./common.slint";
import { CredentialGroupPickerDialog } from "./credential_group_dialogs.slint";
import { ExportSecurityCredentialDialog } from "./credential_editor_dialogs.slint";

export component CredentialMaintenanceFlow inherits Rectangle {
    in-out property <bool> move-credential-group-picker-open;
    in-out property <string> move-credential-source-id;
    in-out property <bool> export-security-credential-dialog-open;
    in-out property <string> export-security-credential-kind-key;
    in-out property <string> export-security-credential-name;
    in-out property <string> export-security-credential-path;
    in-out property <bool> remove-security-credential-dialog-open;
    in-out property <string> remove-security-credential-dialog-id;
    in-out property <string> remove-security-credential-dialog-name;
    in-out property <string> selected-credential-id;
    in-out property <string> selected-credential-name;
    in-out property <string> selected-credential-group-id;
    in-out property <string> selected-credential-group-path;
    in-out property <string> selected-credential-kind;
    in-out property <string> selected-credential-kind-key;
    in-out property <string> selected-credential-username;
    in-out property <string> selected-credential-secret-ref;
    in-out property <bool> selected-credential-secret-available;
    in-out property <string> selected-credential-algorithm;
    in-out property <string> selected-credential-algorithm-key;
    in-out property <string> selected-credential-fingerprint;
    in-out property <string> selected-credential-meta;
    in-out property <string> selected-credential-icon-key;
    in-out property <string> selected-credential-node-kind;
    in-out property <int> selected-credential-accent-index;
    in property <[CredentialRow]> credential-rows;
    in property <string> quick-security-credential-kind-key;
    in property <string> quick-security-credential-group-id;
    in property <string> security-credential-move-label;
    in property <string> create-group-cancel-label;
    in property <string> security-credential-export-title-label;
    in property <string> security-credential-export-path-label;
    in property <string> security-credential-export-path-placeholder;
    in property <string> settings-choose-file-label;
    in property <string> security-credential-save-label;
    in property <string> security-credential-delete-title-label;
    in property <string> security-credential-delete-caption-label;
    in property <string> security-credential-delete-cancel-label;
    in property <string> security-credential-delete-confirm-label;
    callback move-credential-tree-node(source-id: string, target-id: string) -> bool;
    callback choose-security-credential-export-path(current-path: string, kind-key: string) -> string;
    callback export-credential-secret(name: string, target-path: string) -> bool;
    callback remove-credential(credential-id: string);

    if root.move-credential-group-picker-open: CredentialGroupPickerDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-credential-move-label;
        current-kind-key: root.quick-security-credential-kind-key;
        selected-group-id: root.quick-security-credential-group-id;
        blocked-group-id: root.move-credential-source-id;
        emit-root-row-id: true;
        credentials: root.credential-rows;
        close-label: root.create-group-cancel-label;
        select-group(id, path) => {
            if !root.move-credential-tree-node(root.move-credential-source-id, id) {
                return;
            }
            root.move-credential-group-picker-open = false;
            root.move-credential-source-id = "";
        }
        close => {
            root.move-credential-group-picker-open = false;
            root.move-credential-source-id = "";
        }
    }

    if root.export-security-credential-dialog-open: ExportSecurityCredentialDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-credential-export-title-label;
        path-label: root.security-credential-export-path-label;
        path-placeholder: root.security-credential-export-path-placeholder;
        target-path: root.export-security-credential-path;
        choose-label: root.settings-choose-file-label;
        cancel-label: root.create-group-cancel-label;
        save-label: root.security-credential-save-label;
        update-path(value) => { root.export-security-credential-path = value; }
        choose-path => {
            root.export-security-credential-path = root.choose-security-credential-export-path(root.export-security-credential-path, root.export-security-credential-kind-key);
        }
        save => {
            if !root.export-credential-secret(root.export-security-credential-name, root.export-security-credential-path) {
                return;
            }
            root.export-security-credential-dialog-open = false;
            root.export-security-credential-name = "";
            root.export-security-credential-path = "";
            root.export-security-credential-kind-key = "";
        }
        close => {
            root.export-security-credential-dialog-open = false;
            root.export-security-credential-name = "";
            root.export-security-credential-path = "";
            root.export-security-credential-kind-key = "";
        }
    }

    if root.remove-security-credential-dialog-open: ConfirmDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.security-credential-delete-title-label;
        message: root.security-credential-delete-caption-label;
        subject: root.remove-security-credential-dialog-name;
        cancel-label: root.security-credential-delete-cancel-label;
        confirm-label: root.security-credential-delete-confirm-label;
        cancel => {
            root.remove-security-credential-dialog-open = false;
            root.remove-security-credential-dialog-id = "";
            root.remove-security-credential-dialog-name = "";
        }
        confirm => {
            root.remove-credential(root.remove-security-credential-dialog-id);
            if root.selected-credential-id == root.remove-security-credential-dialog-id {
                root.selected-credential-id = "";
                root.selected-credential-name = "";
                root.selected-credential-group-id = "";
                root.selected-credential-group-path = "";
                root.selected-credential-kind = "";
                root.selected-credential-kind-key = "";
                root.selected-credential-username = "";
                root.selected-credential-secret-ref = "";
                root.selected-credential-secret-available = false;
                root.selected-credential-algorithm = "";
                root.selected-credential-algorithm-key = "";
                root.selected-credential-fingerprint = "";
                root.selected-credential-meta = "";
                root.selected-credential-icon-key = "key";
                root.selected-credential-node-kind = "";
                root.selected-credential-accent-index = 0;
            }
            root.remove-security-credential-dialog-open = false;
            root.remove-security-credential-dialog-id = "";
            root.remove-security-credential-dialog-name = "";
        }
    }
}
