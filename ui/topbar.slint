import { AppTheme } from "./theme.slint";
import { TopbarIconButton } from "./nav.slint";

export component TopBar inherits Rectangle {
    in property <string> active-page;
    in property <string> brand-short-label: "";
    in property <string> brand-name-label: "";
    in property <string> find-label: "";
    callback open-command-palette();

    height: 26px;
    background: AppTheme.topbar-bg;
    border-width: 1px;
    border-color: AppTheme.topbar-border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;

        Rectangle {
            width: 15px;
            height: 15px;
            border-radius: 4px;
            background: AppTheme.accent;
            Text {
                text: root.brand-short-label;
                color: AppTheme.text-inverse;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.brand-name-label;
            color: AppTheme.text;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px;
            height: 14px;
            background: AppTheme.border;
        }

        Text {
            text: root.active-page;
            color: AppTheme.text-soft;
            font-size: 10px;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        TopbarIconButton {
            kind: "Search";
            clicked => { root.open-command-palette(); }
        }
    }
}
