import { AppTheme } from "./theme.slint";

export component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    height: 20px;
    border-radius: 9px;
    border-width: 1px;
    border-color: active ? AppTheme.accent : AppTheme.border;
    background: active ? #15352f : #141a23;
    Text {
        text: label;
        color: active ? AppTheme.text : AppTheme.text-muted;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ToolRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: #121923;

    HorizontalLayout {
        padding: 8px;
        Text { text: label; color: #c7d0db; font-size: 11px; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: value; color: AppTheme.text-muted; font-size: 10px; }
    }
}

export component CompactButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 21px;
    min-width: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: enabled ? AppTheme.border : AppTheme.border-soft;
    background: enabled ? AppTheme.surface-bg : #0d1219;

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: label;
        color: enabled ? AppTheme.text : AppTheme.text-muted;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
