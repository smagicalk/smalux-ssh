import { ScrollView } from "std-widgets.slint";
import { CredentialDetailFieldRow, CredentialGroupContentRow } from "./models.slint";
import { AppTheme } from "./theme.slint";
import { CompactButton } from "./common.slint";
import { HostIcon } from "./hosts.slint";
import { CredentialDetailField, CredentialSecretContentBlock, SecurityGroupContentItem } from "./security_credential_detail_parts.slint";
export component SecurityCredentialDetailPage inherits Rectangle {
    in property <string> selected-credential-id;
    in property <string> selected-credential-name;
    in property <string> selected-credential-group-id;
    in property <string> selected-credential-group-path;
    in property <string> selected-credential-kind;
    in property <string> selected-credential-kind-key;
    in property <string> selected-credential-username;
    in property <string> selected-credential-secret-ref;
    in property <bool> selected-credential-secret-available;
    in property <string> selected-credential-algorithm;
    in property <string> selected-credential-algorithm-key;
    in property <string> selected-credential-fingerprint;
    in property <string> selected-credential-meta;
    in property <string> selected-credential-icon-key;
    in property <string> selected-credential-node-kind;
    in property <int> selected-credential-accent-index;
    in property <[CredentialGroupContentRow]> credential-group-contents;
    in property <[CredentialDetailFieldRow]> credential-detail-fields;
    in property <string> title-label;
    in property <string> empty-title-label;
    in property <string> empty-caption-label;
    in property <string> field-type-label;
    in property <string> field-username-label;
    in property <string> field-algorithm-label;
    in property <string> field-fingerprint-label;
    in property <string> field-secret-ref-label;
    in property <string> field-group-label;
    in property <string> group-caption-label;
    in property <string> view-content-label;
    in property <string> view-private-key-label;
    in property <string> view-certificate-label;
    in property <string> view-password-label;
    in property <string> secret-content;
    in property <string> secret-content-missing-label;
    in property <bool> secret-copy-enabled;
    in property <string> secret-copy-label;
    in property <string> secret-copy-success-label;
    in property <string> secret-copy-failed-label;
    in property <string> edit-label;
    in property <string> edit-private-key-label;
    in property <string> edit-certificate-label;
    in property <string> edit-password-label;
    in property <string> compile-label;
    callback copy-secret-content(content: string) -> bool;
    callback select-credential(id: string, name: string, group-id: string, group-path: string, kind: string, kind-key: string, username: string, secret-ref: string, secret-available: bool, algorithm: string, algorithm-key: string, fingerprint: string, meta: string, icon-key: string, node-kind: string, accent-index: int);
    callback edit-credential(credential-id: string, name: string, group-id: string, group-path: string, kind-key: string, algorithm-key: string);
    callback compile-certificate(group-id: string, group-path: string);

    property <bool> secret-content-revealed: false;
    property <bool> certificate-action-visible: false;
    property <bool> credential-action-visible: root.selected-credential-node-kind == "Credential";
    property <bool> header-actions-visible: root.certificate-action-visible;
    property <string> header-caption: root.selected-credential-node-kind == "Credential" ? root.selected-credential-group-path : root.selected-credential-node-kind == "CredentialGroup" ? root.selected-credential-group-path : root.group-caption-label;
    property <string> selected-content-label: root.selected-credential-kind-key == "PrivateKey"
        ? root.view-private-key-label
        : root.selected-credential-kind-key == "Certificate"
            ? root.view-certificate-label
            : root.selected-credential-kind-key == "Password"
                ? root.view-password-label
                : root.view-content-label;
    property <string> selected-edit-label: root.selected-credential-kind-key == "PrivateKey"
        ? root.edit-private-key-label
        : root.selected-credential-kind-key == "Certificate"
            ? root.edit-certificate-label
            : root.selected-credential-kind-key == "Password"
                ? root.edit-password-label
                : root.edit-label;

    changed selected-credential-id => {
        root.secret-content-revealed = false;
    }

    changed secret-content => {
        root.secret-content-revealed = false;
    }

    background: AppTheme.window-bg;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 0px;
        spacing: 8px;

        Text {
            text: root.title-label;
            color: AppTheme.text-strong;
            font-size: 15px;
            font-weight: 700;
        }

        if root.selected-credential-id == "": Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.card-bg;

            VerticalLayout {
                padding: 18px;
                spacing: 6px;

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.empty-title-label;
                    color: AppTheme.text-strong;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.empty-caption-label;
                    color: AppTheme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        if root.selected-credential-id != "": Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border-soft;
            background: AppTheme.card-bg;
            clip: true;

            detail-layout := VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 0px;
                    padding-right: 0px;
                    padding-top: 0px;
                    padding-bottom: 0px;
                    spacing: 0px;

                    Rectangle {
                        height: root.header-actions-visible ? 86px : 58px;
                        border-radius: 0px;
                        border-width: 0px;
                        background: AppTheme.transparent;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                HostIcon {
                                    icon-key: root.selected-credential-icon-key;
                                    accent-index: root.selected-credential-accent-index;
                                    status-key: "Created";
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;

                                    Text {
                                        text: root.selected-credential-name;
                                        color: AppTheme.text-strong;
                                        font-size: 16px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.header-caption;
                                        color: AppTheme.text-muted;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    width: 96px;
                                    height: 24px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: AppTheme.border-soft;
                                    background: AppTheme.surface-bg;

                                    Text {
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        text: root.selected-credential-kind;
                                        color: AppTheme.text-muted;
                                        font-size: 10px;
                                        font-weight: 700;
                                        overflow: elide;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.header-actions-visible: HorizontalLayout {
                                height: 24px;
                                spacing: 8px;

                                Rectangle { horizontal-stretch: 1; }

                                if root.certificate-action-visible: CompactButton {
                                    label: root.compile-label;
                                    tone: "primary";
                                    clicked => {
                                        root.compile-certificate(
                                            root.selected-credential-node-kind == "CredentialGroup" ? root.selected-credential-id : root.selected-credential-group-id,
                                            root.selected-credential-group-path,
                                        );
                                    }
                                }

                            }
                        }
                    }

                    Rectangle { height: 1px; background: AppTheme.border-soft; }

                    if root.selected-credential-node-kind == "Group" || root.selected-credential-node-kind == "CredentialGroup": VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 0px;

                                for content in root.credential-group-contents: SecurityGroupContentItem {
                                    content: content;
                                    active-parent-id: root.selected-credential-id;
                                    selected-id: root.selected-credential-id;
                                    selected(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index) => {
                                        root.select-credential(id, name, group-id, group-path, kind, kind-key, username, secret-ref, secret-available, algorithm, algorithm-key, fingerprint, meta, icon-key, node-kind, accent-index);
                                    }
                                }
                            }
                        }
                    }

                    if root.selected-credential-node-kind == "Credential": VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        Rectangle {
                            height: max(120px, detail-fields-layout.preferred-height);
                            background: AppTheme.transparent;

                            detail-fields-layout := GridLayout {
                                width: parent.width;
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;

                                for field in root.credential-detail-fields: CredentialDetailField {
                                    row: field.row;
                                    col: field.col;
                                    active: field.credential_id == root.selected-credential-id;
                                    label: field.label;
                                    value: field.value;
                                    copy-value(value) => { root.copy-secret-content(value) }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: AppTheme.border-soft; }

                        if root.secret-content != "": CredentialSecretContentBlock {
                            vertical-stretch: 1;
                            label: root.selected-content-label;
                            content: root.secret-content;
                            revealed: root.secret-content-revealed;
                            missing: root.secret-content == root.secret-content-missing-label;
                            toggle-enabled: root.secret-content != "" && root.secret-content != root.secret-content-missing-label;
                            copy-label: root.secret-copy-label;
                            copy-success-label: root.secret-copy-success-label;
                            copy-failed-label: root.secret-copy-failed-label;
                            edit-label: root.selected-edit-label;
                            copy-enabled: root.secret-copy-enabled;
                            edit-enabled: true;
                            toggle-secret() => { root.secret-content-revealed = !root.secret-content-revealed; }
                            copy-content(content) => { root.copy-secret-content(content) }
                            edit-content() => {
                                root.edit-credential(
                                    root.selected-credential-id,
                                    root.selected-credential-name,
                                    root.selected-credential-group-id,
                                    root.selected-credential-group-path,
                                    root.selected-credential-kind-key,
                                    root.selected-credential-algorithm-key,
                                );
                            }
                        }
                    }
            }
        }
    }
}
