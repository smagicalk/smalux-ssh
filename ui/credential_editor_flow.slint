import { CredentialRow } from "./models.slint";
import { CredentialGroupPickerDialog } from "./credential_group_dialogs.slint";
import { CreateSecurityCredentialDialog } from "./credential_editor_dialogs.slint";

export component CredentialEditorFlow inherits Rectangle {
    in-out property <bool> create-security-credential-dialog-open;
    in-out property <bool> security-credential-group-picker-open;
    in-out property <string> quick-security-credential-name;
    in-out property <string> quick-security-credential-secret-ref;
    in-out property <string> quick-security-credential-algorithm;
    in-out property <string> quick-security-credential-group-id;
    in-out property <string> quick-security-credential-group-path;
    in-out property <string> quick-security-credential-kind-key;
    in-out property <bool> quick-security-credential-import-mode;
    in-out property <string> quick-security-credential-import-source-key;
    in-out property <string> quick-security-credential-edit-id;
    in-out property <bool> quick-security-credential-save-ok;
    in-out property <bool> quick-security-credential-busy;
    in-out property <bool> quick-security-credential-generate-pending;
    in-out property <int> quick-security-credential-busy-frame;
    in-out property <string> selected-credential-id;
    in-out property <string> selected-credential-name;
    in-out property <string> selected-credential-group-id;
    in-out property <string> selected-credential-group-path;
    in-out property <string> selected-credential-algorithm-key;
    in property <bool> quick-security-certificate-mode;
    in property <bool> quick-security-password-mode;
    in property <bool> quick-security-agent-mode;
    in property <[CredentialRow]> credential-rows;
    in property <string> security-credential-edit-label;
    in property <string> security-certificate-import-title-label;
    in property <string> security-certificate-create-title-label;
    in property <string> security-password-create-title-label;
    in property <string> security-agent-create-title-label;
    in property <string> security-private-key-import-title-label;
    in property <string> security-private-key-create-title-label;
    in property <string> security-credential-name-label;
    in property <string> security-credential-name-placeholder;
    in property <string> security-field-group-label;
    in property <string> security-credential-replace-secret-field-label;
    in property <string> security-credential-replace-secret-placeholder;
    in property <string> security-certificate-source-label;
    in property <string> security-private-key-source-label;
    in property <string> security-password-secret-label;
    in property <string> security-agent-secret-label;
    in property <string> security-credential-secret-label;
    in property <string> security-password-secret-placeholder;
    in property <string> security-certificate-source-placeholder;
    in property <string> security-private-key-source-placeholder;
    in property <string> security-certificate-secret-placeholder;
    in property <string> security-agent-secret-placeholder;
    in property <string> security-private-key-secret-placeholder;
    in property <string> security-credential-algorithm-label;
    in property <string> security-private-key-import-file-label;
    in property <string> security-private-key-import-text-label;
    in property <string> security-private-key-text-label;
    in property <string> security-private-key-text-placeholder;
    in property <string> security-certificate-text-label;
    in property <string> security-certificate-text-placeholder;
    in property <string> security-password-show-label;
    in property <string> security-password-hide-label;
    in property <string> settings-choose-file-label;
    in property <string> create-group-cancel-label;
    in property <string> security-credential-save-label;
    in property <string> security-credential-generating-private-key-label;
    callback choose-security-credential-file-path(current-path: string) -> string;
    callback update-credential-secret(credential-id: string, secret-text: string) -> bool;
    callback update-credential-metadata(credential-id: string, name: string, group-id: string, algorithm: string) -> bool;
    callback import-certificate-text-credential(name: string, group-id: string, certificate-text: string, algorithm: string) -> bool;
    callback import-certificate-credential(name: string, group-id: string, source-path: string, algorithm: string) -> bool;
    callback import-private-key-text-credential(name: string, group-id: string, private-key-text: string, algorithm: string) -> bool;
    callback import-private-key-credential(name: string, group-id: string, source-path: string, algorithm: string) -> bool;
    callback save-password-credential(name: string, group-id: string, password: string) -> bool;
    callback create-credential-metadata(kind: string, name: string, group-id: string, secret-ref: string, algorithm: string) -> bool;

    if root.create-security-credential-dialog-open: CreateSecurityCredentialDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.quick-security-credential-edit-id != "" ? root.security-credential-edit-label : root.quick-security-certificate-mode ? (root.quick-security-credential-import-mode ? root.security-certificate-import-title-label : root.security-certificate-create-title-label) : root.quick-security-password-mode ? root.security-password-create-title-label : root.quick-security-agent-mode ? root.security-agent-create-title-label : (root.quick-security-credential-import-mode ? root.security-private-key-import-title-label : root.security-private-key-create-title-label);
        name-label: root.security-credential-name-label;
        name-placeholder: root.security-credential-name-placeholder;
        group-label: root.security-field-group-label;
        group-path: root.quick-security-credential-group-path;
        secret-label: root.quick-security-credential-edit-id != "" ? root.security-credential-replace-secret-field-label : root.quick-security-credential-import-mode ? (root.quick-security-certificate-mode ? root.security-certificate-source-label : root.security-private-key-source-label) : root.quick-security-password-mode ? root.security-password-secret-label : root.quick-security-agent-mode ? root.security-agent-secret-label : root.security-credential-secret-label;
        secret-placeholder: root.quick-security-credential-edit-id != "" ? (root.quick-security-password-mode ? root.security-password-secret-placeholder : root.security-credential-replace-secret-placeholder) : root.quick-security-credential-import-mode ? (root.quick-security-certificate-mode ? root.security-certificate-source-placeholder : root.security-private-key-source-placeholder) : root.quick-security-certificate-mode ? root.security-certificate-secret-placeholder : root.quick-security-password-mode ? root.security-password-secret-placeholder : root.quick-security-agent-mode ? root.security-agent-secret-placeholder : root.security-private-key-secret-placeholder;
        algorithm-label: root.security-credential-algorithm-label;
        credential-name: root.quick-security-credential-name;
        secret-ref: root.quick-security-credential-secret-ref;
        algorithm: root.quick-security-credential-algorithm;
        edit-mode: root.quick-security-credential-edit-id != "";
        import-mode: root.quick-security-credential-import-mode;
        text-import-mode: root.quick-security-credential-import-mode && (root.quick-security-credential-kind-key == "PrivateKey" || root.quick-security-certificate-mode);
        certificate-mode: root.quick-security-certificate-mode;
        import-source-key: root.quick-security-credential-import-source-key;
        import-file-label: root.security-private-key-import-file-label;
        import-text-label: root.security-private-key-import-text-label;
        private-key-text-label: root.security-private-key-text-label;
        private-key-text-placeholder: root.security-private-key-text-placeholder;
        certificate-text-label: root.security-certificate-text-label;
        certificate-text-placeholder: root.security-certificate-text-placeholder;
        show-algorithm: root.quick-security-credential-edit-id != "" || (!root.quick-security-credential-import-mode && (root.quick-security-credential-kind-key == "PrivateKey" || root.quick-security-credential-kind-key == "Certificate"));
        password-mode: root.quick-security-password-mode;
        password-show-label: root.security-password-show-label;
        password-hide-label: root.security-password-hide-label;
        generated-private-key-mode: root.quick-security-credential-edit-id == "" && root.quick-security-credential-kind-key == "PrivateKey" && !root.quick-security-credential-import-mode;
        choose-file-label: root.settings-choose-file-label;
        cancel-label: root.create-group-cancel-label;
        save-label: root.security-credential-save-label;
        busy: root.quick-security-credential-busy;
        busy-label: root.security-credential-generating-private-key-label;
        busy-frame: root.quick-security-credential-busy-frame;
        update-name(value) => { root.quick-security-credential-name = value; }
        open-group-picker => { root.security-credential-group-picker-open = true; }
        update-secret-ref(value) => { root.quick-security-credential-secret-ref = value; }
        update-algorithm(value) => { root.quick-security-credential-algorithm = value; }
        update-import-source(value) => {
            root.quick-security-credential-import-source-key = value;
            root.quick-security-credential-secret-ref = "";
        }
        choose-file => {
            root.quick-security-credential-secret-ref = root.choose-security-credential-file-path(root.quick-security-credential-secret-ref);
        }
        save => {
            root.quick-security-credential-save-ok = false;
            if root.quick-security-credential-edit-id != "" {
                if root.quick-security-credential-secret-ref != "" {
                    if !root.update-credential-secret(
                        root.quick-security-credential-edit-id,
                        root.quick-security-credential-secret-ref,
                    ) {
                        return;
                    }
                }
                root.quick-security-credential-save-ok = root.update-credential-metadata(
                    root.quick-security-credential-edit-id,
                    root.quick-security-credential-name,
                    root.quick-security-credential-group-id,
                    root.quick-security-credential-algorithm,
                );
            } else if root.quick-security-credential-import-mode {
                if root.quick-security-certificate-mode {
                    if root.quick-security-credential-import-source-key == "Text" {
                        root.quick-security-credential-save-ok = root.import-certificate-text-credential(
                            root.quick-security-credential-name,
                            root.quick-security-credential-group-id,
                            root.quick-security-credential-secret-ref,
                            "",
                        );
                    } else {
                        root.quick-security-credential-save-ok = root.import-certificate-credential(
                            root.quick-security-credential-name,
                            root.quick-security-credential-group-id,
                            root.quick-security-credential-secret-ref,
                            "",
                        );
                    }
                } else if root.quick-security-credential-import-source-key == "Text" {
                    root.quick-security-credential-save-ok = root.import-private-key-text-credential(
                        root.quick-security-credential-name,
                        root.quick-security-credential-group-id,
                        root.quick-security-credential-secret-ref,
                        "",
                    );
                } else {
                    root.quick-security-credential-save-ok = root.import-private-key-credential(
                        root.quick-security-credential-name,
                        root.quick-security-credential-group-id,
                        root.quick-security-credential-secret-ref,
                        "",
                    );
                }
            } else if root.quick-security-password-mode {
                root.quick-security-credential-save-ok = root.save-password-credential(
                    root.quick-security-credential-name,
                    root.quick-security-credential-group-id,
                    root.quick-security-credential-secret-ref,
                );
            } else if root.quick-security-credential-kind-key == "PrivateKey" {
                root.quick-security-credential-busy = true;
                root.quick-security-credential-generate-pending = true;
                root.quick-security-credential-busy-frame = 0;
                return;
            } else {
                root.quick-security-credential-save-ok = root.create-credential-metadata(
                    root.quick-security-credential-kind-key,
                    root.quick-security-credential-name,
                    root.quick-security-credential-group-id,
                    root.quick-security-credential-secret-ref,
                    root.quick-security-credential-algorithm,
                );
            }
            if !root.quick-security-credential-save-ok {
                return;
            }
            if root.quick-security-credential-edit-id != "" {
                root.selected-credential-id = "credential:" + root.quick-security-credential-name;
                root.selected-credential-name = root.quick-security-credential-name;
                root.selected-credential-group-id = root.quick-security-credential-group-id;
                root.selected-credential-group-path = root.quick-security-credential-group-path;
                root.selected-credential-algorithm-key = root.quick-security-credential-algorithm;
            }
            root.create-security-credential-dialog-open = false;
            root.security-credential-group-picker-open = false;
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-credential-import-mode = false;
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-edit-id = "";
            root.quick-security-credential-busy = false;
            root.quick-security-credential-generate-pending = false;
            root.quick-security-credential-busy-frame = 0;
        }
        close => {
            if root.quick-security-credential-busy {
                return;
            }
            root.create-security-credential-dialog-open = false;
            root.security-credential-group-picker-open = false;
            root.quick-security-credential-name = "";
            root.quick-security-credential-secret-ref = "";
            root.quick-security-credential-algorithm = "Ed25519";
            root.quick-security-credential-group-id = "";
            root.quick-security-credential-group-path = "";
            root.quick-security-credential-kind-key = "PrivateKey";
            root.quick-security-credential-import-mode = false;
            root.quick-security-credential-import-source-key = "File";
            root.quick-security-credential-edit-id = "";
            root.quick-security-credential-busy = false;
            root.quick-security-credential-generate-pending = false;
            root.quick-security-credential-busy-frame = 0;
        }
    }

    if root.security-credential-group-picker-open: CredentialGroupPickerDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title-label: root.security-field-group-label;
        current-kind-key: root.quick-security-credential-kind-key;
        selected-group-id: root.quick-security-credential-group-id;
        credentials: root.credential-rows;
        close-label: root.create-group-cancel-label;
        select-group(id, path) => {
            root.quick-security-credential-group-id = id;
            root.quick-security-credential-group-path = path;
            root.security-credential-group-picker-open = false;
        }
        close => { root.security-credential-group-picker-open = false; }
    }
}
