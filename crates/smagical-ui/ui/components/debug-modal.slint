import { AppTheme } from "../themes/app-theme.slint";
import { AppIconButton } from "base/app-icon-button.slint";
import { DebugBatchTab } from "debug_workbench/debug-batch-tab.slint";
import { DebugPresetTab } from "debug_workbench/debug-preset-tab.slint";
import { DebugCrudTab } from "debug_workbench/debug-crud-tab.slint";
import { DebugLogsTab, LogEntryData } from "debug_workbench/debug-logs-tab.slint";
import { DebugInspectorTab } from "debug_workbench/debug-inspector-tab.slint";



export { LogEntryData }

/// 开发者全功能独立调试与批量数据生成模态弹窗 (Debug Modal)
export component DebugModal inherits Rectangle {
    /// 弹窗显隐状态
    in-out property <bool> is-open: false;

    /// 日志条目列表
    in property <[LogEntryData]> logs: [];
    /// 全量节点数
    in property <int> total-nodes-count: 0;
    /// 可见节点数
    in property <int> visible-nodes-count: 0;
    /// 卡片总数
    in property <int> host-cards-count: 0;
    /// 树形视口计算宽度
    in property <length> tree-viewport-width: 240px;
    /// 当前主题名称
    in property <string> current-theme-name: "Darcula";
    /// 是否为深色模式
    in property <bool> is-dark-mode: true;

    // 当前激活的子面板: "batch" | "presets" | "crud" | "logs" | "inspector"
    property <string> active-subtab: "batch";

    // --- 回调事件 ---
    callback close();
    /// 批量生成主机 (prefix, count_str, ip_prefix, start_ip_str, port_str, group, status_mode, overwrite)
    callback batch-generate(string, string, string, string, string, string, string, bool);
    /// 批量更新状态 (status_mode: "all_online", "all_warning", "all_offline", "random")
    callback batch-update-status(string);
    /// 批量更新端口 (new_port_str)
    callback batch-update-port(string);
    /// 注入预设
    callback inject-preset(string);
    /// 快速新增主机
    callback quick-add-host(string, string, string, string);
    /// 快速新增分组
    callback quick-add-group(string, string);
    /// 清空全量数据
    callback clear-all-data();
    /// 恢复默认数据
    callback reset-default-data();
    /// 清空日志
    callback clear-logs();
    /// 模拟测试日志
    callback emit-test-log(string);
    /// 切换配色主题
    callback switch-theme(string);
    /// 切换深浅色
    callback toggle-color-mode();

    if is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088; // 半透明暗色背景遮罩

        TouchArea {
            // 拦截遮罩点击，防止穿透底层
        }

        // =========================================================================
        // 主弹窗卡片 (780x560px 居中大窗)
        // =========================================================================
        Rectangle {
            width: 780px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // 1. 标题栏 + 关闭按钮
                HorizontalLayout {
                    alignment: space-between;
                    height: 28px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/bug.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("开发者调试与数据控制台");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        // 状态胶囊
                        Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: AppTheme.hover-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: @tr("主机数: ") + root.host-cards-count + @tr(" | 节点: ") + root.visible-nodes-count;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 关闭按钮
                    AppIconButton {
                        icon: @image-url("../assets/icons/window-close.svg");
                        clicked => { root.close(); }
                    }
                }


                // 2. 顶部子标签切换导航栏
                HorizontalLayout {
                    spacing: 6px;
                    height: 32px;

                    // 选项 1: 批量生成与修改
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "batch" ? AppTheme.accent : (b-tab1.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "batch" ? AppTheme.accent : AppTheme.border;

                        b-tab1 := TouchArea {
                            clicked => { root.active-subtab = "batch"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/zap.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "batch" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("批量生成/修改");
                                font-size: 11px;
                                font-weight: root.active-subtab == "batch" ? 600 : 500;
                                color: root.active-subtab == "batch" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 2: 场景预设
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "presets" ? AppTheme.accent : (b-tab2.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "presets" ? AppTheme.accent : AppTheme.border;

                        b-tab2 := TouchArea {
                            clicked => { root.active-subtab = "presets"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/sparkles.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "presets" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("场景预设");
                                font-size: 11px;
                                font-weight: root.active-subtab == "presets" ? 600 : 500;
                                color: root.active-subtab == "presets" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 3: 单项 CRUD
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "crud" ? AppTheme.accent : (b-tab3.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "crud" ? AppTheme.accent : AppTheme.border;

                        b-tab3 := TouchArea {
                            clicked => { root.active-subtab = "crud"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "crud" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("单项增删改");
                                font-size: 11px;
                                font-weight: root.active-subtab == "crud" ? 600 : 500;
                                color: root.active-subtab == "crud" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 4: 实时日志流
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "logs" ? AppTheme.accent : (b-tab4.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "logs" ? AppTheme.accent : AppTheme.border;

                        b-tab4 := TouchArea {
                            clicked => { root.active-subtab = "logs"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/file-text.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "logs" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("实时日志流");
                                font-size: 11px;
                                font-weight: root.active-subtab == "logs" ? 600 : 500;
                                color: root.active-subtab == "logs" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 5: 运行时探针
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "inspector" ? AppTheme.accent : (b-tab5.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "inspector" ? AppTheme.accent : AppTheme.border;

                        b-tab5 := TouchArea {
                            clicked => { root.active-subtab = "inspector"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/activity.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "inspector" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("运行时探针");
                                font-size: 11px;
                                font-weight: root.active-subtab == "inspector" ? 600 : 500;
                                color: root.active-subtab == "inspector" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                // 3. 内容主体区 (动态切换渲染 5 个子组件)
                Rectangle {
                    height: 440px;
                    width: 100%;

                    if root.active-subtab == "batch": DebugBatchTab {
                        batch-generate(p, cnt, ip_p, s_ip, port, grp, st, ovr) => { root.batch-generate(p, cnt, ip_p, s_ip, port, grp, st, ovr); }
                        batch-update-status(st) => { root.batch-update-status(st); }
                        batch-update-port(p) => { root.batch-update-port(p); }
                        reset-default-data => { root.reset-default-data(); }
                        clear-all-data => { root.clear-all-data(); }
                    }

                    if root.active-subtab == "presets": DebugPresetTab {
                        inject-preset(id) => { root.inject-preset(id); }
                    }

                    if root.active-subtab == "crud": DebugCrudTab {
                        current-theme-name: root.current-theme-name;
                        is-dark-mode: root.is-dark-mode;
                        quick-add-host(n, ip, p, g) => { root.quick-add-host(n, ip, p, g); }
                        quick-add-group(n, p) => { root.quick-add-group(n, p); }
                        switch-theme(id) => { root.switch-theme(id); }
                        toggle-color-mode => { root.toggle-color-mode(); }
                        clear-all-data => { root.clear-all-data(); }
                        reset-default-data => { root.reset-default-data(); }
                    }

                    if root.active-subtab == "logs": DebugLogsTab {
                        logs: root.logs;
                        clear-logs => { root.clear-logs(); }
                        emit-test-log(lvl) => { root.emit-test-log(lvl); }
                    }

                    if root.active-subtab == "inspector": DebugInspectorTab {
                        tree-viewport-width: root.tree-viewport-width;
                        total-nodes-count: root.total-nodes-count;
                        visible-nodes-count: root.visible-nodes-count;
                        host-cards-count: root.host-cards-count;
                        current-theme-name: root.current-theme-name;
                        is-dark-mode: root.is-dark-mode;
                        switch-theme(id) => { root.switch-theme(id); }
                        toggle-color-mode => { root.toggle-color-mode(); }
                    }

                }
            }
        }
    }
}
