import { AppTheme } from "../themes/app-theme.slint";
import { HostTreeNode } from "../views/left_drawers/hosts_drawer.slint";

/// 调试控制台日志条目模型 (Log Entry Data)
export struct LogEntryData {
    timestamp: string,
    level: string,
    module: string,
    message: string,
}

/// 开发者全功能独立调试与批量数据生成模态弹窗 (Debug Modal)
export component DebugModal inherits Rectangle {
    /// 弹窗显隐状态
    in-out property <bool> is-open: false;

    /// 日志条目列表
    in property <[LogEntryData]> logs: [];
    /// 全量节点数
    in property <int> total-nodes-count: 0;
    /// 可见节点数
    in property <int> visible-nodes-count: 0;
    /// 卡片总数
    in property <int> host-cards-count: 0;
    /// 树形视口计算宽度
    in property <length> tree-viewport-width: 240px;
    /// 当前主题名称
    in property <string> current-theme-name: "Darcula";
    /// 是否为深色模式
    in property <bool> is-dark-mode: true;

    // 当前激活的子面板: "batch" | "presets" | "crud" | "logs" | "inspector"
    property <string> active-subtab: "batch";

    // --- 批量生成参数 ---
    property <string> batch-prefix: "k8s-node-";
    property <string> batch-count-str: "15";
    property <string> batch-start-ip-str: "10";
    property <string> batch-ip-prefix: "192.168.1.";
    property <string> batch-port-str: "22";
    property <string> batch-group: "集群/k8s";
    property <string> batch-status-mode: "random"; // "online", "warning", "offline", "random"

    // --- 批量修改参数 ---
    property <string> batch-new-port-str: "2222";

    // --- 快速新增参数 ---
    property <string> quick-host-name: "";
    property <string> quick-host-ip: "192.168.1.50";
    property <string> quick-host-port: "22";
    property <string> quick-host-group: "生产集群/核心库";
    property <string> quick-group-name: "";

    // --- 日志过滤等级 ---
    property <string> log-filter-level: "ALL";

    // --- 回调事件 ---
    callback close();
    /// 批量生成主机 (prefix, count_str, ip_prefix, start_ip_str, port_str, group, status_mode, overwrite)
    callback batch-generate(string, string, string, string, string, string, string, bool);
    /// 批量更新状态 (status_mode: "all_online", "all_warning", "all_offline", "random")
    callback batch-update-status(string);
    /// 批量更新端口 (new_port_str)
    callback batch-update-port(string);
    /// 注入预设
    callback inject-preset(string);
    /// 快速新增主机
    callback quick-add-host(string, string, string, string);
    /// 快速新增分组
    callback quick-add-group(string, string);
    /// 清空全量数据
    callback clear-all-data();
    /// 恢复默认数据
    callback reset-default-data();
    /// 清空日志
    callback clear-logs();
    /// 模拟测试日志
    callback emit-test-log(string);
    /// 切换配色主题
    callback switch-theme(string);
    /// 切换深浅色
    callback toggle-color-mode();

    if is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088; // 半透明暗色背景遮罩

        TouchArea {
            // 拦截遮罩点击，防止穿透底层
        }

        // =========================================================================
        // 主弹窗卡片 (780x560px 居中大窗)
        // =========================================================================
        Rectangle {
            width: 780px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // 1. 标题栏 + 关闭按钮
                HorizontalLayout {
                    alignment: space-between;
                    height: 28px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/bug.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("开发者调试与数据控制台");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        // 状态胶囊
                        Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: AppTheme.hover-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: @tr("主机数: ") + root.host-cards-count + @tr(" | 节点: ") + root.visible-nodes-count;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 关闭按钮
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? AppTheme.hover-background : transparent;

                        close-touch := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../assets/icons/window-close.svg");
                            width: 10px;
                            height: 10px;
                            image-fit: contain;
                            colorize: close-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // 2. 顶部子标签切换导航栏
                HorizontalLayout {
                    spacing: 6px;
                    height: 32px;

                    // 选项 1: 批量生成与修改
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "batch" ? AppTheme.accent : (b-tab1.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "batch" ? AppTheme.accent : AppTheme.border;

                        b-tab1 := TouchArea {
                            clicked => { root.active-subtab = "batch"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/zap.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "batch" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("批量生成/修改");
                                font-size: 11px;
                                font-weight: root.active-subtab == "batch" ? 600 : 500;
                                color: root.active-subtab == "batch" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 2: 场景预设
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "presets" ? AppTheme.accent : (b-tab2.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "presets" ? AppTheme.accent : AppTheme.border;

                        b-tab2 := TouchArea {
                            clicked => { root.active-subtab = "presets"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/sparkles.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "presets" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("场景预设");
                                font-size: 11px;
                                font-weight: root.active-subtab == "presets" ? 600 : 500;
                                color: root.active-subtab == "presets" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 3: 单项 CRUD
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "crud" ? AppTheme.accent : (b-tab3.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "crud" ? AppTheme.accent : AppTheme.border;

                        b-tab3 := TouchArea {
                            clicked => { root.active-subtab = "crud"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "crud" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("单项增删改");
                                font-size: 11px;
                                font-weight: root.active-subtab == "crud" ? 600 : 500;
                                color: root.active-subtab == "crud" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 4: 实时日志
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "logs" ? AppTheme.accent : (b-tab4.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "logs" ? AppTheme.accent : AppTheme.border;

                        b-tab4 := TouchArea {
                            clicked => { root.active-subtab = "logs"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/file-text.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "logs" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("实时日志");
                                font-size: 11px;
                                font-weight: root.active-subtab == "logs" ? 600 : 500;
                                color: root.active-subtab == "logs" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 选项 5: 运行时探针
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "inspector" ? AppTheme.accent : (b-tab5.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "inspector" ? AppTheme.accent : AppTheme.border;

                        b-tab5 := TouchArea {
                            clicked => { root.active-subtab = "inspector"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Image {
                                source: @image-url("../assets/icons/activity.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "inspector" ? #ffffff : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("运行时探针");
                                font-size: 11px;
                                font-weight: root.active-subtab == "inspector" ? 600 : 500;
                                color: root.active-subtab == "inspector" ? #ffffff : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                // 3. 内容主体区 (明确分配 440px 高度)
                Rectangle {
                    height: 440px;
                    width: 100%;

                    // =========================================================
                    // 面板 1: 批量生成与修改 (Batch Generator & Modifier)
                    // =========================================================
                    if root.active-subtab == "batch": HorizontalLayout {
                        spacing: 14px;
                        width: 100%;
                        height: 100%;

                        // 1.1 左半区：批量主机生成器
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    height: 20px;

                                    Image {
                                        source: @image-url("../assets/icons/zap.svg");
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                        colorize: AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: @tr("批量主机生成");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                // 主机名前缀 + 生成数量
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 48px;

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("名称前缀:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-prefix;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("数量 (台):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-count-str;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }
                                }

                                // 快捷数量胶囊 (10 / 20 / 50 / 100)
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 22px;

                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: q10.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        q10 := TouchArea { clicked => { root.batch-count-str = "10"; } mouse-cursor: pointer; }
                                        Text { text: "10 台"; font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: q20.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        q20 := TouchArea { clicked => { root.batch-count-str = "20"; } mouse-cursor: pointer; }
                                        Text { text: "20 台"; font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: q50.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        q50 := TouchArea { clicked => { root.batch-count-str = "50"; } mouse-cursor: pointer; }
                                        Text { text: "50 台"; font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: q100.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        q100 := TouchArea { clicked => { root.batch-count-str = "100"; } mouse-cursor: pointer; }
                                        Text { text: "100 台"; font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                // IP 前缀 + 起始段
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 48px;

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("IP 前缀网段:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-ip-prefix;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("起始 IP 末位:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-start-ip-str;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }
                                }

                                // 目标归属分组 + 端口
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 48px;

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("归属分组路径 (支持 / 嵌套):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-group;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("SSH 端口:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-port-str;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }
                                }

                                // 状态模式选择
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    height: 48px;
                                    Text { text: @tr("状态分配策略:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 26px;

                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: root.batch-status-mode == "random" ? AppTheme.accent : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            st-rand := TouchArea { clicked => { root.batch-status-mode = "random"; } mouse-cursor: pointer; }
                                            Text { text: @tr("混合随机"); font-size: 10px; color: root.batch-status-mode == "random" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: root.batch-status-mode == "online" ? AppTheme.accent : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            st-on := TouchArea { clicked => { root.batch-status-mode = "online"; } mouse-cursor: pointer; }
                                            Text { text: @tr("全部在线"); font-size: 10px; color: root.batch-status-mode == "online" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: root.batch-status-mode == "warning" ? AppTheme.accent : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            st-warn := TouchArea { clicked => { root.batch-status-mode = "warning"; } mouse-cursor: pointer; }
                                            Text { text: @tr("全部告警"); font-size: 10px; color: root.batch-status-mode == "warning" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: root.batch-status-mode == "offline" ? AppTheme.accent : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            st-off := TouchArea { clicked => { root.batch-status-mode = "offline"; } mouse-cursor: pointer; }
                                            Text { text: @tr("全部离线"); font-size: 10px; color: root.batch-status-mode == "offline" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // 按钮栏：生成并追加 / 覆盖生成
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: AppTheme.radius-medium;
                                        background: gen-app-touch.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;

                                        gen-app-touch := TouchArea {
                                            clicked => {
                                                root.batch-generate(
                                                    root.batch-prefix,
                                                    root.batch-count-str,
                                                    root.batch-ip-prefix,
                                                    root.batch-start-ip-str,
                                                    root.batch-port-str,
                                                    root.batch-group,
                                                    root.batch-status-mode,
                                                    false
                                                );
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;

                                            Image {
                                                source: @image-url("../assets/icons/plus.svg");
                                                width: 11px;
                                                height: 11px;
                                                image-fit: contain;
                                                colorize: #ffffff;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                text: @tr("批量追加生成");
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: AppTheme.radius-medium;
                                        background: gen-ovr-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px;
                                        border-color: AppTheme.border;

                                        gen-ovr-touch := TouchArea {
                                            clicked => {
                                                root.batch-generate(
                                                    root.batch-prefix,
                                                    root.batch-count-str,
                                                    root.batch-ip-prefix,
                                                    root.batch-start-ip-str,
                                                    root.batch-port-str,
                                                    root.batch-group,
                                                    root.batch-status-mode,
                                                    true
                                                );
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;

                                            Image {
                                                source: @image-url("../assets/icons/zap.svg");
                                                width: 11px;
                                                height: 11px;
                                                image-fit: contain;
                                                colorize: AppTheme.foreground;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                text: @tr("覆盖并生成");
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 1.2 右半区：批量修改与状态治理 (Batch Modifier)
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    height: 20px;

                                    Image {
                                        source: @image-url("../assets/icons/settings.svg");
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                        colorize: AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: @tr("批量修改与数据治理");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                // 1. 批量状态统一变更
                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    Text { text: @tr("批量修改全量主机在线状态:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: m-on.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            m-on := TouchArea { clicked => { root.batch-update-status("all_online"); } mouse-cursor: pointer; }
                                            Text { text: @tr("全部在线"); font-size: 10px; font-weight: 500; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: m-warn.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            m-warn := TouchArea { clicked => { root.batch-update-status("all_warning"); } mouse-cursor: pointer; }
                                            Text { text: @tr("全部告警"); font-size: 10px; font-weight: 500; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: m-off.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            m-off := TouchArea { clicked => { root.batch-update-status("all_offline"); } mouse-cursor: pointer; }
                                            Text { text: @tr("全部离线"); font-size: 10px; font-weight: 500; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                            background: m-rand.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px; border-color: AppTheme.border;
                                            m-rand := TouchArea { clicked => { root.batch-update-status("random"); } mouse-cursor: pointer; }
                                            Text { text: @tr("随机波动"); font-size: 10px; font-weight: 500; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // 2. 批量修改 SSH 端口
                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    Text { text: @tr("批量重置全量主机端口:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 2;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.batch-new-port-str;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 3;
                                            border-radius: AppTheme.radius-medium;
                                            background: m-port.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                            m-port := TouchArea {
                                                clicked => {
                                                    root.batch-update-port(root.batch-new-port-str);
                                                }
                                                mouse-cursor: pointer;
                                            }
                                            Text { text: @tr("批量更新所有端口"); font-size: 10px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // 3. 全局重置与数据清空
                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Text { text: @tr("重置与清空:"); font-size: 10px; color: AppTheme.secondary-foreground; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 32px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: AppTheme.radius-medium;
                                            background: m-reset.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;

                                            m-reset := TouchArea {
                                                clicked => { root.reset-default-data(); }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 5px;

                                                Image {
                                                    source: @image-url("../assets/icons/sparkles.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    image-fit: contain;
                                                    colorize: AppTheme.foreground;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: @tr("恢复初始 (3台)");
                                                    font-size: 11px;
                                                    color: AppTheme.foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: AppTheme.radius-medium;
                                            background: m-clear.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;

                                            m-clear := TouchArea {
                                                clicked => { root.clear-all-data(); }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 5px;

                                                Image {
                                                    source: @image-url("../assets/icons/window-close.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    image-fit: contain;
                                                    colorize: AppTheme.secondary-foreground;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: @tr("清空全量数据");
                                                    font-size: 11px;
                                                    color: AppTheme.secondary-foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // 面板 2: 场景预设注入 (Presets)
                    // =========================================================
                    if root.active-subtab == "presets": Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: 360px;

                        VerticalLayout {
                            padding: 2px;
                            spacing: 8px;
                            alignment: start;

                            // 预设 1
                            Rectangle {
                                height: 60px;
                                border-radius: AppTheme.radius-large;
                                background: AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("../assets/icons/server.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: AppTheme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: @tr("1. 企业生产全集群预设 (35+ 主机)"); font-size: 12px; font-weight: 600; color: AppTheme.foreground; }
                                            Text { text: @tr("包含生产 Web、K8s 编排、PG/Redis 核心库、大数据与 AI 算力中心"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        }
                                    }

                                    Rectangle {
                                        width: 90px; height: 28px; border-radius: AppTheme.radius-medium;
                                        background: p1-t.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                        p1-t := TouchArea { clicked => { root.inject-preset("rich_clusters"); } mouse-cursor: pointer; }
                                        Text { text: @tr("注入场景"); font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }

                            // 预设 2
                            Rectangle {
                                height: 60px;
                                border-radius: AppTheme.radius-large;
                                background: AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("../assets/icons/server.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: AppTheme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: @tr("2. 极简精简数据预设 (3 台主机)"); font-size: 12px; font-weight: 600; color: AppTheme.foreground; }
                                            Text { text: @tr("验证小数据量下的空状态呈现、滚动条隐藏及轻量加载表现"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        }
                                    }

                                    Rectangle {
                                        width: 90px; height: 28px; border-radius: AppTheme.radius-medium;
                                        background: p2-t.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                        p2-t := TouchArea { clicked => { root.inject-preset("minimal"); } mouse-cursor: pointer; }
                                        Text { text: @tr("注入场景"); font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }

                            // 预设 3
                            Rectangle {
                                height: 60px;
                                border-radius: AppTheme.radius-large;
                                background: AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("../assets/icons/server.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: AppTheme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: @tr("3. 超长命名极限测试 (50+ 字符)"); font-size: 12px; font-weight: 600; color: AppTheme.foreground; }
                                            Text { text: @tr("包含超长主机与微服务集群名称，验证平滑横向滚动与动态视口宽度自适应"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        }
                                    }

                                    Rectangle {
                                        width: 90px; height: 28px; border-radius: AppTheme.radius-medium;
                                        background: p3-t.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                        p3-t := TouchArea { clicked => { root.inject-preset("long_names"); } mouse-cursor: pointer; }
                                        Text { text: @tr("注入场景"); font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }

                            // 预设 4
                            Rectangle {
                                height: 60px;
                                border-radius: AppTheme.radius-large;
                                background: AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("../assets/icons/tree.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: AppTheme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: @tr("4. 极深层级嵌套树 (5 级结构)"); font-size: 12px; font-weight: 600; color: AppTheme.foreground; }
                                            Text { text: @tr("全球基础设施 -> 亚太 -> 杭州可用区 -> 机架 POD -> 刀片计算阵列"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        }
                                    }

                                    Rectangle {
                                        width: 90px; height: 28px; border-radius: AppTheme.radius-medium;
                                        background: p4-t.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                        p4-t := TouchArea { clicked => { root.inject-preset("deep_nested"); } mouse-cursor: pointer; }
                                        Text { text: @tr("注入场景"); font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }

                            // 预设 5
                            Rectangle {
                                height: 60px;
                                border-radius: AppTheme.radius-large;
                                background: AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("../assets/icons/activity.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: AppTheme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: @tr("5. 全告警与离线故障集 (Troubleshooting)"); font-size: 12px; font-weight: 600; color: AppTheme.foreground; }
                                            Text { text: @tr("包含丢包路由、高延迟网关、断电主机及磁盘故障节点"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        }
                                    }

                                    Rectangle {
                                        width: 90px; height: 28px; border-radius: AppTheme.radius-medium;
                                        background: p5-t.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                        p5-t := TouchArea { clicked => { root.inject-preset("faults"); } mouse-cursor: pointer; }
                                        Text { text: @tr("注入场景"); font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // 面板 3: 单项增删改 (Single CRUD) - 使用标准原生 SVG 图标
                    // =========================================================
                    if root.active-subtab == "crud": HorizontalLayout {
                        spacing: 14px;
                        width: 100%;
                        height: 100%;

                        // 快速新增单台主机
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    height: 20px;

                                    Image {
                                        source: @image-url("../assets/icons/server.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: @tr("快速添加单台主机");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                // 主机名称输入框
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    height: 48px;
                                    Text { text: @tr("主机名称:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    Rectangle {
                                        height: 28px;
                                        border-radius: AppTheme.radius-medium;
                                        background: AppTheme.control-background;
                                        border-width: 1px;
                                        border-color: AppTheme.border;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/server.svg");
                                                width: 12px;
                                                height: 12px;
                                                image-fit: contain;
                                                colorize: AppTheme.secondary-foreground;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            TextInput {
                                                text <=> root.quick-host-name;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                // IP + 端口
                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 48px;

                                    VerticalLayout {
                                        horizontal-stretch: 3;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("IP 地址:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;

                                                Image {
                                                    source: @image-url("../assets/icons/terminal.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    image-fit: contain;
                                                    colorize: AppTheme.secondary-foreground;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                TextInput {
                                                    text <=> root.quick-host-ip;
                                                    font-size: 11px;
                                                    color: AppTheme.foreground;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 2px;
                                        alignment: start;
                                        Text { text: @tr("端口:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            TextInput {
                                                text <=> root.quick-host-port;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                x: 6px; width: parent.width - 12px;
                                            }
                                        }
                                    }
                                }

                                // 归属分组路径
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    height: 48px;
                                    Text { text: @tr("归属分组路径 (支持 / 嵌套):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    Rectangle {
                                        height: 28px;
                                        border-radius: AppTheme.radius-medium;
                                        background: AppTheme.control-background;
                                        border-width: 1px;
                                        border-color: AppTheme.border;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/folder.svg");
                                                width: 12px;
                                                height: 12px;
                                                image-fit: contain;
                                                colorize: AppTheme.secondary-foreground;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            TextInput {
                                                text <=> root.quick-host-group;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    border-radius: AppTheme.radius-medium;
                                    background: q-host-btn.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                    q-host-btn := TouchArea {
                                        clicked => {
                                            if root.quick-host-name != "" {
                                                root.quick-add-host(
                                                    root.quick-host-name,
                                                    root.quick-host-ip,
                                                    root.quick-host-port,
                                                    root.quick-host-group
                                                );
                                                root.quick-host-name = "";
                                            }
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/plus.svg");
                                            width: 11px;
                                            height: 11px;
                                            image-fit: contain;
                                            colorize: #ffffff;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: @tr("确认添加主机");
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 快速新增分组
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    height: 20px;

                                    Image {
                                        source: @image-url("../assets/icons/folder-plus.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: @tr("快速添加新分组");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    height: 48px;
                                    Text { text: @tr("分组路径 (支持 / 嵌套，如 生产/k8s):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                    Rectangle {
                                        height: 28px;
                                        border-radius: AppTheme.radius-medium;
                                        background: AppTheme.control-background;
                                        border-width: 1px;
                                        border-color: AppTheme.border;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/folder.svg");
                                                width: 12px;
                                                height: 12px;
                                                image-fit: contain;
                                                colorize: AppTheme.secondary-foreground;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            TextInput {
                                                text <=> root.quick-group-name;
                                                font-size: 11px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    border-radius: AppTheme.radius-medium;
                                    background: q-grp-btn.has-hover ? AppTheme.accent.darker(12%) : AppTheme.accent;
                                    q-grp-btn := TouchArea {
                                        clicked => {
                                            if root.quick-group-name != "" {
                                                root.quick-add-group(root.quick-group-name, "");
                                                root.quick-group-name = "";
                                            }
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/folder-plus.svg");
                                            width: 11px;
                                            height: 11px;
                                            image-fit: contain;
                                            colorize: #ffffff;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: @tr("确认添加分组");
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // 面板 4: 实时日志控制台 (Live Logs)
                    // =========================================================
                    if root.active-subtab == "logs": VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 8px;

                        // 工具栏：等级过滤 + 清空 + 模拟
                        HorizontalLayout {
                            alignment: space-between;
                            height: 26px;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;

                                Rectangle {
                                    width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: root.log-filter-level == "ALL" ? AppTheme.accent : AppTheme.control-background;
                                    TouchArea { clicked => { root.log-filter-level = "ALL"; } mouse-cursor: pointer; }
                                    Text { text: "ALL"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "ALL" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: root.log-filter-level == "INFO" ? AppTheme.accent : AppTheme.control-background;
                                    TouchArea { clicked => { root.log-filter-level = "INFO"; } mouse-cursor: pointer; }
                                    Text { text: "INFO"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "INFO" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: root.log-filter-level == "WARN" ? AppTheme.accent : AppTheme.control-background;
                                    TouchArea { clicked => { root.log-filter-level = "WARN"; } mouse-cursor: pointer; }
                                    Text { text: "WARN"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "WARN" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: root.log-filter-level == "ERROR" ? AppTheme.accent : AppTheme.control-background;
                                    TouchArea { clicked => { root.log-filter-level = "ERROR"; } mouse-cursor: pointer; }
                                    Text { text: "ERR"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "ERROR" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;

                                Rectangle {
                                    width: 86px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: tst-l.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                    border-width: 1px; border-color: AppTheme.border;
                                    tst-l := TouchArea { clicked => { root.emit-test-log("INFO"); } mouse-cursor: pointer; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Image {
                                            source: @image-url("../assets/icons/file-text.svg");
                                            width: 10px;
                                            height: 10px;
                                            image-fit: contain;
                                            colorize: AppTheme.secondary-foreground;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text { text: @tr("模拟日志"); font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    width: 76px; height: 24px; border-radius: AppTheme.radius-small;
                                    background: clr-l.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                    border-width: 1px; border-color: AppTheme.border;
                                    clr-l := TouchArea { clicked => { root.clear-logs(); } mouse-cursor: pointer; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Image {
                                            source: @image-url("../assets/icons/window-close.svg");
                                            width: 8px;
                                            height: 8px;
                                            image-fit: contain;
                                            colorize: AppTheme.secondary-foreground;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text { text: @tr("清空日志"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // 日志滚动视图
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: AppTheme.radius-medium;
                            background: AppTheme.control-background.darker(15%);
                            border-width: 1px;
                            border-color: AppTheme.border;

                            Flickable {
                                width: 100%;
                                height: 100%;
                                viewport-height: root.logs.length * 24px + 10px;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 3px;
                                    alignment: start;

                                    for entry[i] in root.logs: Rectangle {
                                        height: 22px;
                                        border-radius: 2px;
                                        background: Math.mod(i, 2) == 0 ? AppTheme.hover-background.transparentize(60%) : transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            alignment: start;

                                            // 时间戳
                                            Text {
                                                text: entry.timestamp;
                                                font-size: 10px;
                                                color: AppTheme.secondary-foreground;
                                                vertical-alignment: center;
                                                font-family: "Consolas, monospace";
                                            }

                                            // 级别徽章
                                            Rectangle {
                                                width: 42px;
                                                height: 16px;
                                                border-radius: 2px;
                                                background: AppTheme.hover-background;
                                                y: (parent.height - self.height) / 2;

                                                Text {
                                                    text: entry.level;
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: AppTheme.foreground;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // 模块标签
                                            Text {
                                                text: "[" + entry.module + "]";
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: AppTheme.accent;
                                                vertical-alignment: center;
                                            }

                                            // 日志消息
                                            Text {
                                                text: entry.message;
                                                font-size: 10px;
                                                color: AppTheme.foreground;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // 面板 5: 运行时探针 (Inspector)
                    // =========================================================
                    if root.active-subtab == "inspector": VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            height: 110px;
                            width: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Image {
                                        source: @image-url("../assets/icons/activity.svg");
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                        colorize: AppTheme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: @tr("GUI 布局与数据探针指标");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px; alignment: start;
                                        Text { text: @tr("全量节点总数:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Text { text: "" + root.total-nodes-count; font-size: 16px; font-weight: 700; color: AppTheme.foreground; }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px; alignment: start;
                                        Text { text: @tr("当前展开可见数:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Text { text: "" + root.visible-nodes-count; font-size: 16px; font-weight: 700; color: AppTheme.accent; }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px; alignment: start;
                                        Text { text: @tr("全量卡片总数:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Text { text: "" + root.host-cards-count; font-size: 16px; font-weight: 700; color: AppTheme.foreground; }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px; alignment: start;
                                        Text { text: @tr("树视口测算宽度:"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                        Text { text: "" + (root.tree-viewport-width / 1px) + " px"; font-size: 16px; font-weight: 700; color: AppTheme.foreground; }
                                    }
                                }
                            }
                        }

                        // 配色与主题快切
                        Rectangle {
                            height: 110px;
                            width: 100%;
                            border-radius: AppTheme.radius-large;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: @tr("主题切换与外观治理 (当前: ") + root.current-theme-name + ")"; font-size: 12px; font-weight: 600; color: AppTheme.foreground; }

                                    Rectangle {
                                        width: 80px; height: 24px; border-radius: AppTheme.radius-small;
                                        background: t-tg.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        t-tg := TouchArea { clicked => { root.toggle-color-mode(); } mouse-cursor: pointer; }
                                        Text { text: root.is-dark-mode ? @tr("浅色模式") : @tr("深色模式"); font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 30px;

                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: th1.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        th1 := TouchArea { clicked => { root.switch-theme("builtin.ui.darcula"); } mouse-cursor: pointer; }
                                        Text { text: "Darcula"; font-size: 11px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: th2.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        th2 := TouchArea { clicked => { root.switch-theme("builtin.ui.monokai"); } mouse-cursor: pointer; }
                                        Text { text: "Monokai"; font-size: 11px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: th3.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        th3 := TouchArea { clicked => { root.switch-theme("builtin.ui.onedark"); } mouse-cursor: pointer; }
                                        Text { text: "One Dark"; font-size: 11px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: th4.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        th4 := TouchArea { clicked => { root.switch-theme("builtin.ui.solarized-dark"); } mouse-cursor: pointer; }
                                        Text { text: "Solarized"; font-size: 11px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                                        background: th5.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        th5 := TouchArea { clicked => { root.switch-theme("builtin.ui.github-light"); } mouse-cursor: pointer; }
                                        Text { text: "GitHub Light"; font-size: 11px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
