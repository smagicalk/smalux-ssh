import { AppTheme } from "../themes/app-theme.slint";

/// 通用右键上下文菜单项
export component ContextMenuItem inherits Rectangle {
    in property <string> item-id: "";
    in property <string> title: "";
    in property <image> icon;
    in property <string> shortcut: "";
    in property <bool> is-danger: false;
    in property <bool> is-disabled: false;
    in property <bool> is-separator: false;

    callback clicked(string /* item_id */);

    height: root.is-separator ? 7px : 24px;

    if root.is-separator: Rectangle {
        width: 100%;
        height: 7px;
        Rectangle {
            x: 6px;
            y: 3px;
            width: parent.width - 12px;
            height: 1px;
            background: #555860;
        }
    }

    if !root.is-separator: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        background: (!root.is-disabled && item-touch.has-hover) ? AppTheme.hover-background : transparent;
        opacity: root.is-disabled ? 0.4 : 1.0;

        item-touch := TouchArea {
            clicked => {
                if !root.is-disabled {
                    root.clicked(root.item-id);
                }
            }
            mouse-cursor: root.is-disabled ? default : pointer;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            if root.icon.width > 0: VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon;
                    width: 12px;
                    height: 12px;
                    image-fit: contain;
                    colorize: root.is-danger ? (item-touch.has-hover ? AppTheme.danger : AppTheme.danger.transparentize(20%)) : (item-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground);
                }
            }

            Text {
                text: root.title;
                font-size: 11px;
                font-weight: 500;
                color: root.is-danger ? AppTheme.danger : (item-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground);
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.shortcut != "": Text {
                text: root.shortcut;
                font-size: 9px;
                color: AppTheme.disabled-foreground;
                vertical-alignment: center;
            }
        }
    }
}

/// 通用右键上下文菜单浮层容器
export component ContextMenuContainer inherits Rectangle {
    in property <bool> is-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <length> menu-width: 160px;
    in property <length> menu-height: 100px;

    x: root.menu-x;
    y: root.menu-y;
    width: root.menu-width;
    height: root.menu-height;

    border-radius: AppTheme.radius-medium;
    background: AppTheme.surface-background;
    border-width: 1px;
    border-color: AppTheme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000088;
    drop-shadow-offset-y: 4px;
}
