import { AppTheme } from "../../themes/app-theme.slint";
import { AppButton } from "../base/app-button.slint";
import { AppFormInput } from "../base/app-form-input.slint";
import { AppCard } from "../base/app-card.slint";

/// 开发者凭据与密钥管理专属调试面板 (Credentials & Keys Debug Tab)
export component DebugCredentialsTab inherits VerticalLayout {
    // 统计指标
    in property <int> credential-count: 0;

    // 快捷添加表单
    in-out property <string> quick-cred-name: "";
    in-out property <string> quick-cred-type: "key"; // "key" | "password" | "agent"
    in-out property <string> quick-cred-data: "";

    // 批量生成表单
    in-out property <string> batch-cred-prefix: "bench-cred-";
    in-out property <string> batch-cred-count-str: "10";
    in-out property <string> batch-cred-mode: "mixed"; // "mixed" | "key" | "password" | "agent"
    in-out property <bool> batch-cred-overwrite: false;

    // 回调事件
    callback batch-generate-credentials(string, string, bool); // count_str, mode, overwrite
    callback quick-add-credential(string, string, string);     // cred_type, name, data
    callback reset-default-credentials();
    callback clear-all-credentials();

    spacing: 10px;
    width: 100%;
    height: 100%;
    alignment: start;

    // 1. 顶部指标胶囊与全局数据重置栏
    Rectangle {
        height: 50px;
        width: 100%;
        border-radius: AppTheme.radius-large;
        background: AppTheme.surface-background;
        border-width: 1px;
        border-color: AppTheme.border;

        HorizontalLayout {
            height: 100%;
            padding-left: 14px;
            padding-right: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("🔐 凭据存储总数: ") + root.credential-count + @tr(" 条");
                        font-size: 12px;
                        font-weight: 700;
                        color: AppTheme.foreground;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                VerticalLayout {
                    alignment: center;
                    AppButton {
                        text: @tr("恢复默认精选预设");
                        icon: @image-url("../../assets/icons/refresh.svg");
                        has-icon: true;
                        variant: "secondary";
                        clicked => { root.reset-default-credentials(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    AppButton {
                        text: @tr("清空所有凭据");
                        icon: @image-url("../../assets/icons/trash.svg");
                        has-icon: true;
                        variant: "danger";
                        clicked => { root.clear-all-credentials(); }
                    }
                }
            }
        }
    }

    // 2. 左右两栏工作台布局
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        width: 100%;

        // 左侧: 常用预设一键注入与快速添加
        AppCard {
            horizontal-stretch: 1;
            height: 100%;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    height: 20px;

                    Image {
                        source: @image-url("../../assets/icons/key.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: AppTheme.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("预设凭据单项注入");
                        font-size: 12px;
                        font-weight: 600;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }

                // 预设注入快捷按钮网格
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-k1.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-k1 := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "key",
                                        "生产 Ed25519 密钥 (带口令)",
                                        "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW\nQyNTUxOQAAACDH8g20vX7K9p1BfN2wP4lXqZbM4xGgA9QJ6tL7r1n6SQAAAJCR2Y69kdmO\nvQAAAAtzc2gtZWQyNTUxOQAAACDH8g20vX7K9p1BfN2wP4lXqZbM4xGgA9QJ6tL7r1n6\nSQAAAEA6WjG4m2JpL5kZ8yQ3uP9tL3wR2bN6pG8oP4qM7lX2nDH8g20vX7K9p1BfN2wP\n4lXqZbM4xGgA9QJ6tL7r1n6SQAAAA1zbWFsdXgtc3NoLWtleQECAwQ=\n-----END OPENSSH PRIVATE KEY-----"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "🔑 + Ed25519 密钥"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }

                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-k2.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-k2 := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "key",
                                        "CI/CD RSA-4096 密钥",
                                        "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0k6K9X7L9p1BfN2wP4lXqZbM4xGgA9QJ6tL7r1n6SQ2Y69kd\nvQMwAAAAtzc2gtcnNhAAAAAwEAAQAAAgEAv7b4a2p8zXqN3vP9xK2m4rL9nO1pQ8tL\n3wR2bN6pG8oP4qM7lX2nDH8g20vX7K9p1BfN2wP4lXqZbM4xGgA9QJ6tL7r1n6SQ\nA6WjG4m2JpL5kZ8yQ3uP9tL3wR2bN6pG8oP4qM7lX2nDH8g20vX7K9p1BfN2wP4l\nXqZbM4xGgA9QJ6tL7r1n6SQAAAA1zbWFsdXgtc3NoLWtleQECAwQFAgcICQoLDA0O\nDxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+P0\nBBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3Bx\ncnN0dXZ3eHl6e3x9fn+AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6Ch\noqOkpaanqKmqq6ytrq+wsbKztLW2t7i5uru8vb6/wMHCw8TFxsfIycrLzM3Oz9DR\n0tPU1dbX2Nna29zd3t/g4eLj5OXm5+jp6uvs7e7v8PHy8/T19vf4+fr7/P3+/wID\n-----END RSA PRIVATE KEY-----"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "📜 + RSA 密钥"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-a1.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-a1 := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "agent",
                                        "1Password SSH Agent",
                                        "\\\\.\\pipe\\1password-ssh-agent"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "🛡️ + 1Password Agent"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }

                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-a2.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-a2 := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "agent",
                                        "Windows OpenSSH Agent",
                                        "\\\\.\\pipe\\openssh-ssh-agent"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "🪟 + OpenSSH Agent"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-a3.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-a3 := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "agent",
                                        "Bitwarden SSH Agent",
                                        "\\\\.\\pipe\\bitwarden-ssh-agent"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "🌐 + Bitwarden Agent"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }

                        Rectangle {
                            horizontal-stretch: 1; height: 26px; border-radius: 4px;
                            background: p-pwd.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px; border-color: AppTheme.border;
                            p-pwd := TouchArea {
                                clicked => {
                                    root.quick-add-credential(
                                        "password",
                                        "堡垒机特权 Root 密码",
                                        "SmaluxSecure#2026!P@ss"
                                    );
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: center; Text { text: "🔒 + Root 密码"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; } }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: AppTheme.border; }

                // 快速添加自定义凭据
                Text { text: @tr("快速添加自定义凭据:"); font-size: 11px; font-weight: 600; color: AppTheme.foreground; }

                AppFormInput {
                    label: @tr("凭据名称:");
                    icon: @image-url("../../assets/icons/file-text.svg");
                    has-icon: true;
                    text <=> root.quick-cred-name;
                }

                HorizontalLayout {
                    spacing: 8px;
                    AppButton {
                        text: @tr("类型: 密钥");
                        variant: root.quick-cred-type == "key" ? "primary" : "secondary";
                        clicked => { root.quick-cred-type = "key"; }
                    }
                    AppButton {
                        text: @tr("类型: 密码");
                        variant: root.quick-cred-type == "password" ? "primary" : "secondary";
                        clicked => { root.quick-cred-type = "password"; }
                    }
                    AppButton {
                        text: @tr("类型: Agent");
                        variant: root.quick-cred-type == "agent" ? "primary" : "secondary";
                        clicked => { root.quick-cred-type = "agent"; }
                    }
                }

                AppButton {
                    text: @tr("确认添加单条凭据");
                    icon: @image-url("../../assets/icons/plus.svg");
                    has-icon: true;
                    variant: "primary";
                    clicked => {
                        if root.quick-cred-name != "" {
                            root.quick-add-credential(
                                root.quick-cred-type,
                                root.quick-cred-name,
                                root.quick-cred-data
                            );
                            root.quick-cred-name = "";
                        }
                    }
                }
            }
        }

        // 右侧: 批量生成与压测
        AppCard {
            horizontal-stretch: 1;
            height: 100%;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    height: 20px;

                    Image {
                        source: @image-url("../../assets/icons/zap.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: AppTheme.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("大规模批量造数与压测");
                        font-size: 12px;
                        font-weight: 600;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    AppFormInput {
                        horizontal-stretch: 3;
                        label: @tr("名称前缀:");
                        icon: @image-url("../../assets/icons/terminal.svg");
                        has-icon: true;
                        text <=> root.batch-cred-prefix;
                    }

                    AppFormInput {
                        horizontal-stretch: 2;
                        label: @tr("生成数量:");
                        text <=> root.batch-cred-count-str;
                    }
                }

                // 生成类型选择
                VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("凭据类型分布:"); font-size: 10px; color: AppTheme.secondary-foreground; }

                    HorizontalLayout {
                        spacing: 6px;

                        AppButton {
                            text: @tr("混合类型");
                            variant: root.batch-cred-mode == "mixed" ? "primary" : "secondary";
                            clicked => { root.batch-cred-mode = "mixed"; }
                        }

                        AppButton {
                            text: @tr("全密钥");
                            variant: root.batch-cred-mode == "key" ? "primary" : "secondary";
                            clicked => { root.batch-cred-mode = "key"; }
                        }

                        AppButton {
                            text: @tr("全密码");
                            variant: root.batch-cred-mode == "password" ? "primary" : "secondary";
                            clicked => { root.batch-cred-mode = "password"; }
                        }

                        AppButton {
                            text: @tr("全 Agent");
                            variant: root.batch-cred-mode == "agent" ? "primary" : "secondary";
                            clicked => { root.batch-cred-mode = "agent"; }
                        }
                    }
                }

                // 覆盖模式开关
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 3px;
                        background: root.batch-cred-overwrite ? AppTheme.accent : AppTheme.control-background;
                        border-width: 1px;
                        border-color: root.batch-cred-overwrite ? AppTheme.accent : AppTheme.border;
                        y: (parent.height - self.height) / 2;

                        TouchArea {
                            clicked => { root.batch-cred-overwrite = !root.batch-cred-overwrite; }
                            mouse-cursor: pointer;
                        }

                        if root.batch-cred-overwrite: Image {
                            source: @image-url("../../assets/icons/check.svg");
                            width: 10px;
                            height: 10px;
                            colorize: #ffffff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        text: @tr("覆盖现有数据 (未勾选则为追加模式)");
                        font-size: 11px;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }

                AppButton {
                    text: @tr("⚡ 立即批量生成测试凭据");
                    icon: @image-url("../../assets/icons/zap.svg");
                    has-icon: true;
                    variant: "primary";
                    clicked => {
                        root.batch-generate-credentials(
                            root.batch-cred-count-str,
                            root.batch-cred-mode,
                            root.batch-cred-overwrite
                        );
                    }
                }

                // 提示卡片
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text {
                            text: @tr("💡 提示: 批量生成测试凭据将同步写入 AppStorage 存储层，并在凭据中心与左侧凭据抽屉中实时响应。");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
