import { AppTheme } from "../../themes/app-theme.slint";
import { AppButton } from "../base/app-button.slint";

export struct LogEntryData {
    timestamp: string,
    level: string,
    module: string,
    message: string,
}

export component DebugLogsTab inherits VerticalLayout {
    in property <[LogEntryData]> logs: [];
    in-out property <string> log-filter-level: "ALL";

    callback clear-logs();
    callback emit-test-log(string);

    width: 100%;
    height: 100%;
    spacing: 8px;

    // 工具栏：等级过滤 + 清空 + 模拟
    HorizontalLayout {
        alignment: space-between;
        height: 26px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            Rectangle {
                width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                background: root.log-filter-level == "ALL" ? AppTheme.accent : AppTheme.control-background;
                TouchArea { clicked => { root.log-filter-level = "ALL"; } mouse-cursor: pointer; }
                Text { text: "ALL"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "ALL" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                background: root.log-filter-level == "INFO" ? AppTheme.accent : AppTheme.control-background;
                TouchArea { clicked => { root.log-filter-level = "INFO"; } mouse-cursor: pointer; }
                Text { text: "INFO"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "INFO" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                background: root.log-filter-level == "WARN" ? AppTheme.accent : AppTheme.control-background;
                TouchArea { clicked => { root.log-filter-level = "WARN"; } mouse-cursor: pointer; }
                Text { text: "WARN"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "WARN" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 44px; height: 24px; border-radius: AppTheme.radius-small;
                background: root.log-filter-level == "ERROR" ? AppTheme.accent : AppTheme.control-background;
                TouchArea { clicked => { root.log-filter-level = "ERROR"; } mouse-cursor: pointer; }
                Text { text: "ERR"; font-size: 10px; font-weight: 600; color: root.log-filter-level == "ERROR" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            AppButton {
                height: 24px;
                text: @tr("模拟日志");
                icon: @image-url("../../assets/icons/file-text.svg");
                has-icon: true;
                icon-size: 10px;
                variant: "outline";
                clicked => { root.emit-test-log("INFO"); }
            }

            AppButton {
                height: 24px;
                text: @tr("清空日志");
                icon: @image-url("../../assets/icons/window-close.svg");
                has-icon: true;
                icon-size: 8px;
                variant: "outline";
                clicked => { root.clear-logs(); }
            }
        }
    }


    // 日志滚动视图
    Rectangle {
        vertical-stretch: 1;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background.darker(15%);
        border-width: 1px;
        border-color: AppTheme.border;

        Flickable {
            width: 100%;
            height: 100%;
            viewport-height: root.logs.length * 24px + 10px;

            VerticalLayout {
                padding: 6px;
                spacing: 3px;
                alignment: start;

                for entry[i] in root.logs: Rectangle {
                    height: 22px;
                    border-radius: 2px;
                    background: Math.mod(i, 2) == 0 ? AppTheme.hover-background.transparentize(60%) : transparent;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: start;

                        // 时间戳
                        Text {
                            text: entry.timestamp;
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                            font-family: "Consolas, monospace";
                        }

                        // 级别徽章
                        Rectangle {
                            width: 42px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.hover-background;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: entry.level;
                                font-size: 9px;
                                font-weight: 700;
                                color: AppTheme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 模块标签
                        Text {
                            text: "[" + entry.module + "]";
                            font-size: 10px;
                            font-weight: 500;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }

                        // 日志消息
                        Text {
                            text: entry.message;
                            font-size: 10px;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
