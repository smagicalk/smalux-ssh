import { AppTheme } from "../../themes/app-theme.slint";
import { AppButton } from "../base/app-button.slint";
import { AppCard } from "../base/app-card.slint";

/// 设置与外观专属调试面板 (Settings & Theme Debug Tab)
export component DebugSettingsTab inherits VerticalLayout {
    in property <string> current-theme-name: "Darcula";
    in property <bool> is-dark-mode: true;

    callback switch-theme(string);
    callback toggle-color-mode();

    spacing: 12px;
    width: 100%;
    height: 100%;
    alignment: start;

    // 1. 主题切换与外观治理卡片
    AppCard {
        width: 100%;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            alignment: start;

            // 标题与深浅色快速翻转
            HorizontalLayout {
                alignment: space-between;
                height: 24px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Image {
                        source: @image-url("../../assets/icons/settings.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: AppTheme.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("主题配色体系测试 (当前生效: ") + root.current-theme-name + ")";
                        font-size: 12px;
                        font-weight: 600;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }

                // 深浅色一键翻转胶囊
                Rectangle {
                    width: 110px;
                    height: 24px;
                    border-radius: AppTheme.radius-medium;
                    background: t-cm.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    t-cm := TouchArea {
                        clicked => { root.toggle-color-mode(); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;

                        Image {
                            source: root.is-dark-mode ? @image-url("../../assets/icons/moon.svg") : @image-url("../../assets/icons/sun.svg");
                            width: 11px;
                            height: 11px;
                            image-fit: contain;
                            colorize: root.is-dark-mode ? AppTheme.accent : #eab308;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.is-dark-mode ? @tr("当前: 深色模式") : @tr("当前: 浅色模式");
                            font-size: 10px;
                            font-weight: 600;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // =========================================================================
            // 分组 1: 深色主题 (Dark Themes)
            // =========================================================================
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Image {
                    source: @image-url("../../assets/icons/moon.svg");
                    width: 11px;
                    height: 11px;
                    image-fit: contain;
                    colorize: AppTheme.accent;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: @tr("深色主题组 (Dark Themes):");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }

            // 深色主题网格 (6 款主流深色系)
            HorizontalLayout {
                spacing: 6px;
                height: 28px;

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "Darcula" ? AppTheme.accent : (th1.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "Darcula" ? AppTheme.accent : AppTheme.border;
                    th1 := TouchArea { clicked => { root.switch-theme("builtin.ui.darcula"); } mouse-cursor: pointer; }
                    Text { text: "Darcula"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Darcula" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "One Dark" ? AppTheme.accent : (th2.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "One Dark" ? AppTheme.accent : AppTheme.border;
                    th2 := TouchArea { clicked => { root.switch-theme("builtin.ui.one-dark"); } mouse-cursor: pointer; }
                    Text { text: "One Dark"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "One Dark" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "Monokai" ? AppTheme.accent : (th3.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "Monokai" ? AppTheme.accent : AppTheme.border;
                    th3 := TouchArea { clicked => { root.switch-theme("monokai"); } mouse-cursor: pointer; }
                    Text { text: "Monokai"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Monokai" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "Nord" ? AppTheme.accent : (th4.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "Nord" ? AppTheme.accent : AppTheme.border;
                    th4 := TouchArea { clicked => { root.switch-theme("nord"); } mouse-cursor: pointer; }
                    Text { text: "Nord"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Nord" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "Solarized" || root.current-theme-name == "Solarized Dark" ? AppTheme.accent : (th5.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "Solarized" || root.current-theme-name == "Solarized Dark" ? AppTheme.accent : AppTheme.border;
                    th5 := TouchArea { clicked => { root.switch-theme("solarized"); } mouse-cursor: pointer; }
                    Text { text: "Solarized Dark"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Solarized" || root.current-theme-name == "Solarized Dark" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "GitHub Dark" ? AppTheme.accent : (th6.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "GitHub Dark" ? AppTheme.accent : AppTheme.border;
                    th6 := TouchArea { clicked => { root.switch-theme("github-dark"); } mouse-cursor: pointer; }
                    Text { text: "GitHub Dark"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "GitHub Dark" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // =========================================================================
            // 分组 2: 浅色主题 (Light Themes)
            // =========================================================================
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                padding-top: 4px;

                Image {
                    source: @image-url("../../assets/icons/sun.svg");
                    width: 11px;
                    height: 11px;
                    image-fit: contain;
                    colorize: #eab308;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: @tr("浅色主题组 (Light Themes):");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }

            // 浅色主题按钮行
            HorizontalLayout {
                spacing: 6px;
                height: 28px;

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "GitHub Light" ? AppTheme.accent : (th7.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "GitHub Light" ? AppTheme.accent : AppTheme.border;
                    th7 := TouchArea { clicked => { root.switch-theme("github-light"); } mouse-cursor: pointer; }
                    Text { text: "GitHub Light (纯白明亮)"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "GitHub Light" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                    background: root.current-theme-name == "Solarized Light" ? AppTheme.accent : (th8.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                    border-width: 1px; border-color: root.current-theme-name == "Solarized Light" ? AppTheme.accent : AppTheme.border;
                    th8 := TouchArea { clicked => { root.switch-theme("builtin.ui.solarized-light"); } mouse-cursor: pointer; }
                    Text { text: "Solarized Light (暖黄护眼)"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Solarized Light" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

    // 2. 设计令牌与设置项实时状态探针
    AppCard {
        width: 100%;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Image {
                    source: @image-url("../../assets/icons/sparkles.svg");
                    width: 13px;
                    height: 13px;
                    image-fit: contain;
                    colorize: AppTheme.accent;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: @tr("UI 设计令牌 (Design Tokens) 探针");
                    font-size: 12px;
                    font-weight: 600;
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    Text { text: @tr("主色强调 (Accent):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    Rectangle { height: 16px; border-radius: 4px; background: AppTheme.accent; }
                }

                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    Text { text: @tr("前景色 (Foreground):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    Rectangle { height: 16px; border-radius: 4px; background: AppTheme.foreground; }
                }

                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    Text { text: @tr("面板底色 (Panel):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    Rectangle { height: 16px; border-radius: 4px; background: AppTheme.panel-background; border-width: 1px; border-color: AppTheme.border; }
                }

                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    Text { text: @tr("控件边框 (Border):"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    Rectangle { height: 16px; border-radius: 4px; background: AppTheme.border; }
                }
            }
        }
    }
}
