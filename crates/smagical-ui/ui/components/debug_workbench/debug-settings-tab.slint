import { AppTheme } from "../../themes/app-theme.slint";
import { AppButton } from "../base/app-button.slint";
import { AppIconButton } from "../base/app-icon-button.slint";
import { AppCard } from "../base/app-card.slint";
import { ScrollView } from "std-widgets.slint";

/// 调试开关组件
component DebugSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? AppTheme.accent : (s-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background);
    border-width: 1px;
    border-color: root.checked ? AppTheme.accent : AppTheme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    s-touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: pointer;
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;

        animate x { duration: 150ms; easing: ease-out; }
    }
}

/// 实验特性设置行组件
component FlagItemRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> badge: "LAB";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 52px;
    border-radius: AppTheme.radius-small;
    background: itm-touch.has-hover ? AppTheme.hover-background : transparent;
    animate background { duration: 120ms; }

    itm-touch := TouchArea {
        clicked => {
            sw.checked = !sw.checked;
            root.checked = sw.checked;
            root.toggled(sw.checked);
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.title;
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 15px;
                    border-radius: 3px;
                    background: root.checked ? AppTheme.accent : AppTheme.control-background;
                    border-width: 1px;
                    border-color: root.checked ? AppTheme.accent : AppTheme.border;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.badge;
                            font-size: 8px;
                            font-weight: 700;
                            color: root.checked ? #ffffff : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: root.subtitle;
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            sw := DebugSwitch {
                checked: root.checked;
                toggled(c) => {
                    root.checked = c;
                    root.toggled(c);
                }
            }
        }
    }
}

/// 设置与外观专属调试面板 (Settings & Theme Debug Tab)
export component DebugSettingsTab inherits ScrollView {
    in-out property <bool> flag-desktop-notifications: false;
    in-out property <bool> flag-terminal-crt-shader: false;
    in-out property <bool> flag-cloud-sync: false;
    in-out property <bool> flag-terminal-scratchpad: false;
    in-out property <bool> use-mock-storage: true;
    in property <string> current-theme-name: "Darcula";
    in property <bool> is-dark-mode: true;
    in-out property <float> setting-modal-opacity: 1.0;

    callback toggle-feature-flag(string, bool);
    callback toggle-mock-storage(bool);
    callback apply-config-preset(string);
    callback reset-all-settings();
    callback switch-theme(string);
    callback toggle-color-mode();
    callback change-modal-opacity(float);

    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: 4px;
        spacing: 12px;
        alignment: start;

        // =========================================================================
        // 卡片 1: 🧪 实验特性与实验室功能门控 (Feature Flags)
        // =========================================================================
        AppCard {
            width: 100%;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: start;

                // 标题栏与批量控制操作
                HorizontalLayout {
                    alignment: space-between;
                    height: 26px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "🧪";
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: @tr("实验特性与功能显隐门控 (Feature Flags)");
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.foreground;
                            }
                            Text {
                                text: @tr("开启的实验特性将实时挂载并显现在偏好设置中，关闭后平滑隐藏");
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                            }
                        }
                    }

                    // 快速开关胶囊
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Rectangle {
                            height: 22px;
                            border-radius: AppTheme.radius-small;
                            background: b-all-on.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            b-all-on := TouchArea {
                                clicked => { root.apply-config-preset("flags_all_on"); }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: @tr("全部开启");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: AppTheme.radius-small;
                            background: b-all-off.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            b-all-off := TouchArea {
                                clicked => { root.apply-config-preset("flags_all_off"); }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: @tr("全部关闭");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 细分割线
                Rectangle { height: 1px; background: AppTheme.border; opacity: 0.5; }

                // 特性行 0: 切换到 Mock 数据层
                FlagItemRow {
                    title: @tr("切换到 Mock 数据层 (Mock Data Layer)");
                    subtitle: @tr("默认开启内存种子 Mock 数据；关闭后切换至真实物理存储模式，便于接入其他存储类型进行调试");
                    badge: "STORAGE";
                    checked: root.use-mock-storage;
                    toggled(c) => {
                        root.use-mock-storage = c;
                        root.toggle-mock-storage(c);
                    }
                }

                // 特性行 1: 桌面气泡通知
                FlagItemRow {
                    title: @tr("系统级桌面托盘气泡通知 (OS Desktop Notification)");
                    subtitle: @tr("长耗时命令结束或会话异常断开时向 Windows 系统托盘推送通知 (直接在此控制生效)");
                    badge: "OS PUSH";
                    checked: root.flag-desktop-notifications;
                    toggled(c) => {
                        root.flag-desktop-notifications = c;
                        root.toggle-feature-flag("desktop_notifications", c);
                    }
                }

                // 特性行 2: 终端 CRT 显像管着色器
                FlagItemRow {
                    title: @tr("终端复古 CRT 扫描线着色器 (Terminal CRT Shader)");
                    subtitle: @tr("开启后在偏好设置终端页显示对应选项，为字符渲染叠加微凸显像管与荧光扫描线特效");
                    badge: "SHADER";
                    checked: root.flag-terminal-crt-shader;
                    toggled(c) => {
                        root.flag-terminal-crt-shader = c;
                        root.toggle-feature-flag("terminal_crt_shader", c);
                    }
                }

                // 特性行 3: 云端配置同步
                FlagItemRow {
                    title: @tr("云端多端加密备份与同步原型 (Cloud Sync Prototype)");
                    subtitle: @tr("开启后在偏好设置备份页显示云端同步选项，基于端到端加密同步配置与主机资产");
                    badge: "CLOUD";
                    checked: root.flag-cloud-sync;
                    toggled(c) => {
                        root.flag-cloud-sync = c;
                        root.toggle-feature-flag("cloud_sync", c);
                    }
                }

                // 特性行 4: 终端划词便签板
                FlagItemRow {
                    title: @tr("终端侧边临时便签划词板 (Terminal Scratchpad)");
                    subtitle: @tr("开启后在右侧活动栏显示 Scratchpad 工具抽屉，用于终端划词文本临时收集备忘");
                    badge: "SCRATCH";
                    checked: root.flag-terminal-scratchpad;
                    toggled(c) => {
                        root.flag-terminal-scratchpad = c;
                        root.toggle-feature-flag("terminal_scratchpad", c);
                    }
                }

                // 特性行 5: 模态弹窗不透明度微调 (Modal Opacity)
                HorizontalLayout {
                    alignment: space-between;
                    height: 36px;
                    padding-left: 8px;
                    padding-right: 8px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: @tr("壁纸模式弹窗底板不透明度 (Modal Opacity)");
                            font-size: 11px;
                            font-weight: 600;
                            color: AppTheme.foreground;
                        }
                        Text {
                            text: @tr("[实验特性] 调节全局壁纸模式下模态弹窗背景透明度 (默认 100% 纯色以防字体重叠)");
                            font-size: 9px;
                            color: AppTheme.secondary-foreground;
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        height: 24px;
                        y: (parent.height - self.height) / 2;

                        AppIconButton {
                            icon: @image-url("../../assets/icons/arrow-left.svg");
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                if root.setting-modal-opacity > 0.60 {
                                    root.setting-modal-opacity = Math.round((root.setting-modal-opacity - 0.05) * 100) / 100;
                                    root.change-modal-opacity(root.setting-modal-opacity);
                                }
                            }
                        }

                        Rectangle {
                            width: 62px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: AppTheme.radius-small;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: modal-op-input.has-focus ? AppTheme.accent : AppTheme.border;

                            TouchArea {
                                clicked => { modal-op-input.focus(); }
                                mouse-cursor: text;
                            }

                            HorizontalLayout {
                                height: 100%;
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 2px;
                                alignment: center;

                                modal-op-input := TextInput {
                                    width: 36px;
                                    height: 100%;
                                    text: Math.round(root.setting-modal-opacity * 100);
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppTheme.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => {
                                        let raw_val = self.text.to-float();
                                        if raw_val >= 60 && raw_val <= 100 {
                                            let val = raw_val / 100.0;
                                            root.setting-modal-opacity = Math.round(val * 100) / 100;
                                            root.change-modal-opacity(root.setting-modal-opacity);
                                        } else if raw_val >= 0.60 && raw_val <= 1.0 {
                                            root.setting-modal-opacity = Math.round(raw_val * 100) / 100;
                                            root.change-modal-opacity(root.setting-modal-opacity);
                                        }
                                    }
                                    accepted => {
                                        let raw_val = self.text.to-float();
                                        let val = raw_val > 1.0 ? raw_val / 100.0 : raw_val;
                                        let clamped = Math.max(0.60, Math.min(1.0, val));
                                        root.setting-modal-opacity = Math.round(clamped * 100) / 100;
                                        root.change-modal-opacity(root.setting-modal-opacity);
                                    }
                                }

                                Text {
                                    text: "%";
                                    font-size: 10px;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        AppIconButton {
                            icon: @image-url("../../assets/icons/arrow-right.svg");
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                if root.setting-modal-opacity < 1.0 {
                                    root.setting-modal-opacity = Math.min(1.0, Math.round((root.setting-modal-opacity + 0.05) * 100) / 100);
                                    root.change-modal-opacity(root.setting-modal-opacity);
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // 卡片 2: 🛠️ 预设配置一键注入与出厂归一化 (Config Presets & Reset)
        // =========================================================================
        AppCard {
            width: 100%;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    height: 24px;

                    Text {
                        text: "🛠️";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: @tr("配置预设注入与出厂重置 (Presets & Recovery)");
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                        }
                        Text {
                            text: @tr("快速注入高负载全功能测试场景或将应用设置恢复出厂干净初始状态");
                            font-size: 9px;
                            color: AppTheme.secondary-foreground;
                        }
                    }
                }

                Rectangle { height: 1px; background: AppTheme.border; opacity: 0.5; }

                HorizontalLayout {
                    spacing: 10px;
                    height: 32px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: AppTheme.radius-medium;
                        background: b-gk.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.accent;
                        b-gk := TouchArea {
                            clicked => { root.apply-config-preset("geek"); }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "🚀"; font-size: 12px; vertical-alignment: center; }
                            Text { text: @tr("极客全开压测模式"); font-size: 11px; font-weight: 600; color: AppTheme.accent; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: AppTheme.radius-medium;
                        background: b-min.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        b-min := TouchArea {
                            clicked => { root.apply-config-preset("minimal"); }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "⚡"; font-size: 12px; vertical-alignment: center; }
                            Text { text: @tr("极简轻量兼容模式"); font-size: 11px; font-weight: 600; color: AppTheme.foreground; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: AppTheme.radius-medium;
                        background: b-rst.has-hover ? #ef444420 : AppTheme.control-background;
                        border-width: 1px;
                        border-color: #ef444480;
                        b-rst := TouchArea {
                            clicked => { root.reset-all-settings(); }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "🔄"; font-size: 12px; vertical-alignment: center; }
                            Text { text: @tr("恢复出厂默认设置"); font-size: 11px; font-weight: 600; color: #ef4444; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // 卡片 4: 🎨 主题配色体系测试与令牌探针
        // =========================================================================
        AppCard {
            width: 100%;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    alignment: space-between;
                    height: 24px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Image {
                            source: @image-url("../../assets/icons/settings.svg");
                            width: 14px;
                            height: 14px;
                            image-fit: contain;
                            colorize: AppTheme.accent;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: @tr("主题配色体系快测 (当前: ") + root.current-theme-name + ")";
                            font-size: 12px;
                            font-weight: 600;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 110px;
                        height: 24px;
                        border-radius: AppTheme.radius-medium;
                        background: t-cm.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.border;

                        t-cm := TouchArea {
                            clicked => { root.toggle-color-mode(); }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;

                            Image {
                                source: root.is-dark-mode ? @image-url("../../assets/icons/moon.svg") : @image-url("../../assets/icons/sun.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: root.is-dark-mode ? AppTheme.accent : #eab308;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.is-dark-mode ? @tr("深色模式") : @tr("浅色模式");
                                font-size: 10px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    height: 26px;

                    Rectangle {
                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                        background: root.current-theme-name == "Darcula" ? AppTheme.accent : (th1.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px; border-color: root.current-theme-name == "Darcula" ? AppTheme.accent : AppTheme.border;
                        th1 := TouchArea { clicked => { root.switch-theme("builtin.ui.darcula"); } mouse-cursor: pointer; }
                        Text { text: "Darcula"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Darcula" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                        background: root.current-theme-name == "One Dark" ? AppTheme.accent : (th2.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px; border-color: root.current-theme-name == "One Dark" ? AppTheme.accent : AppTheme.border;
                        th2 := TouchArea { clicked => { root.switch-theme("builtin.ui.one-dark"); } mouse-cursor: pointer; }
                        Text { text: "One Dark"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "One Dark" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                        background: root.current-theme-name == "GitHub Light" ? AppTheme.accent : (th3.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px; border-color: root.current-theme-name == "GitHub Light" ? AppTheme.accent : AppTheme.border;
                        th3 := TouchArea { clicked => { root.switch-theme("github-light"); } mouse-cursor: pointer; }
                        Text { text: "GitHub Light"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "GitHub Light" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: AppTheme.radius-small;
                        background: root.current-theme-name == "Nord" ? AppTheme.accent : (th4.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px; border-color: root.current-theme-name == "Nord" ? AppTheme.accent : AppTheme.border;
                        th4 := TouchArea { clicked => { root.switch-theme("nord"); } mouse-cursor: pointer; }
                        Text { text: "Nord"; font-size: 10px; font-weight: 600; color: root.current-theme-name == "Nord" ? #ffffff : AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}