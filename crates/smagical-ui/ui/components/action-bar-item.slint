import { AppTheme } from "../themes/app-theme.slint";

/// 48px 极窄活动栏/工具栏图标按钮单元 (支持原生 SVG 矢量图标与单色渲染)
export component ActionBarItem inherits Rectangle {
    in property <image> icon;
    in property <string> icon-text: "";
    in property <string> tooltip: "";
    in property <bool> is-active: false;
    in property <int> badge-count: 0;

    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: AppTheme.radius-medium;
    background: is-active ? AppTheme.selected-background : touch.has-hover ? AppTheme.hover-background : transparent;

    animate background { duration: 120ms; }

    // 激活指示条 (左侧垂直居中)
    if is-active: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: AppTheme.accent;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // 1. 原生 SVG 矢量图标渲染 (绝对居中)
    if root.icon.width > 0: Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        image-fit: contain;
        colorize: is-active ? AppTheme.selected-foreground : touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // 2. 备用字符渲染 (绝对居中)
    if root.icon.width == 0 && root.icon-text != "": Text {
        text: root.icon-text;
        font-size: 15px;
        font-weight: is-active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        color: is-active ? AppTheme.selected-foreground : touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
    }

    // 极简小红点角标
    if badge-count > 0: Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: AppTheme.danger;
    }
}
