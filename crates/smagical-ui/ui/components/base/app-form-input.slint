import { AppTheme } from "../../themes/app-theme.slint";

/// 标准表单输入控件 (App Form Input)
export component AppFormInput inherits VerticalLayout {
    in property <string> label: "";
    in property <image> icon: @image-url("");
    in property <bool> has-icon: false;
    in property <length> input-height: 28px;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;

    callback edited(/* text */ string);
    callback accepted(/* text */ string);

    spacing: 2px;
    alignment: start;

    if root.label != "": Text {
        text: root.label;
        font-size: 10px;
        color: AppTheme.secondary-foreground;
    }

    Rectangle {
        height: root.input-height;
        width: 100%;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: input.has-focus ? AppTheme.accent : AppTheme.border;

        animate border-color { duration: 120ms; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: center;

            if root.has-icon: Image {
                source: root.icon;
                width: 12px;
                height: 12px;
                image-fit: contain;
                colorize: input.has-focus ? AppTheme.accent : AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            input := TextInput {
                font-size: 11px;
                color: AppTheme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
                enabled: root.enabled;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }

        }
    }
}
