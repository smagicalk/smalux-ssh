// =============================================================================
// 文件名称: app-scroll-bar.slint
// 模块功能: 全局统一现代化主题悬浮滚动条 (AppVScrollBar & AppHScrollBar)
// 核心设计:
// 1. 零排版挤压：纯悬浮浮层 (Overlay)，绝对定位在容器边缘，不占用内容排版宽度；
// 2. 全主题联动：透明导轨透出壁纸与底层背景，滑块自适应深浅色，Hover/Drag 呈现 AppTheme.accent；
// 3. 自适应显隐：内容未超出可视视口时自动隐匿 (auto-hide)；
// 4. 舒适交互：视觉 5px 超薄精致胶囊，触控热区向外扩增至 10px，支持鼠标直接拖拽与滚轮跟随。
// =============================================================================

import { AppTheme } from "../../themes/app-theme.slint";

/// 竖向现代化主题悬浮滚动条 (Vertical ScrollBar)
export component AppVScrollBar inherits Rectangle {
    /// 滚动内容真实总高度 (例如 scroll-area.viewport-height 或 content.preferred-height)
    in property <length> viewport-height: 0px;
    /// 外部可视窗口容器高度 (例如 scroll-area.height)
    in property <length> visible-height: 0px;
    /// 当前视口纵向偏移量 (双向绑定至 scroll-area.viewport-y，Slint 中通常 <= 0px)
    in-out property <length> viewport-y: 0px;

    /// 滚动条滑块视觉宽度 (默认 5px)
    in property <length> bar-width: 5px;
    /// 距右侧边缘边距 (默认 2px)
    in property <length> right-offset: 2px;
    /// 距顶部边缘边距 (默认 0px)
    in property <length> top-offset: 0px;
    /// 距底部边缘边距 (默认 0px，当同时存在横向滚动条时可设为 6px)
    in property <length> bottom-offset: 0px;

    /// 是否在内容未超出视口时自动隐匿 (默认 true)
    in property <bool> auto-hide: true;

    // 是否需要展示滚动条
    property <bool> is-needed: root.viewport-height > root.visible-height + 1px;
    visible: !root.auto-hide || root.is-needed;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    track := Rectangle {
        x: parent.width - root.bar-width - root.right-offset;
        y: root.top-offset;
        width: root.bar-width;
        height: Math.max(0px, parent.height - root.top-offset - root.bottom-offset);
        background: Colors.transparent;

        // 滑块尺寸与位置计算
        property <length> track-height: self.height;
        property <length> thumb-height: Math.max(26px, Math.min(track-height, (root.visible-height / Math.max(1px, root.viewport-height)) * track-height));
        property <length> max-thumb-travel: Math.max(0px, track-height - thumb-height);
        property <length> max-content-travel: Math.max(1px, root.viewport-height - root.visible-height);
        property <float> scroll-progress: Math.min(1.0, Math.max(0.0, -root.viewport-y / max-content-travel));

        // 悬浮滑块
        thumb := Rectangle {
            x: 0px;
            y: Math.max(0px, Math.min(track.track-height - self.height, track.scroll-progress * track.max-thumb-travel));
            width: parent.width;
            height: track.thumb-height;
            border-radius: self.width / 2;

            background: (thumb-touch.has-hover || thumb-touch.pressed)
                ? AppTheme.accent
                : AppTheme.secondary-foreground.transparentize(50%);

            animate background { duration: 150ms; easing: ease-out; }

            // 舒适宽度的鼠标拖拽交互层 (左右向外延伸 3px 以便鼠标抓取)
            thumb-touch := TouchArea {
                x: -3px;
                width: parent.width + 6px;
                height: parent.height;
                mouse-cursor: pointer;

                moved => {
                    if self.pressed {
                        let delta_y = self.mouse-y - self.pressed-y;
                        let scale = root.viewport-height / Math.max(1px, root.visible-height);
                        root.viewport-y = Math.min(0px, Math.max(root.visible-height - root.viewport-height, root.viewport-y - delta_y * scale));
                    }
                }
            }
        }
    }
}

/// 横向现代化主题悬浮滚动条 (Horizontal ScrollBar)
export component AppHScrollBar inherits Rectangle {
    /// 滚动内容真实总宽度 (例如 scroll-area.viewport-width 或 content.preferred-width)
    in property <length> viewport-width: 0px;
    /// 外部可视窗口容器宽度 (例如 scroll-area.width)
    in property <length> visible-width: 0px;
    /// 当前视口横向偏移量 (双向绑定至 scroll-area.viewport-x，Slint 中通常 <= 0px)
    in-out property <length> viewport-x: 0px;

    /// 滚动条滑块视觉高度 (默认 5px)
    in property <length> bar-height: 5px;
    /// 距底部边缘边距 (默认 2px)
    in property <length> bottom-offset: 2px;
    /// 距左侧边缘边距 (默认 0px)
    in property <length> left-offset: 0px;
    /// 距右侧边缘边距 (默认 0px，当同时存在纵向滚动条时可设为 6px)
    in property <length> right-offset: 0px;

    /// 是否在内容未超出视口时自动隐匿 (默认 true)
    in property <bool> auto-hide: true;

    property <bool> is-needed: root.viewport-width > root.visible-width + 1px;
    visible: !root.auto-hide || root.is-needed;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    track := Rectangle {
        x: root.left-offset;
        y: parent.height - root.bar-height - root.bottom-offset;
        width: Math.max(0px, parent.width - root.left-offset - root.right-offset);
        height: root.bar-height;
        background: Colors.transparent;

        // 滑块尺寸与位置计算
        property <length> track-width: self.width;
        property <length> thumb-width: Math.max(32px, Math.min(track-width, (root.visible-width / Math.max(1px, root.viewport-width)) * track-width));
        property <length> max-thumb-travel: Math.max(0px, track-width - thumb-width);
        property <length> max-content-travel: Math.max(1px, root.viewport-width - root.visible-width);
        property <float> scroll-progress: Math.min(1.0, Math.max(0.0, -root.viewport-x / max-content-travel));

        // 悬浮滑块
        thumb := Rectangle {
            x: Math.max(0px, Math.min(track.track-width - self.width, track.scroll-progress * track.max-thumb-travel));
            y: 0px;
            width: track.thumb-width;
            height: parent.height;
            border-radius: self.height / 2;

            background: (thumb-touch.has-hover || thumb-touch.pressed)
                ? AppTheme.accent
                : AppTheme.secondary-foreground.transparentize(50%);

            animate background { duration: 150ms; easing: ease-out; }

            thumb-touch := TouchArea {
                y: -3px;
                width: parent.width;
                height: parent.height + 6px;
                mouse-cursor: pointer;

                moved => {
                    if self.pressed {
                        let delta_x = self.mouse-x - self.pressed-x;
                        let scale = root.viewport-width / Math.max(1px, root.visible-width);
                        root.viewport-x = Math.min(0px, Math.max(root.visible-width - root.viewport-width, root.viewport-x - delta_x * scale));
                    }
                }
            }
        }
    }
}

/// 默认竖向滚动条别名
export component AppScrollBar inherits AppVScrollBar {}
