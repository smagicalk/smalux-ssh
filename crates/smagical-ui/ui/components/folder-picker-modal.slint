import { AppTheme } from "../themes/app-theme.slint";
import { GroupTreeSelector, GroupOptionData } from "group-tree-selector.slint";
import { AppButton } from "base/app-button.slint";

export { GroupOptionData }

/// 通用树状文件夹/分组选取弹窗 (Folder / Group Picker Modal)
export component FolderPickerModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> title: @tr("选择所属上级文件夹 / 分组");
    in property <string> prompt: @tr("请在下方树形结构中点选目标归属文件夹（支持多级折叠/展开）：");
    in property <[GroupOptionData]> options: [];

    in property <string> current-id: "root";
    in property <string> current-name: @tr("根目录 (作为顶级分组)");

    property <string> temp-id: root.current-id;
    property <string> temp-name: root.current-name;

    callback close();
    callback confirmed(string /* id */, string /* name */);
    callback toggle-group(string /* id */);

    width: 100%;
    height: 100%;
    z: 1500;
    visible: root.is-open;

    if root.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            // 拦截背景点击误触
        }

        Rectangle {
            width: 440px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;

                // 1. 标题栏
                HorizontalLayout {
                    alignment: space-between;
                    height: 24px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/folder.svg");
                                width: 15px;
                                height: 15px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: root.title;
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    // 关闭按钮
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-t.has-hover ? AppTheme.hover-background : transparent;

                        close-t := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../assets/icons/window-close.svg");
                            width: 10px;
                            height: 10px;
                            image-fit: contain;
                            colorize: close-t.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // 2. 提示说明
                Text {
                    text: root.prompt;
                    font-size: 10px;
                    color: AppTheme.secondary-foreground;
                    height: 14px;
                    vertical-alignment: center;
                }

                // 3. 树形选择器主体
                GroupTreeSelector {
                    options: root.options;
                    selected-id <=> root.temp-id;
                    toggle-group(id) => { root.toggle-group(id); }
                    selection-changed(id, name) => {
                        root.temp-id = id;
                        root.temp-name = name;
                    }
                    height: 220px;
                }

                // 4. 底部操作栏
                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("已选: ") + root.temp-name;
                            font-size: 11px;
                            font-weight: 600;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        AppButton {
                            text: @tr("取消");
                            variant: "secondary";
                            clicked => { root.close(); }
                        }

                        AppButton {
                            text: @tr("确定选定");
                            variant: "primary";
                            clicked => {
                                root.confirmed(root.temp-id, root.temp-name);
                            }
                        }
                    }
                }
            }
        }
    }
}
