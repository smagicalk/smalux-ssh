import { AppTheme } from "../../themes/app-theme.slint";

/// 标准统一开关组件 (App Switch)
///
/// 核心特性：
/// 1. 支持标准尺寸 ("md": 44x24px) 与紧凑微型尺寸 ("sm": 32x18px)；
/// 2. 支持自定义激活状态色彩 (active-brush，如传入 AppTheme.success 用于表示“运行中”)；
/// 3. 平滑滑动动画与阴影反馈。
export component AppSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> size: "md";
    in property <brush> active-brush: AppTheme.accent;
    callback toggled(bool);

    property <length> knob-size: root.size == "sm" ? 14px : 18px;
    property <length> knob-inset: 2px;

    width: root.size == "sm" ? 32px : 44px;
    height: root.size == "sm" ? 18px : 24px;
    border-radius: root.height / 2;
    background: !root.enabled ? AppTheme.control-background.transparentize(50%) :
        root.checked ? root.active-brush : (s-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background);
    border-width: 1px;
    border-color: !root.enabled ? transparent :
        root.checked ? root.active-brush : AppTheme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    s-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: root.enabled ? pointer : default;
    }

    // 白色滑动旋钮
    Rectangle {
        x: root.checked ? parent.width - self.width - knob-inset : knob-inset;
        y: knob-inset;
        width: knob-size;
        height: knob-size;
        border-radius: knob-size / 2;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;

        animate x { duration: 150ms; easing: ease-out; }
    }
}
