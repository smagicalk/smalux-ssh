import { AppTheme } from "../../themes/app-theme.slint";

/// 标准统一开关组件 (App Switch)
export component AppSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: !root.enabled ? AppTheme.control-background.transparentize(50%) :
        root.checked ? AppTheme.accent : (s-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background);
    border-width: 1px;
    border-color: !root.enabled ? transparent :
        root.checked ? AppTheme.accent : AppTheme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    s-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: root.enabled ? pointer : default;
    }

    // 白色滑动旋钮
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;

        animate x { duration: 150ms; easing: ease-out; }
    }
}
