import { AppTheme } from "../../themes/app-theme.slint";

export struct DropdownItemData {
    id: string,
    label: string,
}

/// 标准统一弹出式下拉选择器 (App Dropdown Selector)
/// 支持带滚动条列表、鼠标滚轮穿透、选中高亮、自定义宽度与最大展开高度
export component AppDropdown inherits Rectangle {
    in property <[DropdownItemData]> items: [];
    in-out property <string> active-id: "";
    in-out property <string> active-label: "";
    in property <string> placeholder: @tr("请选择...");
    in property <length> popup-max-height: 180px;
    in property <bool> enabled: true;
    
    callback selected(string /* id */, string /* label */);

    height: 28px;
    min-width: 120px;
    border-radius: AppTheme.radius-medium;
    background: !root.enabled ? AppTheme.control-background.transparentize(50%) :
        dd-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
    border-width: 1px;
    border-color: !root.enabled ? transparent :
        dd-touch.has-hover ? AppTheme.accent : AppTheme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.active-label != "" ? root.active-label : root.placeholder;
            font-size: 11px;
            font-weight: 500;
            color: !root.enabled ? AppTheme.disabled-foreground : AppTheme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 12px;
            Text {
                text: "▼";
                font-size: 8px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    dd-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            dd-popup.show();
        }
        mouse-cursor: root.enabled ? pointer : default;
    }

    dd-popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: Math.min(root.popup-max-height, root.items.length * 30px + 10px);
        close-policy: close-on-click-outside;

        dd-box := Rectangle {
            width: root.width;
            height: parent.height;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000099;
            drop-shadow-offset-y: 4px;
            clip: true;

            property <length> total-height: root.items.length * 30px + 8px;
            property <length> min-scroll: Math.min(0px, self.height - total-height);
            property <length> scroll-offset: 0px;

            // 背景滚轮捕获与冒泡拦截
            TouchArea {
                scroll-event(event) => {
                    dd-box.scroll-offset = Math.min(0px, Math.max(dd-box.min-scroll, dd-box.scroll-offset + event.delta-y));
                    accept
                }
            }

            VerticalLayout {
                y: dd-box.scroll-offset;
                alignment: start;
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 4px;
                padding-right: 6px;
                spacing: 2px;

                for item in root.items: Rectangle {
                    height: 28px;
                    border-radius: AppTheme.radius-small;
                    background: root.active-id == item.id ? AppTheme.accent.transparentize(80%) : (opt-touch.has-hover ? AppTheme.hover-background : transparent);

                    opt-touch := TouchArea {
                        scroll-event(event) => {
                            dd-box.scroll-offset = Math.min(0px, Math.max(dd-box.min-scroll, dd-box.scroll-offset + event.delta-y));
                            accept
                        }
                        clicked => {
                            root.active-id = item.id;
                            root.active-label = item.label;
                            root.selected(item.id, item.label);
                            dd-popup.close();
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: space-between;

                        Text {
                            text: item.label;
                            font-size: 11px;
                            font-weight: root.active-id == item.id ? 600 : 400;
                            color: root.active-id == item.id ? AppTheme.accent :
                                opt-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if root.active-id == item.id: Text {
                            text: "✓";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 紧凑滚动条指示器
            if dd-box.total-height > dd-box.height: Rectangle {
                x: parent.width - 4px;
                y: (-dd-box.scroll-offset / dd-box.total-height) * dd-box.height;
                width: 3px;
                height: Math.max(16px, (dd-box.height / dd-box.total-height) * dd-box.height);
                border-radius: 1.5px;
                background: AppTheme.secondary-foreground.transparentize(50%);
            }
        }
    }
}
