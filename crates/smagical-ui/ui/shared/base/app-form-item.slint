import { AppTheme } from "../../themes/app-theme.slint";

/// 标准垂直表单项组件 (AppFormItem)
///
/// 核心特性：
/// 1. 顶部标签 + 必填红星标识符 (*) + 辅助说明；
/// 2. 中间承载输入控件插槽 (@children)；
/// 3. 底部可选错误提示文案 (error-text)；
/// 4. 彻底统一全站 30+ 处表单字段的间距与排版规范。
export component AppFormItem inherits VerticalLayout {
    in property <string> label: "";
    in property <bool> required: false;
    in property <string> hint: "";
    in property <string> error-text: "";

    spacing: 4px;
    alignment: start;
    width: 100%;

    // 1. 标签行
    if root.label != "": HorizontalLayout {
        spacing: 4px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
            vertical-alignment: center;
        }

        if root.required: Text {
            text: "*";
            font-size: 11px;
            font-weight: 700;
            color: AppTheme.danger;
            vertical-alignment: center;
        }

        if root.hint != "": Text {
            text: "(" + root.hint + ")";
            font-size: 10px;
            color: AppTheme.disabled-foreground;
            vertical-alignment: center;
        }
    }

    // 2. 控件插槽
    Rectangle {
        width: 100%;
        @children
    }

    // 3. 错误提示行
    if root.error-text != "": Text {
        text: root.error-text;
        font-size: 10px;
        font-weight: 600;
        color: AppTheme.danger;
    }
}
