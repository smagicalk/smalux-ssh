                    select-tab(id) => { root.select-tab(id); }
                    close-tab(id) => { root.close-tab(id); }
                    select-pane-tab(pane_id, tab_id) => { root.select-pane-tab(pane_id, tab_id); }
                    close-pane-tab(pane_id, tab_id) => { root.close-pane-tab(pane_id, tab_id); }
                    copy-tab-ip(tab_id) => { root.copy-tab-ip(tab_id); }
                    close-other-tabs(pane_id, tab_id) => { root.close-other-tabs(pane_id, tab_id); }
                    new-tab => { root.is-new-session-modal-open = true; }


                    session-name: root.active-session-name;
                    host-address: root.active-host-address;
