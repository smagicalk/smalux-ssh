import { RightToolBar } from "views/right_tool_bar.slint";

/// smalux-ssh 桌面客户端主窗口根组件
export component AppWindow inherits Window {
    title: @tr("smalux - 现代 Rust SSH 终端工作台");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: AppTheme.window-background;
    no-frame: true; // 隐藏系统原生边框，采用自绘制无边框标题栏
    default-font-family: (SettingsBridge.setting-ui-font == "系统默认 (System Default)" || SettingsBridge.setting-ui-font == "") ? "" : SettingsBridge.setting-ui-font;

        /// 原生窗口最小化回调
    callback minimize-window();
    /// 原生窗口最大化/还原回调
    callback maximize-window();
    /// 原生窗口退出应用回调
    callback close-window();
    /// 强制退出应用回调 (确认弹窗确认后)
    callback force-close-window();
    /// 原生窗口拖动移动回调
    callback start-window-drag();
    /// 原生无边框窗口 8 方向边缘拖拽调整尺寸回调
    callback start-window-resize(string);

    // 全局快捷键拦截 (支持 F12 或 Ctrl+Shift+D 随时呼出调试弹窗)
    forward-focus: main-focus;
    main-focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K" || event.text == "p" || event.text == "P") {
                WindowBridge.is-command-palette-open = !WindowBridge.is-command-palette-open;
                accept
            } else if (event.text == Key.F12 || (event.modifiers.control && event.modifiers.shift && (event.text == "d" || event.text == "D"))) && WindowBridge.is-debug-enabled {
                DebugBridge.is-open = !DebugBridge.is-open;
                accept
            } else if event.text == Key.Escape {

                if WindowBridge.is-command-palette-open {
                    WindowBridge.is-command-palette-open = false;
                    accept
                } else if DebugBridge.is-open {
                    DebugBridge.is-open = false;
                    accept
                } else if HostsBridge.is-create-group-open {
                    HostsBridge.is-create-group-open = false;
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }
    }

    // 顶层主容器 (外层带边框圆角与固态底基)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: AppTheme.base-window-background;
        clip: true;

        // 全局壁纸层 (双缓冲淡入淡出，平滑过渡，绝不卡顿)
        if WindowBridge.wallpaper-mode == "global" && WindowBridge.prev-wallpaper-image.width > 0 && WindowBridge.wallpaper-crossfade < 1.0: Image {
            source: WindowBridge.prev-wallpaper-image;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: WindowBridge.global-wallpaper-opacity * (1.0 - WindowBridge.wallpaper-crossfade);
        }

        if WindowBridge.wallpaper-mode == "global" && WindowBridge.global-wallpaper-image.width > 0: Image {
            source: WindowBridge.global-wallpaper-image;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: WindowBridge.global-wallpaper-opacity * WindowBridge.wallpaper-crossfade;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 0px;
            spacing: 0px;


            // 1. 顶层全宽控制栏 (TabBar + 纯净系统窗口控制)
            TabBar {
                is-maximized: WindowBridge.is-window-maximized;
                is-dark-mode: WindowBridge.is-dark-mode;
                active-tab-id: TerminalBridge.active-session-tab;
                tabs: TerminalBridge.tabs;
                select-tab(id) => {
                    WindowBridge.main-view = "terminal";
                    TerminalBridge.select-tab(id);
                }
                close-tab(id) => { TerminalBridge.close-tab(id); }
                new-tab => {
                    WindowBridge.main-view = "terminal";
                    TerminalBridge.new-tab();
                    WindowBridge.is-new-session-modal-open = true;
                }
                minimize-window => { root.minimize-window(); }
                maximize-window => {
                    root.maximize-window();
                }
                close-window => { root.close-window(); }
                start-window-drag => { root.start-window-drag(); }
            }

            // 2. 中间五栏主工作区 (整齐划一平铺)
            HorizontalLayout {
                vertical-stretch: 1;
                width: 100%;
                padding: 0px;
                spacing: 0px;

                // 2.1 最左侧 48px 动态数据驱动活动图标栏
                LeftActivityBar {
                    active-tab: WindowBridge.active-left-tab;
                    top-items: WindowBridge.top-activity-items;
                    bottom-items: WindowBridge.bottom-activity-items;
                    is-dark-mode: WindowBridge.is-dark-mode;
                    toggle-color-mode => { WindowBridge.toggle-color-mode(); }
                    tab-clicked(id) => {
                        WindowBridge.switch-left-tab(id);
                        if id == "debug" {
                            // 点击调试图标直接唤起全局独立浮动弹窗
                            DebugBridge.is-open = !DebugBridge.is-open;
                        } else if id == "history" {
                            // 切换至独立全屏历史中心大页面 (无终端视口干扰)
                            WindowBridge.active-left-tab = "history";
                            WindowBridge.main-view = "history";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.navigate-to("history", "");
                        } else if id == "credentials" {
                            // 切换至独立全屏凭据中心大页面 (左侧列表 + 右侧详情编辑，无右侧工具栏)
                            WindowBridge.active-left-tab = "credentials";
                            WindowBridge.main-view = "credentials";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.navigate-to("credentials", "");
                        } else if id == "snippets" {
                            // 切换至独立全屏代码片段中心大页面 (左侧多层树形 + 右侧沉浸式编辑器)
                            WindowBridge.active-left-tab = "snippets";
                            WindowBridge.main-view = "snippets";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.navigate-to("snippets", "");
                        } else if id == "tunnels" {
                            // 切换至独立全屏网络与隧道中心大页面 (左侧规则列表 + 右侧拓扑与指标详情)
                            WindowBridge.active-left-tab = "tunnels";
                            WindowBridge.main-view = "tunnels";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.navigate-to("tunnels", "");
                        } else if id == "files" {
                            // 切换至文件管理页面：左侧展示主机树抽屉，中央展示双盘文件管理器
                            WindowBridge.active-left-tab = "files";
                            WindowBridge.main-view = "files";
                            WindowBridge.is-left-drawer-open = true;
                            WindowBridge.navigate-to("files", "");
                        } else if id == "settings" {
                            // 切换至独立全屏偏好设置中心大页面 (含外观、终端、网络、快捷键与数据备份)
                            WindowBridge.active-left-tab = "settings";
                            WindowBridge.main-view = "settings";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.navigate-to("settings", "");
                        } else {
                            // 资产与设置抽屉：切回终端工作区 + 展开对应抽屉
                            WindowBridge.main-view = "terminal";
                            if WindowBridge.active-left-tab == id && WindowBridge.is-left-drawer-open {
                                WindowBridge.is-left-drawer-open = false;
                            } else {
                                WindowBridge.active-left-tab = id;
                                WindowBridge.is-left-drawer-open = true;
                            }
                            WindowBridge.navigate-to(id, "");
                        }
                    }
                }


                // 2.2 左侧可伸缩二级抽屉
                if WindowBridge.is-left-drawer-open: Rectangle {
                    width: WindowBridge.left-drawer-width;
                    clip: true;

                    if WindowBridge.active-left-tab == "hosts" || WindowBridge.active-left-tab == "files": HostsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                        host-double-clicked(id) => {
                            if WindowBridge.main-view == "files" {
                                FilesBridge.open-host-files(id);
                            } else {
                                HostsBridge.open-host(id);
                            }
                        }
                        open-local-shell(type) => { HostsBridge.open-host("local-" + type); }
                    }

                    if WindowBridge.active-left-tab == "credentials": CredentialsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                    }


                    if WindowBridge.active-left-tab == "snippets": SnippetsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                    }

                    if WindowBridge.active-left-tab == "tunnels": TunnelsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                        open-hub => {
                            WindowBridge.main-view = "tunnels";
                            WindowBridge.is-left-drawer-open = false;
                        }
                    }

                    if WindowBridge.active-left-tab == "backup": BackupDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                    }

                    if WindowBridge.active-left-tab == "settings": SettingsDrawer {
                        width: 100%;
                        height: 100%;
                        is-debug-enabled <=> WindowBridge.is-debug-enabled;
                        collapse => { WindowBridge.is-left-drawer-open = false; }
                        switch-theme(id) => { WindowBridge.switch-theme(id); }
                        toggle-debug-enabled(enabled) => { WindowBridge.toggle-debug-enabled(enabled); }
                    }
                }


                // 2.2.1 左侧可拖拽调宽分割条 (可见实体竖条，带左右 1px 边框，与侧栏同色)
                if WindowBridge.is-left-drawer-open: Rectangle {
                    width: 5px;
                    background: left-split-touch.has-hover || left-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    left-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                WindowBridge.left-drawer-width = Math.max(160px, Math.min(520px, WindowBridge.left-drawer-width + self.mouse-x - self.pressed-x));
                            }
                        }
                        double-clicked => {
                            WindowBridge.left-drawer-width = 240px;
                        }
                    }
                }

                // 2.3.1 全屏历史中心页面 (当 main-view == "history" 时全屏展开，彻底隐藏终端与多栏)
                if WindowBridge.main-view == "history": HistoryCenterView {
                    horizontal-stretch: 1;
                    reconnect(id) => {
                        WindowBridge.main-view = "terminal";
                        WindowBridge.active-left-tab = "hosts";
                        WindowBridge.is-left-drawer-open = true;
                        HistoryBridge.reconnect(id);
                    }
                    switch-to-terminal => {
                        WindowBridge.main-view = "terminal";
                        WindowBridge.active-left-tab = "hosts";
                        WindowBridge.is-left-drawer-open = true;
                    }
                }

                // 2.3.2 全屏凭据管理中心
                if WindowBridge.main-view == "credentials": CredentialsCenterView {
                    horizontal-stretch: 1;
                    back-to-terminal => {
                        WindowBridge.main-view = "terminal";
                        WindowBridge.active-left-tab = "hosts";
                        WindowBridge.is-left-drawer-open = true;
                    }
                }

                // 2.3.3 全屏代码片段管理中心
                if WindowBridge.main-view == "snippets": SnippetsCenterView {
                    horizontal-stretch: 1;
                }

                // 2.3.4 全屏网络与隧道管理中心
                if WindowBridge.main-view == "tunnels": TunnelsCenterView {
                    horizontal-stretch: 1;
                    back-to-terminal => {
                        WindowBridge.main-view = "terminal";
                        WindowBridge.active-left-tab = "hosts";
                        WindowBridge.is-left-drawer-open = true;
                    }
                }

                // 2.3.5 全屏偏好设置中心
                if WindowBridge.main-view == "settings": SettingsCenterView {
                    horizontal-stretch: 1;
                }

                // 2.3.6 中央终端视口 (内置终端多会话 Tab 栏，随抽屉伸缩自适应拉满全部剩余空间)
                if WindowBridge.main-view == "terminal": TerminalViewport {
                    horizontal-stretch: 1;
                }

                // 2.3.7 双盘文件管理与 SFTP 传输视图 (当 main-view == "files" 时展开)
                if WindowBridge.main-view == "files": FileExplorerView {
                    horizontal-stretch: 1;
                }











                // 2.3.1 右侧可拖拽调宽分割条 (仅在终端工作区展开右侧抽屉时展示)
                if WindowBridge.is-right-drawer-open && WindowBridge.main-view == "terminal": Rectangle {
                    width: 5px;
                    background: right-split-touch.has-hover || right-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    right-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                WindowBridge.right-drawer-width = Math.max(180px, Math.min(520px, WindowBridge.right-drawer-width - (self.mouse-x - self.pressed-x)));
                            }
                        }
                        double-clicked => {
                            WindowBridge.right-drawer-width = 240px;
                        }
                    }
                }

                // 2.4 右侧可伸缩工具抽屉 (仅在终端工作区展开时展示)
                if WindowBridge.is-right-drawer-open && WindowBridge.main-view == "terminal": Rectangle {
                    width: WindowBridge.right-drawer-width;
                    clip: true;

                    if WindowBridge.active-right-tool == "monitor": MonitorDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                    }

                    if WindowBridge.active-right-tool == "tunnel": TunnelToolDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                        open-tunnels-hub => {
                            WindowBridge.active-left-tab = "tunnels";
                            WindowBridge.main-view = "tunnels";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.is-right-drawer-open = false;
                            WindowBridge.navigate-to("tunnels", "");
                        }
                        start-create-tunnel => {
                            WindowBridge.active-left-tab = "tunnels";
                            WindowBridge.main-view = "tunnels";
                            WindowBridge.is-left-drawer-open = false;
                            WindowBridge.is-right-drawer-open = false;
                            TunnelsBridge.start-create();
                            WindowBridge.navigate-to("tunnels", "");
                        }
                    }

                    if WindowBridge.active-right-tool == "snippets": SnippetToolDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                    }

                    if WindowBridge.active-right-tool == "sftp": SftpToolDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                    }

                    if WindowBridge.active-right-tool == "notes": NotesToolDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                    }

                    if WindowBridge.active-right-tool == "ai": AiToolDrawer {
                        collapse => { WindowBridge.is-right-drawer-open = false; }
                        apply-suggested-cmd(cmd) => { TerminalBridge.send-snippet(cmd); }
                    }
                }

                // 2.5 最右侧 48px 工具图标栏 (仅在终端工作区展示)
                if WindowBridge.main-view == "terminal": RightToolBar {
                    active-tool: WindowBridge.active-right-tool;
                    tool-clicked(id) => {
                        if WindowBridge.active-right-tool == id && WindowBridge.is-right-drawer-open {
                            WindowBridge.is-right-drawer-open = false;
                        } else {
                            WindowBridge.active-right-tool = id;
                            WindowBridge.is-right-drawer-open = true;
                            if id == "tunnel" {
                                TunnelsBridge.sync-host-tunnels();
                            }
                        }
                    }
                }

            }

            // 3. 底层全宽状态栏
            StatusBar {
                current-theme-name: WindowBridge.current-theme-name;
                is-debug-open: DebugBridge.is-open;
                toggle-debug-panel => {
                    DebugBridge.is-open = !DebugBridge.is-open;
                }
            }
        }
    }

    // 浮动 Ctrl+K 指令面板
    CommandPalette {
        is-open: WindowBridge.is-command-palette-open;
        close => { WindowBridge.is-command-palette-open = false; }
        item-selected(id) => {
            if id == "5" {
                WindowBridge.switch-theme("builtin.ui.darcula");
            } else if id == "6" {
                WindowBridge.switch-theme("builtin.ui.monokai");
            } else {
                HostsBridge.open-host(id);
            }
        }
    }

    // 新建主机分组弹窗 (支持树状层级上级选择与名称输入)
    CreateGroupModal {
        is-open: HostsBridge.is-create-group-open;
        default-parent-id: HostsBridge.create-group-default-parent;
        group-options: HostsBridge.group-options;
        toggle-group(id) => { HostsBridge.toggle-selector-group(id); }
        close => { HostsBridge.is-create-group-open = false; }
        confirm(parent-id, name) => {
            HostsBridge.create-group(parent-id, name);
            HostsBridge.is-create-group-open = false;
        }
    }

    // 独立浮动开发者调试与批量数据控制弹窗 (全页面任意时刻可呼出)
    DebugModal { }

    // 主题设计与定制工坊弹窗 (可视化表单、微型沙盒视窗与 TOML 双向代码编辑器)
    ThemeEditorModal { }

    // 快速新建终端会话居中卡片弹窗
    NewSessionModal {
        is-open: WindowBridge.is-new-session-modal-open;
        local-items: WindowBridge.launcher-local-items;
        host-items: HostsBridge.hosts;
        close => { WindowBridge.is-new-session-modal-open = false; }
        search-changed(q) => { WindowBridge.filter-launcher(q); }
        item-selected(id) => {
            WindowBridge.is-new-session-modal-open = false;
            HostsBridge.open-host(id);
        }
    }

    // 会话历史详情与终端屏幕快照弹窗
    HistoryDetailModal {
        close => { HistoryBridge.is-detail-open = false; }
        reconnect(id) => {
            HistoryBridge.is-detail-open = false;
            WindowBridge.main-view = "terminal";
            WindowBridge.active-left-tab = "hosts";
            WindowBridge.is-left-drawer-open = true;
            HistoryBridge.reconnect(id);
        }
    }

    // 通用消息与错误提示模态弹窗
    MessageDialog {
        is-open <=> WindowBridge.is-dialog-open;
        title: WindowBridge.dialog-title;
        message: WindowBridge.dialog-message;
        dialog-type: WindowBridge.dialog-type;
        close => { WindowBridge.is-dialog-open = false; }
    }

    // 关闭窗口含活跃会话二次防呆确认弹窗
    MessageDialog {
        is-open <=> WindowBridge.is-exit-confirm-open;
        title: @tr("确认退出应用程序");
        message: @tr("当前仍有活跃的终端或 SSH 会话正在运行。强行退出将导致远程任务与网络隧道中断，确定要退出吗？");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("强行退出");
        cancel-text: @tr("继续使用");
        close => { WindowBridge.is-exit-confirm-open = false; }
        confirmed => {
            WindowBridge.is-exit-confirm-open = false;
            root.force-close-window();
        }
    }

    // 关闭单个终端会话标签页防误触确认弹窗
    MessageDialog {
        is-open <=> TerminalBridge.is-tab-close-confirm-open;
        title: TerminalBridge.tab-close-confirm-title != "" ? TerminalBridge.tab-close-confirm-title : @tr("确认关闭终端会话");
        message: TerminalBridge.tab-close-confirm-message != "" ? TerminalBridge.tab-close-confirm-message : @tr("确定要断开并关闭此会话吗？远程正在运行的任务将被中断。");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("断开并关闭");
        cancel-text: @tr("取消");
        close => { TerminalBridge.is-tab-close-confirm-open = false; }
        confirmed => {
            TerminalBridge.is-tab-close-confirm-open = false;
            TerminalBridge.confirm-close-tab();
        }
    }

    // 切换渲染引擎重启确认弹窗
    MessageDialog {
        is-open <=> WindowBridge.is-restart-confirm-open;
        title: @tr("切换图形渲染引擎");
        message: WindowBridge.restart-confirm-message != "" ? WindowBridge.restart-confirm-message : @tr("切换图形渲染引擎需要重启客户端以重新初始化底层 GPU 显卡管线，是否立即重启？");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("立即重启");
        cancel-text: @tr("稍后重启");
        close => {
            WindowBridge.is-restart-confirm-open = false;
            WindowBridge.cancel-restart-pipeline();
        }
        confirmed => {
            WindowBridge.is-restart-confirm-open = false;
            WindowBridge.confirm-restart-pipeline();
        }
    }

    // 文件管理会话选择居中卡片弹窗 (单一本地域 + 远程全部主机，点击自动连接 SFTP)
    FileHostModal {
        is-open: FilesBridge.is-file-host-modal-open;
        host-items: FilesBridge.file-launcher-host-items;
        close => { FilesBridge.is-file-host-modal-open = false; }
        search-changed(q) => { FilesBridge.filter-file-launcher(q); }
        local-selected => {
            FilesBridge.is-file-host-modal-open = false;
            FilesBridge.open-file-host("local");
        }

        host-selected(id) => {
            FilesBridge.is-file-host-modal-open = false;
            FilesBridge.open-file-host(id);
        }
    }

    // 新建代码片段文件夹弹窗
    CreateSnippetGroupModal {
        is_open <=> SnippetsBridge.is-create-group-modal-open;
        group_name <=> SnippetsBridge.new-group-name;
        selected_parent_id <=> SnippetsBridge.new-group-parent-id;
        parent_options: SnippetsBridge.parent-options;
        cancel => { SnippetsBridge.close-create-group-modal(); }
        submit => { SnippetsBridge.submit-create-group(); }
        select_parent(id) => { SnippetsBridge.new-group-parent-id = id; }
    }

    // 代码片段动态参数填报执行弹窗
    SnippetRunModal {
        is_open <=> SnippetsBridge.is-run-modal-open;
        snippet_id: SnippetsBridge.run-snippet-id;
        snippet_title: SnippetsBridge.run-snippet-title;
        rendered_command <=> SnippetsBridge.run-rendered-command;
        params_list <=> SnippetsBridge.run-params-list;
        cancel => { SnippetsBridge.cancel-run-modal(); }
        submit => { SnippetsBridge.execute-run-modal(); }
        param_changed(idx, val) => { SnippetsBridge.run-param-changed(idx, val); }
    }

    // 全局气泡通知浮层 (z: 1000 最高层级)
    ToastContainer {
        z: 1000;
        toasts: WindowBridge.toasts;
        position: WindowBridge.toast-position;
        close-toast(id) => { WindowBridge.close-toast(id); }
    }

    // -------------------------------------------------------------------------
    // 边缘拖动改变窗口大小 (Window Edge & Corner Resize Handles)
    // 仅在非最大化状态下启用，8 个方向原生无缝拖拽缩放
    // -------------------------------------------------------------------------
    if !WindowBridge.is-window-maximized: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        // 顶边 (North)
        TouchArea {
            x: 8px; y: 0px; width: parent.width - 16px; height: 5px;
            mouse-cursor: n-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north");
                }
            }
        }
        // 底边 (South)
        TouchArea {
            x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 5px;
            mouse-cursor: s-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south");
                }
            }
        }
        // 左边 (West)
        TouchArea {
            x: 0px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: w-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("west");
                }
            }
        }
        // 右边 (East)
        TouchArea {
            x: parent.width - 5px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: e-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("east");
                }
            }
        }
        // 左上角 (NorthWest)
        TouchArea {
            x: 0px; y: 0px; width: 8px; height: 8px;
            mouse-cursor: nw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north-west");
                }
            }
        }
        // 右上角 (NorthEast)
        TouchArea {
            x: parent.width - 8px; y: 0px; width: 8px; height: 8px;
            mouse-cursor: ne-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north-east");
                }
            }
        }
        // 左下角 (SouthWest)
        TouchArea {
            x: 0px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: sw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south-west");
                }
            }
        }
        // 右下角 (SouthEast)
        TouchArea {
            x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: se-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south-east");
                }
            }
        }
    }
}




