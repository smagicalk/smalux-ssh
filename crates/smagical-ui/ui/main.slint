    in-out property <string> theme-editor-metric-icon-size: "16";

    in-out property <string> theme-editor-toml: "";

    // 色轮取色器属性与回调
    in-out property <float> theme-editor-wheel-indicator-x: 90.0;
    in-out property <float> theme-editor-wheel-indicator-y: 90.0;
    in-out property <float> theme-editor-wheel-brightness: 1.0;
    in-out property <brush> theme-editor-wheel-hue-brush: #ff0000;
