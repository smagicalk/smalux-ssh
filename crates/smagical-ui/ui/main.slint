    in property <brush> theme-editor-preview-hover-bg: #45475a;
    in property <brush> theme-editor-preview-pressed-bg: #585b70;
    in property <brush> theme-editor-preview-selected-bg: #cba6f7;
    in property <brush> theme-editor-preview-selected-fg: #ffffff;
    in property <brush> theme-editor-preview-border: #45475a;
    in property <brush> theme-editor-preview-focus-border: #cba6f7;
    in property <brush> theme-editor-preview-success: #a6e3a1;
    in property <brush> theme-editor-preview-warning: #f9e2af;
    in property <brush> theme-editor-preview-danger: #f38ba8;
    in property <brush> theme-editor-preview-info: #89b4fa;

    in-out property <string> theme-editor-metric-radius-small: "2";
    in-out property <string> theme-editor-metric-radius-medium: "4";
