import { RightToolBar } from "views/right_tool_bar.slint";

/// smalux-ssh 桌面客户端主窗口根组件
export component AppWindow inherits Window {
    title: @tr("smalux - 现代 Rust SSH 终端工作台");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: AppTheme.window-background;
    no-frame: true; // 隐藏系统原生边框，采用自绘制无边框标题栏

    // -------------------------------------------------------------------------
    // 侧边栏与弹窗视口状态属性
    // -------------------------------------------------------------------------
    /// 左侧活动栏当前激活的 Tab 标识 ("hosts", "history", "files", "credentials", "snippets", "tunnels", "backup", "settings")
    in-out property <string> active-left-tab: "hosts";
    /// 左侧功能抽屉是否处于展开状态
    in-out property <bool> is-left-drawer-open: true;
    /// 右侧辅助工具栏当前激活的工具标识 ("monitor", "snippet", "sftp", "notes", "ai")
    in-out property <string> active-right-tool: "monitor";
    /// 右侧辅助工具抽屉是否处于展开状态 (默认关闭，点击右侧工具栏图标时展开)
    in-out property <bool> is-right-drawer-open: false;

    /// Ctrl+K 命令调色板是否处于打开状态
    in-out property <bool> is-command-palette-open: false;
    /// F12 开发者调试诊断控制台模态弹窗是否打开
    in-out property <bool> is-debug-modal-open: false;
    /// 全局开发者调试功能开关 (默认开启 true，关闭则隐藏侧边栏图标并停止日志收集)
    in-out property <bool> is-debug-enabled: true;
    /// 动态左侧活动栏主功能菜单项列表
    in-out property <[ActivityBarItemData]> top-activity-items: [];
    /// 动态左侧活动栏底部系统菜单项列表
    in-out property <[ActivityBarItemData]> bottom-activity-items: [];
    /// 多终端群发广播模式是否开启


    in-out property <bool> is-broadcast-mode: false;
    /// 主窗口当前是否处于系统最大化状态
    in-out property <bool> is-window-maximized: false;
    /// 当前是否处于深色模式
    in-out property <bool> is-dark-mode: true;
    /// 当前生效的配色主题展示名称 (如: "Darcula", "GitHub Light")
    in-out property <string> current-theme-name: "Darcula";
    /// 当前生效的底层图形渲染管线 (如: "winit-skia", "winit-skia-opengl", "winit-skia-vulkan", "winit-femtovg")
    in-out property <string> active-rendering-pipeline: "winit-skia";


    // -------------------------------------------------------------------------
    // 终端多会话状态属性
    // -------------------------------------------------------------------------
    /// 当前聚焦激活的会话 Tab 标识 ID (如 "sess-1")
    in-out property <string> active-session-tab: "";
    /// 当前是否存在已连接的活跃终端会话
    in-out property <bool> has-active-session: false;
    /// 当前激活会话的展示标题
    in-out property <string> active-session-name: "";
    /// 当前激活会话的目标主机地址 (如 "192.168.1.101:22")
    in-out property <string> active-host-address: "";
    /// 当前激活会话的网络延迟 (ms)
    in-out property <int> active-host-ping-ms: 0;
    /// 当前激活会话的在线状态 ("online", "warning", "offline")
    in-out property <string> active-host-status: "online";
    /// 顶部 Tab 栏所有会话标签列表数据
    in-out property <[TabData]> tabs: [];

    // -------------------------------------------------------------------------
    // 主机与分组资产数据模型
    // -------------------------------------------------------------------------
    /// 左侧主机抽屉树形视图可见节点列表
    in-out property <[HostTreeNode]> tree-nodes: [];
    /// 左侧主机抽屉卡片视图可见主机列表
    in-out property <[HostItemData]> hosts: [];
    /// 主机管理视图模式 ("tree" 树形模式 | "card" 列表卡片模式)
    in-out property <string> hosts-view-mode: "tree";
    /// 当前树形内容最宽尺寸（动态驱动左右平滑横向滚动）
    in-out property <length> tree-content-width: 240px;
    /// 新建分组模态对话框是否显示
    in-out property <bool> is-create-group-open: false;
    /// 新建分组默认选中的父级 ID
    in-out property <string> create-group-default-parent: "root";
    /// 新建分组/主机弹窗中“上级分组选择器”下拉树形数据模型
    in-out property <[GroupOptionData]> group-options: [];

    /// 左侧抽屉自适应宽度 (支持鼠标拖拽调节)
    in-out property <length> left-drawer-width: 240px;
    /// 右侧抽屉自适应宽度 (支持鼠标拖拽调节)
    in-out property <length> right-drawer-width: 240px;
    /// 开发者调试控制台实时事件日志列表
    in-out property <[LogEntryData]> debug-logs: [];

    /// 快速新建终端会话弹窗状态与数据
    in-out property <bool> is-new-session-modal-open: false;
    /// 快速启动器本地 Shell 环境探测列表
    in-out property <[LocalShellItemData]> launcher-local-items: [];
    /// 快速启动器远程主机资产列表
    in-out property <[HostItemData]> launcher-host-items: root.hosts;
    /// 主工作区展示视图 ("terminal" 终端视口 | "history" 历史连接中心 | "files" 双盘文件管理)
    in-out property <string> main-view: "terminal";

    // -------------------------------------------------------------------------
    // 双盘文件管理与 SFTP 传输数据模型与状态 (左右独立 Tab 体系)
    // -------------------------------------------------------------------------
    /// 本地文件浏览器 Tab 列表
    in-out property <[FileTabData]> local-tabs: [];
    /// 当前激活的本地文件 Tab ID
    in-out property <string> active-local-tab-id: "";
    /// 远程 SFTP 文件传输 Tab 列表
    in-out property <[FileTabData]> remote-tabs: [];
    /// 当前激活的远程 SFTP Tab ID
    in-out property <string> active-remote-tab-id: "";
    /// 本地当前工作目录路径
    in-out property <string> local-current-path: "";
    /// 远程当前工作目录路径
    in-out property <string> remote-current-path: "";
    /// 本地文件系统可见条目列表
    in-out property <[FileItemData]> local-files: [];
    /// 远程 SFTP 文件系统可见条目列表
    in-out property <[FileItemData]> remote-files: [];
    /// 当前选中的本地文件 ID
    in-out property <string> selected-local-id: "";
    /// 当前选中的远程文件 ID
    in-out property <string> selected-remote-id: "";
    /// 异步文件传输任务队列
    in-out property <[TransferItemData]> transfer-tasks: [];




    // -------------------------------------------------------------------------
    // 历史会话数据模型与状态
    // -------------------------------------------------------------------------

    /// 历史抽屉分组数据模型
    in-out property <[HistoryGroupData]> history-groups: [];
    /// 历史记录总条数
    in-out property <int> history-total-count: 0;
    /// 历史抽屉视图模式 ("timeline" 时间流 | "hosts" 按主机聚合)
    in-out property <string> history-view-mode: "timeline";
    /// 历史抽屉搜索过滤关键词
    in-out property <string> history-search-query: "";

    // -------------------------------------------------------------------------
    // 历史会话详情与快照弹窗状态
    // -------------------------------------------------------------------------
    /// 会话详情与快照弹窗显隐开关
    in-out property <bool> is-history-detail-open: false;
    /// 会话详情弹窗数据
    in-out property <string> history-detail-id: "";
    in-out property <string> history-detail-title: "";
    in-out property <string> history-detail-address: "";
    in-out property <string> history-detail-user: "";
    in-out property <string> history-detail-type: "ssh";
    in-out property <string> history-detail-connected-time: "";
    in-out property <string> history-detail-disconnected-time: "";
    in-out property <string> history-detail-duration: "";
    in-out property <string> history-detail-exit-status: "success";
    in-out property <string> history-detail-error-msg: "";
    in-out property <string> history-detail-snapshot: "";
    in-out property <int> history-detail-snapshot-lines: 0;



    // -------------------------------------------------------------------------
    // 拖拽调序交互状态机
    // -------------------------------------------------------------------------
    /// 是否正在进行鼠标拖拽操作
    in-out property <bool> is-dragging: false;
    /// 被拖拽源节点 ID
    in-out property <string> drag-source-id: "";
    /// 被拖拽源节点显示名称
    in-out property <string> drag-source-name: "";
    /// 被拖拽源节点是否为文件夹分组
    in-out property <bool> drag-source-is-group: false;
    /// 当前悬停命中的目标放置节点 ID
    in-out property <string> drop-target-id: "";
    /// 当前悬停命中的目标放置节点名称
    in-out property <string> drop-target-name: "";
    /// 当前悬停命中的目标放置节点下标
    in-out property <int> drop-target-index: -1;
    /// 放置落点模式 ("before" 前插 | "inside" 移入分组 | "after" 后插 | "root" 顶级 | "none" 无效)
    in-out property <string> drop-position: "inside";
    /// 当前拖拽目标落点是否合法
    in-out property <bool> drop-target-valid: true;
    /// 鼠标当前全局拖拽 X 坐标
    in-out property <length> drag-x: 0px;
    /// 鼠标当前全局拖拽 Y 坐标
    in-out property <length> drag-y: 0px;

    /// 终端主窗格像素位图帧流 (由 Rust 终端引擎光栅化渲染后推送)
    in-out property <image> terminal-screen-image;
    /// 终端副窗格像素位图帧流 (分屏模式有效)
    in-out property <image> terminal-split-image;
    /// 终端第 3 窗格像素位图帧流 (三分屏/四分屏有效)
    in-out property <image> terminal-split2-image;
    /// 终端第 4 窗格像素位图帧流 (四分屏有效)
    in-out property <image> terminal-split3-image;
    /// 是否开启多终端分屏模式
    in-out property <bool> is-split: false;
    /// 分屏窗格总数量 (1: 单屏, 2: 双分屏, 3: 三分屏, 4: 四分屏)
    in-out property <int> split-count: 1;
    /// 分屏排布方向 ("vertical" 垂直左右 | "horizontal" 水平上下)
    in-out property <string> split-orientation: "vertical";
    /// 分屏窗格尺寸比例
    in-out property <float> split-ratio: 0.5;
    /// 当前获得键盘焦点的窗格索引 (0: 主窗格, 1: 副窗格 1, 2: 副窗格 2, 3: 副窗格 3)
    in-out property <int> active-pane-index: 0;
    /// 副窗格展示标题
    in-out property <string> split-session-name: "";
    /// 第 3 窗格展示标题
    in-out property <string> split2-session-name: "";
    /// 第 4 窗格展示标题
    in-out property <string> split3-session-name: "";
    /// 动态多窗格列表模型 (无限嵌套分屏)

    in-out property <[TerminalPaneData]> terminal-panes: [];
    /// 动态分割条列表模型
    in-out property <[TerminalSplitterData]> terminal-splitters: [];
    /// 当前获得键盘焦点的窗格 ID
    in-out property <string> active-pane-id: "";
    /// 终端实际物理像素渲染画布宽高
    out property <float> terminal-canvas-width: viewport.canvas-width;
    out property <float> terminal-canvas-height: viewport.canvas-height;
    /// 终端动态网格列数 (由中央视口根据实际像素宽度自适应换算)
    out property <int> terminal-cols: viewport.terminal-cols;
    /// 终端动态网格行数 (由中央视口根据实际像素高度自适应换算)
    out property <int> terminal-rows: viewport.terminal-rows;

    /// 当前终端历史回滚总行数
    in-out property <int> terminal-history-size: 0;

    /// 当前相对底部的向上回滚行偏移量
    in-out property <int> terminal-scroll-offset: 0;


    /// 壁纸展示模式 ("none" 无壁纸 | "global" 全局磨砂壁纸 | "terminal" 仅终端视口壁纸)
    in-out property <string> wallpaper-mode: "none";
    /// 全局磨砂背景壁纸位图
    in-out property <image> global-wallpaper-image;
    /// 全局背景壁纸不透明度 (0.0 ~ 1.0)
    in-out property <float> global-wallpaper-opacity: 0.15;
    /// 终端专属背景壁纸位图
    in-out property <image> terminal-wallpaper-image;
    /// 终端专属背景壁纸不透明度 (0.0 ~ 1.0)
    in-out property <float> terminal-wallpaper-opacity: 0.20;
    /// 终端字体名称 (如 "JetBrains Mono" / "Consolas")
    in-out property <string> terminal-font-family: "JetBrains Mono";
    /// 终端字体字号 (默认 14.0 px)
    in-out property <float> terminal-font-size: 14.0;


    // -------------------------------------------------------------------------
    // 窗口与业务路由回调
    // -------------------------------------------------------------------------
    /// 动态设置终端字体与字号
    callback set-terminal-font(string /* font_name_or_path */, float /* font_size */);
    /// 动态设置终端色彩主题
    callback set-terminal-theme(string /* theme_id */);
    /// 动态设置壁纸背景
    callback set-wallpaper(string /* mode: "none"|"global"|"terminal" */, string /* image_path */, float /* opacity */);
    /// 呼出全局命令面板回调
    callback trigger-command-palette();
    /// 切换配色主题回调
    callback switch-theme(string /* theme_id */);
    /// 切换深色/浅色外观模式回调
    callback toggle-color-mode();

    /// 树形视图分组折叠/展开回调
    callback toggle-tree-group(string /* group-id */);
    /// 拖拽释放节点移动与调序回调
    callback move-tree-node(string /* source-id */, string /* target-id */, string /* drop-position */);
    /// 拖拽悬停动态命中计算回调
    callback request-drag-hover(string /* source-id */, int /* target-index */, float /* offset-in-row */);
    /// 侧边栏主机资产实时搜索过滤回调
    callback filter-hosts(string /* query */);
    /// 快速启动器弹窗实时搜索过滤回调
    callback filter-launcher(string /* query */);
    /// 快速启动器上级分组动态折叠展开回调
    callback toggle-group-option(string /* id */);
    /// 确认新建分组回调
    callback create-group(string /* parent_id */, string /* name */);
    /// 双击主机或本地 Shell 发起终端连接回调
    callback open-host(string /* id */);
    /// 激活选中的终端会话 Tab 回调
    callback select-tab(string /* id */);
    /// 关闭指定终端会话 Tab 回调
    callback close-tab(string /* id */);
    /// 点击加号呼出新建终端会话弹窗回调
    callback new-tab();
    /// 选择指定分屏窗格内的指定 Tab 回调
    callback select-pane-tab(string /* pane_id */, string /* tab_id */);
    /// 关闭指定分屏窗格内的指定 Tab 回调
    callback close-pane-tab(string /* pane_id */, string /* tab_id */);
    /// 复制指定 Tab 会话所对应主机的 IP / 连接地址回调
    callback copy-tab-ip(string /* tab_id */);
    /// 关闭指定分屏窗格内除目标 Tab 以外的其他会话回调
    callback close-other-tabs(string /* pane_id */, string /* tab_id */);
    /// 向当前终端发送指令片段回调

    callback send-snippet(string /* cmd */);

    /// 原生窗口最小化回调
    callback minimize-window();
    /// 原生窗口最大化/还原回调
    callback maximize-window();
    /// 原生窗口退出应用回调
    callback close-window();

    // -------------------------------------------------------------------------
    // 终端核心底层交互回调
    // -------------------------------------------------------------------------
    /// 终端键盘按键字符/转义序列输入回调
    callback terminal-key-input(string /* text */, bool /* is_ctrl */, bool /* is_shift */, bool /* is_alt */);
    /// 终端鼠标滚轮视口滚动回调
    callback terminal-scroll(length /* delta */);
    /// 终端鼠标划选选区变更回调
    callback terminal-selection-changed(int /* start_col */, int /* start_row */, int /* end_col */, int /* end_row */, bool /* has_selection */);
    /// 终端选区复制到剪贴板回调
    callback terminal-copy();
    /// 剪贴板文本粘贴到终端回调
    callback terminal-paste();
    /// 终端视口清屏回调
    callback terminal-clear();

    /// 终端多窗格分屏回调
    callback split-terminal(string /* orientation */);
    /// 关闭当前终端分屏窗格回调
    callback close-split();
    /// 按窗格下标关闭指定分屏窗格回调
    callback close-pane-by-index(int /* index */);
    /// 按窗格 ID 关闭指定分屏窗格回调
    callback close-pane-by-id(string /* pane_id */);
    /// 选择并聚焦指定分屏窗格回调
    callback select-pane(int /* index */);
    /// 按窗格 ID 选择并聚焦指定窗格回调
    callback select-pane-by-id(string /* pane_id */);
    /// 切换单窗格临时最大化 (Zoom) 与还原回调
    callback toggle-pane-zoom(string /* pane_id */);
    /// 动态拖拽调节分割条比例回调
    callback adjust-splitter(string /* splitter_id */, float /* delta_ratio */);

    /// 终端缓冲区文本检索回调
    callback search-terminal(string /* query */, bool /* match_case */);
    /// 终端动态几何网格尺寸变更回调
    callback terminal-resize(int /* cols */, int /* rows */);
    /// 终端 Tab 拖拽移动与跨分屏移动回调
    callback move-terminal-tab(string /* from_pane_id */, int /* from_index */, length /* drop_x */, length /* drop_y */);

    // -------------------------------------------------------------------------
    // 历史会话抽屉交互回调
    // -------------------------------------------------------------------------
    /// 重连指定历史会话 (在当前焦点窗格中打开)
    callback reconnect-history(string /* id */);
    /// 重连指定历史会话 (向右分屏打开)
    callback reconnect-history-split(string /* id */);
    /// 删除单条历史记录
    callback delete-history-item(string /* id */);
    /// 清空全部历史记录
    callback clear-history();
    /// 切换单条历史记录置顶标星状态
    callback toggle-pin-history(string /* id */);
    /// 切换历史时间分组折叠展开状态
    callback toggle-history-group(string /* group_id */);
    /// 历史记录搜索关键词过滤回调
    callback filter-history(string /* query */);
    /// 切换历史抽屉视图模式回调 ("timeline" | "hosts")
    callback switch-history-view-mode(string /* mode */);
    /// 呼出会话详情与终端快照弹窗回调
    callback show-history-detail(string /* id */);
    /// 复制快照日志到剪贴板回调
    callback copy-history-log(string /* content */);


    // -------------------------------------------------------------------------
    // 开发者 F12 调试控制台专用回调
    // -------------------------------------------------------------------------

    /// 批量生成主机测试数据
    callback debug-batch-generate(string /* prefix */, string /* count_str */, string /* ip_prefix */, string /* start_ip_str */, string /* port_str */, string /* group */, string /* status_mode */, bool /* overwrite */);
    /// 批量更新主机状态模拟
    callback debug-batch-update-status(string /* status_mode */);
    /// 批量修改主机端口
    callback debug-batch-update-port(string /* new_port_str */);
    /// 注入标准场景测试预设
    callback debug-inject-preset(string /* preset_id */);
    /// 快捷添加单台主机
    callback debug-quick-add-host(string /* name */, string /* ip */, string /* port_str */, string /* group */);
    /// 快捷添加嵌套分组
    callback debug-quick-add-group(string /* name */, string /* parent_id */);
    /// 清空全量内存与存储层数据
    callback debug-clear-data();
    /// 恢复系统默认精简数据集
    callback debug-reset-default-data();
    /// 清空诊断日志
    callback debug-clear-logs();
    /// 模拟触发测试诊断日志
    callback debug-emit-test-log(string /* level */);
    /// 强制全屏重绘测试

    callback debug-force-repaint();
    /// 终端 120Hz 高频吞吐基准压测
    callback debug-run-benchmark();
    /// 切换图形渲染管线首选项
    callback debug-switch-pipeline(string /* pipeline_id */);
    /// 保存管线配置 (下次生效)
    callback debug-apply-pipeline();
    /// 保存管线并立即重启客户端
    callback debug-restart-app();
    /// 开发者调试功能开关切换回调
    callback toggle-debug-enabled(bool /* enabled */);

    /// 全局统一路由跳转请求回调
    callback navigate-to(string /* target_tab */, string /* section */);
    /// 侧边栏/主视图活动页签切换
    callback activity-tab-switched(string /* tab_id */);

    // -------------------------------------------------------------------------
    // 双盘文件管理交互回调 (左右独立 Tab 体系)
    // -------------------------------------------------------------------------
    /// 本地文件 Tab 切换
    callback select-local-tab(string /* tab_id */);
    /// 本地文件 Tab 关闭
    callback close-local-tab(string /* tab_id */);
    /// 新建本地文件 Tab
    callback new-local-tab();
    /// 远程文件 Tab 切换
    callback select-remote-tab(string /* tab_id */);
    /// 远程文件 Tab 关闭
    callback close-remote-tab(string /* tab_id */);
    /// 新建远程文件 Tab
    callback new-remote-tab();
    /// 导航本地路径
    callback navigate-local-path(string /* path */);
    /// 导航远程路径
    callback navigate-remote-path(string /* path */);
    /// 导航本地历史后退 / 前进
    callback navigate-local-back();
    callback navigate-local-forward();
    /// 导航远程历史后退 / 前进
    callback navigate-remote-back();
    callback navigate-remote-forward();
    /// 导航本地上级目录
    callback navigate-local-up();
    /// 导航远程上级目录
    callback navigate-remote-up();

    /// 打开本地文件/目录

    callback open-local-item(string /* path */, bool /* is_dir */);
    /// 打开远程文件/目录
    callback open-remote-item(string /* path */, bool /* is_dir */);
    /// 展开/折叠本地目录树
    callback toggle-local-expand(string /* path */);
    /// 展开/折叠远程目录树
    callback toggle-remote-expand(string /* path */);
    /// 刷新本地文件列表
    callback refresh-local-files();
    /// 刷新远程文件列表
    callback refresh-remote-files();
    /// 上传选中本地文件到远程
    callback upload-file();
    /// 下载选中远程文件到本地
    callback download-file();
    /// 清空已完成的传输任务
    callback clear-completed-transfers();
    /// 触发文件/目录拖拽传输任务 (支持单文件与多层级文件夹树)
    callback start-transfer-task(string /* direction */, string /* source_path */, string /* filename */, bool /* is_dir */, string /* target_path */);
    /// 展开/折叠传输队列中的文件夹任务
    callback toggle-transfer-expand(string /* task_id */);
    /// 在文件页面从左侧双击主机打开远程文件会话
    callback open-host-files(string /* host_id */);
    /// 传输任务右键快捷操作 ("pause" | "resume" | "stop" | "retry" | "remove")
    callback transfer-action(string /* action */, string /* task_id */);
    /// 文件/目录右键快捷操作 ("open" | "transfer" | "create_folder" | "create_file" | "delete" | "refresh")
    callback file-action(string /* action */, bool /* is_remote */, string /* path */, string /* name */, bool /* is_dir */);
    /// 复制文本到系统剪贴板
    callback copy-to-clipboard(string /* text */);
    /// 文件夹 Tab 拖拽调整顺序回调 (仅在同栏内生效)
    callback reorder-local-tab(int /* from_index */, int /* to_index */);
    callback reorder-remote-tab(int /* from_index */, int /* to_index */);

    // -------------------------------------------------------------------------
    // 全局气泡通知 (Toast) 状态与回调
    // -------------------------------------------------------------------------
    in property <[ToastItemData]> active-toasts: [];
    in property <string> toast-position: "top-right";
    callback close-toast(string /* id */);

    // -------------------------------------------------------------------------
    // 统一错误与消息提示弹窗状态
    // -------------------------------------------------------------------------
    /// 提示弹窗显隐开关
    in-out property <bool> is-dialog-open: false;
    /// 提示弹窗标题
    in-out property <string> dialog-title: "提示";
    /// 提示详情文本
    in-out property <string> dialog-message: "";
    /// 提示类型 ("error" | "warning" | "info")
    in-out property <string> dialog-type: "error";

    /// 左右双盘历史记录前进/后退使能状态
    in property <bool> local-can-go-back: false;
    in property <bool> local-can-go-forward: false;
    in property <bool> remote-can-go-back: false;
    in property <bool> remote-can-go-forward: false;
    /// 传输队列面板展开/折叠状态
    in-out property <bool> is-transfer-queue-expanded: false;

    // -------------------------------------------------------------------------
    // 文件会话选择弹窗 (FileHostModal) 状态与交互
    // -------------------------------------------------------------------------
    in-out property <bool> is-file-host-modal-open: false;
    in property <[HostItemData]> file-launcher-host-items: [];
    callback filter-file-launcher(string /* query */);
    callback open-file-host(string /* host_id */);











    // 全局快捷键拦截 (支持 F12 或 Ctrl+Shift+D 随时呼出调试弹窗)
    forward-focus: main-focus;
    main-focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K" || event.text == "p" || event.text == "P") {
                root.is-command-palette-open = !root.is-command-palette-open;
                accept
            } else if (event.text == Key.F12 || (event.modifiers.control && event.modifiers.shift && (event.text == "d" || event.text == "D"))) && root.is-debug-enabled {
                root.is-debug-modal-open = !root.is-debug-modal-open;
                accept
            } else if event.text == Key.Escape {

                if root.is-command-palette-open {
                    root.is-command-palette-open = false;
                    accept
                } else if root.is-debug-modal-open {
                    root.is-debug-modal-open = false;
                    accept
                } else if root.is-create-group-open {
                    root.is-create-group-open = false;
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }
    }

    // 顶层主容器 (外层带边框圆角)
    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: AppTheme.window-background;
        clip: true;

        // 全局磨砂壁纸层 (当 wallpaper-mode == "global" 且图像有效时展示)
        if root.wallpaper-mode == "global" && root.global-wallpaper-image.width > 0: Image {
            source: root.global-wallpaper-image;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.global-wallpaper-opacity;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;


            // 1. 顶层全宽控制栏 (TabBar + 纯净系统窗口控制)
            TabBar {
                is-maximized: root.is-window-maximized;
                is-dark-mode: root.is-dark-mode;
                active-tab-id: root.active-session-tab;
                tabs: root.tabs;
                select-tab(id) => {
                    root.main-view = "terminal";
                    root.select-tab(id);
                }
                close-tab(id) => { root.close-tab(id); }
                new-tab => {
                    root.main-view = "terminal";
                    root.new-tab();
                }
                minimize-window => { root.minimize-window(); }
                maximize-window => {
                    root.maximize-window();
                }
                close-window => { root.close-window(); }
            }

            // 2. 中间五栏主工作区 (整齐划一平铺)
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 0px;
                spacing: 0px;

                // 2.1 最左侧 48px 动态数据驱动活动图标栏
                LeftActivityBar {
                    active-tab: root.active-left-tab;
                    top-items: root.top-activity-items;
                    bottom-items: root.bottom-activity-items;
                    is-dark-mode: root.is-dark-mode;
                    toggle-color-mode => { root.toggle-color-mode(); }
                    tab-clicked(id) => {
                        root.activity-tab-switched(id);
                        if id == "debug" {
                            // 点击调试图标直接唤起全局独立浮动弹窗
                            root.is-debug-modal-open = !root.is-debug-modal-open;
                        } else if id == "history" {
                            // 切换至独立全屏历史中心大页面 (无终端视口干扰)
                            root.active-left-tab = "history";
                            root.main-view = "history";
                            root.is-left-drawer-open = false;
                            root.navigate-to("history", "");
                        } else if id == "files" {
                            // 切换至文件管理页面：左侧展示主机树抽屉，中央展示双盘文件管理器
                            root.active-left-tab = "files";
                            root.main-view = "files";
                            root.is-left-drawer-open = true;
                            root.navigate-to("files", "");
                        } else {
                            // 资产与设置抽屉：切回终端工作区 + 展开对应抽屉
                            root.main-view = "terminal";
                            if root.active-left-tab == id && root.is-left-drawer-open {
                                root.is-left-drawer-open = false;
                            } else {
                                root.active-left-tab = id;
                                root.is-left-drawer-open = true;
                            }
                            root.navigate-to(id, "");
                        }
                    }
                }


                // 2.2 左侧可伸缩二级抽屉
                if root.is-left-drawer-open: Rectangle {
                    width: root.left-drawer-width;
                    clip: true;

                    if root.active-left-tab == "hosts" || root.active-left-tab == "files": HostsDrawer {
                        width: 100%;
                        height: 100%;
                        view-mode <=> root.hosts-view-mode;
                        tree-content-width: root.tree-content-width;
                        collapse => { root.is-left-drawer-open = false; }
                        tree-nodes: root.tree-nodes;
                        hosts: root.hosts;
                        is-dragging <=> root.is-dragging;
                        drag-source-id <=> root.drag-source-id;
                        drag-source-name <=> root.drag-source-name;
                        drag-source-is-group <=> root.drag-source-is-group;
                        drop-target-id <=> root.drop-target-id;
                        drop-target-name <=> root.drop-target-name;
                        drop-target-index <=> root.drop-target-index;
                        drop-position <=> root.drop-position;
                        drop-target-valid <=> root.drop-target-valid;
                        drag-x <=> root.drag-x;
                        drag-y <=> root.drag-y;
                        toggle-group(id) => { root.toggle-tree-group(id); }
                        move-node(src, target, pos) => { root.move-tree-node(src, target, pos); }
                        request-drag-hover(src, idx, offset) => { root.request-drag-hover(src, idx, offset); }
                        search-changed(query) => { root.filter-hosts(query); }
                        create-new-group => { root.is-create-group-open = true; }
                        host-double-clicked(id) => {
                            if root.main-view == "files" {
                                root.open-host-files(id);
                            } else {
                                root.open-host(id);
                            }
                        }
                        open-local-shell(type) => { root.open-host("local-" + type); }
                    }

                    if root.active-left-tab == "credentials": CredentialsDrawer {
                        collapse => { root.is-left-drawer-open = false; }
                    }


                    if root.active-left-tab == "snippets": SnippetsDrawer {
                        collapse => { root.is-left-drawer-open = false; }
                        execute-snippet(cmd) => { root.send-snippet(cmd); }
                    }

                    if root.active-left-tab == "tunnels": TunnelsDrawer {
                        collapse => { root.is-left-drawer-open = false; }
                    }

                    if root.active-left-tab == "backup": BackupDrawer {
                        collapse => { root.is-left-drawer-open = false; }
                    }

                    if root.active-left-tab == "settings": SettingsDrawer {
                        is-debug-enabled <=> root.is-debug-enabled;
                        collapse => { root.is-left-drawer-open = false; }
                        switch-theme(id) => { root.switch-theme(id); }
                        toggle-debug-enabled(enabled) => { root.toggle-debug-enabled(enabled); }
                    }
                }


                // 2.2.1 左侧可拖拽调宽分割条 (可见实体竖条，带左右 1px 边框，与侧栏同色)
                if root.is-left-drawer-open: Rectangle {
                    width: 5px;
                    background: left-split-touch.has-hover || left-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    left-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.left-drawer-width = Math.max(160px, Math.min(520px, root.left-drawer-width + self.mouse-x - self.pressed-x));
                            }
                        }
                        double-clicked => {
                            root.left-drawer-width = 240px;
                        }
                    }
                }

                // 2.3.1 全屏历史中心页面 (当 main-view == "history" 时全屏展开，彻底隐藏终端与多栏)
                if root.main-view == "history": HistoryCenterView {
                    horizontal-stretch: 1;
                    history-groups: root.history-groups;
                    total-count: root.history-total-count;
                    has-active-terminal: root.has-active-session;
                    search-query <=> root.history-search-query;

                    reconnect(id) => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                        root.reconnect-history(id);
                    }
                    show-detail(id) => { root.show-history-detail(id); }
                    delete-item(id) => { root.delete-history-item(id); }

                    clear-all => { root.clear-history(); }
                    toggle-pin(id) => { root.toggle-pin-history(id); }
                    toggle-group(id) => { root.toggle-history-group(id); }
                    search-changed(q) => { root.filter-history(q); }
                    switch-to-terminal => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                    }

                }



                // 2.3.2 中央终端视口 (内置终端多会话 Tab 栏，随抽屉伸缩自适应拉满全部剩余空间)
                viewport := TerminalViewport {
                    visible: root.main-view == "terminal";
                    horizontal-stretch: root.main-view == "terminal" ? 1 : 0;
                    min-width: 0px;
                    max-width: root.main-view == "terminal" ? 100000px : 0px;

                    has-active-session: root.has-active-session;

                    tabs: root.tabs;
                    active-tab-id: root.active-session-tab;


                    select-tab(id) => { root.select-tab(id); }
                    close-tab(id) => { root.close-tab(id); }
                    select-pane-tab(pane_id, tab_id) => { root.select-pane-tab(pane_id, tab_id); }
                    close-pane-tab(pane_id, tab_id) => { root.close-pane-tab(pane_id, tab_id); }
                    copy-tab-ip(tab_id) => { root.copy-tab-ip(tab_id); }
                    close-other-tabs(pane_id, tab_id) => { root.close-other-tabs(pane_id, tab_id); }
                    new-tab => { root.is-new-session-modal-open = true; }


                    session-name: root.active-session-name;
                    host-address: root.active-host-address;
                    ping-ms: root.active-host-ping-ms;
                    terminal-screen-image: root.terminal-screen-image;
                    terminal-split-image: root.terminal-split-image;
                    terminal-split2-image: root.terminal-split2-image;
                    terminal-split3-image: root.terminal-split3-image;
                    is-split <=> root.is-split;
                    split-count <=> root.split-count;
                    split-orientation <=> root.split-orientation;
                    split-ratio <=> root.split-ratio;
                    active-pane-index <=> root.active-pane-index;
                    active-pane-id <=> root.active-pane-id;
                    terminal-panes: root.terminal-panes;
                    terminal-splitters: root.terminal-splitters;
                    split-session-name: root.split-session-name;
                    split2-session-name: root.split2-session-name;
                    split3-session-name: root.split3-session-name;
                    history-size: root.terminal-history-size;
                    scroll-offset: root.terminal-scroll-offset;
                    wallpaper-mode: root.wallpaper-mode;
                    terminal-wallpaper-image: root.terminal-wallpaper-image;
                    terminal-wallpaper-opacity: root.terminal-wallpaper-opacity;
                    terminal-key-input(text, is_ctrl, is_shift, is_alt) => { root.terminal-key-input(text, is_ctrl, is_shift, is_alt); }


                    terminal-scroll(delta) => { root.terminal-scroll(delta); }
                    terminal-selection-changed(sc, sr, ec, er, has_sel) => { root.terminal-selection-changed(sc, sr, ec, er, has_sel); }
                    copy-text => { root.terminal-copy(); }
                    paste-text => { root.terminal-paste(); }

                    clear-screen => { root.terminal-clear(); }
                    split-terminal(orient) => { root.split-terminal(orient); }
                    close-split => { root.close-split(); }
                    close-pane-by-index(idx) => { root.close-pane-by-index(idx); }
                    close-pane-by-id(id) => { root.close-pane-by-id(id); }
                    select-pane(idx) => { root.select-pane(idx); }
                    select-pane-by-id(id) => { root.select-pane-by-id(id); }
                    toggle-pane-zoom(id) => { root.toggle-pane-zoom(id); }
                    adjust-splitter(id, delta) => { root.adjust-splitter(id, delta); }

                    search-terminal(q, c) => { root.search-terminal(q, c); }
                    terminal-resize(cols, rows) => { root.terminal-resize(cols, rows); }
                    move-terminal-tab(from_pid, from_idx, drop_x, drop_y) => { root.move-terminal-tab(from_pid, from_idx, drop_x, drop_y); }
                }

                // 2.3.3 双盘文件管理与 SFTP 传输视图 (当 main-view == "files" 时展开)
                file_explorer := FileExplorerView {
                    visible: root.main-view == "files";
                    horizontal-stretch: root.main-view == "files" ? 1 : 0;
                    min-width: 0px;
                    max-width: root.main-view == "files" ? 100000px : 0px;

                    local-tabs: root.local-tabs;
                    active-local-tab-id: root.active-local-tab-id;
                    remote-tabs: root.remote-tabs;
                    active-remote-tab-id: root.active-remote-tab-id;
                    local-current-path: root.local-current-path;
                    remote-current-path: root.remote-current-path;
                    local-files: root.local-files;
                    remote-files: root.remote-files;
                    selected-local-id <=> root.selected-local-id;
                    selected-remote-id <=> root.selected-remote-id;
                    transfer-tasks: root.transfer-tasks;

                    select-local-tab(id) => { root.select-local-tab(id); }
                    close-local-tab(id) => { root.close-local-tab(id); }
                    new-local-tab => { root.new-local-tab(); }
                    select-remote-tab(id) => { root.select-remote-tab(id); }
                    close-remote-tab(id) => { root.close-remote-tab(id); }
                    new-remote-tab => {
                        root.filter-file-launcher("");
                        root.is-file-host-modal-open = true;
                    }

                    navigate-local-path(p) => { root.navigate-local-path(p); }
                    navigate-remote-path(p) => { root.navigate-remote-path(p); }
                    navigate-local-up => { root.navigate-local-up(); }
                    navigate-remote-up => { root.navigate-remote-up(); }
                    open-local-item(p, is_dir) => { root.open-local-item(p, is_dir); }
                    open-remote-item(p, is_dir) => { root.open-remote-item(p, is_dir); }
                    toggle-local-expand(p) => { root.toggle-local-expand(p); }
                    toggle-remote-expand(p) => { root.toggle-remote-expand(p); }
                    local-can-go-back: root.local-can-go-back;
                    local-can-go-forward: root.local-can-go-forward;
                    remote-can-go-back: root.remote-can-go-back;
                    remote-can-go-forward: root.remote-can-go-forward;

                    navigate-local-back => { root.navigate-local-back(); }
                    navigate-local-forward => { root.navigate-local-forward(); }
                    navigate-remote-back => { root.navigate-remote-back(); }
                    navigate-remote-forward => { root.navigate-remote-forward(); }

                    refresh-local => { root.refresh-local-files(); }
                    refresh-remote => { root.refresh-remote-files(); }
                    clear-completed-transfers => { root.clear-completed-transfers(); }
                    start-transfer-task(dir, src, name, is_dir, target) => { root.start-transfer-task(dir, src, name, is_dir, target); }
                    toggle-transfer-expand(id) => { root.toggle-transfer-expand(id); }
                    transfer-action(act, tid) => { root.transfer-action(act, tid); }
                    file-action(act, rem, p, name, is_dir) => { root.file-action(act, rem, p, name, is_dir); }
                    copy-to-clipboard(text) => { root.copy-to-clipboard(text); }
                    reorder-local-tab(from, to) => { root.reorder-local-tab(from, to); }
                    reorder-remote-tab(from, to) => { root.reorder-remote-tab(from, to); }
                    is-transfer-queue-expanded <=> root.is-transfer-queue-expanded;
                }











                // 2.3.1 右侧可拖拽调宽分割条 (仅在终端工作区展开右侧抽屉时展示)
                if root.is-right-drawer-open && root.main-view == "terminal": Rectangle {
                    width: 5px;
                    background: right-split-touch.has-hover || right-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    right-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.right-drawer-width = Math.max(180px, Math.min(520px, root.right-drawer-width - (self.mouse-x - self.pressed-x)));
                            }
                        }
                        double-clicked => {
                            root.right-drawer-width = 240px;
                        }
                    }
                }

                // 2.4 右侧可伸缩工具抽屉 (仅在终端工作区展开时展示)
                if root.is-right-drawer-open && root.main-view == "terminal": Rectangle {
                    width: root.right-drawer-width;
                    clip: true;

                    if root.active-right-tool == "monitor": MonitorDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "snippets": SnippetToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                        send-to-terminal(cmd) => { root.send-snippet(cmd); }
                    }

                    if root.active-right-tool == "sftp": SftpToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "notes": NotesToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "ai": AiToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                        apply-suggested-cmd(cmd) => { root.send-snippet(cmd); }
                    }
                }

                // 2.5 最右侧 48px 工具图标栏 (仅在终端工作区展示)
                if root.main-view == "terminal": RightToolBar {
                    active-tool: root.active-right-tool;
                    tool-clicked(id) => {
                        if root.active-right-tool == id && root.is-right-drawer-open {
                            root.is-right-drawer-open = false;
                        } else {
                            root.active-right-tool = id;
                            root.is-right-drawer-open = true;
                        }
                    }
                }

            }

            // 3. 底层全宽状态栏
            StatusBar {
                current-theme-name: root.current-theme-name;
                is-debug-open: root.is-debug-modal-open;
                toggle-debug-panel => {
                    root.is-debug-modal-open = !root.is-debug-modal-open;
                }
            }
        }
    }

    // 浮动 Ctrl+K 指令面板
    CommandPalette {
        is-open: root.is-command-palette-open;
        close => { root.is-command-palette-open = false; }
        item-selected(id) => {
            if id == "5" {
                root.switch-theme("builtin.ui.darcula");
            } else if id == "6" {
                root.switch-theme("builtin.ui.monokai");
            } else {
                root.open-host(id);
            }
        }
    }

    // 新建主机分组弹窗 (支持树状层级上级选择与名称输入)
    CreateGroupModal {
        is-open: root.is-create-group-open;
        default-parent-id: root.create-group-default-parent;
        group-options: root.group-options;
        toggle-group(id) => { root.toggle-group-option(id); }
        close => { root.is-create-group-open = false; }
        confirm(parent-id, name) => {
            root.create-group(parent-id, name);
            root.is-create-group-open = false;
        }
    }

    // 独立浮动开发者调试与批量数据控制弹窗 (全页面任意时刻可呼出)
    DebugModal {
        is-open: root.is-debug-modal-open;
        total-nodes-count: root.tree-nodes.length;
        visible-nodes-count: root.tree-nodes.length;
        host-cards-count: root.hosts.length;
        tree-viewport-width: root.tree-content-width;
        current-theme-name: root.current-theme-name;
        is-dark-mode: root.is-dark-mode;
        logs: root.debug-logs;
        close => { root.is-debug-modal-open = false; }
        batch-generate(prefix, count, ip-prefix, start-ip, port, group, status-mode, overwrite) => {
            root.debug-batch-generate(prefix, count, ip-prefix, start-ip, port, group, status-mode, overwrite);
        }
        batch-update-status(status-mode) => {
            root.debug-batch-update-status(status-mode);
        }
        batch-update-port(port) => {
            root.debug-batch-update-port(port);
        }
        inject-preset(id) => { root.debug-inject-preset(id); }
        quick-add-host(name, ip, port, group) => { root.debug-quick-add-host(name, ip, port, group); }
        quick-add-group(name, parent-id) => { root.debug-quick-add-group(name, parent-id); }
        clear-all-data => { root.debug-clear-data(); }
        reset-default-data => { root.debug-reset-default-data(); }
        clear-logs => { root.debug-clear-logs(); }
        emit-test-log(level) => { root.debug-emit-test-log(level); }
        switch-theme(id) => { root.switch-theme(id); }
        toggle-color-mode => { root.toggle-color-mode(); }
        active-pipeline: root.active-rendering-pipeline;
        switch-pipeline(id) => { root.debug-switch-pipeline(id); }
        save-pipeline => { root.debug-apply-pipeline(); }
        restart-app => { root.debug-restart-app(); }
        force-repaint => { root.debug-force-repaint(); }
        run-benchmark => { root.debug-run-benchmark(); }
    }




    // 快速新建终端会话居中卡片弹窗
    NewSessionModal {
        is-open: root.is-new-session-modal-open;
        local-items: root.launcher-local-items;
        host-items: root.launcher-host-items;
        close => { root.is-new-session-modal-open = false; }
        search-changed(q) => { root.filter-launcher(q); }
        item-selected(id) => {
            root.is-new-session-modal-open = false;
            root.open-host(id);
        }
    }

    // 会话历史详情与终端屏幕快照弹窗
    HistoryDetailModal {
        is-open: root.is-history-detail-open;
        history-id: root.history-detail-id;
        session-title: root.history-detail-title;
        session-address: root.history-detail-address;
        session-user: root.history-detail-user;
        session-type: root.history-detail-type;
        connected-time: root.history-detail-connected-time;
        disconnected-time: root.history-detail-disconnected-time;
        duration-text: root.history-detail-duration;
        exit-status: root.history-detail-exit-status;
        error-msg: root.history-detail-error-msg;
        snapshot-content: root.history-detail-snapshot;
        snapshot-lines: root.history-detail-snapshot-lines;
        close => { root.is-history-detail-open = false; }
        reconnect(id) => {
            root.is-history-detail-open = false;
            root.main-view = "terminal";
            root.active-left-tab = "hosts";
            root.is-left-drawer-open = true;
            root.reconnect-history(id);
        }

        copy-log(text) => { root.copy-history-log(text); }
    }

    // 通用消息与错误提示模态弹窗
    MessageDialog {
        is-open <=> root.is-dialog-open;
        title: root.dialog-title;
        message: root.dialog-message;
        dialog-type: root.dialog-type;
        close => { root.is-dialog-open = false; }
    }

    // 文件管理会话选择居中卡片弹窗 (单一本地域 + 远程全部主机，点击自动连接 SFTP)
    FileHostModal {
        is-open: root.is-file-host-modal-open;
        host-items: root.file-launcher-host-items;
        close => { root.is-file-host-modal-open = false; }
        search-changed(q) => { root.filter-file-launcher(q); }
        local-selected => {
            root.is-file-host-modal-open = false;
            root.open-file-host("local");
        }

        host-selected(id) => {
            root.is-file-host-modal-open = false;
            root.open-file-host(id);
        }
    }

    // 全局气泡通知浮层 (z: 1000 最高层级)
    ToastContainer {
        z: 1000;
        toasts: root.active-toasts;
        position: root.toast-position;
        close-toast(id) => { root.close-toast(id); }
    }
}




