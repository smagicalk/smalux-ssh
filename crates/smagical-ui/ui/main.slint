    in-out property <string> theme-editor-picker-target-label: "窗口底色";

    callback open-theme-editor();
    callback theme-editor-color-changed(string, string);
    callback theme-editor-metric-changed(string, string);
    callback theme-editor-meta-changed(string, string);
    callback theme-editor-parse-toml(string);
    callback theme-editor-copy-toml(string);
    callback theme-editor-apply-preset(string);
    callback theme-editor-save-and-activate();

    callback theme-editor-wheel-coord-picked(float, float);
    callback theme-editor-wheel-brightness-picked(float);
    callback theme-editor-picker-hex-changed(string);











    // 全局快捷键拦截 (支持 F12 或 Ctrl+Shift+D 随时呼出调试弹窗)
    forward-focus: main-focus;
    main-focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K" || event.text == "p" || event.text == "P") {
                root.is-command-palette-open = !root.is-command-palette-open;
                accept
            } else if (event.text == Key.F12 || (event.modifiers.control && event.modifiers.shift && (event.text == "d" || event.text == "D"))) && root.is-debug-enabled {
                root.is-debug-modal-open = !root.is-debug-modal-open;
                accept
            } else if event.text == Key.Escape {

                if root.is-command-palette-open {
                    root.is-command-palette-open = false;
                    accept
                } else if root.is-debug-modal-open {
                    root.is-debug-modal-open = false;
                    accept
                } else if root.is-create-group-open {
                    root.is-create-group-open = false;
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }
    }

    // 顶层主容器 (外层带边框圆角与固态底基)
    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: AppTheme.base-window-background;
        clip: true;

        // 全局壁纸层 (双缓冲淡入淡出，平滑过渡，绝不卡顿)
        if root.wallpaper-mode == "global" && root.prev-wallpaper-image.width > 0 && root.wallpaper-crossfade < 1.0: Image {
            source: root.prev-wallpaper-image;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.global-wallpaper-opacity * (1.0 - root.wallpaper-crossfade);
        }

        if root.wallpaper-mode == "global" && root.global-wallpaper-image.width > 0: Image {
            source: root.global-wallpaper-image;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.global-wallpaper-opacity * root.wallpaper-crossfade;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;


            // 1. 顶层全宽控制栏 (TabBar + 纯净系统窗口控制)
            TabBar {
                is-maximized: root.is-window-maximized;
                is-dark-mode: root.is-dark-mode;
                active-tab-id: root.active-session-tab;
                tabs: root.tabs;
                select-tab(id) => {
                    root.main-view = "terminal";
                    root.select-tab(id);
                }
                close-tab(id) => { root.close-tab(id); }
                new-tab => {
                    root.main-view = "terminal";
                    root.new-tab();
                }
                minimize-window => { root.minimize-window(); }
                maximize-window => {
                    root.maximize-window();
                }
                close-window => { root.close-window(); }
                start-window-drag => { root.start-window-drag(); }
            }

            // 2. 中间五栏主工作区 (整齐划一平铺)
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 0px;
                spacing: 0px;

                // 2.1 最左侧 48px 动态数据驱动活动图标栏
                LeftActivityBar {
                    active-tab: root.active-left-tab;
                    top-items: root.top-activity-items;
                    bottom-items: root.bottom-activity-items;
                    is-dark-mode: root.is-dark-mode;
                    toggle-color-mode => { root.toggle-color-mode(); }
                    tab-clicked(id) => {
                        root.activity-tab-switched(id);
                        if id == "debug" {
                            // 点击调试图标直接唤起全局独立浮动弹窗
                            root.is-debug-modal-open = !root.is-debug-modal-open;
                        } else if id == "history" {
                            // 切换至独立全屏历史中心大页面 (无终端视口干扰)
                            root.active-left-tab = "history";
                            root.main-view = "history";
                            root.is-left-drawer-open = false;
                            root.navigate-to("history", "");
                        } else if id == "credentials" {
                            // 切换至独立全屏凭据中心大页面 (左侧列表 + 右侧详情编辑，无右侧工具栏)
                            root.active-left-tab = "credentials";
                            root.main-view = "credentials";
                            root.is-left-drawer-open = false;
                            root.navigate-to("credentials", "");
                        } else if id == "snippets" {
                            // 切换至独立全屏代码片段中心大页面 (左侧多层树形 + 右侧沉浸式编辑器)
                            root.active-left-tab = "snippets";
                            root.main-view = "snippets";
                            root.is-left-drawer-open = false;
                            root.navigate-to("snippets", "");
                        } else if id == "tunnels" {
                            // 切换至独立全屏网络与隧道中心大页面 (左侧规则列表 + 右侧拓扑与指标详情)
                            root.active-left-tab = "tunnels";
                            root.main-view = "tunnels";
                            root.is-left-drawer-open = false;
                            root.navigate-to("tunnels", "");
                        } else if id == "files" {
                            // 切换至文件管理页面：左侧展示主机树抽屉，中央展示双盘文件管理器
                            root.active-left-tab = "files";
                            root.main-view = "files";
                            root.is-left-drawer-open = true;
                            root.navigate-to("files", "");
                        } else if id == "settings" {
                            // 切换至独立全屏偏好设置中心大页面 (含外观、终端、网络、快捷键与数据备份)
                            root.active-left-tab = "settings";
                            root.main-view = "settings";
                            root.is-left-drawer-open = false;
                            root.navigate-to("settings", "");
                        } else {
                            // 资产与设置抽屉：切回终端工作区 + 展开对应抽屉
                            root.main-view = "terminal";
                            if root.active-left-tab == id && root.is-left-drawer-open {
                                root.is-left-drawer-open = false;
                            } else {
                                root.active-left-tab = id;
                                root.is-left-drawer-open = true;
                            }
                            root.navigate-to(id, "");
                        }
                    }
                }


                // 2.2 左侧可伸缩二级抽屉
                if root.is-left-drawer-open: Rectangle {
                    width: root.left-drawer-width;
                    clip: true;

                    if root.active-left-tab == "hosts" || root.active-left-tab == "files": HostsDrawer {
                        width: 100%;
                        height: 100%;
                        view-mode <=> root.hosts-view-mode;
                        tree-content-width: root.tree-content-width;
                        collapse => { root.is-left-drawer-open = false; }
                        tree-nodes: root.tree-nodes;
                        hosts: root.hosts;
                        is-dragging <=> root.is-dragging;
                        drag-source-id <=> root.drag-source-id;
                        drag-source-name <=> root.drag-source-name;
                        drag-source-is-group <=> root.drag-source-is-group;
                        drop-target-id <=> root.drop-target-id;
                        drop-target-name <=> root.drop-target-name;
                        drop-target-index <=> root.drop-target-index;
                        drop-position <=> root.drop-position;
                        drop-target-valid <=> root.drop-target-valid;
                        drag-x <=> root.drag-x;
                        drag-y <=> root.drag-y;
                        toggle-group(id) => { root.toggle-tree-group(id); }
                        move-node(src, target, pos) => { root.move-tree-node(src, target, pos); }
                        request-drag-hover(src, idx, offset) => { root.request-drag-hover(src, idx, offset); }
                        search-changed(query) => { root.filter-hosts(query); }
                        create-new-group => { root.is-create-group-open = true; }
                        host-double-clicked(id) => {
                            if root.main-view == "files" {
                                root.open-host-files(id);
                            } else {
                                root.open-host(id);
                            }
                        }
                        open-local-shell(type) => { root.open-host("local-" + type); }
                    }

                    if root.active-left-tab == "credentials": CredentialsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { root.is-left-drawer-open = false; }
                        credentials: root.credentials;
                        filter-category <=> root.credential-filter-category;
                        search-query <=> root.credential-search-query;
                        active-cred-id <=> root.active-credential-id;

                        select-cred(id) => { root.select-credential(id); }
                        open-create-modal => { root.open-create-credential-modal(); }
                        edit-cred(id) => { root.select-credential(id); }
                        delete-cred(id) => { root.delete-credential(id); }
                        copy-secret(id) => { root.copy-credential-secret(id); }
                        search-changed(q) => { root.filter-credentials(root.credential-filter-category, q); }
                        filter-category-changed(cat) => { root.filter-credentials(cat, root.credential-search-query); }
                    }


                    if root.active-left-tab == "snippets": SnippetsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { root.is-left-drawer-open = false; }
                        tree-nodes: root.snippet-tree-nodes;
                        search-query <=> root.snippet-search-query;
                        selected-id <=> root.snippet-selected-id;
                        search-changed(q) => { root.filter-snippets-tree(q); }
                        toggle-group(id) => { root.toggle-snippet-group-expanded(id); }
                        select-node(id, is_grp) => { root.select-snippet-node(id, is_grp); }
                        create-new-group => { root.open-create-snippet-group(); }
                        create-new-snippet => { root.open-create-snippet(); }
                        execute-snippet(id) => { root.execute-snippet-from-center(id); }
                        move-node(src, tgt, pos) => { root.move-snippet-tree-node(src, tgt, pos); }
                        request-drag-hover(src, idx, off) => { root.request-snippet-drag-hover(src, idx, off); }
                    }

                    if root.active-left-tab == "tunnels": TunnelsDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { root.is-left-drawer-open = false; }
                        tunnels: root.tunnels;
                        toggle-tunnel(id) => { root.toggle-tunnel-running(id); }
                        open-hub => {
                            root.main-view = "tunnels";
                            root.is-left-drawer-open = false;
                        }
                    }

                    if root.active-left-tab == "backup": BackupDrawer {
                        width: 100%;
                        height: 100%;
                        collapse => { root.is-left-drawer-open = false; }
                    }

                    if root.active-left-tab == "settings": SettingsDrawer {
                        width: 100%;
                        height: 100%;
                        is-debug-enabled <=> root.is-debug-enabled;
                        collapse => { root.is-left-drawer-open = false; }
                        switch-theme(id) => { root.switch-theme(id); }
                        toggle-debug-enabled(enabled) => { root.toggle-debug-enabled(enabled); }
                    }
                }


                // 2.2.1 左侧可拖拽调宽分割条 (可见实体竖条，带左右 1px 边框，与侧栏同色)
                if root.is-left-drawer-open: Rectangle {
                    width: 5px;
                    background: left-split-touch.has-hover || left-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    left-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.left-drawer-width = Math.max(160px, Math.min(520px, root.left-drawer-width + self.mouse-x - self.pressed-x));
                            }
                        }
                        double-clicked => {
                            root.left-drawer-width = 240px;
                        }
                    }
                }

                // 2.3.1 全屏历史中心页面 (当 main-view == "history" 时全屏展开，彻底隐藏终端与多栏)
                if root.main-view == "history": HistoryCenterView {
                    horizontal-stretch: 1;
                    history-groups: root.history-groups;
                    total-count: root.history-total-count;
                    has-active-terminal: root.has-active-session;
                    search-query <=> root.history-search-query;

                    reconnect(id) => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                        root.reconnect-history(id);
                    }
                    show-detail(id) => { root.show-history-detail(id); }
                    delete-item(id) => { root.delete-history-item(id); }

                    clear-all => { root.clear-history(); }
                    toggle-pin(id) => { root.toggle-pin-history(id); }
                    toggle-group(id) => { root.toggle-history-group(id); }
                    search-changed(q) => { root.filter-history(q); }
                    switch-to-terminal => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                    }

                }

                // 2.3.2 全屏凭据管理中心 (当 main-view == "credentials" 时展开，左侧列表 + 右侧详情编辑，隐藏终端与右侧工具栏)
                if root.main-view == "credentials": CredentialsCenterView {
                    horizontal-stretch: 1;
                    credentials: root.credentials;
                    filter-category <=> root.credential-filter-category;
                    search-query <=> root.credential-search-query;
                    active-cred-id <=> root.active-credential-id;

                    is-create-mode <=> root.is-credential-create-mode;
                    is-editing <=> root.is-credential-editing;
                    form-id <=> root.credential-form-id;
                    form-name <=> root.credential-form-name;
                    form-type <=> root.credential-form-type;
                    form-algorithm <=> root.credential-form-algorithm;
                    form-username <=> root.credential-form-username;
                    form-secret-data <=> root.credential-form-secret-data;
                    form-passphrase <=> root.credential-form-passphrase;
                    form-public-key <=> root.credential-form-public-key;
                    form-fingerprint <=> root.credential-form-fingerprint;
                    form-notes <=> root.credential-form-notes;
                    form-bound-host-count <=> root.credential-form-bound-host-count;
                    form-updated-at <=> root.credential-form-updated-at;

                    select-cred(id) => { root.select-credential(id); }
                    start-create => { root.open-create-credential-modal(); }
                    cancel-create => { root.cancel-create-credential(); }
                    start-edit => { root.start-edit-credential(); }
                    cancel-edit => { root.cancel-edit-credential(); }
                    save-cred(id, name, cred_type, algo, user, secret, pass, pub, fp, notes) => {
                        root.save-credential(id, name, cred_type, algo, user, secret, pass, pub, fp, notes);
                    }
                    delete-cred(id) => { root.delete-credential(id); }
                    copy-secret(id) => { root.copy-credential-secret(id); }
                    copy-text(text, title, msg) => { root.copy-custom-text(text, title, msg); }
                    generate-key(algo) => { root.generate-credential-key(algo); }
                    generate-password => { root.generate-credential-password(); }
                    search-changed(q) => { root.filter-credentials(root.credential-filter-category, q); }
                    filter-category-changed(cat) => { root.filter-credentials(cat, root.credential-search-query); }
                    back-to-terminal => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                    }
                }

                // 2.3.3 全屏代码片段管理中心 (当 main-view == "snippets" 时展开，左侧树形分组 + 右侧沉浸式详情)
                if root.main-view == "snippets": SnippetsCenterView {
                    horizontal-stretch: 1;
                    tree_nodes: root.snippet-tree-nodes;
                    search_query <=> root.snippet-search-query;
                    selected_id <=> root.snippet-selected-id;
                    has_selection: root.snippet-has-selection;
                    is_selected_group: root.snippet-is-selected-group;
                    edit_id <=> root.snippet-edit-id;
                    edit_title <=> root.snippet-edit-title;
                    edit_category_name <=> root.snippet-edit-category-name;
                    edit_language <=> root.snippet-edit-language;
                    edit_content <=> root.snippet-edit-content;
                    edit_auto_execute <=> root.snippet-edit-auto-execute;
                    edit_description <=> root.snippet-edit-description;
                    edit_is_favorite <=> root.snippet-edit-is-favorite;
                    detected_variables_text: root.snippet-detected-variables-text;
                    edit_updated_at: root.snippet-edit-updated-at;

                    search_changed(q) => { root.filter-snippets-tree(q); }
                    toggle_group_expanded(id) => { root.toggle-snippet-group-expanded(id); }
                    select_node(id, is_grp) => { root.select-snippet-node(id, is_grp); }
                    toggle_favorite(id) => { root.toggle-snippet-favorite(id); }
                    create_snippet => { root.open-create-snippet(); }
                    create_group => { root.open-create-snippet-group(); }
                    save_snippet => { root.save-snippet-from-center(); }
                    delete_snippet(id) => { root.delete-snippet-node(id); }
                    delete_group(id) => { root.delete-snippet-group-node(id); }
                    copy_content(id) => { root.copy-snippet-text(id); }
                    execute_snippet(id) => { root.execute-snippet-from-center(id); }
                    move_node(src, tgt, pos) => { root.move-snippet-tree-node(src, tgt, pos); }
                    request_drag_hover(src, idx, off) => { root.request-snippet-drag-hover(src, idx, off); }
                }

                // 2.3.4 全屏网络与隧道管理中心 (当 main-view == "tunnels" 时全屏展开)
                if root.main-view == "tunnels": TunnelsCenterView {
                    horizontal-stretch: 1;
                    tunnels: root.tunnels;
                    filter-category <=> root.tunnel-filter-category;
                    search-query <=> root.tunnel-search-query;
                    active-tunnel-id <=> root.active-tunnel-id;

                    is-create-mode <=> root.is-tunnel-create-mode;
                    is-editing <=> root.is-tunnel-editing;
                    form-id <=> root.tunnel-form-id;
                    form-name <=> root.tunnel-form-name;
                    form-type <=> root.tunnel-form-type;
                    form-ssh-host-id <=> root.tunnel-form-ssh-host-id;
                    form-ssh-host-name <=> root.tunnel-form-ssh-host-name;
                    form-local-bind <=> root.tunnel-form-local-bind;
                    form-local-port <=> root.tunnel-form-local-port;
                    form-remote-host <=> root.tunnel-form-remote-host;
                    form-remote-port <=> root.tunnel-form-remote-port;
                    form-auto-start <=> root.tunnel-form-auto-start;
                    form-auto-reconnect <=> root.tunnel-form-auto-reconnect;
                    form-remote-dns <=> root.tunnel-form-remote-dns;
                    form-compression <=> root.tunnel-form-compression;
                    form-is-running <=> root.tunnel-form-is-running;
                    form-active-connections <=> root.tunnel-form-active-connections;
                    form-traffic-in <=> root.tunnel-form-traffic-in;
                    form-traffic-out <=> root.tunnel-form-traffic-out;
                    form-updated-at <=> root.tunnel-form-updated-at;
                    form-ssh-command <=> root.tunnel-form-ssh-command;
                    form-jump-chain <=> root.tunnel-form-jump-chain;
                    form-proxy-proto <=> root.tunnel-form-proxy-proto;
                    form-proxy-username <=> root.tunnel-form-proxy-username;
                    form-proxy-password <=> root.tunnel-form-proxy-password;
                    form-notes <=> root.tunnel-form-notes;
                    tree-nodes: root.tree-nodes;
                    toggle-group(id) => { root.toggle-tree-group(id); }

                    add-jump-hop(id, name, addr, port) => { root.add-tunnel-jump-hop(id, name, addr, port); }
                    remove-jump-hop(idx) => { root.remove-tunnel-jump-hop(idx); }
                    move-jump-hop-up(idx) => { root.move-tunnel-jump-hop-up(idx); }
                    move-jump-hop-down(idx) => { root.move-tunnel-jump-hop-down(idx); }
                    toggle-jump-hop-enabled(idx) => { root.toggle-tunnel-jump-hop-enabled(idx); }

                    select-tunnel(id) => { root.select-tunnel(id); }
                    toggle-tunnel-running(id) => { root.toggle-tunnel-running(id); }
                    start-create => { root.start-create-tunnel(); }
                    start-create-typed(t) => { root.start-create-typed-tunnel(t); }
                    cancel-create => { root.cancel-create-tunnel(); }
                    start-edit => { root.start-edit-tunnel(); }
                    cancel-edit => { root.cancel-edit-tunnel(); }
                    save-tunnel(id, name, t_type, h_id, h_name, l_bind, l_port, r_host, r_port, auto_s, auto_r, r_dns, comp, notes) => {
                        root.save-tunnel(id, name, t_type, h_id, h_name, l_bind, l_port, r_host, r_port, auto_s, auto_r, r_dns, comp, notes);
                    }
                    delete-tunnel(id) => { root.delete-tunnel(id); }
                    copy-ssh-command(id) => { root.copy-tunnel-ssh-command(id); }
                    copy-custom-text(text, title, msg) => { root.copy-custom-text(text, title, msg); }
                    search-changed(q) => {
                        root.tunnel-search-query = q;
                        root.filter-tunnels(root.tunnel-filter-category, q);
                    }
                    filter-category-changed(cat) => {
                        root.tunnel-filter-category = cat;
                        root.filter-tunnels(cat, root.tunnel-search-query);
                    }
                    back-to-terminal => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                    }
                }

                // 2.3.5 全屏偏好设置中心 (当 main-view == "settings" 时全屏展开，含备份迁移、外观、终端排版)
                if root.main-view == "settings": SettingsCenterView {
                    horizontal-stretch: 1;
                    active-category <=> root.active-settings-category;
                    is-dark-mode <=> root.is-dark-mode;
                    setting-debug-enabled <=> root.is-debug-enabled;
                    setting-wallpaper-mode <=> root.wallpaper-mode;
                    setting-wallpaper-opacity <=> root.global-wallpaper-opacity;
                    setting-modal-opacity <=> root.setting-modal-opacity;
                    change-modal-opacity(op) => { root.change-modal-opacity(op); }

                    setting-close-action <=> root.setting-close-action;
                    setting-confirm-close-tab <=> root.setting-confirm-close-tab;
                    setting-confirm-close-active <=> root.setting-confirm-close-active;
                    setting-always-on-top <=> root.setting-always-on-top;
                    setting-start-on-boot <=> root.setting-start-on-boot;
                    active-rendering-pipeline <=> root.active-rendering-pipeline;

                    toggle-always-on-top(c) => { root.toggle-always-on-top(c); }
                    toggle-start-on-boot(c) => { root.toggle-start-on-boot(c); }
                    toggle-confirm-close-tab(c) => { root.toggle-confirm-close-tab(c); }
                    toggle-confirm-close-active(c) => { root.toggle-confirm-close-active(c); }
                    switch-rendering-pipeline(p) => { root.switch-rendering-pipeline(p); }

                    close-settings => {
                        root.main-view = "terminal";
                        root.active-left-tab = "hosts";
                        root.is-left-drawer-open = true;
                    }
                    themes: root.themes;
                    custom-themes: root.custom-themes;
                    dark-themes: root.dark-themes;
                    light-themes: root.light-themes;
                    custom-theme-rows: root.custom-theme-rows;
                    dark-theme-rows: root.dark-theme-rows;
                    light-theme-rows: root.light-theme-rows;
                    custom-themes-count: root.custom-themes-count;
                    dark-themes-count: root.dark-themes-count;
                    light-themes-count: root.light-themes-count;
                    current-theme-id <=> root.current-theme-id;
                    switch-theme(id) => { root.switch-theme(id); }
                    import-theme => { root.import-theme(); }
                    export-current-theme => { root.export-current-theme(); }
                    create-custom-theme => { root.open-theme-editor(); }
                    delete-custom-theme(id) => { root.delete-custom-theme(id); }

                    setting-wallpaper-list <=> root.wallpaper-list;
                    setting-wallpaper-path <=> root.wallpaper-path;
                    setting-wallpaper-active-index <=> root.wallpaper-active-index;
                    setting-wallpaper-slideshow <=> root.wallpaper-slideshow-interval;
                    setting-wallpaper-transition <=> root.wallpaper-transition-effect;
                    add-wallpaper => { root.add-wallpaper-image(); }
                    add-wallpaper-folder => { root.add-wallpaper-folder(); }
                    remove-wallpaper(idx) => { root.remove-wallpaper-image(idx); }
                    select-wallpaper(idx) => { root.select-wallpaper-image(idx); }
                    set-wallpaper-slideshow(interval, transition) => { root.set-wallpaper-slideshow(interval, transition); }

                    toggle-dark-mode => { root.toggle-color-mode(); }
                    toggle-debug-enabled(enabled) => { root.toggle-debug-enabled(enabled); }
                    change-terminal-font(font, size) => { root.set-terminal-font(font, size); }
                    change-wallpaper(mode, path, opacity) => { root.set-wallpaper(mode, path, opacity); }

                    export-backup-archive(inc_pass) => { root.export-backup-archive(inc_pass); }
                    scan-and-import-openssh => { root.scan-and-import-openssh(); }
                    import-external-file => { root.import-external-assets(); }
                    factory-reset-settings => { root.factory-reset-settings(); }

                    setting-language <=> root.current-language;
                    switch-language(lang) => { root.switch-language(lang); }

                    setting-ui-font <=> root.setting-ui-font;
                    available-ui-fonts: root.available-ui-fonts;
                    change-ui-font(f) => { root.change-ui-font(f); }

                    setting-terminal-url-click <=> root.setting-terminal-url-click;
                    setting-terminal-highlight-keywords <=> root.setting-terminal-highlight-keywords;
                    setting-terminal-custom-keywords <=> root.setting-terminal-custom-keywords;
                    setting-cursor-style <=> root.setting-cursor-style;
                    setting-cursor-blink <=> root.setting-cursor-blink;
                    setting-scrollback-lines <=> root.setting-scrollback-lines;
                    setting-bell-style <=> root.setting-bell-style;

                    change-terminal-url-click(c) => { root.change-terminal-url-click(c); }
                    change-terminal-highlight-keywords(c) => { root.change-terminal-highlight-keywords(c); }
                    change-terminal-custom-keywords(k) => { root.change-terminal-custom-keywords(k); }
                    change-cursor-style(s) => { root.change-cursor-style(s); }
                    change-cursor-blink(b) => { root.change-cursor-blink(b); }
                    change-scrollback-lines(l) => { root.change-scrollback-lines(l); }
                    change-bell-style(s) => { root.change-bell-style(s); }

                    flag-terminal-crt-shader: root.flag-terminal-crt-shader;
                    setting-terminal-crt <=> root.setting-terminal-crt;
                    toggle-terminal-crt(c) => { root.toggle-terminal-crt(c); }

                    terminal-keyword-rules <=> root.terminal-keyword-rules;
                    add-keyword-rule(p, r, c) => { root.add-keyword-rule(p, r, c); }
                    update-keyword-rule(id, p, r, c) => { root.update-keyword-rule(id, p, r, c); }
                    toggle-keyword-rule(id, e) => { root.toggle-keyword-rule(id, e); }
                    delete-keyword-rule(id) => { root.delete-keyword-rule(id); }

                    setting-global-proxy-mode <=> root.setting-global-proxy-mode;
                    setting-global-proxy-server <=> root.setting-global-proxy-server;
                    setting-global-proxy-auth <=> root.setting-global-proxy-auth;
                    setting-global-proxy-user <=> root.setting-global-proxy-user;
                    setting-global-proxy-pass <=> root.setting-global-proxy-pass;

                    setting-connect-timeout <=> root.setting-connect-timeout;
                    setting-keepalive-interval <=> root.setting-keepalive-interval;
                    setting-keepalive-count-max <=> root.setting-keepalive-count-max;
                    setting-host-key-policy <=> root.setting-host-key-policy;
                    setting-tcp-nodelay <=> root.setting-tcp-nodelay;

                    setting-terminal-font: root.terminal-font-family;
                    setting-terminal-font-size: Math.round(root.terminal-font-size);

                    setting-copy-on-select <=> root.setting-copy-on-select;
                    setting-paste-on-right-click <=> root.setting-paste-on-right-click;
                    setting-warn-multiline-paste <=> root.setting-warn-multiline-paste;

                    change-copy-on-select(c) => { root.change-copy-on-select(c); }
                    change-paste-on-right-click(c) => { root.change-paste-on-right-click(c); }
                    change-warn-multiline-paste(c) => { root.change-warn-multiline-paste(c); }
                    change-close-action(a) => { root.change-close-action(a); }
                    change-global-proxy(m, s, a, u, p) => { root.change-global-proxy(m, s, a, u, p); }
                    change-network-handshake(t, i, c) => { root.change-network-handshake(t, i, c); }
                    change-host-key-policy(p) => { root.change-host-key-policy(p); }
                    change-tcp-nodelay(c) => { root.change-tcp-nodelay(c); }

                    color-picker-indicator-x <=> root.theme-editor-wheel-indicator-x;
                    color-picker-indicator-y <=> root.theme-editor-wheel-indicator-y;
                    color-picker-brightness <=> root.theme-editor-wheel-brightness;
                    color-picker-hue-brush: root.theme-editor-wheel-hue-brush;
                    color-picker-preview-brush: root.theme-editor-picker-brush;
                    color-picker-hex <=> root.theme-editor-picker-hex;

                    color-wheel-coord-picked(x, y) => { root.theme-editor-wheel-coord-picked(x, y); }
                    color-wheel-brightness-picked(b) => { root.theme-editor-wheel-brightness-picked(b); }
                    color-picker-hex-changed(h) => {
                        root.theme-editor-picker-target-key = "keyword_rule";
                        root.theme-editor-picker-hex-changed(h);
                    }
                }

                // 2.3.6 中央终端视口 (内置终端多会话 Tab 栏，随抽屉伸缩自适应拉满全部剩余空间)
                viewport := TerminalViewport {
                    visible: root.main-view == "terminal";
                    horizontal-stretch: root.main-view == "terminal" ? 1 : 0;
                    min-width: 0px;
                    max-width: root.main-view == "terminal" ? 100000px : 0px;

                    has-active-session: root.has-active-session;
