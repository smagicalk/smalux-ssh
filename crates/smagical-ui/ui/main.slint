    in property <bool> local-can-go-back: false;
    in property <bool> local-can-go-forward: false;
    in property <bool> remote-can-go-back: false;
    in property <bool> remote-can-go-forward: false;
    /// 传输队列面板展开/折叠状态
    in-out property <bool> is-transfer-queue-expanded: false;

