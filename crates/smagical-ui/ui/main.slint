                    terminal-split2-image: root.terminal-split2-image;
                    terminal-split3-image: root.terminal-split3-image;
                    is-split <=> root.is-split;
                    split-count <=> root.split-count;
                    split-orientation <=> root.split-orientation;
                    split-ratio <=> root.split-ratio;
                    active-pane-index <=> root.active-pane-index;
                    active-pane-id <=> root.active-pane-id;
                    terminal-panes: root.terminal-panes;
                    terminal-splitters: root.terminal-splitters;
                    split-session-name: root.split-session-name;
                    split2-session-name: root.split2-session-name;
                    split3-session-name: root.split3-session-name;
                    history-size: root.terminal-history-size;
                    scroll-offset: root.terminal-scroll-offset;
                    wallpaper-mode: root.wallpaper-mode;
                    terminal-wallpaper-image: root.terminal-wallpaper-image;
                    terminal-wallpaper-opacity: root.terminal-wallpaper-opacity;
                    terminal-key-input(text, is_ctrl, is_shift, is_alt) => { root.terminal-key-input(text, is_ctrl, is_shift, is_alt); }


                    terminal-scroll(delta) => { root.terminal-scroll(delta); }
                    terminal-selection-changed(sc, sr, ec, er, has_sel) => { root.terminal-selection-changed(sc, sr, ec, er, has_sel); }
                    copy-text => { root.terminal-copy(); }
                    paste-text => { root.terminal-paste(); }

                    clear-screen => { root.terminal-clear(); }
                    split-terminal(orient) => { root.split-terminal(orient); }
                    close-split => { root.close-split(); }
                    close-pane-by-index(idx) => { root.close-pane-by-index(idx); }
                    close-pane-by-id(id) => { root.close-pane-by-id(id); }
                    select-pane(idx) => { root.select-pane(idx); }
                    select-pane-by-id(id) => { root.select-pane-by-id(id); }
                    toggle-pane-zoom(id) => { root.toggle-pane-zoom(id); }
                    adjust-splitter(id, delta) => { root.adjust-splitter(id, delta); }

                    search-terminal(q, c) => { root.search-terminal(q, c); }
                    terminal-resize(cols, rows) => { root.terminal-resize(cols, rows); }
                    move-terminal-tab(from_pid, from_idx, drop_x, drop_y) => { root.move-terminal-tab(from_pid, from_idx, drop_x, drop_y); }
                }

                // 2.3.3 双盘文件管理与 SFTP 传输视图 (当 main-view == "files" 时展开)
                file_explorer := FileExplorerView {
                    visible: root.main-view == "files";
                    horizontal-stretch: root.main-view == "files" ? 1 : 0;
                    min-width: 0px;
                    max-width: root.main-view == "files" ? 100000px : 0px;

                    local-tabs: root.local-tabs;
                    active-local-tab-id: root.active-local-tab-id;
                    remote-tabs: root.remote-tabs;
                    active-remote-tab-id: root.active-remote-tab-id;
                    local-current-path: root.local-current-path;
                    remote-current-path: root.remote-current-path;
                    local-files: root.local-files;
                    remote-files: root.remote-files;
                    selected-local-id <=> root.selected-local-id;
                    selected-remote-id <=> root.selected-remote-id;
                    transfer-tasks: root.transfer-tasks;

                    select-local-tab(id) => { root.select-local-tab(id); }
                    close-local-tab(id) => { root.close-local-tab(id); }
                    new-local-tab => { root.new-local-tab(); }
                    select-remote-tab(id) => { root.select-remote-tab(id); }
                    close-remote-tab(id) => { root.close-remote-tab(id); }
                    new-remote-tab => {
                        root.filter-file-launcher("");
                        root.is-file-host-modal-open = true;
                    }

                    navigate-local-path(p) => { root.navigate-local-path(p); }
                    navigate-remote-path(p) => { root.navigate-remote-path(p); }
                    navigate-local-up => { root.navigate-local-up(); }
                    navigate-remote-up => { root.navigate-remote-up(); }
                    open-local-item(p, is_dir) => { root.open-local-item(p, is_dir); }
                    open-remote-item(p, is_dir) => { root.open-remote-item(p, is_dir); }
                    toggle-local-expand(p) => { root.toggle-local-expand(p); }
                    toggle-remote-expand(p) => { root.toggle-remote-expand(p); }
                    local-can-go-back: root.local-can-go-back;
                    local-can-go-forward: root.local-can-go-forward;
                    remote-can-go-back: root.remote-can-go-back;
                    remote-can-go-forward: root.remote-can-go-forward;

                    navigate-local-back => { root.navigate-local-back(); }
                    navigate-local-forward => { root.navigate-local-forward(); }
                    navigate-remote-back => { root.navigate-remote-back(); }
                    navigate-remote-forward => { root.navigate-remote-forward(); }

                    refresh-local => { root.refresh-local-files(); }
                    refresh-remote => { root.refresh-remote-files(); }
                    clear-completed-transfers => { root.clear-completed-transfers(); }
                    start-transfer-task(dir, src, name, is_dir, target) => { root.start-transfer-task(dir, src, name, is_dir, target); }
                    toggle-transfer-expand(id) => { root.toggle-transfer-expand(id); }
                    transfer-action(act, tid) => { root.transfer-action(act, tid); }
                    file-action(act, rem, p, name, is_dir) => { root.file-action(act, rem, p, name, is_dir); }
                    copy-to-clipboard(text) => { root.copy-to-clipboard(text); }
                    reorder-local-tab(from, to) => { root.reorder-local-tab(from, to); }
                    reorder-remote-tab(from, to) => { root.reorder-remote-tab(from, to); }
                    is-transfer-queue-expanded <=> root.is-transfer-queue-expanded;
                }











                // 2.3.1 右侧可拖拽调宽分割条 (仅在终端工作区展开右侧抽屉时展示)
                if root.is-right-drawer-open && root.main-view == "terminal": Rectangle {
                    width: 5px;
                    background: right-split-touch.has-hover || right-split-touch.pressed ? AppTheme.accent : AppTheme.panel-background;
                    animate background { duration: 120ms; }

                    // 左边框
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    // 右边框
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.border;
                    }

                    right-split-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.right-drawer-width = Math.max(180px, Math.min(520px, root.right-drawer-width - (self.mouse-x - self.pressed-x)));
                            }
                        }
                        double-clicked => {
                            root.right-drawer-width = 240px;
                        }
                    }
                }

                // 2.4 右侧可伸缩工具抽屉 (仅在终端工作区展开时展示)
                if root.is-right-drawer-open && root.main-view == "terminal": Rectangle {
                    width: root.right-drawer-width;
                    clip: true;

                    if root.active-right-tool == "monitor": MonitorDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "tunnel": TunnelToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                        active-host-name: root.active-host-name != "" ? root.active-host-name : root.active-session-name;
                        tunnels: root.host-tunnels;
                        toggle-tunnel-running(id) => { root.toggle-tunnel-running(id); }
                        open-tunnels-hub => {
                            root.active-left-tab = "tunnels";
                            root.main-view = "tunnels";
                            root.is-left-drawer-open = false;
                            root.is-right-drawer-open = false;
                            root.navigate-to("tunnels", "");
                        }
                        start-create-tunnel => {
                            root.active-left-tab = "tunnels";
                            root.main-view = "tunnels";
                            root.is-left-drawer-open = false;
                            root.is-right-drawer-open = false;
                            root.start-create-tunnel();
                            root.navigate-to("tunnels", "");
                        }
                    }

                    if root.active-right-tool == "snippets": SnippetToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                        quick-cmds: root.quick-cmds;
                        search_query <=> root.quick-cmds-search-query;
                        search_changed(q) => { root.filter-quick-cmds(q); }
                        send-to-terminal(id) => { root.execute-snippet-from-center(id); }
                    }

                    if root.active-right-tool == "sftp": SftpToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "notes": NotesToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                    }

                    if root.active-right-tool == "ai": AiToolDrawer {
                        collapse => { root.is-right-drawer-open = false; }
                        apply-suggested-cmd(cmd) => { root.send-snippet(cmd); }
                    }
                }

                // 2.5 最右侧 48px 工具图标栏 (仅在终端工作区展示)
                if root.main-view == "terminal": RightToolBar {
                    active-tool: root.active-right-tool;
                    tool-clicked(id) => {
                        if root.active-right-tool == id && root.is-right-drawer-open {
                            root.is-right-drawer-open = false;
                        } else {
                            root.active-right-tool = id;
                            root.is-right-drawer-open = true;
                            if id == "tunnel" {
                                root.sync-host-tunnels();
                            }
                        }
                    }
                }

            }

            // 3. 底层全宽状态栏
            StatusBar {
                current-theme-name: root.current-theme-name;
                is-debug-open: root.is-debug-modal-open;
                toggle-debug-panel => {
                    root.is-debug-modal-open = !root.is-debug-modal-open;
                }
            }
        }
    }

    // 浮动 Ctrl+K 指令面板
    CommandPalette {
        is-open: root.is-command-palette-open;
        close => { root.is-command-palette-open = false; }
        item-selected(id) => {
            if id == "5" {
                root.switch-theme("builtin.ui.darcula");
            } else if id == "6" {
                root.switch-theme("builtin.ui.monokai");
            } else {
                root.open-host(id);
            }
        }
    }

    // 新建主机分组弹窗 (支持树状层级上级选择与名称输入)
    CreateGroupModal {
        is-open: root.is-create-group-open;
        default-parent-id: root.create-group-default-parent;
        group-options: root.group-options;
        toggle-group(id) => { root.toggle-group-option(id); }
        close => { root.is-create-group-open = false; }
        confirm(parent-id, name) => {
            root.create-group(parent-id, name);
            root.is-create-group-open = false;
        }
    }

    // 独立浮动开发者调试与批量数据控制弹窗 (全页面任意时刻可呼出)
    DebugModal {
        is-open: root.is-debug-modal-open;
        total-nodes-count: root.tree-nodes.length;
        visible-nodes-count: root.tree-nodes.length;
        host-cards-count: root.hosts.length;
        credential-count: root.credentials.length;
        snippet-count: root.snippet-tree-nodes.length;
        snippet-group-count: root.snippet-parent-options.length;
        tree-viewport-width: root.tree-content-width;
        current-theme-name: root.current-theme-name;
        is-dark-mode: root.is-dark-mode;
        logs: root.debug-logs;
        close => { root.is-debug-modal-open = false; }
        batch-generate(prefix, count, ip-prefix, start-ip, port, group, status-mode, overwrite) => {
            root.debug-batch-generate(prefix, count, ip-prefix, start-ip, port, group, status-mode, overwrite);
        }
        batch-update-status(status-mode) => {
            root.debug-batch-update-status(status-mode);
        }
        batch-update-port(port) => {
            root.debug-batch-update-port(port);
        }
        inject-preset(id) => { root.debug-inject-preset(id); }
        quick-add-host(name, ip, port, group) => { root.debug-quick-add-host(name, ip, port, group); }
        quick-add-group(name, parent-id) => { root.debug-quick-add-group(name, parent-id); }
        clear-all-data => { root.debug-clear-data(); }
        reset-default-data => { root.debug-reset-default-data(); }
        debug-batch-generate-credentials(cnt, mode, ovr) => { root.debug-batch-generate-credentials(cnt, mode, ovr); }
        debug-quick-add-credential(ctype, n, d) => { root.debug-quick-add-credential(ctype, n, d); }
        debug-reset-default-credentials => { root.debug-reset-default-credentials(); }
        debug-clear-credentials => { root.debug-clear-credentials(); }
        debug-batch-generate-snippets(cnt, ovr) => { root.debug-batch-generate-snippets(cnt, ovr); }
        debug-quick-add-snippet(t, l, c) => { root.debug-quick-add-snippet(t, l, c); }
        debug-reset-default-snippets => { root.debug-reset-default-snippets(); }
        debug-clear-snippets => { root.debug-clear-snippets(); }
        clear-logs => { root.debug-clear-logs(); }
        emit-test-log(level) => { root.debug-emit-test-log(level); }
        switch-theme(id) => { root.switch-theme(id); }
        toggle-color-mode => { root.toggle-color-mode(); }
        active-pipeline: root.active-rendering-pipeline;
        switch-pipeline(id) => { root.debug-switch-pipeline(id); }
        save-pipeline => { root.debug-apply-pipeline(); }
        restart-app => { root.debug-restart-app(); }
        force-repaint => { root.debug-force-repaint(); }
        run-benchmark => { root.debug-run-benchmark(); }

        flag-desktop-notifications <=> root.flag-desktop-notifications;
        flag-terminal-crt-shader <=> root.flag-terminal-crt-shader;
        flag-cloud-sync <=> root.flag-cloud-sync;
        flag-terminal-scratchpad <=> root.flag-terminal-scratchpad;
        use-mock-storage <=> root.use-mock-storage;
        setting-always-on-top: root.setting-always-on-top;
        setting-confirm-close-tab: root.setting-confirm-close-tab;
        setting-confirm-close-active: root.setting-confirm-close-active;
        wallpaper-mode: root.wallpaper-mode;
        wallpaper-slideshow-interval: root.wallpaper-slideshow-interval;
        wallpaper-count: root.wallpaper-list.length;
        setting-modal-opacity <=> root.setting-modal-opacity;
        is-log-capture-enabled <=> root.is-log-capture-enabled;
        toggle-log-capture(e) => { root.toggle-log-capture(e); }
        navigate-to-settings(cat) => {
            root.main-view = "settings";
            root.active-settings-category = cat;
        }
        toggle-feature-flag(f, e) => { root.toggle-feature-flag(f, e); }
        toggle-mock-storage(e) => { root.toggle-mock-storage(e); }
        apply-config-preset(p) => { root.apply-config-preset(p); }
        reset-all-settings => { root.reset-all-settings(); }
        change-modal-opacity(op) => { root.change-modal-opacity(op); }
    }

    // 主题设计与定制工坊弹窗 (可视化表单、微型沙盒视窗与 TOML 双向代码编辑器)
    ThemeEditorModal {
        is-open: root.is-theme-editor-open;
        theme-name <=> root.theme-editor-name;
        theme-author <=> root.theme-editor-author;
        theme-base <=> root.theme-editor-base;
        theme-period <=> root.theme-editor-period;

        color-window-bg <=> root.theme-editor-window-bg;
        color-panel-bg <=> root.theme-editor-panel-bg;
        color-surface-bg <=> root.theme-editor-surface-bg;
        color-control-bg <=> root.theme-editor-control-bg;
        color-foreground <=> root.theme-editor-foreground;
        color-secondary-fg <=> root.theme-editor-secondary-fg;
        color-disabled-fg <=> root.theme-editor-disabled-fg;
        color-accent <=> root.theme-editor-accent;
        color-hover-bg <=> root.theme-editor-hover-bg;
        color-pressed-bg <=> root.theme-editor-pressed-bg;
        color-selected-bg <=> root.theme-editor-selected-bg;
        color-selected-fg <=> root.theme-editor-selected-fg;
        color-border <=> root.theme-editor-border;
        color-focus-border <=> root.theme-editor-focus-border;
        color-success <=> root.theme-editor-success;
        color-warning <=> root.theme-editor-warning;
        color-danger <=> root.theme-editor-danger;
        color-info <=> root.theme-editor-info;

        preview-window-bg: root.theme-editor-preview-window-bg;
        preview-panel-bg: root.theme-editor-preview-panel-bg;
        preview-surface-bg: root.theme-editor-preview-surface-bg;
        preview-control-bg: root.theme-editor-preview-control-bg;
        preview-foreground: root.theme-editor-preview-foreground;
        preview-secondary-fg: root.theme-editor-preview-secondary-fg;
        preview-disabled-fg: root.theme-editor-preview-disabled-fg;
        preview-accent: root.theme-editor-preview-accent;
        preview-hover-bg: root.theme-editor-preview-hover-bg;
        preview-pressed-bg: root.theme-editor-preview-pressed-bg;
        preview-selected-bg: root.theme-editor-preview-selected-bg;
        preview-selected-fg: root.theme-editor-preview-selected-fg;
        preview-border: root.theme-editor-preview-border;
        preview-focus-border: root.theme-editor-preview-focus-border;
        preview-success: root.theme-editor-preview-success;
        preview-warning: root.theme-editor-preview-warning;
        preview-danger: root.theme-editor-preview-danger;
        preview-info: root.theme-editor-preview-info;

        metric-radius-small <=> root.theme-editor-metric-radius-small;
        metric-radius-medium <=> root.theme-editor-metric-radius-medium;
        metric-radius-large <=> root.theme-editor-metric-radius-large;
        metric-spacing-small <=> root.theme-editor-metric-spacing-small;
        metric-spacing-medium <=> root.theme-editor-metric-spacing-medium;
        metric-spacing-large <=> root.theme-editor-metric-spacing-large;
        metric-border-width <=> root.theme-editor-metric-border-width;
        metric-control-height <=> root.theme-editor-metric-control-height;
        metric-icon-size <=> root.theme-editor-metric-icon-size;

        theme-toml <=> root.theme-editor-toml;

        wheel-indicator-x <=> root.theme-editor-wheel-indicator-x;
        wheel-indicator-y <=> root.theme-editor-wheel-indicator-y;
        wheel-brightness <=> root.theme-editor-wheel-brightness;
        wheel-hue-brush: root.theme-editor-wheel-hue-brush;
        picker-preview-brush: root.theme-editor-picker-brush;
        picker-hex-value <=> root.theme-editor-picker-hex;
        picker-target-key <=> root.theme-editor-picker-target-key;
        picker-target-label <=> root.theme-editor-picker-target-label;

        close => { root.is-theme-editor-open = false; }
        apply-preset(p) => { root.theme-editor-apply-preset(p); }
        color-field-changed(f, v) => { root.theme-editor-color-changed(f, v); }
        metric-field-changed(f, v) => { root.theme-editor-metric-changed(f, v); }
        meta-field-changed(f, v) => { root.theme-editor-meta-changed(f, v); }
        parse-and-sync-from-toml(s) => { root.theme-editor-parse-toml(s); }
        copy-toml(s) => { root.theme-editor-copy-toml(s); }
        save-and-activate => { root.theme-editor-save-and-activate(); }

        wheel-coord-picked(x, y) => { root.theme-editor-wheel-coord-picked(x, y); }
        wheel-brightness-picked(b) => { root.theme-editor-wheel-brightness-picked(b); }
        picker-hex-changed(h) => { root.theme-editor-picker-hex-changed(h); }
    }

    // 快速新建终端会话居中卡片弹窗
    NewSessionModal {
        is-open: root.is-new-session-modal-open;
        local-items: root.launcher-local-items;
        host-items: root.launcher-host-items;
        close => { root.is-new-session-modal-open = false; }
        search-changed(q) => { root.filter-launcher(q); }
        item-selected(id) => {
            root.is-new-session-modal-open = false;
            root.open-host(id);
        }
    }

    // 会话历史详情与终端屏幕快照弹窗
    HistoryDetailModal {
        is-open: root.is-history-detail-open;
        history-id: root.history-detail-id;
        session-title: root.history-detail-title;
        session-address: root.history-detail-address;
        session-user: root.history-detail-user;
        session-type: root.history-detail-type;
        connected-time: root.history-detail-connected-time;
        disconnected-time: root.history-detail-disconnected-time;
        duration-text: root.history-detail-duration;
        exit-status: root.history-detail-exit-status;
        error-msg: root.history-detail-error-msg;
        snapshot-content: root.history-detail-snapshot;
        snapshot-lines: root.history-detail-snapshot-lines;
        close => { root.is-history-detail-open = false; }
        reconnect(id) => {
            root.is-history-detail-open = false;
            root.main-view = "terminal";
            root.active-left-tab = "hosts";
            root.is-left-drawer-open = true;
            root.reconnect-history(id);
        }

        copy-log(text) => { root.copy-history-log(text); }
    }

    // 通用消息与错误提示模态弹窗
    MessageDialog {
        is-open <=> root.is-dialog-open;
        title: root.dialog-title;
        message: root.dialog-message;
        dialog-type: root.dialog-type;
        close => { root.is-dialog-open = false; }
    }

    // 关闭窗口含活跃会话二次防呆确认弹窗
    MessageDialog {
        is-open <=> root.is-exit-confirm-open;
        title: @tr("确认退出应用程序");
        message: @tr("当前仍有活跃的终端或 SSH 会话正在运行。强行退出将导致远程任务与网络隧道中断，确定要退出吗？");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("强行退出");
        cancel-text: @tr("继续使用");
        close => { root.is-exit-confirm-open = false; }
        confirmed => {
            root.is-exit-confirm-open = false;
            root.force-close-window();
        }
    }

    // 关闭单个终端会话标签页防误触确认弹窗
    MessageDialog {
        is-open <=> root.is-tab-close-confirm-open;
        title: root.tab-close-confirm-title != "" ? root.tab-close-confirm-title : @tr("确认关闭终端会话");
        message: root.tab-close-confirm-message != "" ? root.tab-close-confirm-message : @tr("确定要断开并关闭此会话吗？远程正在运行的任务将被中断。");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("断开并关闭");
        cancel-text: @tr("取消");
        close => { root.is-tab-close-confirm-open = false; }
        confirmed => {
            root.is-tab-close-confirm-open = false;
            root.confirm-close-tab();
        }
    }

    // 切换渲染引擎重启确认弹窗
    MessageDialog {
        is-open <=> root.is-restart-confirm-open;
        title: @tr("切换图形渲染引擎");
        message: root.restart-confirm-message != "" ? root.restart-confirm-message : @tr("切换图形渲染引擎需要重启客户端以重新初始化底层 GPU 显卡管线，是否立即重启？");
        dialog-type: "warning";
        show-cancel: true;
        confirm-text: @tr("立即重启");
        cancel-text: @tr("稍后重启");
        close => {
            root.is-restart-confirm-open = false;
            root.cancel-restart-pipeline();
        }
        confirmed => {
            root.is-restart-confirm-open = false;
            root.confirm-restart-pipeline();
        }
    }

    // 文件管理会话选择居中卡片弹窗 (单一本地域 + 远程全部主机，点击自动连接 SFTP)
    FileHostModal {
        is-open: root.is-file-host-modal-open;
        host-items: root.file-launcher-host-items;
        close => { root.is-file-host-modal-open = false; }
        search-changed(q) => { root.filter-file-launcher(q); }
        local-selected => {
            root.is-file-host-modal-open = false;
            root.open-file-host("local");
        }

        host-selected(id) => {
            root.is-file-host-modal-open = false;
            root.open-file-host(id);
        }
    }

    // 新建代码片段文件夹弹窗
    CreateSnippetGroupModal {
        is_open <=> root.is-create-snippet-group-open;
        group_name <=> root.new-snippet-group-name;
        selected_parent_id <=> root.new-snippet-group-parent-id;
        parent_options: root.snippet-parent-options;
        cancel => { root.cancel-create-snippet-group(); }
        submit => { root.submit-create-snippet-group(); }
        select_parent(id) => { root.select-snippet-group-parent(id); }
    }

    // 代码片段动态参数填报执行弹窗
    SnippetRunModal {
        is_open <=> root.is-snippet-run-modal-open;
        snippet_id: root.snippet-run-modal-id;
        snippet_title: root.snippet-run-modal-title;
        rendered_command <=> root.snippet-run-modal-rendered-command;
        params_list <=> root.snippet-run-params-list;
        cancel => { root.cancel-snippet-run(); }
        submit => { root.submit-snippet-run(); }
        param_changed(idx, val) => { root.run-snippet-param-changed(idx, val); }
    }

    // 全局气泡通知浮层 (z: 1000 最高层级)
    ToastContainer {
        z: 1000;
        toasts: root.active-toasts;
        position: root.toast-position;
        close-toast(id) => { root.close-toast(id); }
    }

    // -------------------------------------------------------------------------
    // 边缘拖动改变窗口大小 (Window Edge & Corner Resize Handles)
    // 仅在非最大化状态下启用，8 个方向原生无缝拖拽缩放
    // -------------------------------------------------------------------------
    if !root.is-window-maximized: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        // 顶边 (North)
        TouchArea {
            x: 8px; y: 0px; width: parent.width - 16px; height: 5px;
            mouse-cursor: n-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north");
                }
            }
        }
        // 底边 (South)
        TouchArea {
            x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 5px;
            mouse-cursor: s-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south");
                }
            }
        }
        // 左边 (West)
        TouchArea {
            x: 0px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: w-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("west");
                }
            }
        }
        // 右边 (East)
        TouchArea {
            x: parent.width - 5px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: e-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("east");
                }
            }
        }
        // 左上角 (NorthWest)
        TouchArea {
            x: 0px; y: 0px; width: 8px; height: 8px;
            mouse-cursor: nw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north-west");
                }
            }
        }
        // 右上角 (NorthEast)
        TouchArea {
            x: parent.width - 8px; y: 0px; width: 8px; height: 8px;
            mouse-cursor: ne-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("north-east");
                }
            }
        }
        // 左下角 (SouthWest)
        TouchArea {
            x: 0px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: sw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south-west");
                }
            }
        }
        // 右下角 (SouthEast)
        TouchArea {
            x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: se-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-window-resize("south-east");
                }
            }
        }
    }
}




