// =============================================================================
// 文件名称: credentials_view.slint
// 模块功能: 凭据全屏管理中心 (Credentials Center View)
// 核心设计: 统一设计语言 (无花哨纯色块)、左侧列表垂直居中、紧凑标签与表单间距、默认只读浏览 + 显式点击编辑
// =============================================================================

import { AppTheme } from "../themes/app-theme.slint";
import { SearchInput } from "../components/search-input.slint";
import { AppIconButton } from "../components/base/app-icon-button.slint";
import { AppButton } from "../components/base/app-button.slint";
import { ScrollView } from "std-widgets.slint";
import { CredentialItemData } from "left_drawers/credentials_drawer.slint";
export { CredentialItemData }

/// 凭据全屏管理中心组件 (Credentials Center View)
export component CredentialsCenterView inherits Rectangle {
    in property <[CredentialItemData]> credentials: [];
    in-out property <string> filter-category: "all"; // "all" | "key" | "password" | "agent"
    in-out property <string> search-query: "";
    in-out property <string> active-cred-id: "";

    // 模式状态机: 新建模式 / 查看模式 / 编辑模式
    in-out property <bool> is-create-mode: false;
    in-out property <bool> is-editing: false;
    in-out property <bool> show-full-private-key: false;
    in-out property <bool> reveal-passphrase: false;
    in-out property <bool> reveal-password: false;

    // 表单数据绑定
    in-out property <string> form-id: "";
    in-out property <string> form-name: "";
    in-out property <string> form-type: "key"; // "key" | "password" | "agent"
    in-out property <string> form-algorithm: "Ed25519";
    in-out property <string> form-username: "root";
    in-out property <string> form-secret-data: "";
    in-out property <string> form-passphrase: "";
    in-out property <string> form-public-key: "";
    in-out property <string> form-fingerprint: "";
    in-out property <string> form-notes: "";
    in-out property <int> form-bound-host-count: 0;
    in-out property <string> form-updated-at: "";

    // 统计属性
    in property <int> total-count: root.credentials.length;

    // 回调函数
    callback select-cred(string /* id */);
    callback start-create();
    callback cancel-create();
    callback start-edit();
    callback cancel-edit();
    callback save-cred(
        string /* id */,
        string /* name */,
        string /* cred_type */,
        string /* algorithm */,
        string /* username */,
        string /* secret_data */,
        string /* passphrase */,
        string /* public_key */,
        string /* fingerprint */,
        string /* notes */
    );
    callback delete-cred(string /* id */);
    callback copy-secret(string /* id */);
    callback copy-text(string /* text */, string /* title */, string /* msg */);
    callback generate-key(string /* algorithm */);
    callback generate-password();
    callback search-changed(string /* query */);
    callback filter-category-changed(string /* category */);
    callback back-to-terminal();

    background: AppTheme.window-background;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // =====================================================================
        // 左侧 Master: 凭据列表面板 (320px 宽度)
        // =====================================================================
        Rectangle {
            width: 320px;
            background: AppTheme.panel-background;

            // 右侧 1px 分割线
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: AppTheme.border;
            }

            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                // 1. 顶部标题与新建按钮
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;

                            Image {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/icons/key.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: AppTheme.foreground;
                            }
                        }

                        Text {
                            text: @tr("凭据管理");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "(" + root.total-count + ")";
                            font-size: 11px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }

                    // "+ 新建" 按钮 (统一使用主题控件样式)
                    Rectangle {
                        width: 68px;
                        height: 24px;
                        border-radius: 4px;
                        background: add-touch.has-hover ? AppTheme.accent.darker(15%) : AppTheme.accent;

                        add-touch := TouchArea {
                            clicked => {
                                root.is-create-mode = true;
                                root.is-editing = true;
                                root.start-create();
                            }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: AppTheme.selected-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("新建");
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.selected-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 2. 分类切换标签栏 (All / Key / Password / Agent)
                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        // 全部 (All)
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.filter-category == "all"
                                ? AppTheme.selected-background
                                : (all-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                            border-width: 1px;
                            border-color: root.filter-category == "all" ? AppTheme.accent : transparent;
                            animate background, border-color { duration: 100ms; }

                            all-tab-touch := TouchArea {
                                clicked => {
                                    root.filter-category = "all";
                                    root.filter-category-changed("all");
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: @tr("全部");
                                font-size: 10px;
                                font-weight: root.filter-category == "all" ? 700 : 500;
                                color: root.filter-category == "all" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 密钥 (Keys)
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.filter-category == "key"
                                ? AppTheme.selected-background
                                : (key-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                            border-width: 1px;
                            border-color: root.filter-category == "key" ? AppTheme.accent : transparent;
                            animate background, border-color { duration: 100ms; }

                            key-tab-touch := TouchArea {
                                clicked => {
                                    root.filter-category = "key";
                                    root.filter-category-changed("key");
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: @tr("密钥");
                                font-size: 10px;
                                font-weight: root.filter-category == "key" ? 700 : 500;
                                color: root.filter-category == "key" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 密码 (Passwords)
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.filter-category == "password"
                                ? AppTheme.selected-background
                                : (pwd-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                            border-width: 1px;
                            border-color: root.filter-category == "password" ? AppTheme.accent : transparent;
                            animate background, border-color { duration: 100ms; }

                            pwd-tab-touch := TouchArea {
                                clicked => {
                                    root.filter-category = "password";
                                    root.filter-category-changed("password");
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: @tr("密码");
                                font-size: 10px;
                                font-weight: root.filter-category == "password" ? 700 : 500;
                                color: root.filter-category == "password" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 代理 (Agents)
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.filter-category == "agent"
                                ? AppTheme.selected-background
                                : (agent-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                            border-width: 1px;
                            border-color: root.filter-category == "agent" ? AppTheme.accent : transparent;
                            animate background, border-color { duration: 100ms; }

                            agent-tab-touch := TouchArea {
                                clicked => {
                                    root.filter-category = "agent";
                                    root.filter-category-changed("agent");
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: @tr("代理");
                                font-size: 10px;
                                font-weight: root.filter-category == "agent" ? 700 : 500;
                                color: root.filter-category == "agent" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 3. 搜索框
                SearchInput {
                    placeholder: @tr("搜索凭据...");
                    text <=> root.search-query;
                    changed(q) => {
                        root.search-query = q;
                        root.search-changed(q);
                    }
                    clear => {
                        root.search-query = "";
                        root.search-changed("");
                    }
                }

                // 4. 凭据卡片列表 (保证图标与文本严格左垂直居中)
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;
                        padding-bottom: 8px;

                        if root.credentials.length == 0: Rectangle {
                            height: 100px;
                            border-radius: 4px;
                            background: AppTheme.surface-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.search-query != "" ? @tr("未匹配到凭据") : @tr("暂无凭据记录");
                                    font-size: 11px;
                                    color: AppTheme.secondary-foreground;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        for cred in root.credentials: Rectangle {
                            height: 52px;
                            border-radius: 4px;
                            background: (!root.is-create-mode && cred.id == root.active-cred-id)
                                ? AppTheme.selected-background
                                : (item-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                            border-width: 1px;
                            border-color: (!root.is-create-mode && cred.id == root.active-cred-id)
                                ? AppTheme.accent
                                : (item-touch.has-hover ? AppTheme.border : transparent);

                            animate background, border-color { duration: 100ms; }

                            item-touch := TouchArea {
                                clicked => {
                                    root.is-create-mode = false;
                                    root.is-editing = false;
                                    root.show-full-private-key = false;
                                    root.reveal-passphrase = false;
                                    root.reveal-password = false;
                                    root.active-cred-id = cred.id;
                                    root.select-cred(cred.id);
                                }
                                mouse-cursor: pointer;
                            }

                            // 0. 左侧激活高亮指示条
                            if (!root.is-create-mode && cred.id == root.active-cred-id): Rectangle {
                                x: 0px;
                                y: 6px;
                                width: 3px;
                                height: parent.height - 12px;
                                border-radius: 1.5px;
                                background: AppTheme.accent;
                            }

                            // 1. 左侧图标 (放大占满高度，留 6px 边距)
                            Rectangle {
                                x: 6px;
                                y: 6px;
                                width: parent.height - 12px;
                                height: parent.height - 12px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: cred.cred-type == "key"
                                        ? @image-url("../assets/icons/key.svg")
                                        : (cred.cred-type == "password" ? @image-url("../assets/icons/file-text.svg") : @image-url("../assets/icons/zap.svg"));
                                    width: 22px;
                                    height: 22px;
                                    image-fit: contain;
                                    colorize: (!root.is-create-mode && cred.id == root.active-cred-id)
                                        ? AppTheme.accent
                                        : AppTheme.secondary-foreground;
                                }
                            }

                            // 2. 右侧文本信息 (y: 9px 让首行文字向下微调，垂直居中平衡)
                            VerticalLayout {
                                x: (parent.height - 12px) + 14px;
                                width: parent.width - ((parent.height - 12px) + 22px);
                                y: 9px;
                                height: parent.height - 18px;
                                alignment: space-between;
                                padding: 0px;
                                spacing: 0px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Text {
                                        text: cred.name;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: (!root.is-create-mode && cred.id == root.active-cred-id)
                                            ? AppTheme.selected-foreground
                                            : AppTheme.foreground;
                                        overflow: elide;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        vertical-alignment: top;
                                    }

                                    // 简洁算法标签
                                    Rectangle {
                                        height: 16px;
                                        border-radius: 3px;
                                        background: AppTheme.control-background;
                                        border-width: 1px;
                                        border-color: AppTheme.border;

                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            alignment: center;

                                            Text {
                                                text: cred.algorithm;
                                                font-size: 9px;
                                                color: AppTheme.secondary-foreground;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    if cred.cred-type == "key": Text {
                                        text: cred.fingerprint != "" ? cred.fingerprint : @tr("未生成指纹");
                                        font-size: 9px;
                                        font-family: "Cascadia Code, Consolas, monospace";
                                        color: AppTheme.secondary-foreground;
                                        overflow: elide;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        vertical-alignment: bottom;
                                    }

                                    if cred.cred-type == "password": Text {
                                        text: (cred.username != "" ? cred.username : @tr("未设置用户")) + "  ••••••";
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        overflow: elide;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        vertical-alignment: bottom;
                                    }

                                    if cred.cred-type == "agent": Text {
                                        text: @tr("管道: ") + (cred.fingerprint != "" ? cred.fingerprint : @tr("外部代理"));
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: bottom;
                                    }

                                    if cred.bound-host-count > 0: Text {
                                        text: cred.bound-host-count + " " + @tr("台主机");
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        horizontal-alignment: left;
                                        vertical-alignment: bottom;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 右侧 Detail: 凭据详情 / 浏览 / 编辑 / 新建工作区
        // =====================================================================
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            // -----------------------------------------------------------------
            // 模式 A: 新建模式 (is-create-mode == true)
            // -----------------------------------------------------------------
            if root.is-create-mode: VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                // 头部操作条
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: @tr("新建凭据");
                            font-size: 14px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        AppButton {
                            text: @tr("取消");
                            variant: "secondary";
                            clicked => { root.cancel-create(); }
                        }

                        AppButton {
                            text: @tr("保存并创建");
                            variant: "primary";
                            clicked => {
                                root.save-cred(
                                    "",
                                    root.form-name,
                                    root.form-type,
                                    root.form-algorithm,
                                    root.form-username,
                                    root.form-secret-data,
                                    root.form-passphrase,
                                    root.form-public-key,
                                    root.form-fingerprint,
                                    root.form-notes
                                );
                            }
                        }
                    }
                }

                // 凭据类型切换分段控件
                Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "key" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "key" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "key"; } }
                            Text {
                                text: @tr("SSH 密钥对");
                                font-size: 10px;
                                font-weight: root.form-type == "key" ? 600 : 400;
                                color: root.form-type == "key" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "password" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "password" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "password"; } }
                            Text {
                                text: @tr("账号密码");
                                font-size: 10px;
                                font-weight: root.form-type == "password" ? 600 : 400;
                                color: root.form-type == "password" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "agent" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "agent" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "agent"; } }
                            Text {
                                text: @tr("SSH Agent");
                                font-size: 10px;
                                font-weight: root.form-type == "agent" ? 600 : 400;
                                color: root.form-type == "agent" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 表单区域 (紧凑间距，label 与输入框紧贴)
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-right: 8px;

                        // 凭据名称
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("凭据名称 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: c-name-in.has-focus ? AppTheme.accent : AppTheme.border;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    c-name-in := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.form-name;
                                        font-size: 11px; color: AppTheme.foreground; vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 密钥表单
                        if root.form-type == "key": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            // 算法选择与生成
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("密钥算法与生成"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 3px;
                                        background: c-gen-k.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        c-gen-k := TouchArea { clicked => { root.show-full-private-key = true; root.generate-key(root.form-algorithm); } mouse-cursor: pointer; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: @tr("一键生成密钥对"); font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 26px; border-radius: 4px; background: AppTheme.surface-background; border-width: 1px; border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding: 2px; spacing: 2px;
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: 3px;
                                            background: root.form-algorithm == "Ed25519" ? AppTheme.control-background : transparent;
                                            border-width: root.form-algorithm == "Ed25519" ? 1px : 0px; border-color: AppTheme.border;
                                            TouchArea { clicked => { root.form-algorithm = "Ed25519"; } }
                                            Text { text: @tr("Ed25519 (推荐)"); font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: 3px;
                                            background: root.form-algorithm == "RSA-4096" ? AppTheme.control-background : transparent;
                                            border-width: root.form-algorithm == "RSA-4096" ? 1px : 0px; border-color: AppTheme.border;
                                            TouchArea { clicked => { root.form-algorithm = "RSA-4096"; } }
                                            Text { text: "RSA-4096"; font-size: 10px; color: AppTheme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            // 私钥内容
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("私钥内容 (Private Key PEM) *"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        if root.form-secret-data != "": Rectangle {
                                            min-width: 56px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: copy-priv-touch.has-hover ? AppTheme.hover-background : transparent;
                                            copy-priv-touch := TouchArea {
                                                clicked => { root.copy-text(root.form-secret-data, @tr("已复制私钥"), @tr("私钥文本已成功复制至系统剪贴板")); }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                Text {
                                                    text: @tr("复制私钥");
                                                    font-size: 10px;
                                                    color: AppTheme.accent;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 220px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;

                                        c-priv-in := TextInput {
                                            width: 100%; height: 100%; text <=> root.form-secret-data;
                                            font-size: 10px; font-family: "Cascadia Code, Consolas, monospace"; color: AppTheme.foreground; wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // 口令
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("私钥保护口令 (可选)"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px; border-radius: 4px; background: AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                                        TextInput {
                                            horizontal-stretch: 1; height: 100%; text <=> root.form-passphrase;
                                            font-size: 11px; input-type: root.reveal-passphrase ? text : password;
                                            color: AppTheme.foreground; vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 20px; height: 20px; y: (parent.height - self.height) / 2; border-radius: 3px;
                                            background: c-eye-pass.has-hover ? AppTheme.hover-background : transparent;
                                            Image {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                source: root.reveal-passphrase ? @image-url("../assets/icons/eye.svg") : @image-url("../assets/icons/eye-off.svg");
                                                width: 14px; height: 14px; image-fit: contain;
                                                colorize: root.reveal-passphrase ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                            c-eye-pass := TouchArea { clicked => { root.reveal-passphrase = !root.reveal-passphrase; } mouse-cursor: pointer; }
                                        }
                                    }
                                }
                            }
                        }

                        // 密码表单
                        if root.form-type == "password": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("默认登录用户名 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px; border-radius: 4px; background: AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        TextInput { width: 100%; height: 100%; text <=> root.form-username; font-size: 11px; color: AppTheme.foreground; vertical-alignment: center; }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("登录密码 *"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                    Rectangle {
                                        height: 20px; border-radius: 3px; background: c-gen-p.has-hover ? AppTheme.hover-background : AppTheme.surface-background; border-width: 1px; border-color: AppTheme.border;
                                        c-gen-p := TouchArea { clicked => { root.generate-password(); } mouse-cursor: pointer; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: @tr("随机生成强密码"); font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 28px; border-radius: 4px; background: AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                                        TextInput {
                                            horizontal-stretch: 1; height: 100%; text <=> root.form-secret-data;
                                            font-size: 11px; input-type: root.reveal-password ? text : password;
                                            color: AppTheme.foreground; vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 20px; height: 20px; y: (parent.height - self.height) / 2; border-radius: 3px;
                                            background: c-eye-pwd.has-hover ? AppTheme.hover-background : transparent;
                                            Image {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                source: root.reveal-password ? @image-url("../assets/icons/eye.svg") : @image-url("../assets/icons/eye-off.svg");
                                                width: 14px; height: 14px; image-fit: contain;
                                                colorize: root.reveal-password ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                            c-eye-pwd := TouchArea { clicked => { root.reveal-password = !root.reveal-password; } mouse-cursor: pointer; }
                                        }
                                    }
                                }
                            }
                        }

                        // Agent 表单
                        if root.form-type == "agent": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                Text { text: @tr("常用 Agent 快速预设 (点击一键填入管道路径)"); font-size: 10px; color: AppTheme.secondary-foreground; }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    // 1Password Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p1.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p1 := TouchArea {
                                            clicked => {
                                                root.form-name = "1Password SSH Agent";
                                                root.form-algorithm = "1Password";
                                                root.form-secret-data = "\\\\.\\pipe\\1password-ssh-agent";
                                                root.form-notes = @tr("1Password 密码管理器内置 SSH 认证代理管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/key.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "1Password"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Windows OpenSSH Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p2.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p2 := TouchArea {
                                            clicked => {
                                                root.form-name = "Windows OpenSSH Agent";
                                                root.form-algorithm = "OpenSSH";
                                                root.form-secret-data = "\\\\.\\pipe\\openssh-ssh-agent";
                                                root.form-notes = @tr("Windows 内置 OpenSSH Authentication Agent 服务管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/terminal.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "OpenSSH"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Bitwarden Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p3.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p3 := TouchArea {
                                            clicked => {
                                                root.form-name = "Bitwarden SSH Agent";
                                                root.form-algorithm = "Bitwarden";
                                                root.form-secret-data = "\\\\.\\pipe\\bitwarden-ssh-agent";
                                                root.form-notes = @tr("Bitwarden / Vaultwarden 桌面端托管 SSH 代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/shield.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "Bitwarden"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // KeePassXC
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p4.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p4 := TouchArea {
                                            clicked => {
                                                root.form-name = "KeePassXC SSH Agent";
                                                root.form-algorithm = "KeePassXC";
                                                root.form-secret-data = "\\\\.\\pipe\\kpxc_server";
                                                root.form-notes = @tr("KeePassXC 本地密码库 SSH Agent 代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/lock.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "KeePassXC"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Pageant
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p5.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p5 := TouchArea {
                                            clicked => {
                                                root.form-name = "Pageant (PuTTY)";
                                                root.form-algorithm = "Pageant";
                                                root.form-secret-data = "\\\\.\\pipe\\pageant";
                                                root.form-notes = @tr("PuTTY / WinSCP Pageant 经典认证协议代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/tunnel.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "Pageant"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // GPG Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: agt-p6.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        agt-p6 := TouchArea {
                                            clicked => {
                                                root.form-name = "GnuPG SSH Agent";
                                                root.form-algorithm = "GnuPG";
                                                root.form-secret-data = "\\\\.\\pipe\\gnupg-ssh-agent";
                                                root.form-notes = @tr("GnuPG / YubiKey 智能卡 SSH 认证代理管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/zap.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "GnuPG"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("Agent 管道路径 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px; border-radius: 4px; background: AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        TextInput { width: 100%; height: 100%; text <=> root.form-secret-data; font-size: 11px; color: AppTheme.foreground; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // 备注
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("备注说明"); font-size: 10px; color: AppTheme.secondary-foreground; }
                            Rectangle {
                                height: 28px; border-radius: 4px; background: AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    TextInput { width: 100%; height: 100%; text <=> root.form-notes; font-size: 11px; color: AppTheme.foreground; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 模式 B: 查看与编辑已选凭据模式 (active-cred-id != "" && !is-create-mode)
            // -----------------------------------------------------------------
            if !root.is-create-mode && root.active-cred-id != "": VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                // 1. 顶部操作工具栏 (查看态 / 编辑态)
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    // 左侧标题与状态
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.form-type == "key"
                                    ? @image-url("../assets/icons/key.svg")
                                    : (root.form-type == "password" ? @image-url("../assets/icons/file-text.svg") : @image-url("../assets/icons/zap.svg"));
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: AppTheme.foreground;
                            }
                        }

                        Text {
                            text: root.form-name;
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        if root.is-editing: Rectangle {
                            height: 16px;
                            border-radius: 3px;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.accent;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;
                                Text {
                                    text: @tr("编辑中");
                                    font-size: 9px;
                                    color: AppTheme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 右侧动作按钮组
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        // 查看态操作
                        if !root.is-editing: HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            AppButton {
                                text: root.form-type == "key" ? @tr("复制公钥") : (root.form-type == "password" ? @tr("复制密码") : @tr("复制管道"));
                                variant: "secondary";
                                clicked => { root.copy-secret(root.form-id); }
                            }

                            AppButton {
                                text: @tr("编辑");
                                variant: "primary";
                                clicked => {
                                    root.is-editing = true;
                                    root.show-full-private-key = true;
                                    root.start-edit();
                                }
                            }

                            AppButton {
                                text: @tr("删除");
                                variant: "danger";
                                clicked => { root.delete-cred(root.form-id); }
                            }
                        }

                        // 编辑态操作
                        if root.is-editing: HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            AppButton {
                                text: @tr("取消");
                                variant: "secondary";
                                clicked => {
                                    root.is-editing = false;
                                    root.cancel-edit();
                                }
                            }

                            AppButton {
                                text: @tr("保存修改");
                                variant: "primary";
                                clicked => {
                                    root.is-editing = false;
                                    root.save-cred(
                                        root.form-id,
                                        root.form-name,
                                        root.form-type,
                                        root.form-algorithm,
                                        root.form-username,
                                        root.form-secret-data,
                                        root.form-passphrase,
                                        root.form-public-key,
                                        root.form-fingerprint,
                                        root.form-notes
                                    );
                                }
                            }
                        }
                    }
                }

                // 2. 表单可滚动内容 (未点击编辑时为只读受保护态，点击编辑后可输入)
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-right: 8px;

                        // 凭据显示名称
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("凭据显示名称 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: (root.is-editing && v-name-in.has-focus) ? AppTheme.accent : AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    v-name-in := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.form-name;
                                        enabled: root.is-editing;
                                        font-size: 11px;
                                        color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ----------------- 密钥专用属性 -----------------
                        if root.form-type == "key": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            // 算法与重新生成
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("密钥算法: ") + root.form-algorithm; font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }

                                    if root.is-editing: Rectangle {
                                        height: 20px;
                                        border-radius: 3px;
                                        background: v-regen-k.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        v-regen-k := TouchArea { clicked => { root.show-full-private-key = true; root.generate-key(root.form-algorithm); } mouse-cursor: pointer; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: @tr("重新生成密钥对"); font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            // 指纹展示
                            if root.form-fingerprint != "": VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("公钥指纹 (SHA256)"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        alignment: space-between;

                                        Text {
                                            text: root.form-fingerprint;
                                            font-size: 10px;
                                            font-family: "Cascadia Code, Consolas, monospace";
                                            color: AppTheme.foreground;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            width: 36px;
                                            clicked => { root.copy-text(root.form-fingerprint, @tr("已复制指纹"), @tr("公钥指纹已复制至剪贴板")); }
                                            mouse-cursor: pointer;

                                            Text {
                                                text: @tr("复制");
                                                font-size: 10px;
                                                color: AppTheme.secondary-foreground;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // 导出公钥
                            if root.form-public-key != "": VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("导出的 SSH 公钥 (可配置于目标机器 authorized_keys)"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }
                                    Rectangle {
                                        min-width: 50px;
                                        height: 20px;
                                        border-radius: 3px;
                                        background: copy-pub-touch.has-hover ? AppTheme.hover-background : transparent;
                                        copy-pub-touch := TouchArea {
                                            clicked => { root.copy-text(root.form-public-key, @tr("已复制公钥"), @tr("SSH 公钥已复制至剪贴板")); }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text { text: @tr("复制公钥"); font-size: 10px; color: AppTheme.accent; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 52px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: (root.is-editing && pub-key-input.has-focus) ? AppTheme.accent : AppTheme.border;

                                    HorizontalLayout {
                                        padding: 6px;
                                        pub-key-input := TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.form-public-key;
                                            enabled: root.is-editing;
                                            font-size: 9px;
                                            font-family: "Cascadia Code, Consolas, monospace";
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // 私钥内容
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("私钥内容 (OpenSSH PEM 格式)"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            min-width: 76px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: toggle-key-touch.has-hover ? AppTheme.hover-background : transparent;
                                            toggle-key-touch := TouchArea {
                                                clicked => { root.show-full-private-key = !root.show-full-private-key; }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                Text {
                                                    text: root.show-full-private-key ? @tr("收起并隐藏") : @tr("展开并显示");
                                                    font-size: 10px;
                                                    color: AppTheme.secondary-foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if root.form-secret-data != "": Rectangle {
                                            min-width: 56px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: copy-priv2-touch.has-hover ? AppTheme.hover-background : transparent;
                                            copy-priv2-touch := TouchArea {
                                                clicked => { root.copy-text(root.form-secret-data, @tr("已复制私钥"), @tr("私钥文本已成功复制至系统剪贴板")); }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                Text {
                                                    text: @tr("复制私钥");
                                                    font-size: 10px;
                                                    color: AppTheme.accent;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: root.show-full-private-key ? 240px : 36px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    animate height { duration: 150ms; }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: root.show-full-private-key ? 6px : 0px;
                                        padding-bottom: root.show-full-private-key ? 6px : 0px;

                                        if !root.show-full-private-key: Text {
                                            text: root.form-secret-data != "" ? "••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••" : @tr("未导入私钥");
                                            font-size: 11px;
                                            color: AppTheme.secondary-foreground;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }

                                        if root.show-full-private-key: edit-priv-input := TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.form-secret-data;
                                            enabled: root.is-editing;
                                            font-size: 10px;
                                            font-family: "Cascadia Code, Consolas, monospace";
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // 口令
                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("私钥保护口令 (Passphrase)"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                                        pass-input := TextInput {
                                            horizontal-stretch: 1; height: 100%;
                                            text <=> root.form-passphrase;
                                            enabled: root.is-editing;
                                            font-size: 11px;
                                            input-type: root.reveal-passphrase ? text : password;
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 20px; height: 20px; y: (parent.height - self.height) / 2; border-radius: 3px;
                                            background: v-eye-pass.has-hover ? AppTheme.hover-background : transparent;
                                            Image {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                source: root.reveal-passphrase ? @image-url("../assets/icons/eye.svg") : @image-url("../assets/icons/eye-off.svg");
                                                width: 14px; height: 14px; image-fit: contain;
                                                colorize: root.reveal-passphrase ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                            v-eye-pass := TouchArea { clicked => { root.reveal-passphrase = !root.reveal-passphrase; } mouse-cursor: pointer; }
                                        }
                                    }
                                }
                            }
                        }

                        // ----------------- 密码专用属性 -----------------
                        if root.form-type == "password": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("默认登录用户名"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        user-input := TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.form-username;
                                            enabled: root.is-editing;
                                            font-size: 11px;
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text { text: @tr("登录密码"); font-size: 10px; color: AppTheme.secondary-foreground; vertical-alignment: center; }

                                    if root.is-editing: Rectangle {
                                        height: 20px;
                                        border-radius: 3px;
                                        background: v-regen-p.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                        border-width: 1px; border-color: AppTheme.border;
                                        v-regen-p := TouchArea { clicked => { root.generate-password(); } mouse-cursor: pointer; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: @tr("重新生成随机密码"); font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                                        pwd-input := TextInput {
                                            horizontal-stretch: 1; height: 100%;
                                            text <=> root.form-secret-data;
                                            enabled: root.is-editing;
                                            font-size: 11px;
                                            input-type: root.reveal-password ? text : password;
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 20px; height: 20px; y: (parent.height - self.height) / 2; border-radius: 3px;
                                            background: v-eye-pwd.has-hover ? AppTheme.hover-background : transparent;
                                            Image {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                source: root.reveal-password ? @image-url("../assets/icons/eye.svg") : @image-url("../assets/icons/eye-off.svg");
                                                width: 14px; height: 14px; image-fit: contain;
                                                colorize: root.reveal-password ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                            v-eye-pwd := TouchArea { clicked => { root.reveal-password = !root.reveal-password; } mouse-cursor: pointer; }
                                        }
                                    }
                                }
                            }
                        }

                        // ----------------- Agent 专用属性 -----------------
                        if root.form-type == "agent": VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            if root.is-editing: VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                Text { text: @tr("常用 Agent 快速预设 (点击一键填入管道路径)"); font-size: 10px; color: AppTheme.secondary-foreground; }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    // 1Password
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p1.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p1 := TouchArea {
                                            clicked => {
                                                root.form-name = "1Password SSH Agent";
                                                root.form-algorithm = "1Password";
                                                root.form-secret-data = "\\\\.\\pipe\\1password-ssh-agent";
                                                root.form-notes = @tr("1Password 密码管理器内置 SSH 认证代理管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/key.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "1Password"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Windows OpenSSH Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p2.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p2 := TouchArea {
                                            clicked => {
                                                root.form-name = "Windows OpenSSH Agent";
                                                root.form-algorithm = "OpenSSH";
                                                root.form-secret-data = "\\\\.\\pipe\\openssh-ssh-agent";
                                                root.form-notes = @tr("Windows 内置 OpenSSH Authentication Agent 服务管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/terminal.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "OpenSSH"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Bitwarden Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p3.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p3 := TouchArea {
                                            clicked => {
                                                root.form-name = "Bitwarden SSH Agent";
                                                root.form-algorithm = "Bitwarden";
                                                root.form-secret-data = "\\\\.\\pipe\\bitwarden-ssh-agent";
                                                root.form-notes = @tr("Bitwarden / Vaultwarden 桌面端托管 SSH 代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/shield.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "Bitwarden"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // KeePassXC
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p4.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p4 := TouchArea {
                                            clicked => {
                                                root.form-name = "KeePassXC SSH Agent";
                                                root.form-algorithm = "KeePassXC";
                                                root.form-secret-data = "\\\\.\\pipe\\kpxc_server";
                                                root.form-notes = @tr("KeePassXC 本地密码库 SSH Agent 代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/lock.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "KeePassXC"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // Pageant
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p5.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p5 := TouchArea {
                                            clicked => {
                                                root.form-name = "Pageant (PuTTY)";
                                                root.form-algorithm = "Pageant";
                                                root.form-secret-data = "\\\\.\\pipe\\pageant";
                                                root.form-notes = @tr("PuTTY / WinSCP Pageant 经典认证协议代理");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/tunnel.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "Pageant"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }

                                    // GPG Agent
                                    Rectangle {
                                        height: 22px; border-radius: 3px; background: v-agt-p6.has-hover ? AppTheme.hover-background : AppTheme.control-background; border-width: 1px; border-color: AppTheme.border;
                                        v-agt-p6 := TouchArea {
                                            clicked => {
                                                root.form-name = "GnuPG SSH Agent";
                                                root.form-algorithm = "GnuPG";
                                                root.form-secret-data = "\\\\.\\pipe\\gnupg-ssh-agent";
                                                root.form-notes = @tr("GnuPG / YubiKey 智能卡 SSH 认证代理管道");
                                            }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icons/zap.svg"); width: 11px; height: 11px; colorize: AppTheme.foreground; } }
                                            Text { text: "GnuPG"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("Agent 标识"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.form-algorithm;
                                            enabled: root.is-editing;
                                            font-size: 11px;
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text { text: @tr("命名管道路径"); font-size: 10px; color: AppTheme.secondary-foreground; }
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.form-secret-data;
                                            enabled: root.is-editing;
                                            font-size: 11px;
                                            color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 备注说明
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("备注说明"); font-size: 10px; color: AppTheme.secondary-foreground; }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: (root.is-editing && notes-input.has-focus) ? AppTheme.accent : AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    notes-input := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.form-notes;
                                        enabled: root.is-editing;
                                        font-size: 11px;
                                        color: root.is-editing ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 模式 C: 未选择凭据空状态 (!is-create-mode && active-cred-id == "")
            // -----------------------------------------------------------------
            if !root.is-create-mode && root.active-cred-id == "": Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 4px;
                        background: AppTheme.surface-background;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        x: (parent.width - self.width) / 2;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../assets/icons/key.svg");
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            colorize: AppTheme.secondary-foreground;
                        }
                    }

                    Text {
                        text: @tr("请从左侧选择凭据以查看详情");
                        font-size: 12px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
