import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { SearchInput } from "../../components/search-input.slint";
import { StatusDot } from "../../components/status-dot.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";
import { ScrollView } from "std-widgets.slint";


/// 主机项数据结构 (Host Item Data)
///
/// 专用于卡片列表平铺视图模式的数据模型。
export struct HostItemData {
    /// 主机全局唯一标识符
    id: string,
    /// 主机名称 (如 "prod-server-01")
    name: string,
    /// 主机 IP 地址或可解析域名
    address: string,
    /// SSH 服务连接端口 (默认为 22)
    port: int,
    /// 所属分组的显示名称 (如 "生产集群")
    group: string,
    /// 主机运行健康状态 ("online": 在线, "warning": 告警, "error": 异常, "offline": 离线)
    status: string,
    /// 网络延迟测速结果 (单位毫秒)
    ping-ms: int,
}

/// 树形结构节点模型 (Host Tree Node)
///
/// 专用于树状层级折叠视图模式的数据模型，支持无限层级嵌套。
export struct HostTreeNode {
    /// 节点的唯一标识符
    id: string,
    /// 节点的显示名称 (如 "Kubernetes 集群" 或 "k8s-control-plane")
    name: string,
    /// 当前节点是否为分组文件夹 (true: 分组, false: 主机资产)
    is-group: bool,
    /// 父级分组的 ID (顶级根节点为空字符串 "")
    parent-id: string,
    /// 树形层级深度，用于计算左侧缩进 (缩进 = level * 14px)
    level: int,
    /// 当前分组是否处于展开状态 (仅 is-group 为 true 时有效)
    is-expanded: bool,
    /// 主机 IP 地址 (仅主机节点有效)
    address: string,
    /// 连接端口 (仅主机节点有效)
    port: int,
    /// 在线健康状态 ("online", "warning", "error", "offline")
    status: string,
    /// 网络延迟 (毫秒)
    ping-ms: int,
    /// 分组文件夹内包含的主机数量 (仅 is-group 为 true 时有效)
    item-count: int,
}

/// 主机管理抽屉组件 (Hosts Drawer)
///
/// 负责展示主机资产的树形层级视图与卡片列表视图，支持实时搜索、折叠展开与横向平滑滚动。
export component HostsDrawer inherits DrawerContainer {
    title: @tr("主机管理");
    collapse-icon: "◀";

    /// 当前视图模式: "tree" (树形层级嵌套模式) | "card" (卡片列表平铺模式)
    in-out property <string> view-mode: "tree";
    /// 当前选中的高亮主机 ID
    in-out property <string> selected-host-id: "1";
    /// 当前树形内容的最大呈现宽度（根据节点长名称动态扩展，驱动自适应横向滚动）
    in-out property <length> tree-content-width: 240px;

    /// 树形层级嵌套数据源 (由 Rust 存储层提供唯一真相源)
    in-out property <[HostTreeNode]> tree-nodes: [];

    /// 卡片模式扁平列表数据源 (由 Rust 存储层提供唯一真相源)
    in property <[HostItemData]> hosts: [];


    /// 单击选中主机事件回调
    callback host-selected(string /* id */);
    /// 双击打开主机终端连接事件回调
    callback host-double-clicked(string /* id */);
    /// 折叠或展开指定分组事件回调
    callback toggle-group(string /* group-id */);
    /// 移动节点事件回调 (source-id, target-id, drop-position)
    callback move-node(string /* source-id */, string /* target-id */, string /* drop-position */);
    /// 拖拽悬停计算事件回调 (source-id, target-index, offset-in-row)
    callback request-drag-hover(string /* source-id */, int /* target-index */, float /* offset-in-row */);
    /// 搜索框输入变更事件回调
    callback search-changed(string /* query */);
    /// 打开本地 Shell 事件回调
    callback open-local-shell(string /* type */);
    /// 点击新建主机按钮事件回调
    callback create-new-host();
    /// 点击新建分组按钮事件回调
    callback create-new-group();

    /// 拖拽交互状态
    in-out property <bool> is-dragging: false;
    in-out property <string> drag-source-id: "";
    in-out property <string> drag-source-name: "";
    in-out property <bool> drag-source-is-group: false;
    in-out property <string> drop-target-id: "";
    in-out property <string> drop-target-name: "";
    in-out property <int> drop-target-index: -1;
    in-out property <string> drop-position: "inside"; // "before" | "inside" | "after" | "root" | ""
    in-out property <bool> drop-target-valid: true;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        width: 100%;
        height: 100%;

        // 1. 顶部操作栏 (搜索框 + 树形/卡片视图切换器)
        HorizontalLayout {
            spacing: 6px;
            height: 28px;

            // 搜索输入框 (实时搜索与清空)
            SearchInput {
                placeholder: @tr("搜索主机、IP或分组...");
                horizontal-stretch: 1;
                changed(query) => { root.search-changed(query); }
                clear => { root.search-changed(""); }
            }

            // 视图模式切换胶囊 (树形 vs 卡片)
            Rectangle {
                width: 58px;
                height: 28px;
                border-radius: 4px;
                background: AppTheme.surface-background;
                border-width: 1px;
                border-color: AppTheme.border;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    // 树形模式按钮
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: root.view-mode == "tree" ? AppTheme.control-background : tree-btn-touch.has-hover ? AppTheme.hover-background : transparent;
                        border-width: root.view-mode == "tree" ? 1px : 0px;
                        border-color: AppTheme.border;

                        animate background { duration: 120ms; }

                        Image {
                            source: @image-url("../../assets/icons/tree.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: root.view-mode == "tree" ? AppTheme.accent : tree-btn-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        tree-btn-touch := TouchArea {
                            clicked => { root.view-mode = "tree"; }
                            mouse-cursor: pointer;
                        }
                    }

                    // 卡片模式按钮
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: root.view-mode == "card" ? AppTheme.control-background : card-btn-touch.has-hover ? AppTheme.hover-background : transparent;
                        border-width: root.view-mode == "card" ? 1px : 0px;
                        border-color: AppTheme.border;

                        animate background { duration: 120ms; }

                        Image {
                            source: @image-url("../../assets/icons/layout-grid.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: root.view-mode == "card" ? AppTheme.accent : card-btn-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        card-btn-touch := TouchArea {
                            clicked => { root.view-mode = "card"; }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        // 2. 列表统计与快捷创建栏
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            alignment: space-between;
            height: 22px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.view-mode == "tree" ? @tr("树形层级视图") : @tr("全部主机列表");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 16px;
                    border-radius: 8px;
                    background: AppTheme.control-background;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;

                        Text {
                            text: root.hosts.length + " 台";
                            font-size: 9px;
                            font-weight: 600;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 新建主机与分组动作
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                AppIconButton {
                    icon: @image-url("../../assets/icons/folder-plus.svg");
                    clicked => { root.create-new-group(); }
                }

                AppIconButton {
                    icon: @image-url("../../assets/icons/plus.svg");
                    clicked => { root.create-new-host(); }
                }
            }

        }

        // 2.5 拖拽时的顶级根目录放置区 (仅在树形模式呈现，列表模式无物理分组概念无需显示)
        if root.is-dragging && root.view-mode == "tree": Rectangle {
            height: 28px;
            border-radius: 4px;
            background: root.drop-target-id == "root" ? AppTheme.accent.transparentize(70%) : AppTheme.control-background;
            border-width: 1.5px;
            border-color: root.drop-target-id == "root" ? AppTheme.accent : AppTheme.border;
            animate background { duration: 120ms; }
            animate border-color { duration: 120ms; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/folder.svg");
                        width: 13px;
                        height: 13px;
                        image-fit: contain;
                        colorize: root.drop-target-id == "root" ? AppTheme.accent : AppTheme.secondary-foreground;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("移至根目录 (未分组)");
                        font-size: 11px;
                        font-weight: 600;
                        color: root.drop-target-id == "root" ? AppTheme.accent : AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 3. 核心工作区 (支持 Flickable 视口精确映射、滚轮平滑滚动与拖拽)
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            scroll-area := Flickable {
                width: 100%;
                height: 100%;
                interactive: false;
                viewport-width: root.view-mode == "tree" ? Math.max(self.width, root.tree-content-width) : self.width;
                viewport-height: (root.view-mode == "tree" ? root.tree-nodes.length * 32px : root.hosts.length * 56px) + 8px;

                // 3.1 树形层级结构视图 (Tree View: 支持拖拽移动、根据最宽节点自然撑开，超宽时触发平滑横向滚动)
                if root.view-mode == "tree": VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: Math.max(scroll-area.width, root.tree-content-width);
                    height: root.tree-nodes.length * 32px;
                    spacing: 2px;
                    alignment: start;

                    for node[idx] in root.tree-nodes: Rectangle {
                        height: 30px;
                        width: 100%;
                        min-width: Math.max(scroll-area.width, root.tree-content-width);
                        border-radius: 4px;
                        opacity: (root.is-dragging && node.id == root.drag-source-id) ? 0.35 : 1.0;
                        background: (node.is-group && root.is-dragging && root.drop-target-index == idx && root.drop-target-valid) ? AppTheme.accent.transparentize(85%) : (node.id == root.selected-host-id && !node.is-group) ? AppTheme.control-background : tree-touch.has-hover ? AppTheme.hover-background.transparentize(40%) : transparent;
                        border-width: 1px;
                        border-color: (node.is-group && root.is-dragging && root.drop-target-index == idx && root.drop-target-valid) ? AppTheme.accent.transparentize(40%) : (node.id == root.selected-host-id && !node.is-group) ? AppTheme.border : transparent;

                        animate background { duration: root.is-dragging ? 0ms : 120ms; }
                        animate opacity { duration: root.is-dragging ? 0ms : 120ms; }

                        tree-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.drag-source-id = node.id;
                                    root.drag-source-name = node.name;
                                    root.drag-source-is-group = node.is-group;
                                    root.is-dragging = false;
                                    root.drop-target-index = -1;
                                }
                                if event.kind == PointerEventKind.up {
                                    if root.is-dragging && root.drop-target-valid && root.drop-target-id != "" {
                                        if root.drop-target-id == "root" {
                                            root.move-node(root.drag-source-id, "root", "root");
                                        } else if (root.drop-target-id != root.drag-source-id || root.drop-position != "inside") {
                                            root.move-node(root.drag-source-id, root.drop-target-id, root.drop-position);
                                        }
                                    }
                                    root.is-dragging = false;
                                    root.drag-source-id = "";
                                    root.drop-target-id = "";
                                    root.drop-target-name = "";
                                    root.drop-target-index = -1;
                                    root.drop-position = "inside";
                                }
                                if event.kind == PointerEventKind.cancel {
                                    // 仅在手势取消时复位状态，绝不执行移动调序
                                    root.is-dragging = false;
                                    root.drag-source-id = "";
                                    root.drop-target-id = "";
                                    root.drop-target-name = "";
                                    root.drop-target-index = -1;
                                    root.drop-position = "inside";
                                }
                            }
                            moved => {
                                if self.pressed {
                                    if Math.abs(self.mouse-x - self.pressed-x) > 3px || Math.abs(self.mouse-y - self.pressed-y) > 3px {
                                        root.is-dragging = true;
                                        root.drag-source-id = node.id;
                                        root.drag-source-name = node.name;
                                        root.drag-source-is-group = node.is-group;
                                        root.drag-x = self.mouse-x;
                                        let total_y = idx * 32px + self.mouse-y;
                                        root.drag-y = total_y;

                                        let screen_y = total_y + scroll-area.viewport-y;
                                        if screen_y < 16px {
                                            root.drop-target-index = -1;
                                            root.drop-target-id = "root";
                                            root.drop-position = "root";
                                            root.drop-target-valid = true;
                                            root.request-drag-hover(root.drag-source-id, -1, 0.0);
                                        } else {
                                            let target_idx = Math.max(0, Math.min(root.tree-nodes.length - 1, Math.floor(total_y / 32px)));
                                            root.drop-target-index = target_idx;
                                            root.drop-target-valid = (target_idx != idx || root.tree-nodes[target_idx].id != node.id);
                                            root.request-drag-hover(root.drag-source-id, target_idx, 0.0);
                                        }
                                    }
                                }
                            }
                            clicked => {
                                if !root.is-dragging {
                                    if node.is-group {
                                        root.toggle-group(node.id);
                                    } else {
                                        root.selected-host-id = node.id;
                                        root.host-selected(node.id);
                                    }
                                }
                            }
                            double-clicked => {
                                if !node.is-group && !root.is-dragging {
                                    root.host-double-clicked(node.id);
                                }
                            }
                            mouse-cursor: root.is-dragging ? copy : pointer;
                        }

                        // 核心：唯一下线指示条 (Bottom Insertion Line: 从图标起始至名称后方，无起始圆点)
                        if root.is-dragging && root.drop-target-index == idx && root.drop-target-valid && root.drop-target-id != "root": Rectangle {
                            x: 6px + node.level * 14px;
                            y: parent.height - 2px;
                            width: Math.min(125px, parent.width - 16px - node.level * 14px);
                            height: 2px;
                            background: AppTheme.accent;
                            border-radius: 1px;
                            z: 20;
                        }




                        HorizontalLayout {
                            // 层级缩进 (level * 14px)
                            padding-left: 6px + node.level * 14px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: space-between;

                            // 左侧：折叠箭头 + 图标 + 名称
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;

                                // 文件夹图标 (折叠/展开形态自适应切换) / 主机终端图标
                                VerticalLayout {
                                    alignment: center;

                                    if node.is-group: Image {
                                        source: node.is-expanded ? @image-url("../../assets/icons/folder-open.svg") : @image-url("../../assets/icons/folder.svg");
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                        colorize: (node.is-group && root.is-dragging && root.drop-target-index == idx && root.drop-target-valid) ? AppTheme.accent : AppTheme.secondary-foreground;
                                    }

                                    if !node.is-group: Image {
                                        source: @image-url("../../assets/icons/server.svg");
                                        width: 12px;
                                        height: 12px;
                                        image-fit: contain;
                                        colorize: node.id == root.selected-host-id ? AppTheme.accent : tree-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                                    }
                                }

                                // 主机在线/离线状态指示灯
                                if !node.is-group: VerticalLayout {
                                    alignment: center;

                                    StatusDot {
                                        status: node.status;
                                        dot-size: 5px;
                                    }
                                }

                                // 节点名称 (自然展开，超宽时触发平滑横向滚动)
                                VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: node.name;
                                        font-size: 11px;
                                        font-weight: node.is-group ? 600 : node.id == root.selected-host-id ? 600 : 400;
                                        color: (node.is-group && root.is-dragging && root.drop-target-index == idx && root.drop-target-valid) ? AppTheme.accent : node.is-group ? AppTheme.foreground : node.id == root.selected-host-id ? AppTheme.foreground : tree-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 右侧：如果是分组且为 drop 目标显示高亮提示，否则显示数量/延迟
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;

                                if node.is-group && root.is-dragging && root.drop-target-index == idx && root.drop-target-valid: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 18px;
                                        border-radius: 9px;
                                        background: AppTheme.accent;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: @tr("移入此分组");
                                                font-size: 9px;
                                                font-weight: 600;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if node.is-group && (!root.is-dragging || root.drop-target-index != idx): VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: "(" + node.item-count + ")";
                                        font-size: 10px;
                                        color: AppTheme.disabled-foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                if !node.is-group && node.ping-ms > 0: VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: node.ping-ms + "ms";
                                        font-size: 9px;
                                        font-weight: 500;
                                        color: node.ping-ms > 50 ? AppTheme.warning : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 3.2 卡片模式视图 (Card View: 现代化富卡片，严格锁定 100% 宽度，仅纯竖向滚动)
                if root.view-mode == "card": VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: scroll-area.width;
                    height: root.hosts.length * 56px;
                    spacing: 6px;
                    alignment: start;

                    for host[idx] in root.hosts: Rectangle {
                        height: 50px;
                        width: 100%;
                        border-radius: 4px;
                        opacity: (root.is-dragging && host.id == root.drag-source-id) ? 0.35 : 1.0;
                        background: host.id == root.selected-host-id ? AppTheme.control-background : card-item-touch.has-hover ? AppTheme.hover-background.transparentize(40%) : AppTheme.surface-background;
                        border-width: 1px;
                        border-color: host.id == root.selected-host-id ? AppTheme.border : card-item-touch.has-hover ? AppTheme.border : AppTheme.border.transparentize(50%);

                        animate background { duration: root.is-dragging ? 0ms : 120ms; }
                        animate border-color { duration: root.is-dragging ? 0ms : 120ms; }
                        animate opacity { duration: root.is-dragging ? 0ms : 120ms; }

                        card-item-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.drag-source-id = host.id;
                                    root.drag-source-name = host.name;
                                    root.drag-source-is-group = false;
                                    root.is-dragging = false;
                                    root.drop-target-index = -1;
                                }
                                if event.kind == PointerEventKind.up {
                                    if root.is-dragging && root.drop-target-valid && root.drop-target-id != "" && root.drop-target-id != root.drag-source-id {
                                        root.move-node(root.drag-source-id, root.drop-target-id, root.drop-position);
                                    }
                                    root.is-dragging = false;
                                    root.drag-source-id = "";
                                    root.drop-target-id = "";
                                    root.drop-target-name = "";
                                    root.drop-target-index = -1;
                                    root.drop-position = "inside";
                                }
                                if event.kind == PointerEventKind.cancel {
                                    root.is-dragging = false;
                                    root.drag-source-id = "";
                                    root.drop-target-id = "";
                                    root.drop-target-name = "";
                                    root.drop-target-index = -1;
                                    root.drop-position = "inside";
                                }
                            }
                            moved => {
                                if self.pressed {
                                    if Math.abs(self.mouse-x - self.pressed-x) > 3px || Math.abs(self.mouse-y - self.pressed-y) > 3px {
                                        root.is-dragging = true;
                                        root.drag-source-id = host.id;
                                        root.drag-source-name = host.name;
                                        root.drag-source-is-group = false;
                                        root.drag-x = self.mouse-x;
                                        let total_y = idx * 56px + self.mouse-y;
                                        root.drag-y = total_y;

                                        let target_idx = Math.max(0, Math.min(root.hosts.length - 1, Math.floor((total_y + 24px) / 56px)));
                                        root.drop-target-index = target_idx;
                                        root.drop-target-valid = (target_idx != idx || root.hosts[target_idx].id != host.id);
                                        root.request-drag-hover(root.drag-source-id, target_idx, 0.0);

                                    }
                                }
                            }
                            clicked => {
                                if !root.is-dragging {
                                    root.selected-host-id = host.id;
                                    root.host-selected(host.id);
                                }
                            }
                            double-clicked => {
                                if !root.is-dragging {
                                    root.host-double-clicked(host.id);
                                }
                            }
                            mouse-cursor: root.is-dragging ? copy : pointer;
                        }

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 3px;
                            alignment: center;

                            // 卡片顶行：状态灯 + 主机名称 + 分组徽章
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;

                                        StatusDot {
                                            status: host.status;
                                            dot-size: 6px;
                                        }
                                    }

                                    Text {
                                        text: host.name;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                // 分组胶囊
                                Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border.transparentize(40%);

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;

                                        Text {
                                            text: host.group;
                                            font-size: 9px;
                                            font-weight: 600;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 卡片底行：IP 地址与端口 + 延迟时间
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: space-between;

                                Text {
                                    text: host.address + ":" + host.port;
                                    font-size: 11px;
                                    color: AppTheme.secondary-foreground;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                if host.ping-ms > 0: HorizontalLayout {
                                    spacing: 3px;
                                    alignment: end;

                                    Text {
                                        text: "●";
                                        font-size: 6px;
                                        color: host.ping-ms > 50 ? AppTheme.warning : AppTheme.success;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: host.ping-ms + "ms";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: host.ping-ms > 50 ? AppTheme.warning : AppTheme.success;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 核心：唯一下线指示条 (Bottom Insertion Line: 居中贯穿卡片底部，两端留出 8px 边距，无起始圆点)
                        if root.is-dragging && root.drop-target-index == idx && root.drop-target-valid: Rectangle {
                            x: 8px;
                            y: parent.height - 2px;
                            width: parent.width - 16px;
                            height: 2px;
                            background: AppTheme.accent;
                            border-radius: 1px;
                            z: 20;
                        }


                    }
                }
            }

            // 悬浮竖向滚动条 (宽 5px 导轨 + 滑块，支持滚轮与鼠标直接拖拽)
            if scroll-area.viewport-height > scroll-area.height: Rectangle {
                x: parent.width - 6px;
                y: 0px;
                width: 6px;
                height: parent.height - (scroll-area.viewport-width > scroll-area.width ? 6px : 0px);

                v-thumb := Rectangle {
                    x: 0.5px;
                    y: Math.max(0px, Math.min(parent.height - self.height, (-scroll-area.viewport-y / Math.max(1px, scroll-area.viewport-height - scroll-area.height)) * (parent.height - self.height)));
                    width: 5px;
                    height: Math.max(28px, (scroll-area.height / scroll-area.viewport-height) * parent.height);
                    border-radius: 2.5px;
                    background: v-touch.has-hover || v-touch.pressed ? AppTheme.accent : AppTheme.secondary-foreground.transparentize(50%);

                    animate background { duration: 120ms; }

                    v-touch := TouchArea {
                        mouse-cursor: pointer;
                        moved => {
                            if self.pressed {
                                scroll-area.viewport-y = Math.min(0px, Math.max(scroll-area.height - scroll-area.viewport-height, scroll-area.viewport-y - (self.mouse-y - self.pressed-y) * (scroll-area.viewport-height / scroll-area.height)));
                            }
                        }
                    }
                }
            }

            // 悬浮横向滚动条 (高 5px 导轨 + 滑块，在树形模式内容超宽时呈现，支持 Shift+滚轮与鼠标直接拖拽)
            if root.view-mode == "tree" && scroll-area.viewport-width > scroll-area.width: Rectangle {
                x: 0px;
                y: parent.height - 6px;
                height: 6px;
                width: parent.width - (scroll-area.viewport-height > scroll-area.height ? 6px : 0px);

                h-thumb := Rectangle {
                    x: Math.max(0px, Math.min(parent.width - self.width, (-scroll-area.viewport-x / Math.max(1px, scroll-area.viewport-width - scroll-area.width)) * (parent.width - self.width)));
                    y: 0.5px;
                    height: 5px;
                    width: Math.max(36px, (scroll-area.width / scroll-area.viewport-width) * parent.width);
                    border-radius: 2.5px;
                    background: h-touch.has-hover || h-touch.pressed ? AppTheme.accent : AppTheme.accent.transparentize(30%);

                    animate background { duration: 120ms; }

                    h-touch := TouchArea {
                        mouse-cursor: pointer;
                        moved => {
                            if self.pressed {
                                scroll-area.viewport-x = Math.min(0px, Math.max(scroll-area.width - scroll-area.viewport-width, scroll-area.viewport-x - (self.mouse-x - self.pressed-x) * (scroll-area.viewport-width / scroll-area.width)));
                            }
                        }
                    }
                }
            }

            // 4. 浮动拖拽跟随卡片 (Drag Ghost Follower: 仅展示被拖动的源节点图标与名称，半透明预览)
            if root.is-dragging: Rectangle {
                x: 12px;
                y: Math.max(6px, Math.min(parent.height - 36px, root.drag-y + scroll-area.viewport-y - 14px));
                width: Math.min(parent.width - 24px, 150px);
                height: 28px;
                border-radius: 6px;
                background: AppTheme.panel-background.transparentize(15%);
                opacity: 0.82;
                border-width: 1.5px;
                border-color: AppTheme.accent.transparentize(10%);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.drag-source-is-group ? @image-url("../../assets/icons/folder.svg") : @image-url("../../assets/icons/server.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: AppTheme.accent;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.drag-source-name;
                            font-size: 11px;
                            font-weight: 600;
                            color: AppTheme.foreground;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

