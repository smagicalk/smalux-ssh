import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { ScrollView } from "std-widgets.slint";

/// 历史会话项数据结构
export struct HistoryItemData {
    id: string,
    host-name: string,
    address: string,
    time-ago: string,
    duration: string,
}

/// 历史会话抽屉 (History Drawer)
export component HistoryDrawer inherits DrawerContainer {
    title: @tr("历史会话");
    collapse-icon: "◀";

    in property <[HistoryItemData]> history-items: [
        { id: "1", host-name: "prod-server-01", address: "192.168.1.100", time-ago: "10分钟前", duration: "45分钟" },
        { id: "2", host-name: "k8s-control-plane", address: "10.0.0.12", time-ago: "2小时前", duration: "1小时20分" },
        { id: "3", host-name: "prod-db-master", address: "192.168.1.102", time-ago: "昨天 16:30", duration: "18分钟" },
        { id: "4", host-name: "staging-api-test", address: "10.0.12.88", time-ago: "3天前", duration: "5分钟" },
    ];

    callback reconnect(string /* id */);
    callback clear-all();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 头部操作提示
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;

            Text {
                text: @tr("最近连接记录");
                font-size: 11px;
                color: AppTheme.secondary-foreground;
                horizontal-alignment: left;
            }

            Rectangle {
                width: 50px;
                height: 20px;
                border-radius: AppTheme.radius-small;
                background: clear-touch.has-hover ? AppTheme.hover-background : transparent;

                Text {
                    text: @tr("清空");
                    font-size: 10px;
                    color: AppTheme.disabled-foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                clear-touch := TouchArea {
                    clicked => { root.clear-all(); }
                    mouse-cursor: pointer;
                }
            }
        }

        // 历史列表
        ScrollView {
            VerticalLayout {
                spacing: 4px;

                for item in root.history-items: Rectangle {
                    height: 54px;
                    border-radius: AppTheme.radius-medium;
                    background: item-touch.has-hover ? AppTheme.hover-background : transparent;

                    item-touch := TouchArea {
                        clicked => { root.reconnect(item.id); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "◷";
                            font-size: 14px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: item.host-name;
                                font-size: 12px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                text: item.address;
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                            }

                            Text {
                                text: item.time-ago;
                                font-size: 10px;
                                color: AppTheme.disabled-foreground;
                            }
                        }
                    }

                    // 重连按钮
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: AppTheme.radius-small;
                        background: recon-touch.has-hover ? AppTheme.accent : AppTheme.control-background;

                        Text {
                            text: "▶";
                            font-size: 10px;
                            color: recon-touch.has-hover ? #ffffff : AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        recon-touch := TouchArea {
                            clicked => { root.reconnect(item.id); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}
}
