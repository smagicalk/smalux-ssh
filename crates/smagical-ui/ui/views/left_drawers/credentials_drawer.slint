import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { ScrollView } from "std-widgets.slint";

/// 凭据项数据结构
export struct CredentialItemData {
    id: string,
    name: string,
    cred-type: string, // "key" | "password"
    fingerprint: string,
}

/// 凭据保管抽屉 (Credentials Drawer)
export component CredentialsDrawer inherits DrawerContainer {
    title: @tr("凭据保管");
    collapse-icon: "◀";

    in property <[CredentialItemData]> credentials: [
        { id: "1", name: "id_ed25519_prod", cred-type: "key", fingerprint: "SHA256:4a8b... (Ed25519 256bit)" },
        { id: "2", name: "id_rsa_legacy_jump", cred-type: "key", fingerprint: "SHA256:7f9c... (RSA 4096bit)" },
        { id: "3", name: "root_default_vault", cred-type: "password", fingerprint: "••••••••••••" },
    ];

    callback select-cred(string /* id */);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 顶部安全状态卡片
        Rectangle {
            height: 36px;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "⚿";
                    font-size: 13px;
                    color: AppTheme.success;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("凭据保管箱已就绪 (AES-256)");
                    font-size: 11px;
                    color: AppTheme.success;
                    vertical-alignment: center;
                }
            }
        }

        // 列表
        ScrollView {
            VerticalLayout {
                spacing: 4px;

                for cred in root.credentials: Rectangle {
                    height: 50px;
                    border-radius: AppTheme.radius-medium;
                    background: cred-touch.has-hover ? AppTheme.hover-background : transparent;

                    cred-touch := TouchArea {
                        clicked => { root.select-cred(cred.id); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "⚿";
                            font-size: 14px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: cred.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                            }

                            Text {
                                text: cred.fingerprint;
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                            }
                        }
                    }
                }
            }
        }
    }
}
