// =============================================================================
// 文件名称: credentials_drawer.slint
// 模块功能: 凭据保管抽屉 (Credentials Drawer)
// 核心设计: 集中管理 SSH 密钥对、账号密码、外部 SSH Agent 与证书资产，支持分类筛选、检索、一键复制与 CRUD
// =============================================================================

import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { SearchInput } from "../../components/search-input.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";
import { ScrollView } from "std-widgets.slint";

/// 凭据项统一展示数据结构
export struct CredentialItemData {
    id: string,
    name: string,
    cred-type: string,       // "key" | "password" | "agent" | "certificate"
    algorithm: string,       // "Ed25519" | "RSA-4096" | "Password" | "1Password" | "OpenSSH Agent"
    username: string,        // "root" / "ubuntu"
    fingerprint: string,     // "SHA256:7f4a9b2c8e1d5a6f3b0c9e8d7a6b5c4e"
    public-key: string,      // "ssh-ed25519 AAAAC3..."
    has-passphrase: bool,    // 是否有口令保护
    bound-host-count: int,   // 绑定的主机数
    updated-at: string,      // 最近更新时间
    notes: string,           // 备注
}

/// 凭据保管抽屉组件 (Credentials Drawer)
export component CredentialsDrawer inherits DrawerContainer {
    title: @tr("凭据保管");
    collapse-icon: "◀";

    in property <[CredentialItemData]> credentials: [];
    in-out property <string> filter-category: "all"; // "all" | "key" | "password" | "agent"
    in-out property <string> search-query: "";
    in-out property <string> active-cred-id: "";

    // 统计计算属性
    in property <int> total-count: root.credentials.length;
    in property <int> key-count: 0;
    in property <int> password-count: 0;
    in property <int> agent-count: 0;

    callback select-cred(string /* id */);
    callback open-create-modal();
    callback edit-cred(string /* id */);
    callback delete-cred(string /* id */);
    callback copy-secret(string /* id */);
    callback search-changed(string /* query */);
    callback filter-category-changed(string /* category */);

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 8px;
        spacing: 8px;

        // ---------------------------------------------------------------------
        // 1. 顶部安全状态卡片与快捷新建按钮
        // ---------------------------------------------------------------------
        Rectangle {
            height: 38px;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "🛡️";
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: @tr("AES-256 加密保管库");
                            font-size: 11px;
                            font-weight: 700;
                            color: AppTheme.success;
                        }

                        Text {
                            text: root.total-count > 0 ? (root.total-count + " 项凭据 · 实时保护") : "尚未录入凭据";
                            font-size: 9px;
                            color: AppTheme.secondary-foreground;
                        }
                    }
                }

                // 新建凭据操作按钮
                Rectangle {
                    width: 72px;
                    height: 24px;
                    border-radius: 4px;
                    background: add-touch.has-hover ? AppTheme.accent.darker(15%) : AppTheme.accent;
                    y: (parent.height - self.height) / 2;

                    add-touch := TouchArea {
                        clicked => { root.open-create-modal(); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: "+";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("新建");
                            font-size: 11px;
                            font-weight: 600;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 2. 分类分段切换标签栏 (All / Keys / Passwords / Agent)
        // ---------------------------------------------------------------------
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;

                // 全部 (All)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "all"
                        ? AppTheme.selected-background
                        : (all-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "all" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    all-touch := TouchArea {
                        clicked => {
                            root.filter-category = "all";
                            root.filter-category-changed("all");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("全部");
                        font-size: 10px;
                        font-weight: root.filter-category == "all" ? 700 : 500;
                        color: root.filter-category == "all" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 密钥 (Keys)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "key"
                        ? AppTheme.selected-background
                        : (key-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "key" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    key-touch := TouchArea {
                        clicked => {
                            root.filter-category = "key";
                            root.filter-category-changed("key");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("密钥");
                        font-size: 10px;
                        font-weight: root.filter-category == "key" ? 700 : 500;
                        color: root.filter-category == "key" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 密码 (Passwords)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "password"
                        ? AppTheme.selected-background
                        : (pwd-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "password" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    pwd-touch := TouchArea {
                        clicked => {
                            root.filter-category = "password";
                            root.filter-category-changed("password");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("密码");
                        font-size: 10px;
                        font-weight: root.filter-category == "password" ? 700 : 500;
                        color: root.filter-category == "password" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Agent (代理)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "agent"
                        ? AppTheme.selected-background
                        : (agent-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "agent" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    agent-touch := TouchArea {
                        clicked => {
                            root.filter-category = "agent";
                            root.filter-category-changed("agent");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("代理");
                        font-size: 10px;
                        font-weight: root.filter-category == "agent" ? 700 : 500;
                        color: root.filter-category == "agent" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 3. 实时关键词过滤搜索框
        // ---------------------------------------------------------------------
        SearchInput {
            placeholder: @tr("搜索凭据名称、用户名、指纹...");
            text <=> root.search-query;
            changed(q) => {
                root.search-query = q;
                root.search-changed(q);
            }
            clear => {
                root.search-query = "";
                root.search-changed("");
            }
        }

        // ---------------------------------------------------------------------
        // 4. 凭据卡片列表与空状态
        // ---------------------------------------------------------------------
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                padding-bottom: 8px;

                if root.credentials.length == 0: Rectangle {
                    height: 140px;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.surface-background.transparentize(50%);
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "🔐";
                            font-size: 28px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.search-query != "" ? @tr("未找到匹配的凭据记录") : @tr("暂无已保存凭据");
                            font-size: 11px;
                            font-weight: 600;
                            color: AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                        }

                        if root.search-query == "": Rectangle {
                            width: 100px;
                            height: 24px;
                            border-radius: 4px;
                            background: empty-add-touch.has-hover ? AppTheme.accent.darker(15%) : AppTheme.accent;
                            x: (parent.width - self.width) / 2;

                            empty-add-touch := TouchArea {
                                clicked => { root.open-create-modal(); }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: @tr("+ 立即录入");
                                font-size: 11px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                for cred in root.credentials: Rectangle {
                    height: 52px;
                    border-radius: AppTheme.radius-medium;
                    background: cred.id == root.active-cred-id
                        ? AppTheme.selected-background
                        : (cred-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                    border-width: 1px;
                    border-color: cred.id == root.active-cred-id
                        ? AppTheme.accent
                        : (cred-touch.has-hover ? AppTheme.border : transparent);

                    animate background, border-color { duration: 100ms; }

                    cred-touch := TouchArea {
                        clicked => {
                            root.active-cred-id = cred.id;
                            root.select-cred(cred.id);
                        }
                        mouse-cursor: pointer;
                    }

                    // 0. 左侧激活高亮指示条
                    if (cred.id == root.active-cred-id): Rectangle {
                        x: 0px;
                        y: 6px;
                        width: 3px;
                        height: parent.height - 12px;
                        border-radius: 1.5px;
                        background: AppTheme.accent;
                    }

                    // 1. 左侧图标 (放大占满高度，留 6px 边距)
                    Rectangle {
                        x: 6px;
                        y: 6px;
                        width: parent.height - 12px;
                        height: parent.height - 12px;
                        border-radius: 4px;
                        background: AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.border;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: cred.cred-type == "key"
                                ? @image-url("../../assets/icons/key.svg")
                                : (cred.cred-type == "password" ? @image-url("../../assets/icons/file-text.svg") : @image-url("../../assets/icons/zap.svg"));
                            width: 22px;
                            height: 22px;
                            image-fit: contain;
                            colorize: (cred.id == root.active-cred-id)
                                ? AppTheme.accent
                                : AppTheme.secondary-foreground;
                        }
                    }

                    // 2. 右侧文本信息 (y: 9px 让首行文字向下微调，垂直居中平衡)
                    VerticalLayout {
                        x: (parent.height - 12px) + 14px;
                        width: parent.width - ((parent.height - 12px) + 22px);
                        y: 9px;
                        height: parent.height - 18px;
                        alignment: space-between;
                        padding: 0px;
                        spacing: 0px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: cred.name;
                                font-size: 11px;
                                font-weight: 600;
                                color: (cred.id == root.active-cred-id)
                                    ? AppTheme.selected-foreground
                                    : AppTheme.foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: top;
                            }

                            // 简洁算法标签
                            Rectangle {
                                height: 16px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: center;

                                    Text {
                                        text: cred.algorithm;
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            if cred.cred-type == "key": Text {
                                text: cred.fingerprint != "" ? cred.fingerprint : "未生成指纹";
                                font-size: 9px;
                                font-family: "Cascadia Code, Consolas, monospace";
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.cred-type == "password": Text {
                                text: (cred.username != "" ? cred.username : "未设置用户") + "  ••••••";
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.cred-type == "agent": Text {
                                text: "管道: " + (cred.fingerprint != "" ? cred.fingerprint : "外部代理");
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.bound-host-count > 0: Text {
                                text: cred.bound-host-count + " 台主机";
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                horizontal-alignment: left;
                                vertical-alignment: bottom;
                            }
                        }
                    }
                }
            }
        }
    }
}
