import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { StatusDot } from "../../components/status-dot.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";
import { ScrollView } from "std-widgets.slint";
import { TunnelItemData } from "../tunnels_view.slint";
export { TunnelItemData }

/// 网络隧道抽屉 (Tunnels Drawer)
export component TunnelsDrawer inherits DrawerContainer {
    title: @tr("网络隧道");
    collapse-icon: "◀";

    in property <[TunnelItemData]> tunnels: [];

    callback toggle-tunnel(string /* id */);
    callback open-hub();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 顶部管理中心直达快捷入口
        Rectangle {
            height: 28px;
            border-radius: AppTheme.radius-medium;
            background: hub-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Image {
                        source: @image-url("../../assets/icons/tunnel.svg");
                        width: 13px;
                        height: 13px;
                        colorize: AppTheme.accent;
                    }
                    Text {
                        text: @tr("进入网络与隧道管理中心");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.accent;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "➔";
                    font-size: 11px;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }

            hub-touch := TouchArea {
                clicked => { root.open-hub(); }
                mouse-cursor: pointer;
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 4px;

                for tun in root.tunnels: Rectangle {
                    height: 56px;
                    border-radius: AppTheme.radius-medium;
                    background: tun-touch.has-hover ? AppTheme.hover-background : transparent;

                    tun-touch := TouchArea {
                        clicked => { root.toggle-tunnel(tun.id); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        // 运行指示灯
                        StatusDot {
                            status: tun.is-running ? "online" : "offline";
                            dot-size: 7px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: tun.name;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }

                                Rectangle {
                                    height: 14px;
                                    border-radius: 2px;
                                    background: AppTheme.control-background;

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;

                                        Text {
                                            text: tun.tunnel-type;
                                            font-size: 9px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: tun.route-summary;
                                font-size: 10px;
                                font-family: "Cascadia Code, Consolas, monospace";
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                            }
                        }

                        // 开关按钮
                        Rectangle {
                            width: 32px;
                            height: 18px;
                            border-radius: 9px;
                            background: tun.is-running ? AppTheme.success : AppTheme.control-background;

                            Rectangle {
                                x: tun.is-running ? parent.width - self.width - 2px : 2px;
                                y: 2px;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: #ffffff;
                                animate x { duration: 150ms; }
                            }

                            sw-touch := TouchArea {
                                clicked => { root.toggle-tunnel(tun.id); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
    }
}
