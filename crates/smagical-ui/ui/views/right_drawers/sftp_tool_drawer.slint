import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { ScrollView } from "std-widgets.slint";

/// 文件项数据结构
export struct SftpFileItemData {
    name: string,
    is-dir: bool,
    size-str: string,
}

/// 快速 SFTP 抽屉 (SFTP Tool Drawer)
export component SftpToolDrawer inherits DrawerContainer {
    title: @tr("SFTP 文件传输");
    collapse-icon: "▶";

    in property <string> current-dir: "/";
    in property <[SftpFileItemData]> files: [];


    callback upload-file();
    callback download-file(string /* filename */);
    callback change-dir(string /* dirname */);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 路径条与操作
        Rectangle {
            height: 28px;
            border-radius: AppTheme.radius-small;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.current-dir;
                    font-size: 11px;
                    color: AppTheme.foreground;
                    overflow: elide;
                }
            }
        }

        // 上传按钮
        Rectangle {
            height: 26px;
            border-radius: AppTheme.radius-small;
            background: up-touch.has-hover ? AppTheme.accent : AppTheme.control-background;

            Text {
                text: @tr("↑ 上传文件到当前目录");
                font-size: 10px;
                color: up-touch.has-hover ? #ffffff : AppTheme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            up-touch := TouchArea {
                clicked => { root.upload-file(); }
                mouse-cursor: pointer;
            }
        }

        // 文件列表
        ScrollView {
            VerticalLayout {
                spacing: 4px;

                for f in root.files: Rectangle {
                    height: 32px;
                    border-radius: AppTheme.radius-small;
                    background: f-touch.has-hover ? AppTheme.hover-background : transparent;

                    f-touch := TouchArea {
                        clicked => {
                            if f.is-dir {
                                root.change-dir(f.name);
                            } else {
                                root.download-file(f.name);
                            }
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: f.is-dir ? "▤" : "–";
                            font-size: 11px;
                            color: f.is-dir ? AppTheme.accent : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }

                        Text {
                            text: f.name;
                            font-size: 11px;
                            color: AppTheme.foreground;
                            overflow: elide;
                            horizontal-alignment: left;
                        }

                        Text {
                            text: f.size-str;
                            font-size: 9px;
                            color: AppTheme.secondary-foreground;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
        }
    }
}
