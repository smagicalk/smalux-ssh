import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";

/// 会话备忘笔记抽屉 (Notes Tool Drawer)
export component NotesToolDrawer inherits DrawerContainer {
    title: @tr("会话备忘笔记");
    collapse-icon: "▶";

    in-out property <string> note-text: @tr("1. 生产环境 Nginx 配置在 /etc/nginx/sites-available\n2. 每日凌晨 02:00 定时执行数据冷备\n3. 应急联系人: ops-team@company.internal");

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        Text {
            text: @tr("✎ 当前主机会话专用备忘录 (自动保存)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }

        Rectangle {
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            TextInput {
                text <=> root.note-text;
                font-size: 11px;
                color: AppTheme.foreground;
                selection-background-color: AppTheme.selected-background;
                selection-foreground-color: AppTheme.selected-foreground;
                wrap: word-wrap;
            }
        }
    }
}
