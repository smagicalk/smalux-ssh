import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

/// 快捷指令结构
export struct QuickCmdData {
    id: string,
    title: string,
    command: string,
    category: string,
    language: string,
}

/// 右侧代码片段伴生工具栏抽屉 (Snippet Tool Drawer)
export component SnippetToolDrawer inherits DrawerContainer {
    title: @tr("常用代码片段库");
    collapse-icon: "▶";

    in property <[QuickCmdData]> quick-cmds: [];
    in-out property <string> search_query: "";

    callback send-to-terminal(string /* id */);
    callback search_changed(string /* query */);

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // 搜索框
        Rectangle {
            height: 30px;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: "🔍";
                    font-size: 10px;
                    vertical-alignment: center;
                }

                LineEdit {
                    text <=> root.search_query;
                    placeholder-text: @tr("搜索片段...");
                    edited(text) => { root.search_changed(text); }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 4px;

                for cmd in root.quick-cmds: Rectangle {
                    height: 46px;
                    border-radius: AppTheme.radius-medium;
                    background: cmd-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    cmd-touch := TouchArea {
                        clicked => { root.send-to-terminal(cmd.id); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "»";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 4px;

                                Text {
                                    text: cmd.title;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    overflow: elide;
                                }

                                if cmd.category != "": Rectangle {
                                    height: 14px;
                                    border-radius: 2px;
                                    background: AppTheme.control-background;

                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        Text {
                                            text: cmd.category;
                                            font-size: 8px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: cmd.command;
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            background: run-touch.has-hover ? AppTheme.accent : transparent;

                            Text {
                                text: "▶";
                                font-size: 9px;
                                color: run-touch.has-hover ? #ffffff : AppTheme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            run-touch := TouchArea {
                                clicked => { root.send-to-terminal(cmd.id); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
    }
}
