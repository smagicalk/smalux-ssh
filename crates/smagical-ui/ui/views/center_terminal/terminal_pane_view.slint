// =============================================================================
// 文件名称: terminal_pane_view.slint
// 模块功能: 单个终端分屏窗格独立视口组件 (Terminal Pane View)
// 核心设计: 将 Tab 标签页直接下沉并内聚到每个分屏窗格自身顶部 (集成 TabItem 卡片、+ 按钮、Zoom 与分屏操作)
// =============================================================================

import { AppTheme } from "../../themes/app-theme.slint";
import { StatusDot } from "../../components/status-dot.slint";
import { TabItem } from "../../components/tab-item.slint";
import { TabData } from "tab_bar.slint";

/// 单个终端分屏窗格独立视口组件
///
/// 具备原装一致的 TabItem 标签页列表（支持多开与长标题...省略）、固定在最右侧的新建加号 (+)、位图渲染与鼠标交互路由。
export component TerminalPaneView inherits Rectangle {
    // -------------------------------------------------------------------------
    // 1. 基础属性定义
    // -------------------------------------------------------------------------
    /// 窗格唯一标识 ID (如 "sess-1-pane-1")
    in property <string> pane-id: "";
    /// 窗格标题文本 (单卡片模式时使用)
    in property <string> title: "";
    /// 窗格位图渲染流
    in property <image> image;
    /// 窗格当前是否处于键盘鼠标激活焦点状态
    in property <bool> is-active: false;
    /// 窗格当前是否处于临时独占全屏 (Zoomed) 状态
    in property <bool> is-zoomed: false;
    /// 窗格所在主机的在线状态 ("online" | "warning" | "offline")
    in property <string> status: "online";
    /// 窗格在分屏组内的序号 (1-indexed, 如 1, 2, 3)
    in property <int> pane-index: 1;
    /// 当前分屏组内的窗格总数
    in property <int> total-panes: 1;

    /// 会话 Tab 列表数据 (单屏模式或窗格多标签模式)
    in property <[TabData]> tabs: [];
    /// 当前激活的 Tab 会话 ID
    in-out property <string> active-tab-id: "";
    /// Tab 栏横向滚轮滚动偏移量
    in-out property <length> tab-scroll-offset: 0px;
    /// 划选状态记录
    in-out property <int> sel-start-col: -1;
    in-out property <int> sel-start-row: -1;
    in-out property <int> sel-end-col: -1;
    in-out property <int> sel-end-row: -1;
    in-out property <bool> is-selecting: false;

    // Tab 拖拽相关状态
    in property <bool> is-dragging-tab: false;
    in property <string> drag-tab-source-pane: "";
    in property <int> drag-tab-from-index: -1;

    // -------------------------------------------------------------------------
    // 2. 交互回调接口
    // -------------------------------------------------------------------------
    /// 点击选中当前窗格回调
    callback select();
    /// 选择指定 Tab 会话回调
    callback select-tab(string /* id */);
    /// 关闭指定 Tab 会话回调
    callback close-tab(string /* id */);
    /// 点击新建会话 + 回调
    callback new-tab();
    /// 向右水平切分当前窗格回调
    callback split-right();
    /// 向下垂直切分当前窗格回调
    callback split-down();
    /// 切换单窗格临时最大化 (Zoom) 与还原回调
    callback toggle-zoom();
    /// 关闭当前窗格/会话回调
    callback close();
    /// 鼠标滚轮滚动回调
    callback scroll(length /* delta-y */);
    /// 鼠标划选区域变更回调
    callback selection-changed(int /* sc */, int /* sr */, int /* ec */, int /* er */, bool /* has_sel */);
    /// 呼出右键快捷菜单回调
    callback context-menu(length /* global-x */, length /* global-y */);
    /// 呼出 Tab 标签页专属右键菜单回调
    callback tab-context-menu(string /* tab_id */, length /* local-x */, length /* local-y */);
    /// Tab 拖拽移动与释放事件
    callback tab-drag-moved(int /* from_idx */, string /* title */, string /* status */, length /* local_x */, length /* local_y */);
    callback tab-drag-ended();

    // -------------------------------------------------------------------------
    // 3. 视觉容器与边框样式
    // -------------------------------------------------------------------------
    background: AppTheme.window-background;
    border-width: root.is-active && root.total-panes > 1 ? 1.5px : (root.total-panes > 1 ? 1px : 0px);
    border-color: root.is-active ? AppTheme.accent : AppTheme.border;
    clip: true;

    animate border-color { duration: 150ms; easing: ease-out; }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---------------------------------------------------------------------
        // 4. 窗格专属 Tab 页签栏 (高度 36px，左侧 Tab 序列，最右侧固定 + 按钮)
        // ---------------------------------------------------------------------
        header-bar := Rectangle {
            height: 36px;
            background: AppTheme.panel-background;

            // 标题栏底部 1px 细分割线
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: AppTheme.border;
            }

            // 标题栏空白区域交互捕获 (单击激活，双击触发 Zoom 全屏/还原)
            header-touch := TouchArea {
                clicked => { root.select(); }
                double-clicked => {
                    if root.total-panes > 1 {
                        root.toggle-zoom();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                height: 100%;
                padding-left: 6px;
                padding-right: 6px;

                HorizontalLayout {
                    spacing: 6px;

                    // 4.1 Tab 会话卡片可滑动列表视口 (支持长名称 ... 省略与横向滑动)
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        tab-scroll-box := Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            clip: true;
                            property <length> total-tab-width: (root.tabs.length > 0 ? root.tabs.length : 1) * 152px + 10px;
                            property <length> min-scroll: Math.min(0px, self.width - total-tab-width);
                            property <length> effective-offset: Math.min(0px, Math.max(min-scroll, root.tab-scroll-offset));

                            // 鼠标滚轮横向滑动
                            TouchArea {
                                scroll-event(event) => {
                                    root.tab-scroll-offset = Math.min(0px, Math.max(tab-scroll-box.min-scroll, tab-scroll-box.effective-offset + event.delta-y + event.delta-x));
                                    accept
                                }
                            }

                            // 4.1.1 多 Tab 列表渲染 (支持拖拽重排与跨分屏拖拽)
                            HorizontalLayout {
                                x: tab-scroll-box.effective-offset;
                                y: 0px;
                                width: Math.max(parent.width, tab-scroll-box.total-tab-width);
                                height: parent.height;
                                spacing: 4px;
                                alignment: start;

                                animate x { duration: 150ms; easing: ease-out; }

                                for tab[idx] in root.tabs: Rectangle {
                                    min-width: tab.id == root.active-tab-id ? 150px : 140px;
                                    max-width: 180px;
                                    height: 28px;
                                    border-radius: 4px;

                                    opacity: (root.is-dragging-tab && root.drag-tab-source-pane == root.pane-id && root.drag-tab-from-index == idx) ? 0.35 : 1.0;
                                    background: tab.id == root.active-tab-id ? AppTheme.surface-background : (tab-touch.has-hover ? AppTheme.hover-background.transparentize(40%) : AppTheme.surface-background.transparentize(50%));
                                    border-width: 1px;
                                    border-color: tab.id == root.active-tab-id ? AppTheme.accent : (tab-touch.has-hover ? AppTheme.accent.transparentize(40%) : AppTheme.border);

                                    animate background { duration: 180ms; easing: ease-out; }
                                    animate border-color { duration: 180ms; easing: ease-out; }

                                    VerticalLayout {
                                        alignment: center;
                                        height: 100%;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            // 会话选择与拖拽触发主区域
                                            main-touch-box := Rectangle {
                                                horizontal-stretch: 1;
                                                height: 100%;

                                                tab-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        if !root.is-dragging-tab {
                                                            root.active-tab-id = tab.id;
                                                            root.select-tab(tab.id);
                                                        }
                                                    }
                                                    pointer-event(event) => {
                                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                                            root.tab-context-menu(tab.id, 6px + tab-scroll-box.effective-offset + (idx * 152px) + self.mouse-x, 4px + self.mouse-y);
                                                        } else if event.kind == PointerEventKind.up {
                                                            root.tab-drag-ended();
                                                        }
                                                    }
                                                    moved => {
                                                        if self.pressed && (self.mouse-x - self.pressed-x > 6px || self.mouse-x - self.pressed-x < -6px || self.mouse-y - self.pressed-y > 6px || self.mouse-y - self.pressed-y < -6px) {
                                                            let cur_lx: length = 6px + tab-scroll-box.effective-offset + (idx * 152px) + self.mouse-x;
                                                            let cur_ly: length = 4px + self.mouse-y;
                                                            root.tab-drag-moved(idx, tab.title, tab.status, cur_lx, cur_ly);
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 6px;

                                                    // 图标
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/icons/terminal.svg");
                                                            width: 13px;
                                                            height: 13px;
                                                            image-fit: contain;
                                                            colorize: tab.id == root.active-tab-id ? AppTheme.accent : (tab-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground);
                                                            animate colorize { duration: 180ms; easing: ease-out; }
                                                        }
                                                    }

                                                    // 状态指示灯
                                                    VerticalLayout {
                                                        alignment: center;
                                                        StatusDot {
                                                            status: tab.status;
                                                            dot-size: 5px;
                                                        }
                                                    }

                                                    // 标题
                                                    VerticalLayout {
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: tab.title;
                                                            font-size: 11px;
                                                            font-weight: tab.id == root.active-tab-id ? 700 : 500;
                                                            color: tab.id == root.active-tab-id ? AppTheme.foreground : (tab-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground);
                                                            overflow: elide;
                                                            horizontal-alignment: left;
                                                            vertical-alignment: center;
                                                            animate color { duration: 180ms; easing: ease-out; }
                                                        }
                                                    }
                                                }
                                            }

                                            // 关闭按钮
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: close-touch.has-hover ? #e7484833 : transparent;
                                                    animate background { duration: 150ms; easing: ease-out; }

                                                    Image {
                                                        source: @image-url("../../assets/icons/window-close.svg");
                                                        width: 8px;
                                                        height: 8px;
                                                        image-fit: contain;
                                                        colorize: close-touch.has-hover ? AppTheme.danger : (tab.id == root.active-tab-id ? AppTheme.foreground : AppTheme.secondary-foreground);
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        animate colorize { duration: 150ms; easing: ease-out; }
                                                    }

                                                    close-touch := TouchArea {
                                                        clicked => { root.close-tab(tab.id); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 激活状态底部品牌指示光条
                                    if tab.id == root.active-tab-id: Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: parent.width - 12px;
                                        x: 6px;
                                        border-radius: 1px;
                                        background: AppTheme.accent;
                                    }
                                }
                            }
                        }
                    }



                    // 4.2 固定在最右侧的 + 新建终端会话加号按钮 (始终固定在最右侧)
                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: new-tab-touch.has-hover ? AppTheme.hover-background : Colors.transparent;

                            Text {
                                text: "+";
                                font-size: 16px;
                                font-weight: 600;
                                color: new-tab-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            new-tab-touch := TouchArea {
                                clicked => { root.new-tab(); }
                                mouse-cursor: pointer;
                            }
                        }
                    }


                }
            }
        }



        // ---------------------------------------------------------------------
        // 5. 终端位图渲染主视口
        // ---------------------------------------------------------------------
        Rectangle {
            vertical-stretch: 1;
            background: Colors.transparent;
            clip: true;

            // 5.1 实时光栅化位图
            if root.image.width > 0: Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: fill;
                horizontal-alignment: left;
                vertical-alignment: top;
            }

            // 5.2 鼠标手势、划选高亮、聚焦切换与右键菜单拦截层
            pane-body-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.select();
                        if event.button == PointerEventButton.right {
                            root.context-menu(self.mouse-x, self.mouse-y);
                        } else if event.button == PointerEventButton.left {
                            let start-c = Math.max(0, Math.floor((self.mouse-x - 16px) / 8.5px));
                            let start-r = Math.max(0, Math.floor((self.mouse-y - 8px) / 18px));
                            root.sel-start-col = start-c;
                            root.sel-start-row = start-r;
                            root.sel-end-col = start-c;
                            root.sel-end-row = start-r;
                            root.is-selecting = true;
                            root.selection-changed(start-c, start-r, start-c, start-r, false);
                        }
                    } else if event.kind == PointerEventKind.up {
                        if event.button == PointerEventButton.left && root.is-selecting {
                            root.is-selecting = false;
                            if root.sel-start-col != root.sel-end-col || root.sel-start-row != root.sel-end-row {
                                root.selection-changed(root.sel-start-col, root.sel-start-row, root.sel-end-col, root.sel-end-row, true);
                            } else {
                                root.selection-changed(-1, -1, -1, -1, false);
                            }
                        }
                    }
                }

                moved => {
                    if root.is-selecting && self.pressed {
                        let cur-c = Math.max(0, Math.floor((self.mouse-x - 16px) / 8.5px));
                        let cur-r = Math.max(0, Math.floor((self.mouse-y - 8px) / 18px));
                        root.sel-end-col = cur-c;
                        root.sel-end-row = cur-r;
                        if cur-c != root.sel-start-col || cur-r != root.sel-start-row {
                            root.selection-changed(root.sel-start-col, root.sel-start-row, cur-c, cur-r, true);
                        }
                    }
                }

                scroll-event(event) => {
                    root.scroll(event.delta-y);
                    accept
                }

                mouse-cursor: text;
            }

        }
    }
}


