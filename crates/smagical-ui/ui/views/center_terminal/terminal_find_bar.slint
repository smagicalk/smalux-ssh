import { AppTheme } from "../../themes/app-theme.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";

/// 终端内缓冲区文本查找浮层 (Terminal Find Bar / Ctrl+F)
///
/// 提供实时关键词匹配、大小写敏感过滤、上一项/下一项导航与即时匹配项数量统计。
export component TerminalFindBar inherits Rectangle {
    /// 查找浮层是否显示
    in property <bool> is-open: false;
    /// 用户当前输入的检索关键词
    in-out property <string> search-query <=> search-input.text;
    /// 当前聚焦的高亮匹配项序号 (从 1 开始)
    in property <int> current-match: 0;
    /// 终端缓冲区内匹配到的总项数
    in property <int> total-matches: 0;
    /// 是否开启大小写精确匹配 (Case Sensitive)
    in-out property <bool> match-case: false;

    /// 关闭查找浮层回调
    callback close();
    /// 跳转至下一个匹配项回调
    callback find-next();
    /// 跳转至上一个匹配项回调
    callback find-prev();
    /// 搜索关键词变更实时通知回调
    callback search-changed(string);


    width: 320px;
    height: 36px;
    border-radius: AppTheme.radius-medium;
    background: AppTheme.surface-background;
    border-width: 1px;
    border-color: AppTheme.border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;
        alignment: center;

        // 搜索图标
        Image {
            source: @image-url("../../assets/icons/search.svg");
            width: 12px;
            height: 12px;
            image-fit: contain;
            colorize: search-input.has-focus ? AppTheme.accent : AppTheme.secondary-foreground;
            vertical-alignment: center;
        }

        // 搜索输入框
        search-input := TextInput {
            font-size: 11px;
            color: AppTheme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            edited => {
                root.search-changed(self.text);
            }
            accepted => {
                root.find-next();
            }
        }

        // 匹配计数 (e.g. 1/14 或 0/0)
        if root.search-query != "": Text {
            text: root.total-matches > 0 ? (root.current-match + "/" + root.total-matches) : @tr("无匹配");
            font-size: 10px;
            font-weight: 500;
            color: root.total-matches > 0 ? AppTheme.secondary-foreground : AppTheme.danger;
            vertical-alignment: center;
        }

        // 大小写敏感切换按钮
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 3px;
            background: root.match-case ? AppTheme.accent.transparentize(80%) : case-touch.has-hover ? AppTheme.hover-background : transparent;
            border-width: root.match-case ? 1px : 0px;
            border-color: AppTheme.accent;

            case-touch := TouchArea {
                clicked => { root.match-case = !root.match-case; }
                mouse-cursor: pointer;
            }

            Text {
                text: "Aa";
                font-size: 10px;
                font-weight: 700;
                color: root.match-case ? AppTheme.accent : AppTheme.secondary-foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // 上一个匹配
        AppIconButton {
            icon: @image-url("../../assets/icons/chevron-up.svg");
            clicked => { root.find-prev(); }
        }

        // 下一个匹配
        AppIconButton {
            icon: @image-url("../../assets/icons/chevron-down.svg");
            clicked => { root.find-next(); }
        }

        // 分割线
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 1px;
                height: 16px;
                background: AppTheme.border;
            }
        }


        // 关闭查找栏
        AppIconButton {
            icon: @image-url("../../assets/icons/window-close.svg");
            clicked => { root.close(); }
        }
    }
}
