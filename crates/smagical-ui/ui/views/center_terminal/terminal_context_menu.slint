import { AppTheme } from "../../themes/app-theme.slint";
import { ContextMenuItem, ContextMenuContainer } from "../../components/context-menu.slint";

/// 终端右键快捷操作上下文菜单 (Terminal Context Menu)
///
/// 提供快速复制选中内容、粘贴系统剪贴板、全选终端字符、清空终端视口及向右/向下分屏等快捷功能。
export component TerminalContextMenu inherits ContextMenuContainer {
    /// 当前终端视口是否存在有效字符选区 (若无选区则“复制”按钮置灰不可点击)
    in property <bool> has-selection: false;
    /// 当前窗格是否支持分屏 (仅当当前窗格或视口拥有 > 1 个 Tab 时支持分屏)
    in property <bool> can-split: true;

    /// 复制选中内容到系统剪贴板回调
    callback copy-text();
    /// 从系统剪贴板粘贴到终端 PTY 输入流回调
    callback paste-text();
    /// 选中终端视口全部字符回调
    callback select-all();
    /// 清除终端屏幕缓冲区内容回调
    callback clear-screen();
    /// 向右水平垂直分割当前终端会话回调
    callback split-right();
    /// 向下垂直水平分割当前终端会话回调
    callback split-down();
    /// 关闭右键快捷菜单回调
    callback close-menu();

    menu-width: 180px;
    menu-height: 173px;

    VerticalLayout {
        padding: 4px;
        spacing: 1px;

        // 1. 复制 (Copy)
        ContextMenuItem {
            item-id: "copy";
            title: @tr("复制");
            icon: @image-url("../../assets/icons/copy.svg");
            shortcut: "Ctrl+Shift+C";
            is-disabled: !root.has-selection;
            clicked(id) => {
                root.copy-text();
                root.close-menu();
            }
        }

        // 2. 粘贴 (Paste)
        ContextMenuItem {
            item-id: "paste";
            title: @tr("粘贴");
            icon: @image-url("../../assets/icons/clipboard.svg");
            shortcut: "Ctrl+Shift+V";
            clicked(id) => {
                root.paste-text();
                root.close-menu();
            }
        }

        // 3. 全选 (Select All)
        ContextMenuItem {
            item-id: "select_all";
            title: @tr("全选");
            icon: @image-url("../../assets/icons/select-all.svg");
            shortcut: "Ctrl+Shift+A";
            clicked(id) => {
                root.select-all();
                root.close-menu();
            }
        }

        // 分割线
        ContextMenuItem { is-separator: true; }

        // 4. 清屏 (Clear Screen)
        ContextMenuItem {
            item-id: "clear";
            title: @tr("清屏");
            icon: @image-url("../../assets/icons/eraser.svg");
            shortcut: "Ctrl+L";
            clicked(id) => {
                root.clear-screen();
                root.close-menu();
            }
        }

        // 分割线
        ContextMenuItem { is-separator: true; }

        // 5. 左右分屏 (Split Right)
        ContextMenuItem {
            item-id: "split_right";
            title: @tr("向右分屏");
            icon: @image-url("../../assets/icons/split-v.svg");
            shortcut: "Ctrl+Shift+D";
            is-disabled: !root.can-split;
            clicked(id) => {
                root.split-right();
                root.close-menu();
            }
        }

        // 6. 上下分屏 (Split Down)
        ContextMenuItem {
            item-id: "split_down";
            title: @tr("向下分屏");
            icon: @image-url("../../assets/icons/split-h.svg");
            shortcut: "Ctrl+Shift+E";
            is-disabled: !root.can-split;
            clicked(id) => {
                root.split-down();
                root.close-menu();
            }
        }
    }
}



