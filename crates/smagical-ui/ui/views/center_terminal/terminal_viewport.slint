import { AppTheme } from "../../themes/app-theme.slint";
import { StatusDot } from "../../components/status-dot.slint";
import { TabItem } from "../../components/tab-item.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";
import { TabData } from "tab_bar.slint";
import { TerminalFindBar } from "terminal_find_bar.slint";
import { TerminalContextMenu } from "terminal_context_menu.slint";
import { TabContextMenu } from "tab_context_menu.slint";
import { TerminalPaneView } from "terminal_pane_view.slint";


/// 单个动态终端窗格数据模型 (支持无限嵌套任意多分屏)
export struct TerminalPaneData {
    /// 窗格唯一标识 ID (如: "tab-1-pane-1")
    pane-id: string,
    /// 窗格顶部标题文本
    title: string,
    /// 相对终端中央视口左上角像素 X 坐标
    x: length,
    /// 相对终端中央视口左上角像素 Y 坐标
    y: length,
    /// 窗格像素宽度
    width: length,
    /// 窗格像素高度
    height: length,
    /// 窗格像素位图帧流
    image: image,
    /// 是否获得当前焦点
    is-active: bool,
    /// 窗格在当前分屏组内的序号 (1-indexed)
    pane-index: int,
    /// 当前分屏组内的窗格总数
    total-panes: int,
    /// 窗格当前是否处于临时最大化 (Zoom) 状态
    is-zoomed: bool,
    /// 窗格在线状态 ("online" | "warning" | "offline")
    status: string,
    /// 该窗格所属的 Tab 列表
    tabs: [TabData],
    /// 该窗格当前激活的 Tab ID
    active-tab-id: string,
}



/// 窗格间可拖拽分割条数据模型
export struct TerminalSplitterData {
    /// 分割条唯一标识 ID (对应二叉树分支节点 ID)
    splitter-id: string,
    /// 是否为垂直分割条 (true 为左右垂直拖拽条, false 为上下水平拖拽条)
    is-vertical: bool,
    /// 像素 X 坐标
    x: length,
    /// 像素 Y 坐标
    y: length,
    /// 像素宽度
    width: length,
    /// 像素高度
    height: length,
}

/// 终端屏幕与多会话光栅化像素视口 (Terminal Viewport)
///
/// 承载终端位图光栅化渲染、键盘事件捕获转发、鼠标交互、多会话 Tab 调度、查找浮层与右键菜单。
export component TerminalViewport inherits Rectangle {
    /// 当前是否存在处于连接状态的活跃终端会话
    in property <bool> has-active-session: false;
    /// 当前激活会话的展示名称 (如: "node-1 #1")
    in property <string> session-name: "";
    /// 当前激活会话的连接地址 (如: "192.168.1.101:22" 或 "Local (pwsh.exe)")
    in property <string> host-address: "";
    /// 当前主机的 ICMP 延迟毫秒数 (本地 Shell 为 0)
    in property <int> ping-ms: 0;
    /// 是否开启多终端分屏模式
    in-out property <bool> is-split: false;
    /// 分屏排布方向 ("vertical" 左右垂直分屏 | "horizontal" 上下水平分屏)
    in-out property <string> split-orientation: "vertical";
    /// 分屏窗格尺寸比例 (0.15 ~ 0.85, 默认 0.5)
    in-out property <float> split-ratio: 0.5;
    /// 当前获得键盘焦点的窗格索引 (0: 主窗格, 1: 副窗格)
    in-out property <int> active-pane-index: 0;
    /// 当前激活聚焦的窗格唯一 ID
    in-out property <string> active-pane-id: "";

    /// 活跃 Tab 会话列表数据模型
    in property <[TabData]> tabs: [];
    /// 当前被选中的 Tab 会话 ID
    in-out property <string> active-tab-id: "";
    /// 顶部 Tab 栏鼠标滚轮水平滑动像素偏移量
    in-out property <length> tab-scroll-offset: 0px;

    /// 主窗格实时光栅化位图帧流
    in property <image> terminal-screen-image;
    /// 副窗格 1 实时光栅化位图帧流 (分屏模式有效)
    in property <image> terminal-split-image;
    /// 副窗格 2 实时光栅化位图帧流 (3/4 分屏有效)
    in property <image> terminal-split2-image;
    /// 副窗格 3 实时光栅化位图帧流 (4 分屏有效)
    in property <image> terminal-split3-image;
    /// 分屏窗格总数量
    in-out property <int> split-count: 1;
    /// 动态多窗格列表数据模型 (无限嵌套分屏)
    in property <[TerminalPaneData]> terminal-panes: [];
    /// 动态分割条列表数据模型
    in property <[TerminalSplitterData]> terminal-splitters: [];
    /// 分割条拖拽持久状态 (保存在 root 组件上，绝不受模型更新重置影响)
    in-out property <bool> is-dragging-splitter: false;
    in-out property <string> dragging-splitter-id: "";
    in-out property <bool> dragging-is-vertical: false;
    in-out property <length> drag-start-mouse: 0px;

    /// 副窗格 1 展示名称



    in property <string> split-session-name: "";
    /// 副窗格 2 展示名称
    in property <string> split2-session-name: "";
    /// 副窗格 3 展示名称
    in property <string> split3-session-name: "";

    /// 终端内浮动查找栏状态与匹配计数
    in-out property <bool> is-find-open: false;
    in-out property <string> find-query: "";
    in property <int> find-current-match: 0;
    in property <int> find-total-matches: 0;

    /// 终端右键快捷菜单状态与浮动坐标
    in-out property <bool> is-context-menu-open: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <bool> has-selection: false;
    /// 终端历史回滚总行数 (用于驱动滚动条与状态展示)
    in property <int> history-size: 0;
    /// 当前相对底部的向上回滚行偏移量 (0 表示在最底部最新行)
    in property <int> scroll-offset: 0;

    /// 壁纸展示模式 ("none" | "global" | "terminal")
    in-out property <string> wallpaper-mode: "none";
    /// 终端专属壁纸位图
    in-out property <image> terminal-wallpaper-image;
    /// 终端专属壁纸不透明度 (0.0 ~ 1.0)
    in-out property <float> terminal-wallpaper-opacity: 0.20;

    /// 终端实际物理像素渲染画布宽高
    out property <float> canvas-width: root.width / 1px;
    out property <float> canvas-height: Math.max(10px, root.height) / 1px;

    /// 终端动态网格尺寸 (自适应计算字符列数与行数，同步回 Rust 后台 PTY)
    out property <int> terminal-cols: Math.max(10, Math.floor((root.width - 36px) / 8.5px));
    out property <int> terminal-rows: Math.max(5, Math.floor((root.height - 36px) / 18px));

    /// 鼠标划选高亮状态
    in-out property <int> sel-start-col: -1;
    in-out property <int> sel-start-row: -1;
    in-out property <int> sel-end-col: -1;
    in-out property <int> sel-end-row: -1;
    in-out property <bool> is-selecting: false;
    property <bool> context-menu-can-split: false;

    /// Tab 专属右键快捷菜单状态
    in-out property <bool> is-tab-context-menu-open: false;
    in-out property <length> tab-context-menu-x: 0px;
    in-out property <length> tab-context-menu-y: 0px;
    in-out property <string> tab-context-menu-tab-id: "";
    in-out property <string> tab-context-menu-pane-id: "";
    property <bool> tab-context-menu-can-split: false;
    property <bool> tab-context-menu-can-close-others: false;

    /// Tab 拖拽调度全局状态
    in-out property <bool> is-dragging-tab: false;
    in-out property <bool> is-tab-drop-valid: true;
    in-out property <string> drag-tab-source-pane: "";
    in-out property <int> drag-tab-from-index: -1;
    in-out property <string> drag-tab-title: "";
    in-out property <string> drag-tab-status: "online";
    in-out property <length> drag-tab-x: 0px;
    in-out property <length> drag-tab-y: 0px;

    /// Tab 栏调度交互回调
    callback select-tab(string /* id */);
    callback close-tab(string /* id */);
    callback new-tab();
    callback select-pane-tab(string /* pane_id */, string /* tab_id */);
    callback close-pane-tab(string /* pane_id */, string /* tab_id */);
    callback copy-tab-ip(string /* tab_id */);
    callback close-other-tabs(string /* pane_id */, string /* tab_id */);
    callback move-terminal-tab(string /* from_pane_id */, int /* from_index */, length /* drop_x */, length /* drop_y */);



    /// 终端底层输入流与交互事件回调
    callback terminal-key-input(string /* text */, bool /* is_ctrl */, bool /* is_shift */, bool /* is_alt */);
    callback terminal-scroll(length /* delta */);
    callback terminal-selection-changed(int /* sc */, int /* sr */, int /* ec */, int /* er */, bool /* has_sel */);
    callback copy-text();
    callback paste-text();
    callback clear-screen();
    callback split-terminal(string /* "horizontal" | "vertical" */);
    callback close-split();
    callback close-pane-by-index(int /* index */);
    callback close-pane-by-id(string /* pane_id */);
    callback select-pane(int /* index */);
    callback select-pane-by-id(string /* pane_id */);
    callback toggle-pane-zoom(string /* pane_id */);
    callback adjust-splitter(string /* splitter_id */, float /* delta_ratio */);

    callback search-terminal(string /* query */, bool /* match_case */);
    callback terminal-resize(int /* cols */, int /* rows */);

    background: AppTheme.window-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. 空状态默认 Tab 栏 (当无会话时展示标准 36px 栏，最右侧固定 + 按钮)
        if !root.has-active-session: Rectangle {
            height: 36px;
            background: AppTheme.panel-background;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: AppTheme.border;
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: end;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: empty-new-tab-touch.has-hover ? AppTheme.hover-background : Colors.transparent;

                        Text {
                            text: "+";
                            font-size: 16px;
                            font-weight: 600;
                            color: empty-new-tab-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        empty-new-tab-touch := TouchArea {
                            clicked => { root.new-tab(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        // 2. 终端主体区域 (当存在活跃会话时)
        if root.has-active-session: terminal-canvas := Rectangle {
            background: AppTheme.window-background;
            vertical-stretch: 1;
            clip: true;



            // 2.1 键盘按键与焦点捕捉层 (捕获字符与修饰键并统一转发至 Rust 后端状态机)
            terminal-focus := FocusScope {
                key-pressed(event) => {
                    // 全局快捷键: 查找浮层 (Ctrl+F)
                    if event.modifiers.control && (event.text == "f" || event.text == "F") {
                        root.is-find-open = !root.is-find-open;
                        return accept;
                    }
                    // 全局快捷键: 复制 (Ctrl+Shift+C 或有选区时的 Ctrl+C)
                    if event.modifiers.control && ((event.modifiers.shift && (event.text == "c" || event.text == "C")) || (root.has-selection && (event.text == "c" || event.text == "C" || event.text == "\u{0003}"))) {
                        root.copy-text();
                        return accept;
                    }
                    // 全局快捷键: 粘贴 (Ctrl+Shift+V 或 Ctrl+V)
                    if event.modifiers.control && ((event.modifiers.shift && (event.text == "v" || event.text == "V")) || event.text == "\u{0016}") {
                        root.paste-text();
                        return accept;
                    }
                    // 全局快捷键: 垂直分屏 (Ctrl+Shift+D) (仅当当前存在多个 Tab 时可用)
                    if event.modifiers.control && event.modifiers.shift && (event.text == "d" || event.text == "D") {
                        if root.tabs.length > 1 {
                            root.split-terminal("vertical");
                        }
                        return accept;
                    }
                    // 全局快捷键: 水平分屏 (Ctrl+Shift+E) (仅当当前存在多个 Tab 时可用)
                    if event.modifiers.control && event.modifiers.shift && (event.text == "e" || event.text == "E") {
                        if root.tabs.length > 1 {
                            root.split-terminal("horizontal");
                        }
                        return accept;
                    }

                    // 全局快捷键: 清屏 (Ctrl+L)
                    if event.modifiers.control && (event.text == "l" || event.text == "L") {
                        root.clear-screen();
                        return accept;
                    }

                    // 统一转发按键文本与修饰键状态至 Rust 后端进行 ANSI 序列编码
                    if event.text != "" {
                        root.terminal-key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                        return accept;
                    }
                    reject
                }
            }

            // 2.1 终端专属背景壁纸层 (当模式为 terminal 且壁纸有效时展示)
            if root.wallpaper-mode == "terminal" && root.terminal-wallpaper-image.width > 0: Image {
                source: root.terminal-wallpaper-image;
                width: 100%;
                height: 100%;
                image-fit: cover;
                opacity: root.terminal-wallpaper-opacity;
            }

            // 2.3 单屏终端位图渲染主视口
            if !root.is-split: TerminalPaneView {
                pane-id: root.active-tab-id;
                title: root.session-name;
                image: root.terminal-screen-image;
                is-active: true;
                status: "online";
                pane-index: 1;
                total-panes: 1;
                tabs: root.tabs;
                active-tab-id: root.active-tab-id;

                is-dragging-tab: root.is-dragging-tab;
                drag-tab-source-pane: root.drag-tab-source-pane;
                drag-tab-from-index: root.drag-tab-from-index;

                tab-drag-moved(from-idx, title, status, lx, ly) => {
                    root.is-dragging-tab = true;
                    root.drag-tab-source-pane = "";
                    root.drag-tab-from-index = from-idx;
                    root.drag-tab-title = title;
                    root.drag-tab-status = status;
                    root.drag-tab-x = lx;
                    root.drag-tab-y = ly;
                    root.is-tab-drop-valid = lx >= 0px && lx <= root.width && ly >= -15px && ly <= root.height;
                }
                tab-drag-ended => {
                    if root.is-dragging-tab && root.is-tab-drop-valid && root.drag-tab-from-index >= 0 {
                        root.move-terminal-tab("", root.drag-tab-from-index, root.drag-tab-x, root.drag-tab-y);
                    }
                    root.is-dragging-tab = false;
                    root.is-tab-drop-valid = true;
                    root.drag-tab-from-index = -1;
                    root.drag-tab-source-pane = "";
                }

                select-tab(id) => {
                    root.active-tab-id = id;
                    root.select-tab(id);
                    terminal-focus.focus();
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                close-tab(id) => {
                    root.close-tab(id);
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                new-tab => {
                    root.new-tab();
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                select => {
                    terminal-focus.focus();
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                scroll(delta) => {
                    root.terminal-scroll(delta);
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                selection-changed(sc, sr, ec, er, has-sel) => {
                    root.has-selection = has-sel;
                    root.terminal-selection-changed(sc, sr, ec, er, has-sel);
                    root.is-context-menu-open = false;
                    root.is-tab-context-menu-open = false;
                }
                context-menu(mx, my) => {
                    root.context-menu-x = mx;
                    root.context-menu-y = 36px + my;
                    root.context-menu-can-split = root.tabs.length > 1;
                    root.is-context-menu-open = true;
                    root.is-tab-context-menu-open = false;
                }
                tab-context-menu(tab_id, mx, my) => {
                    root.tab-context-menu-tab-id = tab_id;
                    root.tab-context-menu-pane-id = root.active-pane-id;
                    root.tab-context-menu-x = mx;
                    root.tab-context-menu-y = my;
                    root.tab-context-menu-can-split = root.tabs.length > 1;
                    root.tab-context-menu-can-close-others = root.tabs.length > 1;
                    root.is-tab-context-menu-open = true;
                    root.is-context-menu-open = false;
                }

            }

            // 2.4 任意层级嵌套多分屏模式视口 (数据驱动二叉树拓扑)
            if root.is-split: Rectangle {
                width: 100%;
                height: 100%;

                // 2.4.1 动态渲染全部叶子终端独立窗格组件
                for pane in root.terminal-panes: TerminalPaneView {
                    x: pane.x;
                    y: pane.y;
                    width: pane.width;
                    height: pane.height;
                    pane-id: pane.pane-id;
                    title: pane.title;
                    image: pane.image;
                    is-active: pane.is-active;
                    is-zoomed: pane.is-zoomed;
                    status: pane.status;
                    pane-index: pane.pane-index;
                    total-panes: pane.total-panes;
                    tabs: pane.tabs;
                    active-tab-id: pane.active-tab-id;

                    is-dragging-tab: root.is-dragging-tab;
                    drag-tab-source-pane: root.drag-tab-source-pane;
                    drag-tab-from-index: root.drag-tab-from-index;

                    tab-drag-moved(from-idx, title, status, lx, ly) => {
                        root.is-dragging-tab = true;
                        root.drag-tab-source-pane = pane.pane-id;
                        root.drag-tab-from-index = from-idx;
                        root.drag-tab-title = title;
                        root.drag-tab-status = status;
                        let gx = pane.x + lx;
                        let gy = pane.y + ly;
                        root.drag-tab-x = gx;
                        root.drag-tab-y = gy;
                        root.is-tab-drop-valid = gx >= 0px && gx <= root.width && gy >= -15px && gy <= root.height;
                    }
                    tab-drag-ended => {
                        if root.is-dragging-tab && root.is-tab-drop-valid && root.drag-tab-from-index >= 0 {
                            root.move-terminal-tab(root.drag-tab-source-pane, root.drag-tab-from-index, root.drag-tab-x, root.drag-tab-y);
                        }
                        root.is-dragging-tab = false;
                        root.is-tab-drop-valid = true;
                        root.drag-tab-from-index = -1;
                        root.drag-tab-source-pane = "";
                    }

                    select-tab(tab-id) => {
                        root.active-pane-id = pane.pane-id;
                        root.select-pane-tab(pane.pane-id, tab-id);
                        terminal-focus.focus();
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    close-tab(tab-id) => {
                        root.close-pane-tab(pane.pane-id, tab-id);
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    select => {
                        root.active-pane-id = pane.pane-id;
                        root.select-pane-by-id(pane.pane-id);
                        terminal-focus.focus();
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    new-tab => {
                        root.active-pane-id = pane.pane-id;
                        root.new-tab();
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    split-right => {
                        if pane.tabs.length > 1 {
                            root.active-pane-id = pane.pane-id;
                            root.select-pane-by-id(pane.pane-id);
                            root.split-terminal("vertical");
                            root.is-context-menu-open = false;
                            root.is-tab-context-menu-open = false;
                        }
                    }
                    split-down => {
                        if pane.tabs.length > 1 {
                            root.active-pane-id = pane.pane-id;
                            root.select-pane-by-id(pane.pane-id);
                            root.split-terminal("horizontal");
                            root.is-context-menu-open = false;
                            root.is-tab-context-menu-open = false;
                        }
                    }
                    toggle-zoom => {
                        root.toggle-pane-zoom(pane.pane-id);
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    close => {
                        root.close-pane-by-id(pane.pane-id);
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    scroll(delta) => {
                        root.terminal-scroll(delta);
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }
                    selection-changed(sc, sr, ec, er, has-sel) => {
                        root.active-pane-id = pane.pane-id;
                        root.has-selection = has-sel;
                        root.terminal-selection-changed(sc, sr, ec, er, has-sel);
                        root.is-context-menu-open = false;
                        root.is-tab-context-menu-open = false;
                    }


                    context-menu(mx, my) => {
                        root.active-pane-id = pane.pane-id;
                        root.select-pane-by-id(pane.pane-id);
                        root.context-menu-x = pane.x + mx;
                        root.context-menu-y = pane.y + 36px + my;
                        root.context-menu-can-split = pane.tabs.length > 1;
                        root.is-context-menu-open = true;
                        root.is-tab-context-menu-open = false;
                    }
                    tab-context-menu(tab_id, mx, my) => {
                        root.active-pane-id = pane.pane-id;
                        root.select-pane-by-id(pane.pane-id);
                        root.tab-context-menu-tab-id = tab_id;
                        root.tab-context-menu-pane-id = pane.pane-id;
                        root.tab-context-menu-x = pane.x + mx;
                        root.tab-context-menu-y = pane.y + my;
                        root.tab-context-menu-can-split = pane.tabs.length > 1;
                        root.tab-context-menu-can-close-others = pane.tabs.length > 1;
                        root.is-tab-context-menu-open = true;
                        root.is-context-menu-open = false;
                    }

                }


                // 2.4.2 动态渲染全部超窄拖拽分割条 (视觉 2px，触控感应热区 8px)
                for splitter in root.terminal-splitters: Rectangle {
                    x: splitter.x;
                    y: splitter.y;
                    width: splitter.width;
                    height: splitter.height;
                    background: split-bar-touch.has-hover || split-bar-touch.pressed ? AppTheme.accent : AppTheme.border;
                    animate background { duration: 120ms; }

                    split-bar-touch := TouchArea {
                        x: splitter.is-vertical ? -3px : 0px;
                        y: splitter.is-vertical ? 0px : -3px;
                        width: splitter.is-vertical ? parent.width + 6px : parent.width;
                        height: splitter.is-vertical ? parent.height : parent.height + 6px;
                        mouse-cursor: splitter.is-vertical ? col-resize : row-resize;
                        property <length> press-x: 0px;
                        property <length> press-y: 0px;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                            }
                        }

                        moved => {
                            if self.pressed {
                                let dx = (self.mouse-x - self.press-x) / 1px;
                                let dy = (self.mouse-y - self.press-y) / 1px;
                                let delta = splitter.is-vertical ? dx : dy;
                                let total = splitter.is-vertical ? root.canvas-width : root.canvas-height;
                                if Math.abs(delta) >= 1.0 && total > 50.0 {
                                    root.adjust-splitter(splitter.splitter-id, delta / total);
                                }
                            }
                        }
                    }
                }
            }

            // 2.5 浮动文本搜索栏 (Ctrl+F)
            if root.is-find-open: TerminalFindBar {
                x: parent.width - self.width - 16px;
                y: 10px;
                is-open: root.is-find-open;
                search-query <=> root.find-query;
                current-match: root.find-current-match;
                total-matches: root.find-total-matches;
                close => { root.is-find-open = false; }
                find-next => { root.search-terminal(root.find-query, false); }
                find-prev => { root.search-terminal(root.find-query, false); }
                search-changed(q) => { root.search-terminal(q, false); }
            }

            // 2.6 右键上下文快捷菜单
            if root.is-context-menu-open: TerminalContextMenu {
                x: Math.max(2px, Math.min(parent.width - self.width - 4px, root.context-menu-x));
                y: Math.max(2px, Math.min(parent.height - self.height - 4px, root.context-menu-y));
                is-open: root.is-context-menu-open;
                menu-x: root.context-menu-x;
                menu-y: root.context-menu-y;
                has-selection: root.has-selection;
                can-split: root.context-menu-can-split;
                copy-text => { root.copy-text(); }
                paste-text => { root.paste-text(); }
                select-all => { }
                clear-screen => { root.clear-screen(); }
                split-right => { root.split-terminal("vertical"); }
                split-down => { root.split-terminal("horizontal"); }
                close-menu => { root.is-context-menu-open = false; }
            }

            // 2.6.2 Tab 标签专属右键快捷菜单
            if root.is-tab-context-menu-open: TabContextMenu {
                x: Math.max(2px, Math.min(parent.width - self.width - 4px, root.tab-context-menu-x));
                y: Math.max(2px, Math.min(parent.height - self.height - 4px, root.tab-context-menu-y));
                is-open: root.is-tab-context-menu-open;
                menu-x: root.tab-context-menu-x;
                menu-y: root.tab-context-menu-y;
                can-split: root.tab-context-menu-can-split;

                can-close-others: root.tab-context-menu-can-close-others;
                copy-ip => { root.copy-tab-ip(root.tab-context-menu-tab-id); }
                split-right => {
                    if root.tab-context-menu-can-split {
                        if root.is-split {
                            root.select-pane-tab(root.tab-context-menu-pane-id, root.tab-context-menu-tab-id);
                        } else {
                            root.select-tab(root.tab-context-menu-tab-id);
                        }
                        root.split-terminal("vertical");
                    }
                }
                split-down => {
                    if root.tab-context-menu-can-split {
                        if root.is-split {
                            root.select-pane-tab(root.tab-context-menu-pane-id, root.tab-context-menu-tab-id);
                        } else {
                            root.select-tab(root.tab-context-menu-tab-id);
                        }
                        root.split-terminal("horizontal");
                    }
                }
                close-tab => {
                    if root.is-split {
                        root.close-pane-tab(root.tab-context-menu-pane-id, root.tab-context-menu-tab-id);
                    } else {
                        root.close-tab(root.tab-context-menu-tab-id);
                    }
                }
                close-others => {
                    root.close-other-tabs(root.tab-context-menu-pane-id, root.tab-context-menu-tab-id);
                }
                close-menu => { root.is-tab-context-menu-open = false; }
            }



            // 2.7 终端右侧微型历史滚动条 (当存在回滚历史时展示)
            if root.history-size > 0: Rectangle {
                x: parent.width - 8px;
                y: 6px;
                width: 5px;
                height: parent.height - 12px;
                border-radius: 2.5px;
                background: AppTheme.border.transparentize(70%);

                // 滚动滑块
                Rectangle {
                    y: Math.max(0px, Math.min(parent.height - 32px, (parent.height - 32px) * (1.0 - (root.scroll-offset / Math.max(1, root.history-size)))));
                    width: 5px;
                    height: Math.max(24px, parent.height * (root.terminal-rows / (root.history-size + root.terminal-rows)));
                    border-radius: 2.5px;
                    background: root.scroll-offset > 0 ? AppTheme.accent : AppTheme.secondary-foreground.transparentize(50%);
                    animate background { duration: 120ms; }
                }
            }
        }

        // 3. 空状态 / 欢迎仪表盘 (当无会话时)
        if !root.has-active-session: Rectangle {
            background: AppTheme.window-background;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Text {
                    text: "✨ smalux-ssh";
                    font-size: 28px;
                    font-weight: 700;
                    color: AppTheme.accent;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("请从左侧双击主机发起连接，或点击右上角 + 快速新建本地/远程终端");
                    font-size: 13px;
                    color: AppTheme.secondary-foreground;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // -------------------------------------------------------------------------
    // 4. Tab 拖拽浮动虚影 (Floating Ghost Card - 尺寸与原装 Tab 卡片 140px x 28px 完全一致)
    // -------------------------------------------------------------------------
    if root.is-dragging-tab: Rectangle {
        x: root.drag-tab-x - 70px;
        y: root.drag-tab-y - 14px;
        width: 140px;
        height: 28px;
        border-radius: 4px;
        opacity: root.is-tab-drop-valid ? 0.90 : 0.45;
        background: AppTheme.surface-background.transparentize(15%);
        border-width: 1.5px;
        border-color: root.is-tab-drop-valid ? AppTheme.accent : AppTheme.danger;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000.transparentize(40%);

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/icons/terminal.svg");
                    width: 13px;
                    height: 13px;
                    image-fit: contain;
                    colorize: root.is-tab-drop-valid ? AppTheme.accent : AppTheme.disabled-foreground;
                }
            }

            if root.is-tab-drop-valid: VerticalLayout {
                alignment: center;
                StatusDot {
                    status: root.drag-tab-status;
                    dot-size: 5px;
                }
            }

            Text {
                text: root.drag-tab-title;
                font-size: 11px;
                font-weight: 700;
                color: root.is-tab-drop-valid ? AppTheme.foreground : AppTheme.disabled-foreground;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }
    }
}
