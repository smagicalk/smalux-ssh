// -----------------------------------------------------------------------------
// 出网代理专属配置表单 (Tunnel Proxy Form)
// 适配 SOCKS5, HTTP, HTTPS 静态代理节点，包含凭据与环境变量导出预览
// -----------------------------------------------------------------------------

import { AppTheme } from "../../../themes/app-theme.slint";

export component TunnelProxyForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <string> form-proxy-proto: "SOCKS5";
    in-out property <string> form-name: "";
    in-out property <string> form-remote-host: "";
    in-out property <string> form-remote-port: "1080";
    in-out property <string> form-proxy-username: "";
    in-out property <string> form-proxy-password: "";
    in-out property <string> form-ssh-command: "";
    in-out property <string> form-notes: "";

    callback copy-custom-text(string /* text */, string /* title */, string /* message */);

    alignment: start;
    spacing: 12px;

    // 1. 代理协议类型单选组
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;
        Text {
            text: @tr("代理协议类型");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }

        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            width: 100%;

            // SOCKS5
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-proxy-proto == "SOCKS5" ? AppTheme.accent.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-proxy-proto == "SOCKS5" ? AppTheme.accent : AppTheme.border;

                Text {
                    text: @tr("SOCKS5 代理");
                    font-size: 11px;
                    font-weight: root.form-proxy-proto == "SOCKS5" ? 700 : 400;
                    color: root.form-proxy-proto == "SOCKS5" ? AppTheme.accent : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => {
                        root.form-proxy-proto = "SOCKS5";
                    }
                    mouse-cursor: pointer;
                }
            }

            // HTTP
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-proxy-proto == "HTTP" ? AppTheme.accent.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-proxy-proto == "HTTP" ? AppTheme.accent : AppTheme.border;

                Text {
                    text: @tr("HTTP 代理");
                    font-size: 11px;
                    font-weight: root.form-proxy-proto == "HTTP" ? 700 : 400;
                    color: root.form-proxy-proto == "HTTP" ? AppTheme.accent : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => {
                        root.form-proxy-proto = "HTTP";
                    }
                    mouse-cursor: pointer;
                }
            }

            // HTTPS
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-proxy-proto == "HTTPS" ? AppTheme.accent.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-proxy-proto == "HTTPS" ? AppTheme.accent : AppTheme.border;

                Text {
                    text: @tr("HTTPS 代理");
                    font-size: 11px;
                    font-weight: root.form-proxy-proto == "HTTPS" ? 700 : 400;
                    color: root.form-proxy-proto == "HTTPS" ? AppTheme.accent : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => {
                        root.form-proxy-proto = "HTTPS";
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // 2. 规则名称
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;
        Text {
            text: @tr("代理资产描述名称");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 32px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-name;
                    font-size: 12px;
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                    enabled: root.is-create-mode || root.is-editing;
                }
            }
        }
    }

    // 3. 代理服务器与身份认证网格
    GridLayout {
        width: 100%;
        spacing: 12px;

        Row {
            // 代理服务器地址
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                spacing: 4px;

                Text {
                    text: @tr("代理服务器地址 (IP 或域名)");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    overflow: elide;
                }
                Rectangle {
                    height: 32px;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.form-remote-host;
                            font-size: 12px;
                            font-family: "Cascadia Code, Consolas, monospace";
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                            enabled: root.is-create-mode || root.is-editing;
                        }
                    }
                }
            }

            // 代理服务端口
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                spacing: 4px;

                Text {
                    text: @tr("代理服务端口 (Port)");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    overflow: elide;
                }
                Rectangle {
                    height: 32px;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.form-remote-port;
                            font-size: 12px;
                            font-family: "Cascadia Code, Consolas, monospace";
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                            enabled: root.is-create-mode || root.is-editing;
                        }
                    }
                }
            }
        }

        Row {
            // 认证用户名
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                spacing: 4px;

                Text {
                    text: @tr("认证用户名 (可选，留空无需认证)");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    overflow: elide;
                }
                Rectangle {
                    height: 32px;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.form-proxy-username;
                            font-size: 12px;
                            font-family: "Cascadia Code, Consolas, monospace";
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                            enabled: root.is-create-mode || root.is-editing;
                        }
                    }
                }
            }

            // 认证密码
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                spacing: 4px;

                Text {
                    text: @tr("认证密码 (可选，留空无需认证)");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    overflow: elide;
                }
                Rectangle {
                    height: 32px;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.form-proxy-password;
                            font-size: 12px;
                            font-family: "Cascadia Code, Consolas, monospace";
                            color: AppTheme.foreground;
                            input-type: password;
                            vertical-alignment: center;
                            enabled: root.is-create-mode || root.is-editing;
                        }
                    }
                }
            }
        }
    }

    // 4. 实时环境变量代理预览与一键复制
    VerticalLayout {
        alignment: start;
        spacing: 6px;
        width: 100%;

        HorizontalLayout {
            width: 100%;
            alignment: start;
            spacing: 6px;

            Text {
                text: @tr("全局代理环境变量预览");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            // 复制按钮
            Rectangle {
                height: 22px;
                border-radius: 4px;
                background: proxy-copy-hover.has-hover ? AppTheme.accent.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: proxy-copy-hover.has-hover ? AppTheme.accent : AppTheme.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "📋";
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("复制参数");
                        font-size: 10px;
                        font-weight: 600;
                        color: proxy-copy-hover.has-hover ? AppTheme.accent : AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }

                proxy-copy-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy-custom-text(root.form-ssh-command, @tr("复制成功"), @tr("已复制代理环境变量配置"));
                    }
                }
            }
        }

        Rectangle {
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.window-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding: 8px;
                Text {
                    width: 100%;
                    text: root.form-ssh-command != "" ? root.form-ssh-command : @tr("(待填写代理地址与端口)");
                    font-family: "Cascadia Code, Consolas, monospace";
                    font-size: 11px;
                    color: root.form-ssh-command != "" ? AppTheme.accent : AppTheme.secondary-foreground.transparentize(40%);
                    wrap: char-wrap;
                }
            }
        }
    }

    // 5. 备注说明
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;
        Text {
            text: @tr("备注说明与业务用途");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 50px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-notes;
                    font-size: 12px;
                    color: AppTheme.foreground;
                    single-line: false;
                    wrap: word-wrap;
                    enabled: root.is-create-mode || root.is-editing;
                }
            }
        }
    }
}
