// -----------------------------------------------------------------------------
// 跳板机堡垒专属配置表单 (Tunnel Bastion Form)
// 包含跳板链路描述名称、多跳中继节点链表 (ProxyJump) 与级联参数预览
// -----------------------------------------------------------------------------

import { AppTheme } from "../../../themes/app-theme.slint";
import { JumpHopData } from "../tunnels_model.slint";

export component TunnelBastionForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <string> form-name: "";
    in-out property <[JumpHopData]> form-jump-chain: [];
    in-out property <string> form-ssh-command: "";
    in-out property <string> form-notes: "";

    callback add-hop();
    callback remove-jump-hop(int /* index */);
    callback move-jump-hop-up(int /* index */);
    callback move-jump-hop-down(int /* index */);
    callback toggle-jump-hop-enabled(int /* index */);

    alignment: start;
    spacing: 12px;

    // 1. 跳板机链路描述名称
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;

        Text {
            text: @tr("跳板机链路描述名称");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 32px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-name;
                    font-size: 12px;
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                    enabled: root.is-create-mode || root.is-editing;
                }
            }
        }
    }

    // 2. 级联跳板主机节点列表
    VerticalLayout {
        alignment: start;
        spacing: 6px;
        width: 100%;

        HorizontalLayout {
            alignment: space-between;
            width: 100%;

            Text {
                text: @tr("级联跳板主机顺序 (ProxyJump Chain)");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
            }

            Text {
                text: @tr("共 ") + root.form-jump-chain.length + @tr(" 级跳板中继");
                font-size: 10px;
                color: AppTheme.accent;
            }
        }

        // 列表项循环展示选中的主机
        for hop[idx] in root.form-jump-chain: Rectangle {
            height: 46px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: hop.enabled ? AppTheme.control-background : AppTheme.control-background.transparentize(50%);
            border-width: 1px;
            border-color: hop.enabled ? AppTheme.border : AppTheme.border.transparentize(50%);

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                // 左侧：跳板序号徽章
                Rectangle {
                    height: 20px;
                    border-radius: 4px;
                    background: hop.enabled ? #e67e22.transparentize(80%) : AppTheme.border.transparentize(70%);
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "Hop " + (idx + 1);
                            font-size: 10px;
                            font-weight: 700;
                            color: hop.enabled ? #e67e22 : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                // 服务器图标
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/icons/server.svg");
                        width: 14px;
                        height: 14px;
                        colorize: hop.enabled ? AppTheme.accent : AppTheme.secondary-foreground;
                    }
                }

                // 主机名称与连接地址
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: hop.host-name != "" ? hop.host-name : @tr("未命名主机");
                        font-size: 12px;
                        font-weight: 600;
                        color: hop.enabled ? AppTheme.foreground : AppTheme.secondary-foreground;
                        overflow: elide;
                    }

                    Text {
                        text: hop.host-address != "" ? (hop.host-address + ":" + hop.host-port) : @tr("默认端口 22");
                        font-size: 10px;
                        font-family: "Cascadia Code, Consolas, monospace";
                        color: AppTheme.secondary-foreground;
                        overflow: elide;
                    }
                }

                // 右侧操作区：调序上移、调序下移、删除、开关
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    // 调序上移按钮 🔼
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: up-touch.has-hover ? AppTheme.hover-background : transparent;
                        y: (parent.height - self.height) / 2;

                        up-touch := TouchArea {
                            enabled: (root.is-create-mode || root.is-editing) && idx > 0;
                            clicked => { root.move-jump-hop-up(idx); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../../../assets/icons/chevron-up.svg");
                            width: 11px;
                            height: 11px;
                            colorize: ((root.is-create-mode || root.is-editing) && idx > 0)
                                ? (up-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground)
                                : AppTheme.secondary-foreground.transparentize(70%);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 调序下移按钮 🔽
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: down-touch.has-hover ? AppTheme.hover-background : transparent;
                        y: (parent.height - self.height) / 2;

                        down-touch := TouchArea {
                            enabled: (root.is-create-mode || root.is-editing) && idx < root.form-jump-chain.length - 1;
                            clicked => { root.move-jump-hop-down(idx); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../../../assets/icons/chevron-down.svg");
                            width: 11px;
                            height: 11px;
                            colorize: ((root.is-create-mode || root.is-editing) && idx < root.form-jump-chain.length - 1)
                                ? (down-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground)
                                : AppTheme.secondary-foreground.transparentize(70%);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 移除节点按钮 🗑️
                    if root.is-create-mode || root.is-editing: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: del-hop-touch.has-hover ? #e74c3c.transparentize(85%) : transparent;
                        y: (parent.height - self.height) / 2;

                        del-hop-touch := TouchArea {
                            clicked => { root.remove-jump-hop(idx); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../../../assets/icons/trash.svg");
                            width: 11px;
                            height: 11px;
                            colorize: del-hop-touch.has-hover ? #e74c3c : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 竖直分割线
                    Rectangle {
                        width: 1px;
                        height: 16px;
                        background: AppTheme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    // 开关 (启用/旁路)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: hop.enabled ? @tr("启用") : @tr("旁路");
                            font-size: 10px;
                            color: hop.enabled ? AppTheme.success : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 32px;
                            height: 18px;
                            border-radius: 9px;
                            background: hop.enabled ? AppTheme.accent : AppTheme.control-background;
                            border-width: 1px;
                            border-color: hop.enabled ? AppTheme.accent : AppTheme.border;
                            animate background { duration: 120ms; }
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: #ffffff;
                                x: hop.enabled ? 16px : 2px;
                                y: 1px;
                                animate x { duration: 120ms; }
                            }

                            TouchArea {
                                enabled: root.is-create-mode || root.is-editing;
                                clicked => { root.toggle-jump-hop-enabled(idx); }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }

        // 空状态提示
        if root.form-jump-chain.length == 0: Rectangle {
            height: 64px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: @tr("尚未添加任何跳板主机节点");
                    font-size: 12px;
                    color: AppTheme.secondary-foreground;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("请点击下方按钮从现有的主机资产树中添加第一跳中继机");
                    font-size: 10px;
                    color: AppTheme.secondary-foreground.transparentize(30%);
                    horizontal-alignment: center;
                }
            }
        }

        // 列表底部：+ 添加跳板主机节点
        if root.is-create-mode || root.is-editing: Rectangle {
            height: 34px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: add-hop-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
            border-width: 1px;
            border-color: add-hop-touch.has-hover ? AppTheme.accent : AppTheme.border;

            add-hop-touch := TouchArea {
                clicked => { root.add-hop(); }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Image {
                    source: @image-url("../../../assets/icons/plus.svg");
                    width: 12px;
                    height: 12px;
                    colorize: add-hop-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: @tr("+ 添加跳板中继主机 (从资产树选择)");
                    font-size: 11px;
                    font-weight: 600;
                    color: add-hop-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }

    // 3. OpenSSH ProxyJump 级联参数预览卡片
    Rectangle {
        width: 100%;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: AppTheme.border;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Text {
                text: @tr("OpenSSH ProxyJump 级联调用参数预览 (-J)");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
            }

            Text {
                text: root.form-ssh-command != "" ? root.form-ssh-command : @tr("-J <尚未选择启用跳板节点>");
                font-size: 11px;
                font-family: "Cascadia Code, Consolas, monospace";
                color: AppTheme.accent;
                wrap: word-wrap;
            }
        }
    }

    // 4. 备注说明
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;
        Text {
            text: @tr("备注说明与业务用途");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 50px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-notes;
                    font-size: 12px;
                    color: AppTheme.foreground;
                    single-line: false;
                    wrap: word-wrap;
                    enabled: root.is-create-mode || root.is-editing;
                }
            }
        }
    }
}
