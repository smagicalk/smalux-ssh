import { TabData, TerminalPaneData, TerminalSplitterData } from "./terminal_model.slint";

export { TabData, TerminalPaneData, TerminalSplitterData }

/// 终端多会话与多分屏窗格领域全局状态总线 (Terminal Bridge)
export global TerminalBridge {
    // 会话基础属性
    in-out property <bool> has-active-session: false;
    in-out property <string> active-session-tab: "";
    in-out property <string> active-session-name: "";
    in-out property <string> active-host-id: "";
    in-out property <string> active-host-name: "";
    in-out property <string> active-host-address: "";
    in-out property <int> active-host-ping-ms: 0;
    in-out property <string> active-host-status: "online";
    in-out property <[TabData]> tabs: [];

    // 多分屏与窗格拓扑
    in-out property <bool> is-split: false;
    in-out property <int> split-count: 1;
    in-out property <string> split-orientation: "vertical";
    in-out property <float> split-ratio: 0.5;
    in-out property <int> active-pane-index: 0;
    in-out property <string> active-pane-id: "";
    in-out property <[TerminalPaneData]> panes: [];
    in-out property <[TerminalSplitterData]> splitters: [];
    in-out property <bool> is-zoomed: false;
    in-out property <string> zoomed-pane-id: "";
    in-out property <bool> is-broadcast-mode: false;

    // 终端实时位图帧流
    in-out property <image> terminal-screen-image;
    in-out property <image> terminal-split-image;
    in-out property <image> terminal-split2-image;
    in-out property <image> terminal-split3-image;

    // 终端历史与回滚
    in-out property <int> history-size: 0;
    in-out property <int> scroll-offset: 0;

    // 终端动态尺寸 (自适应计算字符列数与行数，由视口同步给 Rust 后台 PTY)
    in-out property <int> terminal-cols: 80;
    in-out property <int> terminal-rows: 24;
    in-out property <float> canvas-width: 800;
    in-out property <float> canvas-height: 600;

    // 标签页关闭二次防误触确认弹窗状态与回调
    in-out property <bool> is-tab-close-confirm-open: false;
    in-out property <string> tab-close-confirm-title: "";
    in-out property <string> tab-close-confirm-message: "";
    callback confirm-close-tab();
    callback cancel-close-tab();

    // 会话与 Tab 交互回调
    callback select-tab(string /* id */);
    callback close-tab(string /* id */);
    callback new-tab();
    callback select-pane-tab(string /* pane_id */, string /* tab_id */);
    callback close-pane-tab(string /* pane_id */, string /* tab_id */);
    callback copy-tab-ip(string /* tab_id */);
    callback close-other-tabs(string /* pane_id */, string /* tab_id */);
    callback move-terminal-tab(string /* from_pane_id */, int /* from_index */, length /* drop_x */, length /* drop_y */);
    callback send-snippet(string /* cmd */);

    // 分屏窗格调度回调
    callback split-terminal(string /* orientation */);
    callback close-split();
    callback close-pane-by-id(string /* pane_id */);
    callback close-pane-by-index(int /* index */);
    callback select-pane(int /* index */);
    callback select-pane-by-id(string /* pane_id */);
    callback toggle-pane-zoom(string /* pane_id */);
    callback adjust-splitter(string /* splitter_id */, float /* delta_ratio */);

    // 终端核心底层交互回调
    callback terminal-key-input(string /* text */, bool /* is_ctrl */, bool /* is_shift */, bool /* is_alt */);
    callback terminal-scroll(length /* delta */);
    callback terminal-scroll-to(int /* target_offset */);
    callback terminal-selection-changed(int /* start_col */, int /* start_row */, int /* end_col */, int /* end_row */, bool /* has_selection */);
    callback terminal-copy();
    callback terminal-paste();
    callback terminal-clear();
    callback search-terminal(string /* query */, bool /* match_case */);
    callback terminal-resize(int /* cols */, int /* rows */);
}
