// =============================================================================
// 文件名称: credential_master_list.slint
// 模块功能: 凭据左侧规则列表栏 (Credential Master List)
// 包含分类快速切换 Pills、全文搜索、卡片流与状态
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";
import { SearchInput } from "../../../components/search-input.slint";
import { AppIconButton } from "../../../components/base/app-icon-button.slint";
import { AppButton } from "../../../components/base/app-button.slint";
import { ScrollView } from "std-widgets.slint";
import { CredentialItemData } from "../credentials_model.slint";

export component CredentialMasterList inherits Rectangle {
    in property <[CredentialItemData]> credentials: [];
    in-out property <string> filter-category: "all";
    in-out property <string> search-query: "";
    in-out property <string> active-cred-id: "";
    in-out property <bool> is-create-mode: false;
    in property <int> total-count: root.credentials.length;

    callback select-cred(string /* id */);
    callback start-create();
    callback search-changed(string /* query */);
    callback filter-category-changed(string /* category */);
    callback back-to-terminal();

    width: 320px;
    background: AppTheme.panel-background;

    // 右侧 1px 分割线
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: AppTheme.border;
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        // 1. 顶部标题与新建按钮
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                AppIconButton {
                    icon: @image-url("../../../assets/icons/arrow-left.svg");
                    icon-size: 14px;
                    clicked => { root.back-to-terminal(); }
                }

                Rectangle {
                    width: 16px;
                    height: 16px;

                    Image {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../assets/icons/key.svg");
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                        colorize: AppTheme.foreground;
                    }
                }

                Text {
                    text: @tr("凭据管理");
                    font-size: 13px;
                    font-weight: 700;
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                }

                Text {
                    text: "(" + root.total-count + ")";
                    font-size: 11px;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }

            // "+ 新建" 按钮
            Rectangle {
                width: 68px;
                height: 24px;
                border-radius: 4px;
                background: add-touch.has-hover ? AppTheme.accent.darker(15%) : AppTheme.accent;

                add-touch := TouchArea {
                    clicked => {
                        root.start-create();
                    }
                    mouse-cursor: pointer;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Image {
                        source: @image-url("../../../assets/icons/plus.svg");
                        width: 12px;
                        height: 12px;
                        image-fit: contain;
                        colorize: AppTheme.selected-foreground;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("新建");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.selected-foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. 分类切换标签栏 (All / Key / Password / Agent)
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;

                // 全部 (All)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "all"
                        ? AppTheme.selected-background
                        : (all-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "all" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    all-tab-touch := TouchArea {
                        clicked => {
                            root.filter-category = "all";
                            root.filter-category-changed("all");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("全部");
                        font-size: 10px;
                        font-weight: root.filter-category == "all" ? 700 : 500;
                        color: root.filter-category == "all" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 密钥 (Keys)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "key"
                        ? AppTheme.selected-background
                        : (key-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "key" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    key-tab-touch := TouchArea {
                        clicked => {
                            root.filter-category = "key";
                            root.filter-category-changed("key");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("密钥");
                        font-size: 10px;
                        font-weight: root.filter-category == "key" ? 700 : 500;
                        color: root.filter-category == "key" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 密码 (Passwords)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "password"
                        ? AppTheme.selected-background
                        : (pwd-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "password" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    pwd-tab-touch := TouchArea {
                        clicked => {
                            root.filter-category = "password";
                            root.filter-category-changed("password");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("密码");
                        font-size: 10px;
                        font-weight: root.filter-category == "password" ? 700 : 500;
                        color: root.filter-category == "password" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 代理 (Agents)
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.filter-category == "agent"
                        ? AppTheme.selected-background
                        : (agent-tab-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: 1px;
                    border-color: root.filter-category == "agent" ? AppTheme.accent : transparent;
                    animate background, border-color { duration: 100ms; }

                    agent-tab-touch := TouchArea {
                        clicked => {
                            root.filter-category = "agent";
                            root.filter-category-changed("agent");
                        }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: @tr("代理");
                        font-size: 10px;
                        font-weight: root.filter-category == "agent" ? 700 : 500;
                        color: root.filter-category == "agent" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 3. 搜索框
        SearchInput {
            placeholder: @tr("搜索凭据...");
            text <=> root.search-query;
            changed(q) => {
                root.search-query = q;
                root.search-changed(q);
            }
            clear => {
                root.search-query = "";
                root.search-changed("");
            }
        }

        // 4. 凭据卡片列表
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 4px;
                padding-bottom: 8px;

                if root.credentials.length == 0: Rectangle {
                    height: 100px;
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: root.search-query != "" ? @tr("未匹配到凭据") : @tr("暂无凭据记录");
                            font-size: 11px;
                            color: AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                        }
                    }
                }

                for cred in root.credentials: Rectangle {
                    height: 52px;
                    border-radius: 4px;
                    background: (!root.is-create-mode && cred.id == root.active-cred-id)
                        ? AppTheme.selected-background
                        : (item-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                    border-width: 1px;
                    border-color: (!root.is-create-mode && cred.id == root.active-cred-id)
                        ? AppTheme.accent
                        : (item-touch.has-hover ? AppTheme.border : transparent);

                    animate background, border-color { duration: 100ms; }

                    item-touch := TouchArea {
                        clicked => {
                            root.select-cred(cred.id);
                        }
                        mouse-cursor: pointer;
                    }

                    // 0. 左侧激活高亮指示条
                    if (!root.is-create-mode && cred.id == root.active-cred-id): Rectangle {
                        x: 0px;
                        y: 6px;
                        width: 3px;
                        height: parent.height - 12px;
                        border-radius: 1.5px;
                        background: AppTheme.accent;
                    }

                    // 1. 左侧图标
                    Rectangle {
                        x: 6px;
                        y: 6px;
                        width: parent.height - 12px;
                        height: parent.height - 12px;
                        border-radius: 4px;
                        background: AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.border;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: cred.cred-type == "key"
                                ? @image-url("../../../assets/icons/key.svg")
                                : (cred.cred-type == "password" ? @image-url("../../../assets/icons/file-text.svg") : @image-url("../../../assets/icons/zap.svg"));
                            width: 22px;
                            height: 22px;
                            image-fit: contain;
                            colorize: (!root.is-create-mode && cred.id == root.active-cred-id)
                                ? AppTheme.accent
                                : AppTheme.secondary-foreground;
                        }
                    }

                    // 2. 右侧文本信息
                    VerticalLayout {
                        x: (parent.height - 12px) + 14px;
                        width: parent.width - ((parent.height - 12px) + 22px);
                        y: 9px;
                        height: parent.height - 18px;
                        alignment: space-between;
                        padding: 0px;
                        spacing: 0px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: cred.name;
                                font-size: 11px;
                                font-weight: 600;
                                color: (!root.is-create-mode && cred.id == root.active-cred-id)
                                    ? AppTheme.selected-foreground
                                    : AppTheme.foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: top;
                            }

                            // 简洁算法标签
                            Rectangle {
                                height: 16px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: center;

                                    Text {
                                        text: cred.algorithm;
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            if cred.cred-type == "key": Text {
                                text: cred.fingerprint != "" ? cred.fingerprint : @tr("未生成指纹");
                                font-size: 9px;
                                font-family: "Cascadia Code, Consolas, monospace";
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.cred-type == "password": Text {
                                text: (cred.username != "" ? cred.username : @tr("未设置用户")) + "  ••••••";
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.cred-type == "agent": Text {
                                text: @tr("管道: ") + (cred.fingerprint != "" ? cred.fingerprint : @tr("外部代理"));
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: bottom;
                            }

                            if cred.bound-host-count > 0: Text {
                                text: cred.bound-host-count + " " + @tr("台主机");
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                horizontal-alignment: left;
                                vertical-alignment: bottom;
                            }
                        }
                    }
                }
            }
        }
    }
}
