// =============================================================================
// 文件名称: credential_password_form.slint
// 模块功能: 账号密码凭据配置表单 (Credential Password Form)
// 包含登录用户名、密码输入、随机强密码生成与明文切换
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";

export component CredentialPasswordForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <bool> reveal-password: false;
    in-out property <string> form-username: "root";
    in-out property <string> form-secret-data: "";

    callback generate-password();

    alignment: start;
    spacing: 10px;

    // 1. 用户名
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("默认登录用户名 *");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        AppTextInput {
            text <=> root.form-username;
            enabled: root.is-create-mode || root.is-editing;
            input-height: 28px;
            font-size: 11px;
            placeholder: @tr("请输入用户名，例如 root...");
        }
    }

    // 2. 登录密码
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: @tr("登录密码 *");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            if root.is-create-mode || root.is-editing: Rectangle {
                height: 20px;
                border-radius: 3px;
                background: gen-p-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                border-width: 1px;
                border-color: AppTheme.border;
                gen-p-touch := TouchArea {
                    clicked => { root.generate-password(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.is-create-mode ? @tr("随机生成强密码") : @tr("重新生成随机密码");
                        font-size: 10px;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        AppPasswordInput {
            text <=> root.form-secret-data;
            enabled: root.is-create-mode || root.is-editing;
            input-height: 28px;
            placeholder: @tr("请输入密码...");
            is-visible <=> root.reveal-password;
        }
    }
}
