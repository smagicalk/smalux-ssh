// =============================================================================
// 文件名称: credential_password_form.slint
// 模块功能: 账号密码凭据配置表单 (Credential Password Form)
// 包含登录用户名、密码输入、随机强密码生成与明文切换
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";

export component CredentialPasswordForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <bool> reveal-password: false;
    in-out property <string> form-username: "root";
    in-out property <string> form-secret-data: "";

    callback generate-password();

    alignment: start;
    spacing: 10px;

    // 1. 用户名
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("默认登录用户名 *");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: ((root.is-create-mode || root.is-editing) && user-in.has-focus) ? AppTheme.accent : AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                user-in := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-username;
                    enabled: root.is-create-mode || root.is-editing;
                    font-size: 11px;
                    color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }

    // 2. 登录密码
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: @tr("登录密码 *");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            if root.is-create-mode || root.is-editing: Rectangle {
                height: 20px;
                border-radius: 3px;
                background: gen-p-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                border-width: 1px;
                border-color: AppTheme.border;
                gen-p-touch := TouchArea {
                    clicked => { root.generate-password(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.is-create-mode ? @tr("随机生成强密码") : @tr("重新生成随机密码");
                        font-size: 10px;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: ((root.is-create-mode || root.is-editing) && pwd-in.has-focus) ? AppTheme.accent : AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 4px;

                pwd-in := TextInput {
                    horizontal-stretch: 1;
                    height: 100%;
                    text <=> root.form-secret-data;
                    enabled: root.is-create-mode || root.is-editing;
                    font-size: 11px;
                    input-type: root.reveal-password ? text : password;
                    color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: eye-pwd-touch.has-hover ? AppTheme.hover-background : transparent;

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.reveal-password
                            ? @image-url("../../../assets/icons/eye.svg")
                            : @image-url("../../../assets/icons/eye-off.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: root.reveal-password ? AppTheme.accent : AppTheme.secondary-foreground;
                    }

                    eye-pwd-touch := TouchArea {
                        clicked => { root.reveal-password = !root.reveal-password; }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}
