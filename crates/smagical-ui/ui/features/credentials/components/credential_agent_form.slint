// =============================================================================
// 文件名称: credential_agent_form.slint
// 模块功能: SSH Agent 外部代理凭据配置表单 (Credential Agent Form)
// 包含主流 Agent (1Password, OpenSSH, Bitwarden, KeePassXC, Pageant, GnuPG) 预设与命名管道路径
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";

export component CredentialAgentForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <string> form-name: "";
    in-out property <string> form-algorithm: "1Password";
    in-out property <string> form-secret-data: "";
    in-out property <string> form-notes: "";

    alignment: start;
    spacing: 10px;

    // 1. 常用 Agent 快速预设
    if root.is-create-mode || root.is-editing: VerticalLayout {
        alignment: start;
        spacing: 4px;
        Text {
            text: @tr("常用 Agent 快速预设 (点击一键填入管道路径)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            // 1Password Agent
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p1.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p1 := TouchArea {
                    clicked => {
                        root.form-name = "1Password SSH Agent";
                        root.form-algorithm = "1Password";
                        root.form-secret-data = "\\\\.\\pipe\\1password-ssh-agent";
                        root.form-notes = @tr("1Password 密码管理器内置 SSH 认证代理管道");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/key.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "1Password"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }

            // Windows OpenSSH Agent
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p2.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p2 := TouchArea {
                    clicked => {
                        root.form-name = "Windows OpenSSH Agent";
                        root.form-algorithm = "OpenSSH";
                        root.form-secret-data = "\\\\.\\pipe\\openssh-ssh-agent";
                        root.form-notes = @tr("Windows 内置 OpenSSH Authentication Agent 服务管道");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/terminal.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "OpenSSH"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }

            // Bitwarden Agent
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p3.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p3 := TouchArea {
                    clicked => {
                        root.form-name = "Bitwarden SSH Agent";
                        root.form-algorithm = "Bitwarden";
                        root.form-secret-data = "\\\\.\\pipe\\bitwarden-ssh-agent";
                        root.form-notes = @tr("Bitwarden / Vaultwarden 桌面端托管 SSH 代理");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/shield.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "Bitwarden"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }

            // KeePassXC
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p4.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p4 := TouchArea {
                    clicked => {
                        root.form-name = "KeePassXC SSH Agent";
                        root.form-algorithm = "KeePassXC";
                        root.form-secret-data = "\\\\.\\pipe\\kpxc_server";
                        root.form-notes = @tr("KeePassXC 本地密码库 SSH Agent 代理");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/lock.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "KeePassXC"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }

            // Pageant
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p5.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p5 := TouchArea {
                    clicked => {
                        root.form-name = "Pageant (PuTTY)";
                        root.form-algorithm = "Pageant";
                        root.form-secret-data = "\\\\.\\pipe\\pageant";
                        root.form-notes = @tr("PuTTY / WinSCP Pageant 经典认证协议代理");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/tunnel.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "Pageant"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }

            // GPG Agent
            Rectangle {
                height: 22px;
                border-radius: 3px;
                background: agt-p6.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                agt-p6 := TouchArea {
                    clicked => {
                        root.form-name = "GnuPG SSH Agent";
                        root.form-algorithm = "GnuPG";
                        root.form-secret-data = "\\\\.\\pipe\\gnupg-ssh-agent";
                        root.form-notes = @tr("GnuPG / YubiKey 智能卡 SSH 认证代理管道");
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/zap.svg");
                            width: 11px;
                            height: 11px;
                            colorize: AppTheme.foreground;
                        }
                    }
                    Text { text: "GnuPG"; font-size: 10px; color: AppTheme.foreground; vertical-alignment: center; }
                }
            }
        }
    }

    // 2. Agent 标识
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("Agent 标识");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: ((root.is-create-mode || root.is-editing) && algo-in.has-focus) ? AppTheme.accent : AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                algo-in := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-algorithm;
                    enabled: root.is-create-mode || root.is-editing;
                    font-size: 11px;
                    color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }

    // 3. 命名管道路径
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("Agent 管道路径 *");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: ((root.is-create-mode || root.is-editing) && pipe-in.has-focus) ? AppTheme.accent : AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                pipe-in := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.form-secret-data;
                    enabled: root.is-create-mode || root.is-editing;
                    font-size: 11px;
                    color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }
}
