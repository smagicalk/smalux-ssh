// =============================================================================
// 文件名称: credentials_view.slint
// 模块功能: 凭据全屏管理中心组装视图 (Credentials Center View)
// 核心设计: 统一设计语言 (无花哨纯色块)、左侧列表垂直居中、紧凑标签与表单间距、默认只读浏览 + 显式点击编辑
// =============================================================================

import { AppTheme } from "../../themes/app-theme.slint";
import { AppButton } from "../../components/base/app-button.slint";
import { ScrollView } from "std-widgets.slint";

import { CredentialItemData } from "credentials_model.slint";
import { CredentialMasterList } from "components/credential_master_list.slint";
import { CredentialKeyForm } from "components/credential_key_form.slint";
import { CredentialPasswordForm } from "components/credential_password_form.slint";
import { CredentialAgentForm } from "components/credential_agent_form.slint";
import { CredentialsBridge } from "credentials_bridge.slint";

export { CredentialItemData }

/// 凭据全屏管理中心组件 (Credentials Center View)
export component CredentialsCenterView inherits Rectangle {
    in property <[CredentialItemData]> credentials: CredentialsBridge.credentials;
    in-out property <string> filter-category: CredentialsBridge.credential-filter-category; // "all" | "key" | "password" | "agent"
    in-out property <string> search-query: CredentialsBridge.credential-search-query;
    in-out property <string> active-cred-id: CredentialsBridge.active-credential-id;

    // 模式状态机: 新建模式 / 查看模式 / 编辑模式
    in-out property <bool> is-create-mode: CredentialsBridge.is-credential-create-mode;
    in-out property <bool> is-editing: CredentialsBridge.is-credential-editing;
    in-out property <bool> show-full-private-key: false;
    in-out property <bool> reveal-passphrase: false;
    in-out property <bool> reveal-password: false;

    // 表单数据绑定
    in-out property <string> form-id: CredentialsBridge.credential-form-id;
    in-out property <string> form-name: CredentialsBridge.credential-form-name;
    in-out property <string> form-type: CredentialsBridge.credential-form-type; // "key" | "password" | "agent"
    in-out property <string> form-algorithm: CredentialsBridge.credential-form-algorithm;
    in-out property <string> form-username: CredentialsBridge.credential-form-username;
    in-out property <string> form-secret-data: CredentialsBridge.credential-form-secret-data;
    in-out property <string> form-passphrase: CredentialsBridge.credential-form-passphrase;
    in-out property <string> form-public-key: CredentialsBridge.credential-form-public-key;
    in-out property <string> form-fingerprint: CredentialsBridge.credential-form-fingerprint;
    in-out property <string> form-notes: CredentialsBridge.credential-form-notes;
    in-out property <int> form-bound-host-count: CredentialsBridge.credential-form-bound-host-count;
    in-out property <string> form-updated-at: CredentialsBridge.credential-form-updated-at;

    // 统计属性
    in property <int> total-count: root.credentials.length;

    // 回调函数 (仅保留页面跳转导航)
    callback back-to-terminal();

    background: AppTheme.window-background;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        // =====================================================================
        // 1. 左侧 Master: 凭据列表面板 (320px 宽度)
        // =====================================================================
        CredentialMasterList {
            credentials: root.credentials;
            filter-category <=> root.filter-category;
            search-query <=> root.search-query;
            active-cred-id <=> root.active-cred-id;
            is-create-mode <=> root.is-create-mode;
            total-count: root.total-count;
            select-cred(id) => {
                root.is-create-mode = false;
                root.is-editing = false;
                root.show-full-private-key = false;
                root.reveal-passphrase = false;
                root.reveal-password = false;
                root.active-cred-id = id;
                CredentialsBridge.select-credential(id);
            }
            start-create => {
                root.is-create-mode = true;
                root.is-editing = true;
                CredentialsBridge.open-create-credential-modal();
            }
            search-changed(q) => { CredentialsBridge.search-changed(q); }
            filter-category-changed(c) => { CredentialsBridge.filter-category(c); }
            back-to-terminal => { root.back-to-terminal(); }
        }

        // =====================================================================
        // 2. 右侧 Detail: 凭据详情 / 浏览 / 编辑 / 新建工作区
        // =====================================================================
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            // 未选择任何凭据的空状态
            if !root.is-create-mode && root.active-cred-id == "": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 10px;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 4px;
                        background: AppTheme.surface-background;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        x: (parent.width - self.width) / 2;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../assets/icons/key.svg");
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            colorize: AppTheme.secondary-foreground;
                        }
                    }

                    Text {
                        text: @tr("请从左侧选择凭据以查看详情");
                        font-size: 12px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                    }
                }
            }

            // 已选定凭据或新建模式时的详情面板
            if root.is-create-mode || root.active-cred-id != "": VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                // 2.1 头部操作工具栏
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    // 左侧标题与状态
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.form-type == "key"
                                    ? @image-url("../../assets/icons/key.svg")
                                    : (root.form-type == "password" ? @image-url("../../assets/icons/file-text.svg") : @image-url("../../assets/icons/zap.svg"));
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: AppTheme.foreground;
                            }
                        }

                        Text {
                            text: root.is-create-mode ? @tr("新建凭据") : root.form-name;
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        if !root.is-create-mode && root.is-editing: Rectangle {
                            height: 16px;
                            border-radius: 3px;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.accent;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;
                                Text {
                                    text: @tr("编辑中");
                                    font-size: 9px;
                                    color: AppTheme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 右侧动作按钮组
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        // 新建态操作按钮
                        if root.is-create-mode: HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            AppButton {
                                text: @tr("取消");
                                variant: "secondary";
                                clicked => { CredentialsBridge.cancel-create-credential(); }
                            }

                            AppButton {
                                text: @tr("保存并创建");
                                variant: "primary";
                                clicked => {
                                    CredentialsBridge.save-credential(
                                        "",
                                        root.form-name,
                                        root.form-type,
                                        root.form-algorithm,
                                        root.form-username,
                                        root.form-secret-data,
                                        root.form-passphrase,
                                        root.form-public-key,
                                        root.form-fingerprint,
                                        root.form-notes
                                    );
                                }
                            }
                        }

                        // 查看态操作按钮
                        if !root.is-create-mode && !root.is-editing: HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            AppButton {
                                text: root.form-type == "key" ? @tr("复制公钥") : (root.form-type == "password" ? @tr("复制密码") : @tr("复制管道"));
                                variant: "secondary";
                                clicked => { CredentialsBridge.copy-secret-to-clipboard(root.form-id, "secret"); }
                            }

                            AppButton {
                                text: @tr("编辑");
                                variant: "primary";
                                clicked => {
                                    root.is-editing = true;
                                    root.show-full-private-key = true;
                                    CredentialsBridge.start-edit-credential();
                                }
                            }

                            AppButton {
                                text: @tr("删除");
                                variant: "danger";
                                clicked => { CredentialsBridge.delete-credential(root.form-id); }
                            }
                        }

                        // 编辑态操作按钮
                        if !root.is-create-mode && root.is-editing: HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            AppButton {
                                text: @tr("取消");
                                variant: "secondary";
                                clicked => {
                                    root.is-editing = false;
                                    CredentialsBridge.cancel-edit-credential();
                                }
                            }

                            AppButton {
                                text: @tr("保存修改");
                                variant: "primary";
                                clicked => {
                                    root.is-editing = false;
                                    CredentialsBridge.save-credential(
                                        root.form-id,
                                        root.form-name,
                                        root.form-type,
                                        root.form-algorithm,
                                        root.form-username,
                                        root.form-secret-data,
                                        root.form-passphrase,
                                        root.form-public-key,
                                        root.form-fingerprint,
                                        root.form-notes
                                    );
                                }
                            }
                        }
                    }
                }

                // 2.2 新建模式下的凭据类型切换分段控件
                if root.is-create-mode: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "key" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "key" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "key"; } }
                            Text {
                                text: @tr("SSH 密钥对");
                                font-size: 10px;
                                font-weight: root.form-type == "key" ? 600 : 400;
                                color: root.form-type == "key" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "password" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "password" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "password"; } }
                            Text {
                                text: @tr("账号密码");
                                font-size: 10px;
                                font-weight: root.form-type == "password" ? 600 : 400;
                                color: root.form-type == "password" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.form-type == "agent" ? AppTheme.control-background : transparent;
                            border-width: root.form-type == "agent" ? 1px : 0px;
                            border-color: AppTheme.border;
                            TouchArea { clicked => { root.form-type = "agent"; } }
                            Text {
                                text: @tr("SSH Agent");
                                font-size: 10px;
                                font-weight: root.form-type == "agent" ? 600 : 400;
                                color: root.form-type == "agent" ? AppTheme.foreground : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 2.3 详细表单内容区 (ScrollView)
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        padding-right: 8px;

                        // 凭据显示名称
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text {
                                text: @tr("凭据显示名称 *");
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: ((root.is-create-mode || root.is-editing) && name-in.has-focus) ? AppTheme.accent : AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    name-in := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.form-name;
                                        enabled: root.is-create-mode || root.is-editing;
                                        font-size: 11px;
                                        color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 凭据类型专属表单
                        if root.form-type == "key": CredentialKeyForm {
                            is-create-mode: root.is-create-mode;
                            is-editing: root.is-editing;
                            show-full-private-key <=> root.show-full-private-key;
                            reveal-passphrase <=> root.reveal-passphrase;
                            form-algorithm <=> root.form-algorithm;
                            form-secret-data <=> root.form-secret-data;
                            form-passphrase <=> root.form-passphrase;
                            form-public-key <=> root.form-public-key;
                            form-fingerprint <=> root.form-fingerprint;
                            generate-key(algo) => { CredentialsBridge.generate-key-pair(algo); }
                            copy-text(t, title, msg) => { CredentialsBridge.copy-custom-text(t, title, msg); }
                        }

                        if root.form-type == "password": CredentialPasswordForm {
                            is-create-mode: root.is-create-mode;
                            is-editing: root.is-editing;
                            reveal-password <=> root.reveal-password;
                            form-username <=> root.form-username;
                            form-secret-data <=> root.form-secret-data;
                            generate-password => { CredentialsBridge.generate-strong-password(); }
                        }

                        if root.form-type == "agent": CredentialAgentForm {
                            is-create-mode: root.is-create-mode;
                            is-editing: root.is-editing;
                            form-name <=> root.form-name;
                            form-algorithm <=> root.form-algorithm;
                            form-secret-data <=> root.form-secret-data;
                            form-notes <=> root.form-notes;
                        }

                        // 备注说明 (通用)
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text {
                                text: @tr("备注说明");
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: ((root.is-create-mode || root.is-editing) && notes-in.has-focus) ? AppTheme.accent : AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    notes-in := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.form-notes;
                                        enabled: root.is-create-mode || root.is-editing;
                                        font-size: 11px;
                                        color: (root.is-create-mode || root.is-editing) ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
