import { CredentialItemData } from "./credentials_model.slint";

export { CredentialItemData }

/// 凭据保管与密钥管理领域全局状态总线 (Credentials Bridge)
export global CredentialsBridge {
    // 列表与过滤
    in-out property <[CredentialItemData]> credentials: [];
    in-out property <string> credential-filter-category: "all";
    in-out property <string> credential-search-query: "";
    in-out property <string> active-credential-id: "";

    // 详情表单与编辑状态
    in-out property <bool> is-credential-create-mode: false;
    in-out property <bool> is-credential-editing: false;
    in-out property <string> credential-form-id: "";
    in-out property <string> credential-form-name: "";
    in-out property <string> credential-form-type: "key";
    in-out property <string> credential-form-algorithm: "Ed25519";
    in-out property <string> credential-form-username: "root";
    in-out property <string> credential-form-secret-data: "";
    in-out property <string> credential-form-passphrase: "";
    in-out property <string> credential-form-public-key: "";
    in-out property <string> credential-form-fingerprint: "";
    in-out property <string> credential-form-notes: "";
    in-out property <int> credential-form-bound-host-count: 0;
    in-out property <string> credential-form-updated-at: "";

    // 交互回调
    callback select-credential(string /* id */);
    callback filter-category(string /* category */);
    callback search-changed(string /* query */);
    callback create-new-credential(string /* cred_type */);
    callback open-create-credential-modal();
    callback cancel-create-credential();
    callback start-edit-credential();
    callback cancel-edit-credential();
    callback save-credential(
        string /* id */,
        string /* name */,
        string /* cred_type */,
        string /* algorithm */,
        string /* username */,
        string /* secret_data */,
        string /* passphrase */,
        string /* public_key */,
        string /* fingerprint */,
        string /* notes */
    );
    callback delete-credential(string /* id */);
    callback copy-secret-to-clipboard(string /* id */, string /* field */);
    callback copy-custom-text(string /* text */, string /* title */, string /* msg */);
    callback generate-key-pair(string /* algorithm */);
    callback generate-strong-password();
}
