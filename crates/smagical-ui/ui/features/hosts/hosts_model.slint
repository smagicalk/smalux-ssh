/// 主机项数据结构 (Host Item Data)
///
/// 专用于卡片列表平铺视图模式的数据模型。
export struct HostItemData {
    /// 主机全局唯一标识符
    id: string,
    /// 主机名称 (如 "prod-server-01")
    name: string,
    /// 主机 IP 地址或可解析域名
    address: string,
    /// SSH 服务连接端口 (默认为 22)
    port: int,
    /// 所属分组的显示名称 (如 "生产集群")
    group: string,
    /// 主机运行健康状态 ("online": 在线, "warning": 告警, "error": 异常, "offline": 离线)
    status: string,
    /// 网络延迟测速结果 (单位毫秒)
    ping-ms: int,
}

/// 树形结构节点模型 (Host Tree Node)
///
/// 专用于树状层级折叠视图模式的数据模型，支持无限层级嵌套。
export struct HostTreeNode {
    /// 节点的唯一标识符
    id: string,
    /// 节点的显示名称 (如 "Kubernetes 集群" 或 "k8s-control-plane")
    name: string,
    /// 当前节点是否为分组文件夹 (true: 分组, false: 主机资产)
    is-group: bool,
    /// 父级分组的 ID (顶级根节点为空字符串 "")
    parent-id: string,
    /// 树形层级深度，用于计算左侧缩进 (缩进 = level * 14px)
    level: int,
    /// 当前分组是否处于展开状态 (仅 is-group 为 true 时有效)
    is-expanded: bool,
    /// 主机 IP 地址 (仅主机节点有效)
    address: string,
    /// 连接端口 (仅主机节点有效)
    port: int,
    /// 在线健康状态 ("online", "warning", "error", "offline")
    status: string,
    /// 网络延迟 (毫秒)
    ping-ms: int,
    /// 分组文件夹内包含的主机数量 (仅 is-group 为 true 时有效)
    item-count: int,
}
