import { HostItemData, HostTreeNode } from "./hosts_model.slint";
import { GroupOptionData } from "../../components/create-group-modal.slint";

export { HostItemData, HostTreeNode }

/// 主机与资产树领域全局状态总线 (Hosts & Assets Bridge)
export global HostsBridge {
    // 状态属性
    in-out property <[HostTreeNode]> tree-nodes: [];
    in-out property <[HostItemData]> hosts: [];
    in-out property <string> hosts-view-mode: "tree";
    in-out property <length> tree-content-width: 240px;
    in-out property <string> selected-host-id: "";
    in-out property <string> search-query: "";
    in-out property <bool> is-create-group-open: false;
    in-out property <string> create-group-default-parent: "root";
    in-out property <[GroupOptionData]> group-options: [];
    in-out property <length> left-drawer-width: 240px;

    // 拖拽悬停状态
    in-out property <string> drop-target-id: "";
    in-out property <int> drop-target-index: -1;
    in-out property <string> drop-position: "none";
    in-out property <bool> drop-target-valid: false;

    // 交互回调
    callback select-host(string /* id */);
    callback open-host(string /* id */);
    callback toggle-group(string /* id */);
    callback toggle-selector-group(string /* id */);
    callback move-node(string /* source_id */, string /* target_id */, string /* drop_pos */);
    callback request-drag-hover(string /* source_id */, int /* target_index */, float /* offset_in_row */);
    callback create-group(string /* parent_id */, string /* name */);
    callback delete-node(string /* id */, bool /* is_group */);
    callback create-new-host();
    callback create-new-group();
    callback search-changed(string /* query */);
    callback switch-view-mode(string /* mode */);
    callback close-group-modal();
}
