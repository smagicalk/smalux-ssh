import { FileItemData, FileTabData, TransferItemData } from "./file_explorer_model.slint";

export { FileItemData, FileTabData, TransferItemData }

/// 双盘文件管理与 SFTP 传输领域全局状态总线 (Files Bridge)
export global FilesBridge {
    // 布局与分屏
    in-out property <float> split-ratio: 0.5;

    // 本地与远程 Tab 序列
    in-out property <[FileTabData]> local-tabs: [];
    in-out property <string> active-local-tab-id: "";
    in-out property <[FileTabData]> remote-tabs: [];
    in-out property <string> active-remote-tab-id: "";

    // 路径与文件数据
    in-out property <string> local-current-path: "";
    in-out property <string> remote-current-path: "";
    in-out property <[FileItemData]> local-files: [];
    in-out property <[FileItemData]> remote-files: [];
    in-out property <string> selected-local-id: "";
    in-out property <string> selected-remote-id: "";

    // 传输任务与队列
    in-out property <[TransferItemData]> transfer-tasks: [];
    in-out property <bool> is-transfer-queue-expanded: false;

    // 导航历史状态
    in-out property <bool> local-can-go-back: false;
    in-out property <bool> local-can-go-forward: false;
    in-out property <bool> remote-can-go-back: false;
    in-out property <bool> remote-can-go-forward: false;

    // 交互回调
    callback select-local-tab(string /* tab_id */);
    callback close-local-tab(string /* tab_id */);
    callback new-local-tab();
    callback select-remote-tab(string /* tab_id */);
    callback close-remote-tab(string /* tab_id */);
    callback new-remote-tab();
    callback reorder-local-tab(int /* from_index */, int /* to_index */);
    callback reorder-remote-tab(int /* from_index */, int /* to_index */);

    callback navigate-local-path(string /* path */);
    callback navigate-remote-path(string /* path */);
    callback navigate-local-up();
    callback navigate-remote-up();
    callback navigate-local-back();
    callback navigate-local-forward();
    callback navigate-remote-back();
    callback navigate-remote-forward();

    callback refresh-local();
    callback refresh-remote();
    callback open-local-item(string /* path */, bool /* is_dir */);
    callback open-remote-item(string /* path */, bool /* is_dir */);
    callback toggle-local-expand(string /* path */);
    callback toggle-remote-expand(string /* path */);

    callback start-transfer-task(string /* direction */, string /* source_path */, string /* filename */, bool /* is_dir */, string /* target_path */);
    callback toggle-transfer-expand(string /* task_id */);
    callback clear-completed-transfers();
    callback transfer-action(string /* action */, string /* task_id */);
    callback file-action(string /* action */, bool /* is_remote */, string /* path */, string /* name */, bool /* is_dir */);
    callback copy-to-clipboard(string /* text */);
}
