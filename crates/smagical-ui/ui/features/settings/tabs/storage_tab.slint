import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge, BackupTaskItem } from "../settings_bridge.slint";
import {
    SettingsPageHeader,
    SettingsSectionCard,
    SettingsRow,
    SettingsSwitch,
} from "../components/settings_widgets.slint";
import { AppButton, AppIconButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";

export component SettingsStorageTab inherits VerticalLayout {
    spacing: 16px;

    SettingsPageHeader {
        title: @tr("数据备份、跨工具迁移与多端容灾");
        subtitle: @tr("本地全量加密备份/还原、多端容灾备份节点管理 (本地目录 / WebDAV / S3 / Gist / 自建服务) 与镜像版本回退");
        icon: @image-url("../../../assets/icons/archive.svg");
    }

    // 卡片 1: 本地全量加密备份与恢复
    SettingsSectionCard {
        title: @tr("本地全量加密备份与快速还原");
        subtitle: @tr("导出或导入所有主机资产、分组层级树、凭据保管箱、常用代码片段与网络隧道规则");
        icon: @image-url("../../../assets/icons/archive.svg");

        SettingsRow {
            title: @tr("导出全量加密备份文件 (.smalux / .json)");
            subtitle: @tr("打包所有资产与偏好设置，数据经客户端端到端高强度加密保护");

            AppButton {
                text: @tr("立即导出备份包");
                variant: "primary";
                has-icon: true;
                icon: @image-url("../../../assets/icons/download.svg");
                clicked => { SettingsBridge.export-backup-archive(true); }
            }
        }

        SettingsRow {
            title: @tr("从本地加密备份包还原资产 (Restore Backup)");
            subtitle: @tr("选择本机已导出的 .smalux 备份文件，输入解密口令无损恢复全部资产");
            show-border: false;

            AppButton {
                text: @tr("选择备份包还原...");
                variant: "secondary";
                has-icon: true;
                icon: @image-url("../../../assets/icons/upload.svg");
                clicked => { SettingsBridge.import-external-file(); }
            }
        }
    }

    // 卡片 2: 自动化备份与多端节点容灾中心 (弹窗创建 + 表格列表)
    SettingsSectionCard {
        title: @tr("自动化备份与多端容灾节点管理");
        subtitle: @tr("配置本地目录增量快照或远程云端多节点容灾，支持独立生命周期管理与镜像还原");
        icon: @image-url("../../../assets/icons/server.svg");

        // 顶层全局开关模式 (默认: 关闭备份)
        SettingsRow {
            title: @tr("备份与同步总策略 (Backup Mode)");
            subtitle: @tr("选择停用自动化备份，或启用本地自动增量归档、多端节点并发容灾");

            Rectangle {
                height: 28px;
                border-radius: AppTheme.radius-medium;
                background: AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    for bm in [
                        { id: "off", name: @tr("关闭备份") },
                        { id: "local", name: @tr("本地备份") },
                        { id: "cloud", name: @tr("多端云同步") }
                    ]: Rectangle {
                        property <bool> is-selected: SettingsBridge.setting-backup-master-mode == bm.id;
                        border-radius: AppTheme.radius-small;
                        background: is-selected ? AppTheme.accent : bm-t.has-hover ? AppTheme.hover-background : transparent;
                        animate background { duration: 120ms; }

                        bm-t := TouchArea {
                            clicked => {
                                SettingsBridge.setting-backup-master-mode = bm.id;
                                SettingsBridge.set-backup-master-mode(bm.id);
                            }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: bm.name;
                                font-size: 11px;
                                font-weight: is-selected ? 700 : 500;
                                color: is-selected ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 仅在非关闭备份状态下显示节点管理表格
        if SettingsBridge.setting-backup-master-mode != "off": VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // 表格上方操作条
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: @tr("已配置的备份节点与同步任务");
                        font-size: 12px;
                        font-weight: 700;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 18px;
                        border-radius: 9px;
                        background: AppTheme.control-background;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: SettingsBridge.backup-tasks.length + " " + @tr("个节点");
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 新建备份任务按钮 (带真实 SVG 加号图标)
                AppButton {
                    text: @tr("新建备份任务");
                    size: "sm";
                    variant: "primary";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/plus.svg");
                    clicked => {
                        SettingsBridge.is-create-backup-modal-open = true;
                    }
                }
            }

            // 表格容器
            Rectangle {
                border-radius: 6px;
                background: AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;
                clip: true;

                VerticalLayout {
                    spacing: 0px;

                    // 表头 (从左到右: 名称, 类型, 最后备份时间, 镜像数量, 策略, 启用, 操作)
                    Rectangle {
                        height: 30px;
                        background: AppTheme.surface-background.darker(8%);
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: 100%;
                            background: AppTheme.border;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text { text: @tr("任务名称"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 150px; }
                            Text { text: @tr("类型"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 80px; }
                            Text { text: @tr("最后备份时间"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 130px; }
                            Text { text: @tr("镜像数量"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 70px; }
                            Text { text: @tr("调度策略"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 90px; }
                            Text { text: @tr("启用"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 50px; horizontal-alignment: center; }
                            Text { text: @tr("操作"); font-size: 10px; font-weight: 700; color: AppTheme.secondary-foreground; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
                        }
                    }

                    // 空状态
                    if SettingsBridge.backup-tasks.length == 0: VerticalLayout {
                        alignment: center;
                        padding: 32px;
                        spacing: 8px;

                        Text {
                            text: @tr("暂无配置的备份任务节点");
                            font-size: 12px;
                            font-weight: 600;
                            color: AppTheme.foreground;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("点击右上角「新建备份任务」创建本地文件夹同步或云端 WebDAV / S3 / Gist 存储");
                            font-size: 10px;
                            color: AppTheme.disabled-foreground;
                            horizontal-alignment: center;
                        }
                    }

                    // 表格数据行
                    for task[tidx] in SettingsBridge.backup-tasks: Rectangle {
                        height: 42px;
                        background: Math.mod(tidx, 2) == 1 ? AppTheme.surface-background.transparentize(50%) : transparent;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: 100%;
                            background: AppTheme.border.transparentize(80%);
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            // 1. 名称
                            VerticalLayout {
                                width: 150px;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: task.name;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    overflow: elide;
                                }
                                if task.endpoint != "": Text {
                                    text: task.endpoint;
                                    font-size: 9px;
                                    color: AppTheme.disabled-foreground;
                                    overflow: elide;
                                }
                            }

                            // 2. 类型徽章
                            VerticalLayout {
                                width: 80px;
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    border-radius: 3px;
                                    background: AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        alignment: center;
                                        Text {
                                            text: task.backup-type == "local" ? @tr("本地磁盘") :
                                                  task.backup-type == "webdav" ? "WebDAV" :
                                                  task.backup-type == "s3" ? "S3" :
                                                  task.backup-type == "gist" ? "Gist" : @tr("自建");
                                            font-size: 9px;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 3. 最后备份时间
                            Text {
                                text: task.last-backup-time != "" ? task.last-backup-time : @tr("从未执行");
                                font-size: 10px;
                                color: task.last-backup-time != "" ? AppTheme.secondary-foreground : AppTheme.disabled-foreground;
                                vertical-alignment: center;
                                width: 130px;
                            }

                            // 4. 镜像数量
                            Text {
                                text: task.snapshot-count + " " + @tr("个版本");
                                font-size: 10px;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                                width: 70px;
                            }

                            // 5. 调度策略
                            Text {
                                text: task.strategy == "daily" ? @tr("每天定时") :
                                      task.strategy == "hourly" ? @tr("每小时") :
                                      task.strategy == "on_exit" ? @tr("软件退出时") : @tr("手动同步");
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                                width: 90px;
                            }

                            // 6. 启用开关
                            HorizontalLayout {
                                width: 50px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    SettingsSwitch {
                                        checked: task.enabled;
                                        toggled(c) => {
                                            SettingsBridge.toggle-backup-task-enabled(task.id, c);
                                        }
                                    }
                                }
                            }

                            // 7. 操作列 (在最右端：镜像列表与还原按钮、删除按钮)
                            HorizontalLayout {
                                width: 70px;
                                alignment: end;
                                spacing: 4px;

                                // 镜像列表与版本还原按钮
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: snap-btn-t.has-hover ? AppTheme.hover-background : transparent;
                                    snap-btn-t := TouchArea {
                                        clicked => {
                                            SettingsBridge.open-task-snapshots(task.id, task.name);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                    Image {
                                        source: @image-url("../../../assets/icons/archive.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: snap-btn-t.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                // 删除该任务按钮
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: del-btn-t.has-hover ? AppTheme.danger.transparentize(85%) : transparent;
                                    del-btn-t := TouchArea {
                                        clicked => {
                                            SettingsBridge.delete-backup-task(task.id);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                    Image {
                                        source: @image-url("../../../assets/icons/trash.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: del-btn-t.has-hover ? AppTheme.danger : AppTheme.secondary-foreground;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 卡片 3: 立即全量双向同步操作 (全部使用真实 SVG 矢量图标)
    if SettingsBridge.setting-backup-master-mode != "off": SettingsSectionCard {
        title: @tr("立即执行全量容灾备份与检测");
        subtitle: @tr("测试各备份节点网络连通性、立即推送最新增量快照或从远端拉取覆盖本地资产");
        icon: @image-url("../../../assets/icons/refresh.svg");

        SettingsRow {
            title: @tr("双向同步与全节点容灾调度");
            subtitle: @tr("立即触发所有已启用备份节点的上传与校验任务");
            show-border: false;

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    text: @tr("测试全节点连通性");
                    variant: "secondary";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/server.svg");
                    clicked => { }
                }

                AppButton {
                    text: @tr("立即增量同步");
                    variant: "primary";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/download.svg");
                    clicked => { }
                }

                AppButton {
                    text: @tr("从远端拉取覆盖");
                    variant: "secondary";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/upload.svg");
                    clicked => { }
                }
            }
        }
    }
}
