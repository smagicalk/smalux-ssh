import { AppTheme } from "../../themes/app-theme.slint";
import { AppVScrollBar } from "../../components/base/app-scroll-bar.slint";
import { ThemeOption, ThemeRow } from "../../views/left_drawers/settings_drawer.slint";
import {
    SettingsBridge,
    KeywordHighlightRule,
    SettingKeybindingItem,
    SettingSnapshotItem,
} from "./settings_bridge.slint";

import { CategoryNavButton } from "./components/settings_widgets.slint";
import { KeywordRuleModal } from "./components/keyword_rule_modal.slint";
import { MasterPasswordModal } from "./components/master_pwd_modal.slint";

import { SettingsGeneralTab } from "./tabs/general_tab.slint";
import { SettingsAppearanceTab } from "./tabs/appearance_tab.slint";
import { SettingsTerminalTab } from "./tabs/terminal_tab.slint";
import { SettingsNetworkTab } from "./tabs/network_tab.slint";
import { SettingsFilesTab } from "./tabs/files_tab.slint";
import { SettingsKeybindingsTab } from "./tabs/keybindings_tab.slint";
import { SettingsStorageTab } from "./tabs/storage_tab.slint";
import { SettingsSecurityTab } from "./tabs/security_tab.slint";

export { SettingKeybindingItem, SettingSnapshotItem, KeywordHighlightRule }
export { ThemeOption, ThemeRow }

/// 全屏偏好设置中心视图 (SettingsCenterView)
/// 彻底轻量化容器：仅管理顶部操作栏、左侧分类导航与多态内容路由
export component SettingsCenterView inherits Rectangle {
    // -------------------------------------------------------------------------
    // 界面结构渲染 (Layout)
    // -------------------------------------------------------------------------
    background: AppTheme.window-background;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // 1. 顶部 Header 导航条 (54px)
        Rectangle {
            width: 100%;
            height: 54px;
            background: AppTheme.panel-background;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/settings.svg");
                            width: 20px;
                            height: 20px;
                            colorize: AppTheme.accent;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: @tr("偏好设置");
                            font-size: 15px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                        }
                        Text {
                            text: @tr("自定义终端外观、网络连接、快捷键与全量数据备份策略");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                        }
                    }
                }

                // 右侧关闭按钮
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 6px;
                    background: close-touch.has-hover ? AppTheme.hover-background : transparent;

                    close-touch := TouchArea {
                        clicked => {
                            SettingsBridge.close-settings();
                        }
                        mouse-cursor: pointer;
                    }

                    Image {
                        source: @image-url("../../assets/icons/window-close.svg");
                        width: 16px;
                        height: 16px;
                        colorize: close-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: AppTheme.border;
            }
        }

        // 2. 主体双栏区域
        HorizontalLayout {
            vertical-stretch: 1;
            width: 100%;
            spacing: 0px;

            // 2.1 左侧固定宽导航菜单 (220px)
            Rectangle {
                width: 220px;
                background: AppTheme.panel-background;
                clip: true;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: AppTheme.border;
                }

                nav-scroll := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: nav-content.preferred-height;

                    nav-content := VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 3px;

                        CategoryNavButton {
                            text: @tr("通用与窗口");
                            icon: @image-url("../../assets/icons/home.svg");
                            is-active: SettingsBridge.active-category == "general";
                            clicked => { SettingsBridge.active-category = "general";  }
                        }

                        CategoryNavButton {
                            text: @tr("外观与视效");
                            icon: @image-url("../../assets/icons/sun.svg");
                            is-active: SettingsBridge.active-category == "appearance";
                            clicked => { SettingsBridge.active-category = "appearance";  }
                        }

                        CategoryNavButton {
                            text: @tr("终端首选项");
                            icon: @image-url("../../assets/icons/terminal.svg");
                            is-active: SettingsBridge.active-category == "terminal";
                            clicked => { SettingsBridge.active-category = "terminal";  }
                        }

                        CategoryNavButton {
                            text: @tr("网络连接与代理");
                            icon: @image-url("../../assets/icons/tunnel.svg");
                            is-active: SettingsBridge.active-category == "network";
                            clicked => { SettingsBridge.active-category = "network";  }
                        }

                        CategoryNavButton {
                            text: @tr("传输与文件管理");
                            icon: @image-url("../../assets/icons/folder.svg");
                            is-active: SettingsBridge.active-category == "files";
                            clicked => { SettingsBridge.active-category = "files";  }
                        }

                        CategoryNavButton {
                            text: @tr("快捷键绑定");
                            icon: @image-url("../../assets/icons/key.svg");
                            is-active: SettingsBridge.active-category == "shortcuts";
                            clicked => { SettingsBridge.active-category = "shortcuts";  }
                        }

                        CategoryNavButton {
                            text: @tr("数据备份与同步");
                            icon: @image-url("../../assets/icons/archive.svg");
                            is-active: SettingsBridge.active-category == "backup";
                            show-dot: true;
                            clicked => { SettingsBridge.active-category = "backup";  }
                        }

                        CategoryNavButton {
                            text: @tr("安全与高级诊断");
                            icon: @image-url("../../assets/icons/shield.svg");
                            is-active: SettingsBridge.active-category == "security";
                            clicked => { SettingsBridge.active-category = "security";  }
                        }
                    }
                }

                AppVScrollBar {
                    viewport-height: nav-scroll.viewport-height;
                    visible-height: nav-scroll.height;
                    viewport-y <=> nav-scroll.viewport-y;
                }
            }

            // 2.2 右侧设置内容流 (100% 占满)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                clip: true;

                scroll-area := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: list-content.preferred-height;

                    list-content := VerticalLayout {
                        width: 100%;
                        padding-top: 14px;
                        padding-bottom: 32px;
                        padding-left: 24px;
                        padding-right: 28px;
                        spacing: 0px;

                        if SettingsBridge.active-category == "general": SettingsGeneralTab { width: 100%; }
                        if SettingsBridge.active-category == "appearance": SettingsAppearanceTab { width: 100%; }
                        if SettingsBridge.active-category == "terminal": SettingsTerminalTab { width: 100%; }
                        if SettingsBridge.active-category == "network": SettingsNetworkTab { width: 100%; }
                        if SettingsBridge.active-category == "files": SettingsFilesTab { width: 100%; }
                        if SettingsBridge.active-category == "shortcuts": SettingsKeybindingsTab { width: 100%; }
                        if SettingsBridge.active-category == "backup": SettingsStorageTab { width: 100%; }
                        if SettingsBridge.active-category == "security": SettingsSecurityTab { width: 100%; }
                    }
                }

                AppVScrollBar {
                    viewport-height: scroll-area.viewport-height;
                    visible-height: scroll-area.height;
                    viewport-y <=> scroll-area.viewport-y;
                }
            }
        }
    }

    // 3. 全屏模态弹窗 (Modals)
    KeywordRuleModal {}
    MasterPasswordModal {}
}
