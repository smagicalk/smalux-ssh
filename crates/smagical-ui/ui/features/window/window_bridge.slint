import { ActivityBarItemData } from "../../views/left_activity_bar.slint";
import { LogEntryData } from "../../components/debug_workbench/debug-logs-tab.slint";
import { LocalShellItemData } from "../../components/new-session-modal.slint";
import { ToastItemData } from "../../components/toast.slint";
import { HostItemData } from "../hosts/hosts_bridge.slint";

export { ActivityBarItemData, LogEntryData, LocalShellItemData, ToastItemData, HostItemData }

/// 应用窗口、布局导航与全局框架总线 (Window & Navigation Bridge)
export global WindowBridge {
    // 基础导航状态
    in-out property <string> active-left-tab: "hosts";
    in-out property <bool> is-left-drawer-open: true;
    in-out property <string> active-right-tool: "monitor";
    in-out property <bool> is-right-drawer-open: false;
    in-out property <string> main-view: "terminal"; // "terminal" | "history" | "files" | "credentials" | "snippets" | "tunnels" | "settings"

    // 布局与抽屉尺寸 (支持鼠标拖拽持久保存)
    in-out property <length> left-drawer-width: 240px;
    in-out property <length> right-drawer-width: 240px;

    // 窗口与系统控制
    in-out property <bool> is-window-maximized: false;
    in-out property <bool> is-dark-mode: true;
    in-out property <string> current-theme-name: "Darcula";
    in-out property <string> current-theme-id: "builtin.ui.darcula";
    in-out property <string> current-language: "zh-CN";
    in-out property <string> active-rendering-pipeline: "winit-skia";

    // 模态弹窗状态
    in-out property <bool> is-command-palette-open: false;
    in-out property <bool> is-debug-modal-open: false;
    in-out property <bool> is-new-session-modal-open: false;
    in-out property <bool> is-debug-enabled: true;
    in-out property <bool> is-log-capture-enabled: true;

    // 快速启动器环境与主机列表
    in-out property <[LocalShellItemData]> launcher-local-items: [];
    in-out property <[HostItemData]> launcher-host-items: [];

    // 动态菜单、调试日志与气泡列表
    in-out property <[ActivityBarItemData]> top-activity-items: [];
    in-out property <[ActivityBarItemData]> bottom-activity-items: [];
    in-out property <[LogEntryData]> debug-logs: [];
    in-out property <[ToastItemData]> toasts: [];
    in-out property <string> toast-position: "top-right";

    // 壁纸与外观定制属性
    in-out property <string> wallpaper-mode: "none"; // "none" | "global" | "terminal"
    in-out property <string> wallpaper-path: "";
    in-out property <image> global-wallpaper-image;
    in-out property <float> global-wallpaper-opacity: 0.15;
    in-out property <image> terminal-wallpaper-image;
    in-out property <float> terminal-wallpaper-opacity: 0.20;
    in-out property <image> prev-wallpaper-image;
    in-out property <float> wallpaper-crossfade: 1.0;
    in-out property <float> setting-modal-opacity: 1.0;
    in-out property <string> terminal-font-family: "JetBrains Mono";
    in-out property <float> terminal-font-size: 14.0;

    // 二次确认防呆弹窗
    in-out property <bool> is-exit-confirm-open: false;
    in-out property <bool> is-restart-confirm-open: false;
    in-out property <string> restart-confirm-message: "";

    // 通用消息与错误提示弹窗
    in-out property <bool> is-dialog-open: false;
    in-out property <string> dialog-title: "提示";
    in-out property <string> dialog-message: "";
    in-out property <string> dialog-type: "error"; // "error" | "warning" | "info"

    // 导航与抽屉控制回调
    callback switch-left-tab(string /* tab_id */);
    callback toggle-left-drawer();
    callback switch-right-tool(string /* tool_id */);
    callback toggle-right-drawer();
    callback switch-main-view(string /* view_id */);
    callback navigate-to(string /* target_tab */, string /* section */);

    // 弹窗启闭控制回调
    callback open-command-palette();
    callback close-command-palette();
    callback open-debug-modal();
    callback close-debug-modal();
    callback open-new-session-modal();
    callback close-new-session-modal();
    callback filter-launcher(string /* query */);

    // 系统与窗口控制回调
    callback minimize-window();
    callback maximize-window();
    callback close-window();
    callback force-close-window();
    callback start-window-drag();
    callback start-window-resize(string /* direction */);
    callback toggle-color-mode();
    callback switch-language(string /* lang */);
    callback toggle-debug-enabled(bool /* enabled */);
    callback close-toast(string /* id */);

    // 主题与壁纸控制回调
    callback set-wallpaper(string /* mode */, string /* image_path */, float /* opacity */);
    callback set-terminal-font(string /* font_name_or_path */, float /* font_size */);
    callback set-terminal-theme(string /* theme_id */);
    callback switch-theme(string /* theme_id */);
    callback confirm-restart-pipeline();
    callback cancel-restart-pipeline();
}
