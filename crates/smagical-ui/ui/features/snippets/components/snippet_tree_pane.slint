// =============================================================================
// 文件名称: snippet_tree_pane.slint
// 模块功能: 代码片段树形左侧导航面板 (Snippet Tree Pane)
// 包含多层文件夹/脚本树、拖拽移动排序、折叠展开、搜索与新建操作
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SearchInput } from "../../../components/search-input.slint";
import { AppIconButton } from "../../../components/base/app-icon-button.slint";
import { SnippetTreeNode } from "../snippets_model.slint";

export component SnippetTreePane inherits Rectangle {
    in property <[SnippetTreeNode]> tree_nodes: [];
    in-out property <string> search_query: "";
    in-out property <string> selected_id: "";

    // 拖拽交互状态
    in-out property <bool> is_dragging: false;
    in-out property <string> drag_source_id: "";
    in-out property <string> drag_source_name: "";
    in-out property <bool> drag_source_is_group: false;
    in-out property <string> drop_target_id: "";
    in-out property <string> drop_target_name: "";
    in-out property <int> drop_target_index: -1;
    in-out property <string> drop_position: "inside";
    in-out property <bool> drop_target_valid: false;
    in-out property <length> drag_x: 0px;
    in-out property <length> drag_y: 0px;

    // 回调事件
    callback search_changed(string);
    callback toggle_group_expanded(string /* group_id */);
    callback select_node(string /* id */, bool /* is_group */);
    callback toggle_favorite(string /* id */);
    callback create_snippet;
    callback create_group;
    callback move_node(string /* source_id */, string /* target_id */, string /* drop_position */);
    callback request_drag_hover(string /* source_id */, int /* target_index */, float /* offset_in_row */);

    width: 320px;
    background: AppTheme.panel-background;

    // 右侧分割线
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: AppTheme.border;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // 1. 顶部统一检索框
        SearchInput {
            text <=> root.search_query;
            placeholder: @tr("搜索代码片段、脚本或文件夹...");
            changed(text) => { root.search_changed(text); }
        }

        // 2. 标题与操作栏 (层级统计 + 新建分组 + 新建片段)
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            alignment: space-between;
            height: 24px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: @tr("代码片段树形视图");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 16px;
                    border-radius: 8px;
                    background: AppTheme.control-background;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;

                        Text {
                            text: root.tree_nodes.length + " " + @tr("项");
                            font-size: 9px;
                            font-weight: 600;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 新建分组与片段动作按钮组
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                AppIconButton {
                    icon: @image-url("../../../assets/icons/folder-plus.svg");
                    clicked => { root.create_group(); }
                }

                AppIconButton {
                    icon: @image-url("../../../assets/icons/plus.svg");
                    clicked => { root.create_snippet(); }
                }
            }
        }

        // 3. 拖拽时的顶级根目录放置区
        if root.is_dragging: Rectangle {
            height: 28px;
            border-radius: 4px;
            background: root.drop_target_id == "root" ? AppTheme.accent.transparentize(70%) : AppTheme.control-background;
            border-width: 1.5px;
            border-color: root.drop_target_id == "root" ? AppTheme.accent : AppTheme.border;
            animate background { duration: 120ms; }
            animate border-color { duration: 120ms; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/icons/folder.svg");
                        width: 13px;
                        height: 13px;
                        image-fit: contain;
                        colorize: root.drop_target_id == "root" ? AppTheme.accent : AppTheme.secondary-foreground;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("移至根目录 (顶级)");
                        font-size: 11px;
                        font-weight: 600;
                        color: root.drop_target_id == "root" ? AppTheme.accent : AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 4. 树节点滚动列表
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            snippet_scroll := ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 2px;

                    for node[idx] in root.tree_nodes: Rectangle {
                        height: 30px;
                        border-radius: AppTheme.radius-small;
                        opacity: (root.is_dragging && node.id == root.drag_source_id) ? 0.35 : 1.0;
                        background: (node.is_group && root.is_dragging && root.drop_target_index == idx && root.drop_target_valid) 
                            ? AppTheme.accent.transparentize(85%)
                            : (node.id == root.selected_id) 
                                ? AppTheme.control-background 
                                : (item-touch.has-hover ? AppTheme.hover-background.transparentize(40%) : transparent);
                        border-width: 1px;
                        border-color: (node.is_group && root.is_dragging && root.drop_target_index == idx && root.drop_target_valid)
                            ? AppTheme.accent.transparentize(40%)
                            : (node.id == root.selected_id ? AppTheme.border : transparent);

                        animate background { duration: root.is_dragging ? 0ms : 120ms; }
                        animate opacity { duration: root.is_dragging ? 0ms : 120ms; }

                        item-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.drag_source_id = node.id;
                                    root.drag_source_name = node.name;
                                    root.drag_source_is_group = node.is_group;
                                    root.is_dragging = false;
                                    root.drop_target_index = -1;
                                }
                                if event.kind == PointerEventKind.up {
                                    if root.is_dragging && root.drop_target_valid && root.drop_target_id != "" {
                                        if root.drop_target_id == "root" {
                                            root.move_node(root.drag_source_id, "root", "root");
                                        } else if (root.drop_target_id != root.drag_source_id || root.drop_position != "inside") {
                                            root.move_node(root.drag_source_id, root.drop_target_id, root.drop_position);
                                        }
                                    }
                                    root.is_dragging = false;
                                    root.drag_source_id = "";
                                    root.drop_target_id = "";
                                    root.drop_target_name = "";
                                    root.drop_target_index = -1;
                                    root.drop_position = "inside";
                                }
                                if event.kind == PointerEventKind.cancel {
                                    root.is_dragging = false;
                                    root.drag_source_id = "";
                                    root.drop_target_id = "";
                                    root.drop_target_name = "";
                                    root.drop_target_index = -1;
                                    root.drop_position = "inside";
                                }
                            }
                            moved => {
                                if self.pressed {
                                    if Math.abs(self.mouse-x - self.pressed-x) > 3px || Math.abs(self.mouse-y - self.pressed-y) > 3px {
                                        root.is_dragging = true;
                                        root.drag_source_id = node.id;
                                        root.drag_source_name = node.name;
                                        root.drag_source_is_group = node.is_group;
                                        root.drag_x = self.mouse-x;
                                        let total_y = idx * 32px + self.mouse-y;
                                        root.drag_y = total_y;

                                        let screen_y = total_y + snippet_scroll.viewport-y;
                                        if screen_y < 16px {
                                            root.drop_target_index = -1;
                                            root.drop_target_id = "root";
                                            root.drop_position = "root";
                                            root.drop_target_valid = true;
                                            root.request_drag_hover(root.drag_source_id, -1, 0.0);
                                        } else {
                                            let target_idx = Math.max(0, Math.min(root.tree_nodes.length - 1, Math.floor(total_y / 32px)));
                                            root.drop_target_index = target_idx;
                                            root.drop_target_valid = (target_idx != idx || root.tree_nodes[target_idx].id != node.id);
                                            root.request_drag_hover(root.drag_source_id, target_idx, 0.0);
                                        }
                                    }
                                }
                            }
                            clicked => {
                                if !root.is_dragging {
                                    if node.is_group {
                                        root.toggle_group_expanded(node.id);
                                    }
                                    root.select_node(node.id, node.is_group);
                                }
                            }
                        }

                        // 行内元素水平布局
                        HorizontalLayout {
                            padding-left: 8px + (node.level * 14px);
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: start;

                            // 展开/折叠箭头 (仅分组展示)
                            if node.is_group: VerticalLayout {
                                alignment: center;
                                width: 14px;
                                height: 14px;

                                Image {
                                    source: node.is_expanded 
                                        ? @image-url("../../../assets/icons/chevron-down.svg")
                                        : @image-url("../../../assets/icons/chevron-right.svg");
                                    width: 10px;
                                    height: 10px;
                                    image-fit: contain;
                                    colorize: AppTheme.secondary-foreground;
                                }
                            }

                            // 占位留白 (叶子节点无箭头，保持对齐)
                            if !node.is_group: Rectangle {
                                width: 14px;
                                height: 14px;
                            }

                            // 图标 (分组文件夹 vs 脚本文件)
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: node.is_group 
                                        ? (node.is_expanded ? @image-url("../../../assets/icons/folder-open.svg") : @image-url("../../../assets/icons/folder.svg"))
                                        : @image-url("../../../assets/icons/terminal.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    colorize: node.is_group 
                                        ? (node.is_expanded ? AppTheme.accent : AppTheme.secondary-foreground)
                                        : AppTheme.foreground;
                                }
                            }

                            // 标题文字
                            Text {
                                text: node.name;
                                font-size: 11px;
                                font-weight: node.is_group ? 600 : 400;
                                color: (node.id == root.selected_id) ? AppTheme.foreground : AppTheme.foreground.transparentize(15%);
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            // 徽标指示器
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;

                                // 收藏星标
                                if !node.is_group && node.is_favorite: VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../../assets/icons/star-filled.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: #f1c40f;
                                    }
                                }

                                // 子项计数 (仅分组)
                                if node.is_group: Text {
                                    text: "" + node.item_count;
                                    font-size: 10px;
                                    color: AppTheme.secondary-foreground.transparentize(40%);
                                    vertical-alignment: center;
                                }

                                // 语言徽标 (仅脚本)
                                if !node.is_group && node.language != "": Rectangle {
                                    height: 14px;
                                    border-radius: 2px;
                                    background: AppTheme.control-background;

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;

                                        Text {
                                            text: node.language;
                                            font-size: 9px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
