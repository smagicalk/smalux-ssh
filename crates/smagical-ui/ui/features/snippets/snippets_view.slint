// =============================================================================
// 文件名称: snippets_view.slint
// 模块功能: 全屏代码片段与多层层级管理中心容器 (SnippetsCenterView)
// 核心设计: 左侧多层文件夹树（支持拖拽） + 右侧沉浸式脚本编辑器与动态变量识别
// =============================================================================

import { AppTheme } from "../../themes/app-theme.slint";
import { SnippetTreeNode, SnippetParamInputData } from "snippets_model.slint";
import { SnippetsBridge } from "snippets_bridge.slint";
import { SnippetTreePane } from "components/snippet_tree_pane.slint";
import { SnippetGroupDetail } from "components/snippet_group_detail.slint";
import { SnippetEditorPane } from "components/snippet_editor_pane.slint";
import { FolderPickerModal } from "../../components/folder-picker-modal.slint";

export { SnippetTreeNode, SnippetParamInputData }

/// 全屏代码片段与多层层级管理中心视图 (SnippetsCenterView)
export component SnippetsCenterView inherits Rectangle {
    background: AppTheme.window-background;

    // 树数据源
    in property <[SnippetTreeNode]> tree_nodes: SnippetsBridge.tree-nodes;
    in-out property <string> search_query: SnippetsBridge.search-query;
    in-out property <string> selected_id: SnippetsBridge.active-snippet-id;

    // 详情编辑器数据绑定
    in property <bool> has_selection: SnippetsBridge.has-selection;
    in property <bool> is_selected_group: SnippetsBridge.is-active-group;
    in-out property <string> edit_id: SnippetsBridge.form-id;
    in-out property <string> edit_title: SnippetsBridge.form-title;
    in-out property <string> edit_category_name: SnippetsBridge.form-category-name;
    in-out property <string> edit_language: SnippetsBridge.form-language;
    in-out property <string> edit_content: SnippetsBridge.form-code;
    in-out property <bool> edit_auto_execute: SnippetsBridge.form-auto-execute;
    in-out property <string> edit_description: SnippetsBridge.form-description;
    in-out property <bool> edit_is_favorite: SnippetsBridge.form-is-favorite;
    in property <string> detected_variables_text: SnippetsBridge.form-detected-variables-text;
    in property <string> edit_updated_at: SnippetsBridge.form-updated-at;

    // 拖拽交互状态
    in-out property <bool> is_dragging: false;
    in-out property <string> drag_source_id: "";
    in-out property <string> drag_source_name: "";
    in-out property <bool> drag_source_is_group: false;
    in-out property <string> drop_target_id: "";
    in-out property <string> drop_target_name: "";
    in-out property <int> drop_target_index: -1;
    in-out property <string> drop_position: "inside";
    in-out property <bool> drop_target_valid: false;
    in-out property <length> drag_x: 0px;
    in-out property <length> drag_y: 0px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        // ==========================================
        // 1. 左侧：多层文件夹代码片段树导航栏
        // ==========================================
        SnippetTreePane {
            tree_nodes: root.tree_nodes;
            search_query <=> root.search_query;
            selected_id <=> root.selected_id;
            is_dragging <=> root.is_dragging;
            drag_source_id <=> root.drag_source_id;
            drag_source_name <=> root.drag_source_name;
            drag_source_is_group <=> root.drag_source_is_group;
            drop_target_id <=> root.drop_target_id;
            drop_target_name <=> root.drop_target_name;
            drop_target_index <=> root.drop_target_index;
            drop_position <=> root.drop_position;
            drop_target_valid <=> root.drop_target_valid;
            drag_x <=> root.drag_x;
            drag_y <=> root.drag_y;

            search_changed(text) => { SnippetsBridge.search-changed(text); }
            toggle_group_expanded(id) => { SnippetsBridge.toggle-group-expanded(id); }
            select_node(id, is_g) => { SnippetsBridge.select-node(id, is_g); }
            toggle_favorite(id) => { SnippetsBridge.toggle-favorite(id); }
            create_snippet => { SnippetsBridge.create-new-snippet(); }
            create_group => { SnippetsBridge.create-new-group(); }
            move_node(src, target, pos) => { SnippetsBridge.move-node(src, target, pos); }
            request_drag_hover(src, idx, offset) => { SnippetsBridge.request-drag-hover(src, idx, offset); }
        }

        // ==========================================
        // 2. 右侧：代码片段详情与脚本编辑器
        // ==========================================
        Rectangle {
            horizontal-stretch: 1;
            background: AppTheme.window-background;

            // 2.0 未选择状态提示
            if !root.has_selection: Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/code.svg");
                            width: 36px;
                            height: 36px;
                            image-fit: contain;
                            colorize: AppTheme.secondary-foreground.transparentize(60%);
                        }
                    }

                    Text {
                        text: @tr("选择左侧代码片段进行查看或编辑");
                        font-size: 13px;
                        font-weight: 500;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: @tr("支持拖拽调序、跨分组归类与参数化变量 {{var}}");
                        font-size: 11px;
                        color: AppTheme.secondary-foreground.transparentize(50%);
                        horizontal-alignment: center;
                    }
                }
            }

            // 2.1 选中的是文件夹分组
            if root.has_selection && root.is_selected_group: SnippetGroupDetail {
                width: 100%;
                height: 100%;
                edit_id: root.edit_id;
                edit_title: root.edit_title;
                create_snippet => { SnippetsBridge.create-new-snippet(); }
                delete_group(id) => { SnippetsBridge.delete-group(id); }
            }

            // 2.2 选中的是代码片段
            if root.has_selection && !root.is_selected_group: SnippetEditorPane {
                width: 100%;
                height: 100%;
                edit_id <=> root.edit_id;
                edit_title <=> root.edit_title;
                edit_category_id <=> SnippetsBridge.form-group-id;
                edit_category_name <=> SnippetsBridge.form-category-name;
                edit_content <=> root.edit_content;
                edit_auto_execute <=> root.edit_auto_execute;
                edit_description <=> root.edit_description;
                detected_variables_text: root.detected_variables_text;
                is_editing <=> SnippetsBridge.is-editing;
                parent_options: SnippetsBridge.parent-options;
                copy_content(id) => { SnippetsBridge.copy-snippet(id); }
                save_snippet => { SnippetsBridge.save-snippet(); }
                delete_snippet(id) => { SnippetsBridge.delete-snippet(id); }
            }
        }
    }

    // 文件夹树形选取弹窗
    FolderPickerModal {
        is-open: SnippetsBridge.is-folder-picker-open;
        title: @tr("选择所属文件夹");
        prompt: @tr("请在下方树形结构中点选代码片段的归属文件夹：");
        options: SnippetsBridge.parent-options;
        current-id: SnippetsBridge.form-group-id;
        current-name: SnippetsBridge.form-category-name != "" ? SnippetsBridge.form-category-name : @tr("根目录 (作为顶级分组)");
        toggle-group(id) => { SnippetsBridge.toggle-group-expanded(id); }
        close => { SnippetsBridge.is-folder-picker-open = false; }
        confirmed(id, name) => {
            SnippetsBridge.form-group-id = id;
            SnippetsBridge.form-category-name = name;
            SnippetsBridge.is-folder-picker-open = false;
        }
    }
}
