import { AppTheme } from "@common/themes/app-theme.slint";
import { DrawerContainer } from "@common/components/drawer-container.slint";
import { ProgressBar } from "@common/components/progress-bar.slint";
import { StatusDot } from "@common/components/status-dot.slint";
import { AppVScrollBar } from "@common/components/base/app-scroll-bar.slint";
import { AppSwitch } from "@common/shared/base/app-switch.slint";
import { SparklineArea } from "../charts/sparkline-area.slint";
import { ArcGauge } from "../charts/arc-gauge.slint";
import { PulseIndicator } from "../charts/pulse-indicator.slint";

import { MonitorProcessItem, DiskPartitionItem, SystemMetricsData } from "@common/features/monitor/monitor_bridge.slint";
export { MonitorProcessItem, DiskPartitionItem, SystemMetricsData }

/// 实时系统监控抽屉 (Monitor Drawer)
///
/// 具备高密度、无空白留白排版设计，集成双圆弧仪表、双时序平滑波形、多磁盘分离与轻量四宫格。
export component MonitorDrawer inherits DrawerContainer {
    title: @tr("主机实时监控");
    collapse-icon: "▶";

    in property <SystemMetricsData> metrics: {
        host-name: "prod-server-01",
        host-ip: "192.168.1.100:22",
        os-name: "Ubuntu 22.04 LTS",
        virt-type: "KVM 虚机",
        uptime: "24天 16时 42分",
        load-avg: "0.48, 0.52, 0.61",
        fd-usage: "2,840 / 104万 (0.3%)",
        tasks-threads: "3 活跃 / 248 线程",
        active-users: 2,
        cpu-usage: 0.428,
        cpu-cores: 8,
        cpu-freq: "3.40 GHz",
        cpu-temp: "48℃",
        cpu-user-pct: "28.4%",
        cpu-sys-pct: "14.4%",
        cpu-iowait-pct: "0.2%",
        cpu-steal-pct: "0.0%",
        ram-usage: 0.684,
        ram-used: "10.9 GB",
        ram-total: "16.0 GB",
        ram-available: "5.1 GB",
        ram-cached: "2.8 GB",
        ram-free: "2.3 GB",
        swap-enabled: true,
        swap-usage: 0.128,
        swap-used: "512 MB",
        swap-total: "4.0 GB",
        swap-free: "3.5 GB",
        swap-status-text: "运行健康 (无频繁换入换出)",
        net-interface: "eth0",
        net-rx-rate: "14.8 MB/s",
        net-tx-rate: "3.2 MB/s",
        net-total-rx: "128.4 GB",
        net-total-tx: "42.1 GB",
        tcp-inuse: 28,
        tcp-tw: 14,
        udp-inuse: 9,
        net-drops: 0,
        net-errs: 0,
        ping-ms: 18,
        probe-latency-ms: 16,
        last-update-time: "17:05:42",
        poll-interval: "3s",
        cpu-sparkline-area: "M 0 40 L 0 30 C 10 28, 15 20, 25 22 C 35 24, 40 14, 50 16 C 60 18, 65 8, 75 12 C 85 16, 90 26, 100 20 L 100 40 Z",
        cpu-sparkline-line: "M 0 30 C 10 28, 15 20, 25 22 C 35 24, 40 14, 50 16 C 60 18, 65 8, 75 12 C 85 16, 90 26, 100 20",
        net-rx-sparkline-area: "M 0 40 L 0 35 C 10 32, 20 18, 30 20 C 40 22, 45 10, 55 12 C 65 14, 70 6, 80 8 C 90 12, 95 24, 100 22 L 100 40 Z",
        net-rx-sparkline-line: "M 0 35 C 10 32, 20 18, 30 20 C 40 22, 45 10, 55 12 C 65 14, 70 6, 80 8 C 90 12, 95 24, 100 22",
        net-tx-sparkline-area: "M 0 40 L 0 38 C 15 36, 25 28, 35 30 C 50 32, 60 22, 70 24 C 80 26, 90 32, 100 30 L 100 40 Z",
        net-tx-sparkline-line: "M 0 38 C 15 36, 25 28, 35 30 C 50 32, 60 22, 70 24 C 80 26, 90 32, 100 30",
        memory-usage: 0.684,
        disk-usage: 0.352,
        uptime-days: 24,
        process-count: 148,
    };

    /// 物理磁盘分区阵列 (支持 1 到多块磁盘同时挂载展示)
    in property <[DiskPartitionItem]> partitions: [
        {
            name: "系统根盘",
            mount-point: "/",
            filesystem: "/dev/nvme0n1p2",
            used: "176 GB",
            total: "500 GB",
            free: "324 GB",
            usage-pct: 0.352,
            inode-pct: "14%",
        },
        {
            name: "数据盘",
            mount-point: "/data",
            filesystem: "/dev/sdb1",
            used: "1.2 TB",
            total: "2.0 TB",
            free: "800 GB",
            usage-pct: 0.600,
            inode-pct: "28%",
        },
        {
            name: "备份归档",
            mount-point: "/mnt/backup",
            filesystem: "/dev/sdc1",
            used: "220 GB",
            total: "4.0 TB",
            free: "3.78 TB",
            usage-pct: 0.055,
            inode-pct: "5%",
        }
    ];

    /// 是否开启进程统计 (加在标题的开关，默认关闭以减少探针开销)
    in-out property <bool> enable-process-monitor: false;

    /// 核心进程排行数据 (Top 10 进程资源占比，仅在开启时展示)
    in property <[MonitorProcessItem]> processes: [
        { pid: 1124, name: "nginx: master", user: "root", cpu-pct: "4.2%", mem-pct: "1.8%" },
        { pid: 2450, name: "mysqld", user: "mysql", cpu-pct: "3.8%", mem-pct: "12.4%" },
        { pid: 1890, name: "redis-server", user: "redis", cpu-pct: "1.2%", mem-pct: "3.1%" },
        { pid: 980, name: "containerd", user: "root", cpu-pct: "0.9%", mem-pct: "2.5%" },
        { pid: 3412, name: "node /app/server", user: "www", cpu-pct: "0.8%", mem-pct: "4.6%" },
        { pid: 3120, name: "smalux-agent", user: "root", cpu-pct: "0.6%", mem-pct: "0.8%" },
        { pid: 4120, name: "sshd: root@pts/0", user: "root", cpu-pct: "0.3%", mem-pct: "0.4%" },
        { pid: 482, name: "systemd-journald", user: "systemd", cpu-pct: "0.1%", mem-pct: "0.5%" },
        { pid: 1530, name: "prometheus-node", user: "nobody", cpu-pct: "0.1%", mem-pct: "1.2%" },
        { pid: 620, name: "rsyslogd", user: "syslog", cpu-pct: "0.1%", mem-pct: "0.2%" },
    ];

    /// 当前终端是否有活跃连接的主机
    in property <bool> has-active-host: true;

    callback refresh-clicked();
    callback process-monitor-toggled(bool);

    Rectangle {
        width: 100%;
        height: 100%;
        background: AppTheme.panel-background;

        // 无活跃终端时的占位空状态
        if !root.has-active-host: Rectangle {
            width: 100%;
            height: 100%;
            background: AppTheme.panel-background;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/activity.svg");
                        width: 36px;
                        height: 36px;
                        colorize: AppTheme.disabled-foreground;
                    }
                }
                Text {
                    text: @tr("未连接主机");
                    font-size: 13px;
                    font-weight: 700;
                    color: AppTheme.foreground;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("请在中央终端打开或连接主机\n实时性能监控将自动唤醒");
                    font-size: 10px;
                    color: AppTheme.disabled-foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        scroll-area := Flickable {
            width: 100%;
            height: 100%;
            visible: root.has-active-host;
            viewport-height: max(self.height, content-layout.preferred-height + 16px);

            content-layout := VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 14px;
                spacing: 8px;
                alignment: start;

                // =============================================================
                // 1. 顶部状态与轮询控制栏 (集成微光脉冲探针指示)
                // =============================================================
                HorizontalLayout {
                    alignment: space-between;
                    height: 22px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        PulseIndicator {
                            pulse-color: AppTheme.success;
                            active: true;
                            text: root.metrics.ping-ms + "ms · " + @tr("实时侦听中");
                            show-text: true;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        Rectangle {
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.control-background;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.metrics.poll-interval + " " + @tr("轮询");
                                    font-size: 9px;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 3px;
                            background: ref-touch.has-hover ? AppTheme.hover-background : transparent;

                            ref-touch := TouchArea {
                                clicked => { root.refresh-clicked(); }
                                mouse-cursor: pointer;
                            }

                            Image {
                                source: @image-url("../../assets/icons/refresh.svg");
                                width: 11px;
                                height: 11px;
                                colorize: ref-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // =============================================================
                // 2. 主机与环境概览微卡片 (紧凑高密度排版)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 7px;
                        spacing: 4px;

                        // 首行：主机名 + 虚拟化徽章 + 系统徽章
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/icons/server.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: AppTheme.accent;
                                    }
                                }

                                Text {
                                    text: root.metrics.host-name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppTheme.foreground;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;

                                Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: AppTheme.accent.transparentize(85%);
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.metrics.virt-type;
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: AppTheme.control-background;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.metrics.os-name;
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 次行：IP 地址、在线运行时间
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            Text {
                                text: root.metrics.host-ip;
                                font-size: 9px;
                                font-weight: 500;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("运行: ") + root.metrics.uptime;
                                font-size: 9px;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 第三行：负载均值、在线终端、句柄占用
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            Text {
                                text: @tr("负载: ") + root.metrics.load-avg;
                                font-size: 9px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("在线终端: ") + root.metrics.active-users + " | 句柄: " + root.metrics.fd-usage;
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // =============================================================
                // 3. 【核心创新】核心算力与物理内存双圆弧仪表盘并排 (破除长条死板)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        alignment: space-around;

                        // 左侧：CPU 核心仪表
                        ArcGauge {
                            progress: root.metrics.cpu-usage;
                            value-text: Math.round(root.metrics.cpu-usage * 100) + "%";
                            sub-text: root.metrics.cpu-cores + "核 · " + root.metrics.cpu-freq;
                            label-text: @tr("CPU 核心算力");
                            active-color: root.metrics.cpu-usage > 0.85 ? AppTheme.danger : (root.metrics.cpu-usage > 0.70 ? AppTheme.warning : #38bdf8);
                        }

                        // 中间微弱纵向分割线
                        Rectangle {
                            width: 1px;
                            height: 48px;
                            background: AppTheme.border.transparentize(50%);
                            y: (parent.height - self.height) / 2;
                        }

                        // 右侧：物理内存仪表
                        ArcGauge {
                            progress: root.metrics.ram-usage;
                            value-text: Math.round(root.metrics.ram-usage * 100) + "%";
                            sub-text: root.metrics.ram-used + " / " + root.metrics.ram-total;
                            label-text: @tr("物理内存 (RAM)");
                            active-color: root.metrics.ram-usage > 0.85 ? AppTheme.danger : (root.metrics.ram-usage > 0.70 ? AppTheme.warning : #a855f7);
                        }
                    }
                }

                // =============================================================
                // 4. 【核心创新】CPU 实时负载走势 (30s 渐变平滑面积波形图)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // 卡片标题栏
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("CPU 实时走势 (30s 动态波形)");
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.metrics.cpu-temp;
                                font-size: 9px;
                                font-weight: 600;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 平滑面积波形图 (SparklineArea)
                        SparklineArea {
                            commands-area: root.metrics.cpu-sparkline-area;
                            commands-line: root.metrics.cpu-sparkline-line;
                            line-color: #38bdf8;
                            current-val-text: Math.round(root.metrics.cpu-usage * 100) + "%";
                            peak-val-text: @tr("峰值 68%");
                            time-label: "-30s";
                        }

                        // 底部微型负载分析标签
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "用户 " + root.metrics.cpu-user-pct;
                                font-size: 8px;
                                color: AppTheme.secondary-foreground;
                            }
                            Text {
                                text: "内核 " + root.metrics.cpu-sys-pct;
                                font-size: 8px;
                                color: AppTheme.secondary-foreground;
                            }
                            Text {
                                text: "IO等 " + root.metrics.cpu-iowait-pct;
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                            }
                            Text {
                                text: "偷取 " + root.metrics.cpu-steal-pct;
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                            }
                        }
                    }
                }

                // =============================================================
                // 5. 【核心创新】网络实时吞吐双轨交织波形图 (下行绿 / 上行蓝)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // 标题栏
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("网络双轨吞吐 (") + root.metrics.net-interface + ")";
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("全双工 1000 Mbps");
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 即时上传与下载大字速率徽章
                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: space-between;
                                    Text {
                                        text: "↓ " + @tr("入网");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.net-rx-rate;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: AppTheme.success;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: space-between;
                                    Text {
                                        text: "↑ " + @tr("出网");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.net-tx-rate;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #818cf8;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 图例说明 (绿线入网 RX，紫线出网 TX)
                        HorizontalLayout {
                            alignment: space-between;
                            height: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #10b981;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: @tr("下行 RX (入网)");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #818cf8;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: @tr("上行 TX (出网)");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: @tr("30s 双轨走势");
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 双轨时序波形图 (绿线 RX + 紫线 TX)
                        SparklineArea {
                            commands-area: root.metrics.net-rx-sparkline-area;
                            commands-line: root.metrics.net-rx-sparkline-line;
                            line-color: #10b981;
                            show-secondary: true;
                            secondary-commands-area: root.metrics.net-tx-sparkline-area;
                            secondary-commands-line: root.metrics.net-tx-sparkline-line;
                            secondary-line-color: #818cf8;
                            current-val-text: root.metrics.net-rx-rate;
                            peak-val-text: @tr("峰值 22.4 MB/s");
                            time-label: "-30s";
                        }

                        // 累计流量统计
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("累计入 ") + root.metrics.net-total-rx;
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                            }
                            Text {
                                text: @tr("累计出 ") + root.metrics.net-total-tx;
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                            }
                            Text {
                                text: "0 错包 · 0 丢包";
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                            }
                        }
                    }
                }

                // =============================================================
                // 6. 存储空间 (多磁盘分区阵列与 Swap 彻底分离)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // 卡片标题栏
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("存储与交换空间 (多分区阵列)");
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.partitions.length + " " + @tr("个挂载点");
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 多物理磁盘分区循环展示
                        for part[idx] in root.partitions: VerticalLayout {
                            spacing: 4px;

                            if idx > 0: Rectangle {
                                height: 1px;
                                background: AppTheme.border.transparentize(50%);
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    Text {
                                        text: part.name;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 15px;
                                        border-radius: 2px;
                                        background: AppTheme.control-background;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            Text {
                                                text: part.mount-point;
                                                font-size: 8px;
                                                font-weight: 600;
                                                color: AppTheme.accent;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: end;

                                    Text {
                                        text: part.used + " / " + part.total;
                                        font-size: 8px;
                                        color: AppTheme.disabled-foreground;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: Math.round(part.usage-pct * 100) + "%";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: part.usage-pct > 0.85 ? AppTheme.danger : part.usage-pct > 0.70 ? AppTheme.warning : AppTheme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            ProgressBar {
                                progress: part.usage-pct;
                                fill-color: part.usage-pct > 0.85 ? AppTheme.danger : part.usage-pct > 0.70 ? AppTheme.warning : AppTheme.accent;
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: part.filesystem;
                                    font-size: 8px;
                                    color: AppTheme.disabled-foreground;
                                    overflow: elide;
                                }
                                Text {
                                    text: @tr("可用: ") + part.free + " · Inode: " + part.inode-pct;
                                    font-size: 8px;
                                    color: AppTheme.secondary-foreground;
                                }
                            }
                        }

                        // 分割线：进入虚拟交换空间 (Swap)
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border.transparentize(50%);
                        }

                        // Swap 独立展示块
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: @tr("交换空间 (Swap)");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: end;
                                    Text {
                                        text: root.metrics.swap-enabled ? (root.metrics.swap-used + " / " + root.metrics.swap-total) : @tr("未配置交换区");
                                        font-size: 8px;
                                        color: AppTheme.disabled-foreground;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.swap-enabled ? (Math.round(root.metrics.swap-usage * 100) + "%") : "OFF";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: !root.metrics.swap-enabled ? AppTheme.disabled-foreground : root.metrics.swap-usage > 0.50 ? AppTheme.danger : root.metrics.swap-usage > 0.20 ? AppTheme.warning : AppTheme.success;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.metrics.swap-enabled: ProgressBar {
                                progress: root.metrics.swap-usage;
                                fill-color: root.metrics.swap-usage > 0.50 ? AppTheme.danger : root.metrics.swap-usage > 0.20 ? AppTheme.warning : AppTheme.success;
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.metrics.swap-enabled ? (@tr("剩余可用: ") + root.metrics.swap-free) : @tr("系统未挂载交换文件");
                                    font-size: 8px;
                                    color: AppTheme.secondary-foreground;
                                }
                                Text {
                                    text: root.metrics.swap-status-text;
                                    font-size: 8px;
                                    color: AppTheme.disabled-foreground;
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // 7. 【核心创新】套接字与链路状态 (四宫格极轻量微徽章)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("套接字与链路连接");
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("内核原子统计");
                                font-size: 8px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 四宫格极轻量展示
                        HorizontalLayout {
                            spacing: 5px;

                            // 格 1: ESTABLISHED
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: "ESTABLISHED";
                                        font-size: 7px;
                                        color: AppTheme.disabled-foreground;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.tcp-inuse;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: AppTheme.success;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // 格 2: TIME_WAIT
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: "TIME_WAIT";
                                        font-size: 7px;
                                        color: AppTheme.disabled-foreground;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.tcp-tw;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: AppTheme.warning;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // 格 3: LISTEN
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: "LISTEN";
                                        font-size: 7px;
                                        color: AppTheme.disabled-foreground;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "12";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // 格 4: UDP
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: "UDP 套接字";
                                        font-size: 7px;
                                        color: AppTheme.disabled-foreground;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.metrics.udp-inuse;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: AppTheme.secondary-foreground;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // 8. 核心进程统计卡片 (标题集成开关，默认关闭以减少探针开销)
                // =============================================================
                Rectangle {
                    border-radius: 4px;
                    background: AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // 卡片标题栏：标题 + 状态指示 + 标题开关 (AppSwitch)
                        HorizontalLayout {
                            alignment: space-between;
                            height: 22px;

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/icons/activity.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: root.enable-process-monitor ? AppTheme.accent : AppTheme.disabled-foreground;
                                    }
                                }

                                Text {
                                    text: @tr("进程资源统计");
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    vertical-alignment: center;
                                }

                                if root.enable-process-monitor: Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: AppTheme.accent.transparentize(85%);
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "Top " + root.processes.length;
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;

                                Text {
                                    text: root.enable-process-monitor ? @tr("采集中") : @tr("已关闭");
                                    font-size: 9px;
                                    color: root.enable-process-monitor ? AppTheme.success : AppTheme.disabled-foreground;
                                    vertical-alignment: center;
                                }

                                AppSwitch {
                                    size: "sm";
                                    checked <=> root.enable-process-monitor;
                                    toggled(val) => { root.process-monitor-toggled(val); }
                                }
                            }
                        }

                        // 分支 A: 默认关闭状态 (轻量紧凑无扰提示)
                        if !root.enable-process-monitor: Rectangle {
                            height: 28px;
                            border-radius: 3px;
                            background: AppTheme.control-background;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;

                                Text {
                                    text: @tr("默认关闭进程统计 (保持单行探针零性能损耗)");
                                    font-size: 9px;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: @tr("点击右上开关开启");
                                    font-size: 8px;
                                    color: AppTheme.disabled-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // 分支 B: 开启状态 (展开 Top 5 核心进程资源榜)
                        if root.enable-process-monitor: VerticalLayout {
                            spacing: 4px;

                            // 列表表头
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                height: 16px;

                                Text {
                                    text: "PID";
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: AppTheme.disabled-foreground;
                                    width: 38px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: @tr("进程名称");
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: AppTheme.disabled-foreground;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: @tr("用户");
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: AppTheme.disabled-foreground;
                                    width: 38px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "CPU";
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: AppTheme.disabled-foreground;
                                    width: 34px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: @tr("内存");
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: AppTheme.disabled-foreground;
                                    width: 34px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // 进程数据行 (条纹隔行背景)
                            for proc[pidx] in root.processes: Rectangle {
                                height: 22px;
                                border-radius: 2px;
                                background: Math.mod(pidx, 2) == 1 ? AppTheme.control-background.transparentize(50%) : transparent;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    Text {
                                        text: proc.pid;
                                        font-size: 9px;
                                        color: AppTheme.disabled-foreground;
                                        width: 38px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.name;
                                        font-size: 9px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.user;
                                        font-size: 8.5px;
                                        color: AppTheme.secondary-foreground;
                                        width: 38px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.cpu-pct;
                                        font-size: 9px;
                                        font-weight: 600;
                                        color: AppTheme.warning;
                                        width: 34px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.mem-pct;
                                        font-size: 9px;
                                        font-weight: 600;
                                        color: AppTheme.accent;
                                        width: 34px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // 9. 底部微型探针元数据
                // =============================================================
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 4px;
                    padding-right: 4px;

                    Text {
                        text: "SSH 管道探针 · " + root.metrics.probe-latency-ms + "ms";
                        font-size: 9px;
                        color: AppTheme.disabled-foreground;
                    }

                    Text {
                        text: @tr("更新于 ") + root.metrics.last-update-time;
                        font-size: 9px;
                        color: AppTheme.disabled-foreground;
                    }
                }
            }
        }

        // 悬浮现代化滚动条
        AppVScrollBar {
            visible: root.has-active-host;
            viewport-height: scroll-area.viewport-height;
            visible-height: scroll-area.height;
            viewport-y <=> scroll-area.viewport-y;
        }
    }
}
