// =============================================================================
// 文件名称: credential_key_form.slint
// 模块功能: SSH 密钥对配置表单 (Credential Key Form)
// 包含一键生成密钥对弹窗呼出、从本地文件导入、直接输入私钥自动解析公钥/指纹、公钥导出复制与口令保护
// =============================================================================

import { AppTheme } from "@common/themes/app-theme.slint";
import { AppTextArea } from "@common/shared/base/app-text-area.slint";
import { AppPasswordInput } from "@common/shared/base/app-password-input.slint";

component CredentialKeyForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <bool> show-full-private-key: false;
    in-out property <bool> reveal-passphrase: false;
    in-out property <string> form-algorithm: "Ed25519";
    in-out property <string> form-secret-data: "";
    in-out property <string> form-passphrase: "";
    in-out property <string> form-public-key: "";
    in-out property <string> form-fingerprint: "";

    callback open-generate-modal();
    callback import-from-file();
    callback parse-private-key(string /* secret_data */, string /* passphrase */);
    callback copy-text(string /* text */, string /* title */, string /* msg */);

    alignment: start;
    spacing: 10px;

    // 1. 算法与规格状态指示行
    HorizontalLayout {
        width: 100%;
        alignment: space-between;
        height: 22px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: @tr("密钥算法规格: ");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            Rectangle {
                height: 18px;
                border-radius: 3px;
                background: AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.form-algorithm != "" ? root.form-algorithm : @tr("自动识别");
                        font-size: 9px;
                        font-weight: 600;
                        color: AppTheme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 2. 指纹展示 (若存在)
    if root.form-fingerprint != "": VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("公钥指纹 (SHA256)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;

                Text {
                    text: root.form-fingerprint;
                    font-size: 10px;
                    font-family: "Cascadia Code, Consolas, monospace";
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 20px;
                    border-radius: 3px;
                    background: copy-fp-touch.has-hover ? AppTheme.hover-background : transparent;
                    copy-fp-touch := TouchArea {
                        clicked => {
                            root.copy-text(root.form-fingerprint, @tr("已复制指纹"), @tr("公钥指纹已复制至剪贴板"));
                        }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/copy.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: AppTheme.secondary-foreground;
                            }
                        }
                        Text {
                            text: @tr("复制");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 3. 导出公钥 (若已推导出公钥)
    if root.form-public-key != "": VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: @tr("导出的 SSH 公钥 (可配置于目标服务器 ~/.ssh/authorized_keys)");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }
            Rectangle {
                min-width: 50px;
                height: 20px;
                border-radius: 3px;
                background: copy-pub-touch.has-hover ? AppTheme.hover-background : transparent;
                copy-pub-touch := TouchArea {
                    clicked => {
                        root.copy-text(root.form-public-key, @tr("已复制公钥"), @tr("SSH 公钥已复制至剪贴板"));
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: 4px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/copy.svg");
                            width: 11px;
                            height: 11px;
                            image-fit: contain;
                            colorize: AppTheme.accent;
                        }
                    }

                    Text {
                        text: @tr("复制公钥");
                        font-size: 10px;
                        color: AppTheme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        AppTextArea {
            height: 52px;
            text <=> root.form-public-key;
            enabled: root.is-create-mode || root.is-editing;
            font-size: 9px;
            monospace: true;
        }
    }

    // 4. 私钥内容 (OpenSSH / PPK 格式)
    VerticalLayout {
        alignment: start;
        spacing: 3px;

        HorizontalLayout {
            width: 100%;
            alignment: space-between;

            Text {
                text: @tr("私钥内容 (OpenSSH / PEM) *");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // [从文件导入] 按钮
                if root.is-create-mode || root.is-editing: Rectangle {
                    height: 20px;
                    border-radius: 3px;
                    background: import-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    import-touch := TouchArea {
                        clicked => { root.import-from-file(); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/folder-plus.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("从文件导入");
                            font-size: 10px;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                // [一键生成密钥对] 按钮
                if root.is-create-mode || root.is-editing: Rectangle {
                    height: 20px;
                    border-radius: 3px;
                    background: gen-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    gen-touch := TouchArea {
                        clicked => { root.open-generate-modal(); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/zap.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("生成密钥对");
                            font-size: 10px;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                // 遮挡/完整查看私钥
                Rectangle {
                    height: 20px;
                    border-radius: 3px;
                    background: toggle-key-touch.has-hover ? AppTheme.hover-background : transparent;
                    toggle-key-touch := TouchArea {
                        clicked => { root.show-full-private-key = !root.show-full-private-key; }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: root.show-full-private-key ? @image-url("../../assets/icons/eye-off.svg") : @image-url("../../assets/icons/eye.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: AppTheme.secondary-foreground;
                            }
                        }

                        Text {
                            text: root.show-full-private-key ? @tr("遮挡私钥") : @tr("完整查看私钥");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                // 复制私钥
                if root.form-secret-data != "": Rectangle {
                    height: 20px;
                    border-radius: 3px;
                    background: copy-priv-touch.has-hover ? AppTheme.hover-background : transparent;
                    copy-priv-touch := TouchArea {
                        clicked => {
                            root.copy-text(root.form-secret-data, @tr("已复制私钥"), @tr("私钥文本已成功复制至系统剪贴板"));
                        }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 4px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/copy.svg");
                                width: 11px;
                                height: 11px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("复制私钥");
                            font-size: 10px;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        AppTextArea {
            height: root.show-full-private-key ? 120px : 34px;
            text <=> root.form-secret-data;
            placeholder: @tr("请粘贴 OpenSSH 私钥文本，或点击右上角 [从文件导入] / [一键生成密钥对]...");
            enabled: root.is-create-mode || root.is-editing;
            font-size: 9px;
            monospace: true;
            input-type: root.show-full-private-key ? InputType.text : InputType.password;
            animate height { duration: 150ms; }
            edited(val) => {
                root.parse-private-key(val, root.form-passphrase);
            }
        }
    }

    // 5. 密钥密码短语 (Passphrase)
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("私钥解密密码短语 (Passphrase，无密码留空)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        AppPasswordInput {
            text <=> root.form-passphrase;
            enabled: root.is-create-mode || root.is-editing;
            placeholder: @tr("无密码留空；若私钥已加密，输入正确口令后将自动推导公钥");
            edited(p) => {
                root.parse-private-key(root.form-secret-data, p);
            }
        }
    }
}

export { CredentialKeyForm }
