// =============================================================================
// 文件名称: generate-key-pair-modal.slint
// 模块功能: SSH 密钥对生成独立模态弹窗 (Generate Key Pair Modal)
// 包含算法选择 (Ed25519 / RSA-4096 / RSA-2048 / ECDSA-256)、口令加密与注释设定
// =============================================================================

import { AppTheme } from "@common/themes/app-theme.slint";
import { AppButton } from "@common/shared/base/app-button.slint";
import { AppTextInput } from "@common/shared/base/app-text-input.slint";
import { AppPasswordInput } from "@common/shared/base/app-password-input.slint";

component GenerateKeyPairModal inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <string> selected-algorithm: "Ed25519";
    in-out property <string> passphrase: "";
    in-out property <string> comment: "";

    callback close();
    callback confirm(string /* algorithm */, string /* passphrase */, string /* comment */);

    if root.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        // 拦截背景穿透
        TouchArea {}

        modal-card := Rectangle {
            width: 460px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            clip: true;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                // 1. 弹窗标题栏
                HorizontalLayout {
                    alignment: space-between;
                    height: 24px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/key.svg");
                                width: 15px;
                                height: 15px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("一键生成 SSH 密钥对");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: AppTheme.radius-small;
                        background: close-touch.has-hover ? AppTheme.hover-background : transparent;

                        close-touch := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../assets/icons/window-close.svg");
                            width: 11px;
                            height: 11px;
                            image-fit: contain;
                            colorize: close-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                // 2. 算法选择
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;

                    Text {
                        text: @tr("选择密钥生成算法 *");
                        font-size: 10px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                    }

                    // 算法选择网格 (2x2)
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;

                            // Ed25519
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 4px;
                                background: root.selected-algorithm == "Ed25519"
                                    ? AppTheme.control-background
                                    : (algo-ed-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                                border-width: 1px;
                                border-color: root.selected-algorithm == "Ed25519" ? AppTheme.accent : AppTheme.border;

                                algo-ed-touch := TouchArea {
                                    clicked => { root.selected-algorithm = "Ed25519"; }
                                    mouse-cursor: pointer;
                                }

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    spacing: 1px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: "Ed25519";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: AppTheme.foreground;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("(推荐)");
                                            font-size: 9px;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: @tr("高强度 256 位椭圆曲线，现代标准");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                    }
                                }
                            }

                            // RSA-4096
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 4px;
                                background: root.selected-algorithm == "RSA-4096"
                                    ? AppTheme.control-background
                                    : (algo-rsa4-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                                border-width: 1px;
                                border-color: root.selected-algorithm == "RSA-4096" ? AppTheme.accent : AppTheme.border;

                                algo-rsa4-touch := TouchArea {
                                    clicked => { root.selected-algorithm = "RSA-4096"; }
                                    mouse-cursor: pointer;
                                }

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: "RSA (4096 位)";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                    }
                                    Text {
                                        text: @tr("超高强度，兼容传统生产环境");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            // RSA-2048
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 4px;
                                background: root.selected-algorithm == "RSA-2048"
                                    ? AppTheme.control-background
                                    : (algo-rsa2-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                                border-width: 1px;
                                border-color: root.selected-algorithm == "RSA-2048" ? AppTheme.accent : AppTheme.border;

                                algo-rsa2-touch := TouchArea {
                                    clicked => { root.selected-algorithm = "RSA-2048"; }
                                    mouse-cursor: pointer;
                                }

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: "RSA (2048 位)";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                    }
                                    Text {
                                        text: @tr("广泛兼容旧式嵌入式与老旧 OpenSSH");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                    }
                                }
                            }

                            // ECDSA-256
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 4px;
                                background: root.selected-algorithm == "ECDSA-256"
                                    ? AppTheme.control-background
                                    : (algo-ecdsa-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background);
                                border-width: 1px;
                                border-color: root.selected-algorithm == "ECDSA-256" ? AppTheme.accent : AppTheme.border;

                                algo-ecdsa-touch := TouchArea {
                                    clicked => { root.selected-algorithm = "ECDSA-256"; }
                                    mouse-cursor: pointer;
                                }

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: "ECDSA (NIST P-256)";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                    }
                                    Text {
                                        text: @tr("标准 FIPS 椭圆曲线算法");
                                        font-size: 8px;
                                        color: AppTheme.secondary-foreground;
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. 口令保护 (选填)
                VerticalLayout {
                    alignment: start;
                    spacing: 3px;

                    Text {
                        text: @tr("私钥加密口令 (Passphrase，选填)");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }

                    AppPasswordInput {
                        text <=> root.passphrase;
                        placeholder: @tr("无密码留空；若设置将使用 PBKDF 加密私钥");
                    }
                }

                // 4. 公钥注释 (选填)
                VerticalLayout {
                    alignment: start;
                    spacing: 3px;

                    Text {
                        text: @tr("公钥标识注释 (Comment，选填)");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }

                    AppTextInput {
                        text <=> root.comment;
                        input-height: 28px;
                        font-size: 11px;
                        placeholder: @tr("例如: admin@company-prod (留空默认自动生成)");
                    }
                }

                // 占位弹簧
                Rectangle {
                    vertical-stretch: 1;
                }

                // 5. 底部操作栏
                HorizontalLayout {
                    height: 32px;
                    alignment: end;
                    spacing: 8px;

                    AppButton {
                        text: @tr("取消");
                        variant: "secondary";
                        clicked => { root.close(); }
                    }

                    AppButton {
                        text: @tr("立即生成并填充");
                        variant: "primary";
                        clicked => {
                            root.confirm(root.selected-algorithm, root.passphrase, root.comment);
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

export { GenerateKeyPairModal }
