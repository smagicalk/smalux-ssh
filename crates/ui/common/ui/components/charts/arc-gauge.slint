import { AppTheme } from "../../themes/app-theme.slint";

/// 微型半圆弧仪表盘组件 (Arc Gauge)
/// 专为侧栏高密度仪表设计，打破长条死板排版，100% 矢量抗锯齿渲染
export component ArcGauge {
    in property <float> progress: 0.428;           // 0.0 ~ 1.0 比例
    in property <string> value-text: "42.8%";      // 核心大字
    in property <string> sub-text: "4 Cores";      // 核心副标
    in property <string> label-text: @tr("CPU 负载"); // 底部名称
    in property <color> active-color: AppTheme.accent;
    in property <color> track-color: AppTheme.control-background;
    in property <length> stroke-width: 5px;

    // 几何参数 (基于 100 x 60 坐标系，半径 38，圆心 (50, 52))
    property <float> clamped-progress: Math.max(0.01, Math.min(0.999, root.progress));
    property <float> target-x: 50.0 + 38.0 * Math.cos(180deg * (1.0 - root.clamped-progress));
    property <float> target-y: 52.0 - 38.0 * Math.sin(180deg * (1.0 - root.clamped-progress));

    property <string> track-commands: "M 12 52 A 38 38 0 0 1 88 52";
    property <string> active-commands: "M 12 52 A 38 38 0 0 1 " + Math.round(root.target-x) + " " + Math.round(root.target-y);

    min-width: 90px;
    height: 74px;

    VerticalLayout {
        spacing: 2px;
        alignment: center;

        // 仪表盘绘图区
        Rectangle {
            height: 54px;
            width: 100%;

            // 1. 底层完整轨道弧
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0.0;
                viewbox-y: 0.0;
                viewbox-width: 100.0;
                viewbox-height: 60.0;
                commands: root.track-commands;
                stroke: root.track-color;
                stroke-width: root.stroke-width;
            }

            // 2. 高亮进度弧
            Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0.0;
                viewbox-y: 0.0;
                viewbox-width: 100.0;
                viewbox-height: 60.0;
                commands: root.active-commands;
                stroke: root.active-color;
                stroke-width: root.stroke-width;
            }

            // 3. 弧心数值居中排版
            VerticalLayout {
                y: 14px;
                width: 100%;
                spacing: 1px;
                alignment: center;

                Text {
                    text: root.value-text;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.active-color;
                    horizontal-alignment: center;
                }

                if root.sub-text != "": Text {
                    text: root.sub-text;
                    font-size: 7px;
                    color: AppTheme.disabled-foreground;
                    horizontal-alignment: center;
                }
            }
        }

        // 4. 底部微型标题
        Text {
            text: root.label-text;
            font-size: 8px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
            horizontal-alignment: center;
        }
    }
}
