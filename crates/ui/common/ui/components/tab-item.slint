import { AppTheme } from "../themes/app-theme.slint";
import { StatusDot } from "status-dot.slint";

/// JetBrains / Zed 极简工业风会话标签卡片 (Tab Item)
export component TabItem inherits Rectangle {
    in property <string> title: @tr("会话");
    in property <string> status: "online";
    in property <bool> is-active: false;

    callback select();
    callback close();
    callback context-menu(length /* x */, length /* y */);

    // 舒适易读宽度：确保会话名称、终端图标与关闭按钮完整展现，紧凑无多余冗余空间
    min-width: is-active ? 150px : 140px;
    max-width: 180px;
    height: 28px;
    border-radius: 4px;

    // 激活状态沉稳深色底，非激活状态常态微卡片底，悬停呈现轻柔微光
    background: is-active ? AppTheme.surface-background : main-touch.has-hover ? AppTheme.hover-background.transparentize(40%) : AppTheme.surface-background.transparentize(50%);
    border-width: 1px;
    // 默认常驻精致边框，悬停微蓝高亮，激活呈现品牌色边框
    border-color: is-active ? AppTheme.accent : main-touch.has-hover ? AppTheme.accent.transparentize(40%) : AppTheme.border;

    animate background { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 180ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        height: 100%;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 6px;

            // 1. 会话选择区域 (图标 + 状态指示灯 + 标题文本，与关闭按钮物理隔离)
            main-touch-box := Rectangle {
                horizontal-stretch: 1;
                height: 100%;

                main-touch := TouchArea {
                    clicked => { root.select(); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.context-menu(self.mouse-x, self.mouse-y);
                        }
                    }
                    mouse-cursor: pointer;
                }


                HorizontalLayout {
                    spacing: 6px;

                    // 1.1 终端专用图标
                    VerticalLayout {
                        alignment: center;

                        Image {
                            source: @image-url("../assets/icons/terminal.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: is-active ? AppTheme.accent : main-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;

                            animate colorize { duration: 180ms; easing: ease-out; }
                        }
                    }

                    // 1.2 状态指示灯
                    VerticalLayout {
                        alignment: center;

                        StatusDot {
                            status: root.status;
                            dot-size: 5px;
                        }
                    }

                    // 1.3 会话标题
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.title;
                            font-size: 11px;
                            font-weight: is-active ? 700 : 500;
                            color: is-active ? AppTheme.foreground : main-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            overflow: elide;
                            horizontal-alignment: left;
                            vertical-alignment: center;

                            animate color { duration: 180ms; easing: ease-out; }
                        }
                    }
                }
            }

            // 2. 独立微型关闭按钮 (专享独立 TouchArea，绝不与选择区域重叠抢占)
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    background: close-touch.has-hover ? #e7484833 : transparent;

                    animate background { duration: 150ms; easing: ease-out; }

                    Image {
                        source: @image-url("../assets/icons/window-close.svg");
                        width: 8px;
                        height: 8px;
                        image-fit: contain;
                        colorize: close-touch.has-hover ? AppTheme.danger : is-active ? AppTheme.foreground : AppTheme.secondary-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        animate colorize { duration: 150ms; easing: ease-out; }
                    }

                    close-touch := TouchArea {
                        clicked => { root.close(); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // 激活状态专属底部品牌指示光条 (JetBrains 2024 / Zed 标志性指示条)
    if is-active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 12px;
        x: 6px;
        border-radius: 1px;
        background: AppTheme.accent;
    }
}

