// -----------------------------------------------------------------------------
// 网络与隧道中心数据模型 (Tunnels Domain Models)
// -----------------------------------------------------------------------------

/// 跳板机中继节点数据模型 (多跳串联 ProxyJump)
export struct JumpHopData {
    host-id: string,
    host-name: string,
    host-address: string,
    host-port: int,
    enabled: bool,
}

/// 统一隧道与网络项数据结构
export struct TunnelItemData {
    id: string,
    name: string,
    tunnel-type: string, // "Local" | "Remote" | "Dynamic" | "JumpHost" | "ProxyServer"
    type-badge: string,  // "LOCAL -L" | "REMOTE -R" | "SOCKS5 -D" | "BASTION -J" | "PROXY"
    ssh-host-id: string,
    ssh-host-name: string,
    local-bind: string,
    local-port: int,
    remote-host: string,
    remote-port: int,
    route-summary: string,
    is-running: bool,
    enabled: bool,
    run-mode: string,      // "FollowTerminal" | "FollowApp"
    status-text: string,   // "运行中" | "待命中" | "已停止"
    status-badge: string,  // "running" | "standby" | "stopped"
    auto-start: bool,
    auto-reconnect: bool,
    remote-dns: bool,
    compression: bool,
    active-connections: int,
    traffic-in: string,
    traffic-out: string,
    notes: string,
    updated-at: string,
    ssh-command: string,
}
