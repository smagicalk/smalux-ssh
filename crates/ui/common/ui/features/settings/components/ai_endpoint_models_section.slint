import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge } from "../settings_bridge.slint";
import { AppButton, AppIconButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppDropdown } from "../../../shared/base/app-dropdown.slint";

/// AI 端点模型库管理与连通性验证区块 (AiEndpointModelsSection)
component AiEndpointModelsSection inherits VerticalLayout {
    spacing: 8px;

    // 标题行与快捷功能按钮
    HorizontalLayout {
        alignment: space-between;
        height: 26px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/sparkles.svg");
                    width: 12px;
                    height: 12px;
                    colorize: AppTheme.accent;
                }
            }
            Text {
                text: @tr("模型库与连通性验证");
                font-size: 11px;
                font-weight: 700;
                color: AppTheme.foreground;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // 测试 API 连通性按钮
            AppButton {
                text: SettingsBridge.modal-endpoint-test-status == "testing" ? @tr("正在测试...") : @tr("测试连通性");
                variant: "secondary";
                size: "sm";
                has-icon: true;
                icon: @image-url("../../../assets/icons/refresh.svg");
                height: 24px;
                clicked => {
                    SettingsBridge.modal-test-connection();
                }
            }

            // 一键远端拉取模型按钮
            AppButton {
                text: SettingsBridge.modal-endpoint-is-fetching-models ? @tr("正在获取...") : @tr("一键获取模型");
                variant: "secondary";
                size: "sm";
                has-icon: true;
                icon: @image-url("../../../assets/icons/refresh.svg");
                height: 24px;
                clicked => {
                    SettingsBridge.modal-fetch-models();
                }
            }
        }
    }

    // 连通性测试结果提示条
    if SettingsBridge.modal-endpoint-test-status == "testing": Rectangle {
        height: 26px;
        border-radius: AppTheme.radius-small;
        background: AppTheme.accent.transparentize(88%);
        border-width: 1px;
        border-color: AppTheme.accent.transparentize(60%);
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: start;
            Text {
                text: @tr("正在向目标 Base URL 与接口发送探活请求...");
                font-size: 10px;
                color: AppTheme.accent;
                vertical-alignment: center;
            }
        }
    }

    if SettingsBridge.modal-endpoint-test-status == "success": Rectangle {
        height: 26px;
        border-radius: AppTheme.radius-small;
        background: AppTheme.success.transparentize(88%);
        border-width: 1px;
        border-color: AppTheme.success.transparentize(60%);
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: start;
            Text {
                text: SettingsBridge.modal-endpoint-test-message != "" ? SettingsBridge.modal-endpoint-test-message : @tr("连通正常 (200 OK, 网络通路良好)");
                font-size: 10px;
                font-weight: 600;
                color: AppTheme.success;
                vertical-alignment: center;
            }
        }
    }

    if SettingsBridge.modal-endpoint-test-status == "failed": Rectangle {
        height: 26px;
        border-radius: AppTheme.radius-small;
        background: AppTheme.danger.transparentize(88%);
        border-width: 1px;
        border-color: AppTheme.danger.transparentize(60%);
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: start;
            Text {
                text: SettingsBridge.modal-endpoint-test-message != "" ? SettingsBridge.modal-endpoint-test-message : @tr("连通失败，请检查 Base URL 与 API Key 是否正确");
                font-size: 10px;
                font-weight: 600;
                color: AppTheme.danger;
                vertical-alignment: center;
            }
        }
    }

    // 手动添加模型输入框与按钮
    HorizontalLayout {
        spacing: 6px;
        AppTextInput {
            height: 28px;
            horizontal-stretch: 1;
            text <=> SettingsBridge.modal-endpoint-new-model-input;
            placeholder: @tr("输入模型标识，例如 deepseek-coder 或 qwen2.5:14b");
        }

        AppButton {
            text: @tr("添加模型");
            variant: "secondary";
            size: "sm";
            height: 28px;
            clicked => {
                SettingsBridge.modal-add-model(SettingsBridge.modal-endpoint-new-model-input);
            }
        }
    }

    // 已配置模型列表滚动区 (标签展示 + 设为默认 + 删除)
    Rectangle {
        height: 260px;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: AppTheme.border;
        clip: true;

        Flickable {
            width: 100%;
            height: 100%;
            content-height: Math.max(self.height, SettingsBridge.modal-endpoint-models-list.length * 30px + 8px);

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                if SettingsBridge.modal-endpoint-models-list.length == 0: Rectangle {
                    height: 60px;
                    Text {
                        text: @tr("暂无模型，请点击上方「一键获取模型」或手动添加");
                        font-size: 10px;
                        color: AppTheme.disabled-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for m in SettingsBridge.modal-endpoint-models-list: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(85%) :
                                m-touch.has-hover ? AppTheme.hover-background : transparent;
                    border-width: 1px;
                    border-color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(60%) : transparent;

                    m-touch := TouchArea {
                        clicked => {
                            SettingsBridge.modal-select-model(m);
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: m == SettingsBridge.modal-endpoint-selected-model ? @image-url("../../../assets/icons/sparkles.svg") : @image-url("../../../assets/icons/server.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.secondary-foreground;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: m;
                                    font-size: 10px;
                                    font-weight: m == SettingsBridge.modal-endpoint-selected-model ? 700 : 400;
                                    color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.foreground;
                                    overflow: elide;
                                }
                            }

                            if m == SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 14px;
                                    border-radius: 3px;
                                    background: AppTheme.accent.transparentize(80%);
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: @tr("默认");
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: AppTheme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;

                            if m != SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    border-radius: 3px;
                                    background: set-def.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    set-def := TouchArea {
                                        clicked => {
                                            SettingsBridge.modal-select-model(m);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: @tr("设为默认");
                                            font-size: 8px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                AppIconButton {
                                    icon: @image-url("../../../assets/icons/trash.svg");
                                    clicked => {
                                        SettingsBridge.modal-remove-model(m);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 默认推理模型下拉选择框
    VerticalLayout {
        spacing: 3px;
        Text {
            text: @tr("默认推理模型 (Selected Model)");
            font-size: 10px;
            font-weight: 600;
            color: AppTheme.foreground;
        }

        Rectangle {
            height: 30px;
            border-radius: AppTheme.radius-medium;
            background: sel-m-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
            border-width: 1px;
            border-color: sel-m-touch.has-hover ? AppTheme.accent : AppTheme.border;

            sel-m-touch := TouchArea {
                clicked => {
                    sel-m-popup.show();
                }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                Text {
                    text: SettingsBridge.modal-endpoint-selected-model != "" ? SettingsBridge.modal-endpoint-selected-model : @tr("请选择默认推理模型...");
                    font-size: 11px;
                    font-weight: 500;
                    color: SettingsBridge.modal-endpoint-selected-model != "" ? AppTheme.foreground : AppTheme.disabled-foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    font-size: 8px;
                    color: AppTheme.secondary-foreground;
                    vertical-alignment: center;
                }
            }

            sel-m-popup := PopupWindow {
                x: 0px;
                y: parent.height + 4px;
                width: parent.width;
                height: Math.min(200px, Math.max(44px, SettingsBridge.modal-endpoint-models-list.length * 28px + 10px));
                close-policy: close-on-click-outside;

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: AppTheme.radius-medium;
                    background: AppTheme.modal-background;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000099;
                    clip: true;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: Math.max(self.height, SettingsBridge.modal-endpoint-models-list.length * 28px + 10px);

                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            if SettingsBridge.modal-endpoint-models-list.length == 0: Rectangle {
                                height: 36px;
                                Text {
                                    text: @tr("暂无可用模型，请先在上方添加或获取模型");
                                    font-size: 10px;
                                    color: AppTheme.disabled-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for m in SettingsBridge.modal-endpoint-models-list: Rectangle {
                                height: 26px;
                                border-radius: 3px;
                                background: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(80%) :
                                            pi-touch.has-hover ? AppTheme.hover-background : transparent;

                                pi-touch := TouchArea {
                                    clicked => {
                                        SettingsBridge.modal-endpoint-selected-model = m;
                                        SettingsBridge.modal-select-model(m);
                                        sel-m-popup.close();
                                    }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        horizontal-stretch: 1;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: m == SettingsBridge.modal-endpoint-selected-model ? @image-url("../../../assets/icons/sparkles.svg") : @image-url("../../../assets/icons/server.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: m;
                                                font-size: 10px;
                                                font-weight: m == SettingsBridge.modal-endpoint-selected-model ? 700 : 500;
                                                color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.foreground;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    if m == SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            Image {
                                                source: @image-url("../../../assets/icons/check.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: AppTheme.accent;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 默认思考度下拉选择框 (Thinking Effort)
    VerticalLayout {
        spacing: 3px;
        Text {
            text: @tr("默认思考深度档位 (Thinking Effort)");
            font-size: 10px;
            font-weight: 600;
            color: AppTheme.foreground;
        }

        AppDropdown {
            items: [
                { id: "disabled", label: @tr("关闭思考 (Disabled)") },
                { id: "low", label: @tr("快速思考 (Low)") },
                { id: "medium", label: @tr("标准推荐 (Medium)") },
                { id: "high", label: @tr("最大深度推理 (High)") },
            ];
            active-id: SettingsBridge.modal-endpoint-thinking-degree;
            active-label: SettingsBridge.modal-endpoint-thinking-degree == "disabled" ? @tr("关闭思考 (Disabled)") :
                          SettingsBridge.modal-endpoint-thinking-degree == "low" ? @tr("快速思考 (Low)") :
                          SettingsBridge.modal-endpoint-thinking-degree == "high" ? @tr("最大深度推理 (High)") : @tr("标准推荐 (Medium)");
            selected(id, label) => {
                SettingsBridge.modal-endpoint-thinking-degree = id;
            }
        }
    }
}

export { AiEndpointModelsSection }

