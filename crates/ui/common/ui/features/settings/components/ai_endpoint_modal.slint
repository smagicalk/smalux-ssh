import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge } from "../settings_bridge.slint";
import { AppButton, AppIconButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";
import { AppDropdown, DropdownItemData } from "../../../shared/base/app-dropdown.slint";

/// 添加 / 编辑 AI 端点端口全功能模态弹窗 (AiEndpointModal)
/// 一站式完成端点基础连接、支持模型库管理、默认模型/思考度设定、连通性验证以及高级参数配置
export component AiEndpointModal inherits Rectangle {
    visible: SettingsBridge.is-ai-endpoint-modal-open;
    width: 100%;
    height: 100%;
    background: #000000b3;
    z: 1000;

    TouchArea {
        clicked => { SettingsBridge.is-ai-endpoint-modal-open = false; }
    }

    Rectangle {
        width: Math.min(960px, parent.width - 32px);
        height: Math.min(780px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: AppTheme.radius-large;
        background: AppTheme.modal-background;
        border-width: 1.5px;
        border-color: AppTheme.border;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000099;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {} // 阻断弹窗内容区点击穿透

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // 1. 顶部标题栏
            HorizontalLayout {
                alignment: space-between;
                height: 32px;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: SettingsBridge.is-ai-endpoint-editing ? @tr("编辑 AI 端点端口与模型") : @tr("添加 AI 端点端口与模型");
                        font-size: 15px;
                        font-weight: 700;
                        color: AppTheme.foreground;
                    }
                    Text {
                        text: @tr("一站式配置 API 端点、拉取模型库、测试连通性与高级网络参数");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    AppIconButton {
                        icon: @image-url("../../../assets/icons/window-close.svg");
                        clicked => { SettingsBridge.is-ai-endpoint-modal-open = false; }
                    }
                }
            }

            // 分割线
            Rectangle {
                height: 1px;
                background: AppTheme.border;
            }

            // 2. 表单核心滚动区 (Flickable 自适应高度)
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                form-scroll := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: form-layout.preferred-height;

                    form-layout := VerticalLayout {
                        spacing: 14px;
                        padding-right: 6px;
                        padding-bottom: 12px;

                        // =====================================================
                        // 区块 1: 基础连接配置 (Basic Connection)
                        // =====================================================
                        VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../../assets/icons/server.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: AppTheme.accent;
                                    }
                                }
                                Text {
                                    text: @tr("基础连接信息");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppTheme.foreground;
                                }
                            }

                            // 端点名称
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("端点名称");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }
                                AppTextInput {
                                    height: 30px;
                                    text <=> SettingsBridge.modal-endpoint-name;
                                    placeholder: @tr("例如: DeepSeek 官方 / Ollama 本地 / 硅基流动");
                                }
                            }

                            // 接口地址 (Base URL)
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("API 接口地址 (Base URL)");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }
                                AppTextInput {
                                    height: 30px;
                                    text <=> SettingsBridge.modal-endpoint-base-url;
                                    placeholder: "https://api.deepseek.com/v1 或 http://localhost:11434/v1";
                                }
                            }

                            // API 请求协议模式 (统一规范下拉选择框)
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("API 请求协议模式");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }
                                AppDropdown {
                                    items: [
                                        { id: "chat", label: @tr("OpenAI Chat 模式 (/v1/chat/completions)") },
                                        { id: "response", label: @tr("OpenAI Responses 模式 (/v1/responses)") },
                                    ];
                                    active-id: SettingsBridge.modal-endpoint-api-mode;
                                    active-label: SettingsBridge.modal-endpoint-api-mode == "response" ? @tr("OpenAI Responses 模式 (/v1/responses)") : @tr("OpenAI Chat 模式 (/v1/chat/completions)");
                                    selected(id, label) => {
                                        SettingsBridge.modal-endpoint-api-mode = id;
                                    }
                                }
                            }

                            // API Key
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("API 密钥 (API Key)");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }
                                AppPasswordInput {
                                    height: 30px;
                                    text <=> SettingsBridge.modal-endpoint-api-key;
                                    placeholder: "sk-... (本地无授权私有端点可留空)";
                                }
                            }
                        }

                        // 分割线
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border.transparentize(50%);
                        }

                        // =====================================================
                        // 区块 2: 模型库管理与连通性测试 (Models & Verification)
                        // =====================================================
                        VerticalLayout {
                            spacing: 8px;

                            // 标题行与快捷功能按钮
                            HorizontalLayout {
                                alignment: space-between;
                                height: 26px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../../../assets/icons/sparkles.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.accent;
                                        }
                                    }
                                    Text {
                                        text: @tr("模型库与连通性验证");
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;

                                    // 测试 API 连通性按钮
                                    AppButton {
                                        text: SettingsBridge.modal-endpoint-test-status == "testing" ? @tr("正在测试...") : @tr("测试连通性");
                                        variant: "secondary";
                                        size: "sm";
                                        has-icon: true;
                                        icon: @image-url("../../../assets/icons/refresh.svg");
                                        height: 24px;
                                        clicked => {
                                            SettingsBridge.modal-test-connection();
                                        }
                                    }

                                    // 一键远端拉取模型按钮
                                    AppButton {
                                        text: SettingsBridge.modal-endpoint-is-fetching-models ? @tr("正在获取...") : @tr("一键获取模型");
                                        variant: "secondary";
                                        size: "sm";
                                        has-icon: true;
                                        icon: @image-url("../../../assets/icons/refresh.svg");
                                        height: 24px;
                                        clicked => {
                                            SettingsBridge.modal-fetch-models();
                                        }
                                    }
                                }
                            }

                            // 连通性测试结果提示条
                            if SettingsBridge.modal-endpoint-test-status == "testing": Rectangle {
                                height: 26px;
                                border-radius: AppTheme.radius-small;
                                background: AppTheme.accent.transparentize(88%);
                                border-width: 1px;
                                border-color: AppTheme.accent.transparentize(60%);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: @tr("正在向目标 Base URL 与接口发送探活请求...");
                                        font-size: 10px;
                                        color: AppTheme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if SettingsBridge.modal-endpoint-test-status == "success": Rectangle {
                                height: 26px;
                                border-radius: AppTheme.radius-small;
                                background: AppTheme.success.transparentize(88%);
                                border-width: 1px;
                                border-color: AppTheme.success.transparentize(60%);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: SettingsBridge.modal-endpoint-test-message != "" ? SettingsBridge.modal-endpoint-test-message : @tr("连通正常 (200 OK, 网络通路良好)");
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppTheme.success;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if SettingsBridge.modal-endpoint-test-status == "failed": Rectangle {
                                height: 26px;
                                border-radius: AppTheme.radius-small;
                                background: AppTheme.danger.transparentize(88%);
                                border-width: 1px;
                                border-color: AppTheme.danger.transparentize(60%);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: SettingsBridge.modal-endpoint-test-message != "" ? SettingsBridge.modal-endpoint-test-message : @tr("连通失败，请检查 Base URL 与 API Key 是否正确");
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppTheme.danger;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 手动添加模型输入框与按钮
                            HorizontalLayout {
                                spacing: 6px;
                                AppTextInput {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    text <=> SettingsBridge.modal-endpoint-new-model-input;
                                    placeholder: @tr("输入模型标识，例如 deepseek-coder 或 qwen2.5:14b");
                                }

                                AppButton {
                                    text: @tr("添加模型");
                                    variant: "secondary";
                                    size: "sm";
                                    height: 28px;
                                    clicked => {
                                        SettingsBridge.modal-add-model(SettingsBridge.modal-endpoint-new-model-input);
                                    }
                                }
                            }

                            // 已配置模型列表滚动区 (标签展示 + 设为默认 + 删除)
                            Rectangle {
                                height: 260px;
                                border-radius: AppTheme.radius-medium;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                clip: true;

                                Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-height: Math.max(self.height, SettingsBridge.modal-endpoint-models-list.length * 30px + 8px);

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;

                                        if SettingsBridge.modal-endpoint-models-list.length == 0: Rectangle {
                                            height: 60px;
                                            Text {
                                                text: @tr("暂无模型，请点击上方「一键获取模型」或手动添加");
                                                font-size: 10px;
                                                color: AppTheme.disabled-foreground;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        for m in SettingsBridge.modal-endpoint-models-list: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(85%) :
                                                        m-touch.has-hover ? AppTheme.hover-background : transparent;
                                            border-width: 1px;
                                            border-color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(60%) : transparent;

                                            m-touch := TouchArea {
                                                clicked => {
                                                    SettingsBridge.modal-select-model(m);
                                                }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 6px;
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    horizontal-stretch: 1;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: m == SettingsBridge.modal-endpoint-selected-model ? @image-url("../../../assets/icons/sparkles.svg") : @image-url("../../../assets/icons/server.svg");
                                                            width: 11px;
                                                            height: 11px;
                                                            colorize: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.secondary-foreground;
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: m;
                                                            font-size: 10px;
                                                            font-weight: m == SettingsBridge.modal-endpoint-selected-model ? 700 : 400;
                                                            color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.foreground;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    if m == SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            height: 14px;
                                                            border-radius: 3px;
                                                            background: AppTheme.accent.transparentize(80%);
                                                            HorizontalLayout {
                                                                padding-left: 4px;
                                                                padding-right: 4px;
                                                                Text {
                                                                    text: @tr("默认");
                                                                    font-size: 8px;
                                                                    font-weight: 700;
                                                                    color: AppTheme.accent;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: end;

                                                    if m != SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            height: 18px;
                                                            border-radius: 3px;
                                                            background: set-def.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                                            border-width: 1px;
                                                            border-color: AppTheme.border;
                                                            set-def := TouchArea {
                                                                clicked => {
                                                                    SettingsBridge.modal-select-model(m);
                                                                }
                                                                mouse-cursor: pointer;
                                                            }
                                                            HorizontalLayout {
                                                                padding-left: 4px;
                                                                padding-right: 4px;
                                                                Text {
                                                                    text: @tr("设为默认");
                                                                    font-size: 8px;
                                                                    color: AppTheme.secondary-foreground;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        AppIconButton {
                                                            icon: @image-url("../../../assets/icons/trash.svg");
                                                            clicked => {
                                                                SettingsBridge.modal-remove-model(m);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 默认推理模型下拉选择框
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("默认推理模型 (Selected Model)");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }

                                Rectangle {
                                    height: 30px;
                                    border-radius: AppTheme.radius-medium;
                                    background: sel-m-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: sel-m-touch.has-hover ? AppTheme.accent : AppTheme.border;

                                    sel-m-touch := TouchArea {
                                        clicked => {
                                            sel-m-popup.show();
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;

                                        Text {
                                            text: SettingsBridge.modal-endpoint-selected-model != "" ? SettingsBridge.modal-endpoint-selected-model : @tr("请选择默认推理模型...");
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: SettingsBridge.modal-endpoint-selected-model != "" ? AppTheme.foreground : AppTheme.disabled-foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: "▼";
                                            font-size: 8px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }

                                    sel-m-popup := PopupWindow {
                                        x: 0px;
                                        y: parent.height + 4px;
                                        width: parent.width;
                                        height: Math.min(200px, Math.max(44px, SettingsBridge.modal-endpoint-models-list.length * 28px + 10px));
                                        close-policy: close-on-click-outside;

                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            border-radius: AppTheme.radius-medium;
                                            background: AppTheme.modal-background;
                                            border-width: 1px;
                                            border-color: AppTheme.border;
                                            drop-shadow-blur: 16px;
                                            drop-shadow-color: #00000099;
                                            clip: true;

                                            Flickable {
                                                width: 100%;
                                                height: 100%;
                                                viewport-height: Math.max(self.height, SettingsBridge.modal-endpoint-models-list.length * 28px + 10px);

                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 2px;

                                                    if SettingsBridge.modal-endpoint-models-list.length == 0: Rectangle {
                                                        height: 36px;
                                                        Text {
                                                            text: @tr("暂无可用模型，请先在上方添加或获取模型");
                                                            font-size: 10px;
                                                            color: AppTheme.disabled-foreground;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    for m in SettingsBridge.modal-endpoint-models-list: Rectangle {
                                                        height: 26px;
                                                        border-radius: 3px;
                                                        background: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent.transparentize(80%) :
                                                                    pi-touch.has-hover ? AppTheme.hover-background : transparent;

                                                        pi-touch := TouchArea {
                                                            clicked => {
                                                                SettingsBridge.modal-endpoint-selected-model = m;
                                                                SettingsBridge.modal-select-model(m);
                                                                sel-m-popup.close();
                                                            }
                                                            mouse-cursor: pointer;
                                                        }

                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            alignment: space-between;

                                                            HorizontalLayout {
                                                                spacing: 6px;
                                                                alignment: start;
                                                                horizontal-stretch: 1;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: m == SettingsBridge.modal-endpoint-selected-model ? @image-url("../../../assets/icons/sparkles.svg") : @image-url("../../../assets/icons/server.svg");
                                                                        width: 11px;
                                                                        height: 11px;
                                                                        colorize: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.secondary-foreground;
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Text {
                                                                        text: m;
                                                                        font-size: 10px;
                                                                        font-weight: m == SettingsBridge.modal-endpoint-selected-model ? 700 : 500;
                                                                        color: m == SettingsBridge.modal-endpoint-selected-model ? AppTheme.accent : AppTheme.foreground;
                                                                        vertical-alignment: center;
                                                                        overflow: elide;
                                                                    }
                                                                }
                                                            }

                                                            if m == SettingsBridge.modal-endpoint-selected-model: VerticalLayout {
                                                                alignment: center;
                                                                Rectangle {
                                                                    width: 14px;
                                                                    height: 14px;
                                                                    Image {
                                                                        source: @image-url("../../../assets/icons/check.svg");
                                                                        width: 12px;
                                                                        height: 12px;
                                                                        colorize: AppTheme.accent;
                                                                        image-fit: contain;
                                                                        x: (parent.width - self.width) / 2;
                                                                        y: (parent.height - self.height) / 2;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 默认思考度下拉选择框 (Thinking Effort)
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: @tr("默认思考深度档位 (Thinking Effort)");
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                }

                                AppDropdown {
                                    items: [
                                        { id: "disabled", label: @tr("关闭思考 (Disabled)") },
                                        { id: "low", label: @tr("快速思考 (Low)") },
                                        { id: "medium", label: @tr("标准推荐 (Medium)") },
                                        { id: "high", label: @tr("最大深度推理 (High)") },
                                    ];
                                    active-id: SettingsBridge.modal-endpoint-thinking-degree;
                                    active-label: SettingsBridge.modal-endpoint-thinking-degree == "disabled" ? @tr("关闭思考 (Disabled)") :
                                                  SettingsBridge.modal-endpoint-thinking-degree == "low" ? @tr("快速思考 (Low)") :
                                                  SettingsBridge.modal-endpoint-thinking-degree == "high" ? @tr("最大深度推理 (High)") : @tr("标准推荐 (Medium)");
                                    selected(id, label) => {
                                        SettingsBridge.modal-endpoint-thinking-degree = id;
                                    }
                                }
                            }
                        }

                        // 分割线
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border.transparentize(50%);
                        }

                        // =====================================================
                        // 区块 3: 高级运行时参数 (折叠面板 / Advanced Settings)
                        // =====================================================
                        VerticalLayout {
                            spacing: 8px;

                            // 折叠/展开触发栏
                            Rectangle {
                                height: 32px;
                                border-radius: AppTheme.radius-medium;
                                background: adv-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                adv-touch := TouchArea {
                                    clicked => {
                                        SettingsBridge.modal-endpoint-show-advanced = !SettingsBridge.modal-endpoint-show-advanced;
                                    }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../../../assets/icons/settings.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: AppTheme.accent;
                                            }
                                        }
                                        Text {
                                            text: @tr("高级参数设置 (超时 / 上下文 / 重试 / 自定义请求头)");
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: AppTheme.foreground;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: SettingsBridge.modal-endpoint-show-advanced ? "▲" : "▼";
                                            font-size: 8px;
                                            color: AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 展开的高级表单项
                            if SettingsBridge.modal-endpoint-show-advanced: VerticalLayout {
                                spacing: 10px;
                                padding-left: 4px;
                                padding-right: 4px;

                                // 1. 超时时间 (带单位: 秒)
                                VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: @tr("最长执行时长 / 请求超时");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: AppTheme.foreground;
                                        }
                                        Text {
                                            text: @tr("单位: 秒");
                                            font-size: 9px;
                                            color: AppTheme.secondary-foreground;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        // 快捷档位
                                        for to in [
                                            { val: 30, label: "30s" },
                                            { val: 60, label: "60s" },
                                            { val: 120, label: "120s" },
                                            { val: 300, label: "300s" },
                                        ]: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: SettingsBridge.modal-endpoint-timeout-secs == to.val ? AppTheme.accent.transparentize(80%) :
                                                        to-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: SettingsBridge.modal-endpoint-timeout-secs == to.val ? AppTheme.accent : AppTheme.border;
                                            to-touch := TouchArea {
                                                clicked => {
                                                    SettingsBridge.modal-endpoint-timeout-secs = to.val;
                                                    SettingsBridge.modal-endpoint-timeout-secs-input = to.val;
                                                }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: to.label;
                                                    font-size: 10px;
                                                    font-weight: SettingsBridge.modal-endpoint-timeout-secs == to.val ? 700 : 400;
                                                    color: SettingsBridge.modal-endpoint-timeout-secs == to.val ? AppTheme.accent : AppTheme.foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 输入框 + 单位 (使用 AppTextInput 原生 suffix-text，消除多层边框与冗余 padding)
                                        AppTextInput {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            text <=> SettingsBridge.modal-endpoint-timeout-secs-input;
                                            placeholder: "60";
                                            suffix-text: @tr("秒");
                                        }
                                    }
                                }

                                // 2. 最大上下文长度 (带单位: Token)
                                VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: @tr("最大上下文窗口限制");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: AppTheme.foreground;
                                        }
                                        Text {
                                            text: @tr("单位: Token");
                                            font-size: 9px;
                                            color: AppTheme.secondary-foreground;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        for ctx-item in [
                                            { val: 16384, label: "16K" },
                                            { val: 32768, label: "32K" },
                                            { val: 65536, label: "64K" },
                                            { val: 131072, label: "128K" },
                                        ]: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: SettingsBridge.modal-endpoint-max-context == ctx-item.val ? AppTheme.accent.transparentize(80%) :
                                                        ctx-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: SettingsBridge.modal-endpoint-max-context == ctx-item.val ? AppTheme.accent : AppTheme.border;
                                            ctx-touch := TouchArea {
                                                clicked => {
                                                    SettingsBridge.modal-endpoint-max-context = ctx-item.val;
                                                    SettingsBridge.modal-endpoint-max-context-input = ctx-item.val;
                                                }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: ctx-item.label;
                                                    font-size: 10px;
                                                    font-weight: SettingsBridge.modal-endpoint-max-context == ctx-item.val ? 700 : 400;
                                                    color: SettingsBridge.modal-endpoint-max-context == ctx-item.val ? AppTheme.accent : AppTheme.foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 输入框 + 单位 (使用 AppTextInput 原生 suffix-text)
                                        AppTextInput {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            text <=> SettingsBridge.modal-endpoint-max-context-input;
                                            placeholder: "32768";
                                            suffix-text: "Token";
                                        }
                                    }
                                }

                                // 3. 失败重试次数 (带单位: 次)
                                VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: @tr("网络抖动自动重试次数");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: AppTheme.foreground;
                                        }
                                        Text {
                                            text: @tr("单位: 次");
                                            font-size: 9px;
                                            color: AppTheme.secondary-foreground;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        for ret in [
                                            { val: 0, label: "0" },
                                            { val: 1, label: "1" },
                                            { val: 2, label: "2" },
                                            { val: 3, label: "3" },
                                        ]: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: SettingsBridge.modal-endpoint-max-retries == ret.val ? AppTheme.accent.transparentize(80%) :
                                                        r-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                            border-width: 1px;
                                            border-color: SettingsBridge.modal-endpoint-max-retries == ret.val ? AppTheme.accent : AppTheme.border;
                                            r-touch := TouchArea {
                                                clicked => {
                                                    SettingsBridge.modal-endpoint-max-retries = ret.val;
                                                    SettingsBridge.modal-endpoint-max-retries-input = ret.val;
                                                }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: ret.label + @tr("次");
                                                    font-size: 10px;
                                                    font-weight: SettingsBridge.modal-endpoint-max-retries == ret.val ? 700 : 400;
                                                    color: SettingsBridge.modal-endpoint-max-retries == ret.val ? AppTheme.accent : AppTheme.foreground;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 输入框 + 单位 (使用 AppTextInput 原生 suffix-text)
                                        AppTextInput {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            text <=> SettingsBridge.modal-endpoint-max-retries-input;
                                            placeholder: "2";
                                            suffix-text: @tr("次");
                                        }
                                    }
                                }
                                // 4. 自定义请求头 (Custom Headers)
                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: @tr("自定义请求头 (Custom HTTP Headers)");
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                    }
                                    AppTextInput {
                                        height: 28px;
                                        text <=> SettingsBridge.modal-endpoint-custom-headers;
                                        placeholder: "例如: X-Org-ID: devops, X-Proxy-Auth: secret";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 分割线
            Rectangle {
                height: 1px;
                background: AppTheme.border;
            }

            // 3. 底部操作栏
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                height: 32px;

                AppButton {
                    text: @tr("取消");
                    variant: "ghost";
                    height: 32px;
                    clicked => {
                        SettingsBridge.is-ai-endpoint-modal-open = false;
                    }
                }

                AppButton {
                    text: SettingsBridge.is-ai-endpoint-editing ? @tr("保存端点修改") : @tr("确认添加端点");
                    variant: "primary";
                    height: 32px;
                    clicked => {
                        SettingsBridge.save-ai-endpoint-modal();
                    }
                }
            }
        }
    }
}
