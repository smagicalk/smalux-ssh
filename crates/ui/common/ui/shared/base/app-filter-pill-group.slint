import { AppTheme } from "../../themes/app-theme.slint";

/// 分类过滤单选胶囊数据模型
export struct FilterPillItem {
    id: string,
    label: string,
    icon: image,
    badge-count: int,
}

/// 标准统一分类过滤胶囊单选组组件 (AppFilterPillGroup)
///
/// 核心特性：
/// 1. 声明式数据驱动：传入 FilterPillItem 数组即可自动渲染分类单选组；
/// 2. 彻底淘汰全站 6+ 处手动复制 4~5 个 Rectangle 的高冗余样板代码；
/// 3. 支持内联图标与微型数字角标；
/// 4. 激活项品牌强调色高亮、平滑悬停与圆角工业风。
export component AppFilterPillGroup inherits HorizontalLayout {
    in property <[FilterPillItem]> items: [];
    in-out property <string> active-id: "";
    in property <length> pill-height: 26px;
    in property <bool> stretch-items: false;
    in property <bool> segmented: false;

    callback selected(string);

    spacing: root.segmented ? 2px : 6px;
    alignment: root.stretch-items ? stretch : start;

    for item in root.items: Rectangle {
        horizontal-stretch: root.stretch-items ? 1 : 0;
        height: root.pill-height;
        border-radius: root.segmented ? 3px : AppTheme.radius-medium;
        background: root.segmented
            ? (root.active-id == item.id ? AppTheme.selected-background : pill-touch.has-hover ? AppTheme.hover-background : transparent)
            : (root.active-id == item.id ? AppTheme.accent : pill-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background);
        border-width: 1px;
        border-color: root.segmented
            ? (root.active-id == item.id ? AppTheme.accent : transparent)
            : (root.active-id == item.id ? AppTheme.accent : AppTheme.border);

        animate background { duration: 120ms; }
        animate border-color { duration: 120ms; }

        pill-touch := TouchArea {
            clicked => {
                root.active-id = item.id;
                root.selected(item.id);
            }
            mouse-cursor: pointer;
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 5px;
            alignment: center;

            // 可选图标
            if item.icon.width > 0: VerticalLayout {
                alignment: center;
                width: 12px;
                Image {
                    source: item.icon;
                    width: 12px;
                    height: 12px;
                    image-fit: contain;
                    colorize: root.active-id == item.id ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                }
            }

            // 选项文字
            Text {
                text: item.label;
                font-size: 11px;
                font-weight: root.active-id == item.id ? 700 : 500;
                color: root.active-id == item.id ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // 可选数字角标
            if item.badge-count > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 14px;
                    border-radius: 7px;
                    background: root.active-id == item.id ? #ffffff35 : AppTheme.hover-background;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        alignment: center;
                        Text {
                            text: item.badge-count;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-id == item.id ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
