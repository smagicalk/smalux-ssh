import { AppTheme } from "../../themes/app-theme.slint";

/// 全景单栏/流式工作台通用脚手架 (App Page Scaffold)
/// 全自动适配全局壁纸透光与自适应布局，任何未来新增页面可直接套用
export component AppPageScaffold inherits Rectangle {
    in property <string> page-title: "";
    in property <string> page-subtitle: "";
    in property <image> page-icon;
    in property <bool> has-page-icon: false;
    in property <bool> show-header: true;
    in property <length> outer-padding: 14px;
    in property <length> content-spacing: 12px;

    // 自适应壁纸透光：在 global 壁纸下自动透底
    background: AppTheme.window-background;

    VerticalLayout {
        padding: root.outer-padding;
        spacing: root.content-spacing;

        // 1. 顶部 Header 悬浮操作栏
        if root.show-header: Rectangle {
            height: 48px;
            border-radius: AppTheme.radius-large;
            background: AppTheme.panel-background;
            border-width: 1px;
            border-color: AppTheme.border;
            clip: true;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    if root.has-page-icon: Image {
                        source: root.page-icon;
                        width: 20px;
                        height: 20px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.page-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                        }

                        if root.page-subtitle != "": Text {
                            text: root.page-subtitle;
                            font-size: 11px;
                            color: AppTheme.secondary-foreground;
                        }
                    }
                }
            }
        }

        // 2. 中央主工作台区域
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;
        }
    }
}
