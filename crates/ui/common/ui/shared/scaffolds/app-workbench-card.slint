import { AppTheme } from "../../themes/app-theme.slint";

/// 悬浮工作台标准卡片容器 (App Workbench Card)
/// 专为壁纸体系与暗色/亮色主题深度定制，95% 扎实底色彻底杜绝滚动文字眩晕与背景杂音
export component AppWorkbenchCard inherits Rectangle {
    in property <length> card-padding: 14px;
    in property <bool> has-shadow: true;

    border-radius: AppTheme.radius-large;
    background: AppTheme.surface-background;
    border-width: 1px;
    border-color: AppTheme.border;
    clip: true;

    drop-shadow-blur: root.has-shadow ? 14px : 0px;
    drop-shadow-color: root.has-shadow ? #00000020 : transparent;
    drop-shadow-offset-y: root.has-shadow ? 3px : 0px;
}
