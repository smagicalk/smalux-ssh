// =============================================================================
// 文件名称: credential_key_form.slint
// 模块功能: SSH 密钥对配置表单 (Credential Key Form)
// 包含算法选择/一键生成、指纹展示、公钥导出复制、私钥 PEM 录入/遮盖与口令保护
// =============================================================================

import { AppTheme } from "../../../themes/app-theme.slint";
import { AppTextArea } from "../../../shared/base/app-text-area.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";

export component CredentialKeyForm inherits VerticalLayout {
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <bool> show-full-private-key: false;
    in-out property <bool> reveal-passphrase: false;
    in-out property <string> form-algorithm: "Ed25519";
    in-out property <string> form-secret-data: "";
    in-out property <string> form-passphrase: "";
    in-out property <string> form-public-key: "";
    in-out property <string> form-fingerprint: "";

    callback generate-key(string /* algorithm */);
    callback copy-text(string /* text */, string /* title */, string /* msg */);

    alignment: start;
    spacing: 10px;

    // 1. 算法选择与生成
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: (root.is-create-mode || root.is-editing)
                    ? @tr("密钥算法与生成")
                    : (@tr("密钥算法: ") + root.form-algorithm);
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            if root.is-create-mode || root.is-editing: Rectangle {
                height: 20px;
                border-radius: 3px;
                background: gen-k-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                border-width: 1px;
                border-color: AppTheme.border;
                gen-k-touch := TouchArea {
                    clicked => {
                        root.show-full-private-key = true;
                        root.generate-key(root.form-algorithm);
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.is-create-mode ? @tr("一键生成密钥对") : @tr("重新生成密钥对");
                        font-size: 10px;
                        color: AppTheme.foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.is-create-mode || root.is-editing: Rectangle {
            height: 26px;
            border-radius: 4px;
            background: AppTheme.surface-background;
            border-width: 1px;
            border-color: AppTheme.border;
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.form-algorithm == "Ed25519" ? AppTheme.control-background : transparent;
                    border-width: root.form-algorithm == "Ed25519" ? 1px : 0px;
                    border-color: AppTheme.border;
                    TouchArea { clicked => { root.form-algorithm = "Ed25519"; } }
                    Text {
                        text: @tr("Ed25519 (推荐)");
                        font-size: 10px;
                        color: AppTheme.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 3px;
                    background: root.form-algorithm == "RSA-4096" ? AppTheme.control-background : transparent;
                    border-width: root.form-algorithm == "RSA-4096" ? 1px : 0px;
                    border-color: AppTheme.border;
                    TouchArea { clicked => { root.form-algorithm = "RSA-4096"; } }
                    Text {
                        text: "RSA-4096";
                        font-size: 10px;
                        color: AppTheme.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 2. 指纹展示 (若存在)
    if root.form-fingerprint != "": VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("公钥指纹 (SHA256)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;

                Text {
                    text: root.form-fingerprint;
                    font-size: 10px;
                    font-family: "Cascadia Code, Consolas, monospace";
                    color: AppTheme.foreground;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 36px;
                    clicked => {
                        root.copy-text(root.form-fingerprint, @tr("已复制指纹"), @tr("公钥指纹已复制至剪贴板"));
                    }
                    mouse-cursor: pointer;

                    Text {
                        text: @tr("复制");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 3. 导出公钥 (若存在)
    if root.form-public-key != "": VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: @tr("导出的 SSH 公钥 (可配置于目标机器 authorized_keys)");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }
            Rectangle {
                min-width: 50px;
                height: 20px;
                border-radius: 3px;
                background: copy-pub-touch.has-hover ? AppTheme.hover-background : transparent;
                copy-pub-touch := TouchArea {
                    clicked => {
                        root.copy-text(root.form-public-key, @tr("已复制公钥"), @tr("SSH 公钥已复制至剪贴板"));
                    }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: @tr("复制公钥");
                        font-size: 10px;
                        color: AppTheme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        AppTextArea {
            height: 52px;
            text <=> root.form-public-key;
            enabled: root.is-create-mode || root.is-editing;
            font-size: 9px;
            monospace: true;
        }
    }

    // 4. 私钥内容 (OpenSSH PEM)
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        HorizontalLayout {
            width: 100%;
            alignment: space-between;
            Text {
                text: @tr("私钥内容 (OpenSSH PEM 格式) *");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    min-width: 76px;
                    height: 20px;
                    border-radius: 3px;
                    background: toggle-key-touch.has-hover ? AppTheme.hover-background : transparent;
                    toggle-key-touch := TouchArea {
                        clicked => { root.show-full-private-key = !root.show-full-private-key; }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: root.show-full-private-key ? @tr("遮挡私钥") : @tr("完整查看私钥");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.form-secret-data != "": Rectangle {
                    min-width: 56px;
                    height: 20px;
                    border-radius: 3px;
                    background: copy-priv-touch.has-hover ? AppTheme.hover-background : transparent;
                    copy-priv-touch := TouchArea {
                        clicked => {
                            root.copy-text(root.form-secret-data, @tr("已复制私钥"), @tr("私钥文本已成功复制至系统剪贴板"));
                        }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: @tr("复制私钥");
                            font-size: 10px;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        AppTextArea {
            height: root.show-full-private-key ? 110px : 32px;
            text <=> root.form-secret-data;
            enabled: root.is-create-mode || root.is-editing;
            font-size: 9px;
            monospace: true;
            input-type: root.show-full-private-key ? InputType.text : InputType.password;
            animate height { duration: 150ms; }
        }
    }

    // 5. 密钥密码短语 (Passphrase)
    VerticalLayout {
        alignment: start;
        spacing: 3px;
        Text {
            text: @tr("私钥解密密码短语 (Passphrase，无密码留空)");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
        }
        AppPasswordInput {
            text <=> root.form-passphrase;
            enabled: root.is-create-mode || root.is-editing;
            placeholder: @tr("无密码留空");
        }
    }
}
