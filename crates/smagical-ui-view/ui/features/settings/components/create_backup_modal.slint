import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge } from "../settings_bridge.slint";
import { AppButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";

/// 新建与编辑备份容灾任务模态弹窗 (CreateBackupModal)
export component CreateBackupModal inherits Rectangle {
    in-out property <bool> is-edit-mode: false;
    in-out property <string> edit-task-id: "";
    in-out property <string> form-name: "";
    in-out property <string> form-type: "local"; // "local" | "webdav" | "s3" | "gist" | "self_hosted"
    in-out property <string> form-endpoint: "";
    in-out property <string> form-user: "";
    in-out property <string> form-pass: "";
    in-out property <string> form-strategy: "daily"; // "realtime" | "manual" | "hourly" | "daily" | "on_exit"
    in-out property <string> form-retention-val: "10";
    in-out property <string> form-retention-unit: "copies"; // "copies" | "days" | "hours" | "unlimited"
    in-out property <string> form-retention-summary: @tr("保留最近 10 份");

    function update-retention-summary() {
        if root.form-retention-unit == "unlimited" {
            root.form-retention-summary = @tr("永久保留");
        } else if root.form-retention-unit == "days" {
            root.form-retention-summary = @tr("保留最近 ") + root.form-retention-val + @tr(" 天");
        } else if root.form-retention-unit == "hours" {
            root.form-retention-summary = @tr("保留最近 ") + root.form-retention-val + @tr(" 小时");
        } else {
            root.form-retention-summary = @tr("保留最近 ") + root.form-retention-val + @tr(" 份");
        }
    }

    callback close();
    callback save();

    width: 100%;
    height: 100%;
    background: #000000.transparentize(50%);

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: Math.min(620px, parent.width - 32px);
        height: Math.min(610px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: AppTheme.surface-background;
        border-width: 1px;
        border-color: AppTheme.border;
        clip: true;

        TouchArea {}

        VerticalLayout {
            padding: 24px;
            spacing: 13px;
            alignment: space-between;

            // 标题栏
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: root.is-edit-mode ? @tr("编辑备份容灾节点") : @tr("创建新的备份容灾节点");
                        font-size: 15px;
                        font-weight: 700;
                        color: AppTheme.foreground;
                    }
                    Text {
                        text: root.is-edit-mode ? @tr("修改当前备份节点的存储端点、认证凭据、同步策略与快照生命周期") :
                                                 @tr("支持将资产库定时或实时同步至本地存储盘、私有 WebDAV、S3 或自建服务器");
                        font-size: 11px;
                        color: AppTheme.secondary-foreground;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: cx-t.has-hover ? AppTheme.hover-background : transparent;
                    cx-t := TouchArea {
                        clicked => { root.close(); }
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: "×";
                        font-size: 16px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // 表单字段列表 (全宽占满设计)
            VerticalLayout {
                spacing: 11px;

                // 1. 任务名称
                VerticalLayout {
                    spacing: 3px;
                    Text { text: @tr("备份任务名称 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    AppTextInput {
                        width: 100%;
                        size: "sm";
                        placeholder: @tr("例如: 个人 NAS WebDAV 每日备份 / 本地机械硬盘归档...");
                        text <=> root.form-name;
                    }
                }

                // 2. 存储协议类型 (等宽横向占满)
                VerticalLayout {
                    spacing: 3px;
                    Text { text: @tr("存储协议类型 *"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    HorizontalLayout {
                        spacing: 6px;
                        for tp in [
                            { id: "local", name: @tr("本地磁盘") },
                            { id: "webdav", name: "WebDAV" },
                            { id: "s3", name: "Amazon S3" },
                            { id: "gist", name: "GitHub Gist" },
                            { id: "self_hosted", name: @tr("自建服务端") }
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            property <bool> is-sel: root.form-type == tp.id;
                            height: 28px;
                            border-radius: 4px;
                            background: is-sel ? AppTheme.accent : tp-t.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px;
                            border-color: is-sel ? AppTheme.accent : AppTheme.border;
                            tp-t := TouchArea {
                                clicked => { root.form-type = tp.id; }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: tp.name;
                                    font-size: 11px;
                                    font-weight: is-sel ? 700 : 400;
                                    color: is-sel ? AppTheme.selected-foreground : AppTheme.foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 3. 存储端点 / 路径 (本地模式支持直接浏览选择文件夹)
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: root.form-type == "local" ? @tr("本地备份保存目录路径 *") :
                              root.form-type == "gist" ? @tr("Gist ID (留空则新建公开/私有 Gist)") : @tr("服务器 URL / Endpoint / Bucket *");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        AppTextInput {
                            horizontal-stretch: 1;
                            size: "sm";
                            placeholder: root.form-type == "local" ? "D:\\smalux_backups" : "https://dav.example.com/remote.php/webdav";
                            text <=> root.form-endpoint;
                        }
                        if root.form-type == "local": AppButton {
                            text: @tr("浏览...");
                            size: "sm";
                            variant: "secondary";
                            has-icon: true;
                            icon: @image-url("../../../assets/icons/folder.svg");
                            clicked => {
                                SettingsBridge.browse-backup-local-dir();
                            }
                        }
                    }
                }

                // 4. 账号与认证口令 (根据类型展示)
                if root.form-type != "local": HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text {
                            text: root.form-type == "gist" ? @tr("GitHub 个人访问令牌 (PAT) *") : @tr("用户名 / Access Key");
                            font-size: 10px;
                            color: AppTheme.secondary-foreground;
                        }
                        AppTextInput {
                            width: 100%;
                            size: "sm";
                            text <=> root.form-user;
                        }
                    }
                    if root.form-type != "gist": VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: @tr("密码 / Secret Key"); font-size: 10px; color: AppTheme.secondary-foreground; }
                        AppPasswordInput {
                            width: 100%;
                            size: "sm";
                            text <=> root.form-pass;
                        }
                    }
                }

                // 5. 备份调度策略 (包含实时同步、每天、每小时、退出时、手动同步，等宽横向占满)
                VerticalLayout {
                    spacing: 3px;
                    Text { text: @tr("自动备份同步策略"); font-size: 10px; color: AppTheme.secondary-foreground; }
                    HorizontalLayout {
                        spacing: 6px;
                        for st in [
                            { id: "realtime", name: @tr("实时同步") },
                            { id: "daily", name: @tr("每天定时") },
                            { id: "hourly", name: @tr("每小时") },
                            { id: "on_exit", name: @tr("软件退出时") },
                            { id: "manual", name: @tr("仅手动同步") }
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            property <bool> is-sel: root.form-strategy == st.id;
                            height: 28px;
                            border-radius: 4px;
                            background: is-sel ? AppTheme.accent : st-t.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                            border-width: 1px;
                            border-color: is-sel ? AppTheme.accent : AppTheme.border;
                            st-t := TouchArea {
                                clicked => { root.form-strategy = st.id; }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: st.name;
                                    font-size: 10px;
                                    font-weight: is-sel ? 700 : 400;
                                    color: is-sel ? AppTheme.selected-foreground : AppTheme.foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.form-strategy == "realtime" ? @tr("策略说明: 监听配置与主机资产修改事件，发生变更时自动实时触发增量同步") :
                              root.form-strategy == "daily" ? @tr("策略说明: 每天固定时间静默自动备份一次增量快照") :
                              root.form-strategy == "hourly" ? @tr("策略说明: 每隔 1 小时自动进行增量备份与校验") :
                              root.form-strategy == "on_exit" ? @tr("策略说明: 软件安全退出时自动生成并推送最新快照") :
                              @tr("策略说明: 仅在设置中心手动点击「立即增量同步」时触发备份");
                        font-size: 10px;
                        color: AppTheme.accent;
                    }
                }

                // 6. 历史快照清理与版本保留策略 (支持直接输入数值 + 快捷预设)
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: @tr("快照清理与版本保留策略 (Retention Policy)"); font-size: 10px; color: AppTheme.secondary-foreground; }
                        Text { text: root.form-retention-summary; font-size: 10px; font-weight: 700; color: AppTheme.accent; }
                    }

                    // 上行: 数值直接输入 + 单位切换胶囊 (占满整行)
                    HorizontalLayout {
                        spacing: 8px;

                        if root.form-retention-unit != "unlimited": AppTextInput {
                            width: 120px;
                            size: "sm";
                            placeholder: "10";
                            text <=> root.form-retention-val;
                            suffix-text: root.form-retention-unit == "copies" ? @tr("份") :
                                         root.form-retention-unit == "days" ? @tr("天") : @tr("小时");
                            edited(v) => {
                                root.update-retention-summary();
                            }
                        }

                        // 单位胶囊
                        HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            for u in [
                                { id: "copies", name: @tr("按份数") },
                                { id: "days", name: @tr("按天数") },
                                { id: "hours", name: @tr("按小时") },
                                { id: "unlimited", name: @tr("永久保留") }
                            ]: Rectangle {
                                horizontal-stretch: 1;
                                property <bool> is-u-sel: root.form-retention-unit == u.id;
                                height: 26px;
                                border-radius: 4px;
                                background: is-u-sel ? AppTheme.accent : ru-t.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                                border-width: 1px;
                                border-color: is-u-sel ? AppTheme.accent : AppTheme.border;
                                ru-t := TouchArea {
                                    clicked => {
                                        root.form-retention-unit = u.id;
                                        root.update-retention-summary();
                                    }
                                    mouse-cursor: pointer;
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: u.name;
                                        font-size: 10px;
                                        font-weight: is-u-sel ? 700 : 400;
                                        color: is-u-sel ? AppTheme.selected-foreground : AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 下行: 常用快捷选择按钮 (占满整行)
                    HorizontalLayout {
                        spacing: 6px;
                        for qk in [
                            { id: "copies_5", val: "5", unit: "copies", name: @tr("保留 5 份") },
                            { id: "copies_10", val: "10", unit: "copies", name: @tr("保留 10 份") },
                            { id: "days_7", val: "7", unit: "days", name: @tr("保留 7 天") },
                            { id: "days_30", val: "30", unit: "days", name: @tr("保留 30 天") },
                            { id: "hours_24", val: "24", unit: "hours", name: @tr("保留 24 小时") },
                            { id: "all", val: "0", unit: "unlimited", name: @tr("永久不清理") }
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            property <bool> is-qk-active: (qk.unit == "unlimited" && root.form-retention-unit == "unlimited") ||
                                                          (qk.unit == root.form-retention-unit && qk.val == root.form-retention-val);
                            height: 22px;
                            border-radius: 3px;
                            background: is-qk-active ? AppTheme.accent.transparentize(80%) : qk-t.has-hover ? AppTheme.hover-background : transparent;
                            border-width: 1px;
                            border-color: is-qk-active ? AppTheme.accent : AppTheme.border.transparentize(40%);
                            qk-t := TouchArea {
                                clicked => {
                                    root.form-retention-unit = qk.unit;
                                    root.form-retention-val = qk.val;
                                    root.update-retention-summary();
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: qk.name;
                                    font-size: 9px;
                                    color: is-qk-active ? AppTheme.accent : AppTheme.secondary-foreground;
                                    font-weight: is-qk-active ? 700 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 底部操作按钮
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                AppButton {
                    text: @tr("取消");
                    size: "sm";
                    variant: "secondary";
                    clicked => { root.close(); }
                }

                AppButton {
                    text: root.is-edit-mode ? @tr("保存修改") : @tr("保存并创建备份节点");
                    size: "sm";
                    variant: "primary";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/check.svg");
                    clicked => {
                        if root.form-name != "" {
                            if root.is-edit-mode {
                                SettingsBridge.update-backup-task(
                                    root.edit-task-id,
                                    root.form-name,
                                    root.form-type,
                                    root.form-endpoint,
                                    root.form-user,
                                    root.form-pass,
                                    root.form-strategy,
                                    root.form-retention-summary
                                );
                            } else {
                                SettingsBridge.save-new-backup-task(
                                    root.form-name,
                                    root.form-type,
                                    root.form-endpoint,
                                    root.form-user,
                                    root.form-pass,
                                    root.form-strategy,
                                    root.form-retention-summary
                                );
                            }
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
