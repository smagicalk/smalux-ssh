import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge } from "../settings_bridge.slint";
import { AppButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { KeyBadge } from "settings_widgets.slint";

/// 自定义快捷键设置模态弹窗 (KeybindingEditModal - 支持键盘按键直接实时监听与录制)
export component KeybindingEditModal inherits Rectangle {
    in property <string> action-id: "";
    in property <string> action-name: "";
    in property <string> default-key: "";
    in-out property <string> current-key: "";

    callback close();
    callback save(string /* new_key */);
    callback reset();
    callback clear-key();

    property <bool> is-recording: true;

    forward-focus: rec-scope;

    width: 100%;
    height: 100%;
    background: #000000.transparentize(50%);

    // 拦截外层遮罩点击
    TouchArea {
        clicked => { root.close(); }
    }

    // 居中弹窗主体
    Rectangle {
        width: 480px;
        height: 310px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: AppTheme.surface-background;
        border-width: 1px;
        border-color: AppTheme.border;
        clip: true;

        TouchArea {}

        // 键盘焦点监听域 (置于弹窗内部，全域捕获击键事件)
        rec-scope := FocusScope {
            enabled: root.is-recording;
            key-pressed(event) => {
                if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == Key.Escape {
                    root.close();
                    return accept;
                }

                let parsed = SettingsBridge.format-keybinding-event(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta
                );

                if parsed != "" {
                    root.current-key = parsed;
                    return accept;
                }
                reject
            }
        }

        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            alignment: space-between;

            // 1. 弹窗标题与操作名
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: @tr("自定义快捷键");
                        font-size: 15px;
                        font-weight: 700;
                        color: AppTheme.foreground;
                    }
                    Text {
                        text: @tr("为「") + root.action-name + @tr("」设定个性化专属组合快捷键");
                        font-size: 11px;
                        color: AppTheme.secondary-foreground;
                    }
                }

                // 右上角关闭按钮
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: x-touch.has-hover ? AppTheme.hover-background : transparent;
                    x-touch := TouchArea {
                        clicked => { root.close(); }
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: "×";
                        font-size: 16px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // 2. 快捷键实时按键录制与展示交互卡片
            Rectangle {
                border-radius: 8px;
                background: AppTheme.control-background;
                border-width: 1px;
                border-color: root.is-recording ? AppTheme.accent : AppTheme.border;
                height: 96px;

                rec-click := TouchArea {
                    clicked => {
                        root.is-recording = true;
                        rec-scope.focus();
                    }
                    mouse-cursor: pointer;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    // 卡片顶栏: 状态说明与模式切换
                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            // 录制指示小红点 / 呼吸灯
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: root.is-recording ? #EF4444 : AppTheme.disabled-foreground;
                            }
                            Text {
                                text: root.is-recording ? @tr("正在监听键盘按键... 请直接在键盘按下组合键") : @tr("当前映射按键:");
                                font-size: 10px;
                                font-weight: 600;
                                color: root.is-recording ? AppTheme.accent : AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }
                        }

                        // 模式切换小按钮
                        Rectangle {
                            height: 20px;
                            border-radius: 3px;
                            background: m-btn-t.has-hover ? AppTheme.hover-background : transparent;
                            border-width: 1px;
                            border-color: AppTheme.border.transparentize(50%);
                            m-btn-t := TouchArea {
                                clicked => {
                                    root.is-recording = !root.is-recording;
                                    if root.is-recording {
                                        rec-scope.focus();
                                    }
                                }
                                mouse-cursor: pointer;
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.is-recording ? @tr("手动输入") : @tr("按键录制");
                                    font-size: 9px;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 中部按键展示区
                    if root.is-recording: HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        if root.current-key != "": KeyBadge {
                            key-text: root.current-key;
                        }

                        if root.current-key == "": Text {
                            text: @tr("请按下 Ctrl / Alt / Shift + 字母数字或功能键 (如 Ctrl+Shift+P)");
                            font-size: 11px;
                            color: AppTheme.disabled-foreground;
                            vertical-alignment: center;
                        }
                    }

                    if !root.is-recording: HorizontalLayout {
                        alignment: center;
                        AppTextInput {
                            width: 100%;
                            size: "sm";
                            monospace: true;
                            placeholder: @tr("请输入按键组合 (例如 Ctrl+Shift+T 或 Alt+Enter)...");
                            text <=> root.current-key;
                            text-alignment: center;
                        }
                    }

                    // 底栏说明
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.is-recording ? @tr("提示: 键盘任意击键即可即时替换，按 Esc 取消") : @tr("直接键入文本后点击右下角保存");
                            font-size: 9px;
                            color: AppTheme.disabled-foreground;
                        }

                        if root.default-key != "": HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            Text {
                                text: @tr("默认快捷键:");
                                font-size: 9px;
                                color: AppTheme.disabled-foreground;
                                vertical-alignment: center;
                            }
                            KeyBadge {
                                key-text: root.default-key;
                            }
                        }
                    }
                }
            }

            // 3. 底部动作栏
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    AppButton {
                        text: @tr("恢复默认");
                        size: "sm";
                        variant: "outline";
                        has-icon: true;
                        icon: @image-url("../../../assets/icons/refresh.svg");
                        clicked => {
                            root.reset();
                            root.current-key = root.default-key;
                        }
                    }
                    AppButton {
                        text: @tr("清除解绑");
                        size: "sm";
                        variant: "ghost";
                        clicked => {
                            root.clear-key();
                            root.current-key = "";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    AppButton {
                        text: @tr("取消");
                        size: "sm";
                        variant: "secondary";
                        clicked => { root.close(); }
                    }
                    AppButton {
                        text: @tr("保存快捷键");
                        size: "sm";
                        variant: "primary";
                        has-icon: true;
                        icon: @image-url("../../../assets/icons/check.svg");
                        clicked => {
                            root.save(root.current-key);
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
