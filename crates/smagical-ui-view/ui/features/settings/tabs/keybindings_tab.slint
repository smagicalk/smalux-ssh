import { AppTheme } from "../../../themes/app-theme.slint";
import { SettingsBridge, SettingKeybindingItem } from "../settings_bridge.slint";
import {
    SettingsPageHeader,
    SettingsSectionCard,
    SettingsRow,
    KeyBadge,
} from "../components/settings_widgets.slint";
import { AppButton, AppIconButton } from "../../../shared/base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { KeybindingEditModal } from "../components/keybinding_edit_modal.slint";

export component SettingsKeybindingsTab inherits VerticalLayout {
    spacing: 16px;

    SettingsPageHeader {
        title: @tr("快捷键与全局键位映射");
        subtitle: @tr("查看、检索并自定义高频终端操作、多窗格分屏、会话标签与开发者调试的快捷键位");
        icon: @image-url("../../../assets/icons/key.svg");
    }

    SettingsSectionCard {
        title: @tr("快捷操作清单与自定义按键绑定");
        subtitle: @tr("点击按键徽章或编辑按钮可直接录制新按键；支持冲突检测与随时单项/全局恢复默认");
        icon: @image-url("../../../assets/icons/key.svg");

        // 顶部工具栏：搜索过滤、分类标签与全部重置
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 12px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;

                // 左侧搜索输入框
                Rectangle {
                    width: 260px;
                    height: 28px;
                    AppTextInput {
                        width: 100%;
                        size: "sm";
                        placeholder: @tr("搜索操作或按键 (如 新建标签、Ctrl)...");
                        text <=> SettingsBridge.keybindings-search;
                        prefix-icon: @image-url("../../../assets/icons/search.svg");
                        clearable: true;
                    }
                }

                // 右侧恢复全部默认按钮
                AppButton {
                    text: @tr("全部恢复默认键位");
                    size: "sm";
                    variant: "outline";
                    has-icon: true;
                    icon: @image-url("../../../assets/icons/refresh.svg");
                    clicked => {
                        SettingsBridge.reset-all-keybindings();
                    }
                }
            }

            // 分类筛选胶囊
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for cat in [
                    { id: "all", name: @tr("全部") },
                    { id: "terminal", name: @tr("终端交互") },
                    { id: "panes", name: @tr("窗格分屏") },
                    { id: "tabs", name: @tr("会话标签") },
                    { id: "general", name: @tr("全局导航") },
                    { id: "debug", name: @tr("开发者调试") }
                ]: Rectangle {
                    property <bool> is-active: SettingsBridge.keybindings-filter-category == cat.id;
                    height: 24px;
                    border-radius: 12px;
                    background: is-active ? AppTheme.accent : cat-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                    border-width: 1px;
                    border-color: is-active ? AppTheme.accent : AppTheme.border;

                    cat-touch := TouchArea {
                        clicked => { SettingsBridge.keybindings-filter-category = cat.id; }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: cat.name;
                            font-size: 10px;
                            font-weight: is-active ? 700 : 400;
                            color: is-active ? AppTheme.selected-foreground : AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 细分割线
        Rectangle {
            height: 1px;
            background: AppTheme.border.transparentize(65%);
        }

        // 快捷键列表
        for item[idx] in SettingsBridge.keybindings: SettingsRow {
            title: item.action-name;
            subtitle: (item.category == "terminal" ? @tr("终端交互") :
                       item.category == "panes" ? @tr("窗格分屏") :
                       item.category == "tabs" ? @tr("会话标签") :
                       item.category == "debug" ? @tr("开发者调试") : @tr("全局导航")) +
                       (item.is-customized ? (" • " + @tr("已自定义 (默认: ") + item.default-key + ")") : "");

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // 主按键徽章 (支持整块点击进入编辑模式)
                KeyBadge {
                    key-text: item.primary-key != "" ? item.primary-key : @tr("[未绑定]");
                    is-highlight: item.is-customized;
                    is-interactive: true;
                    is-recording: SettingsBridge.editing-keybinding-id == item.id;
                    clicked => {
                        SettingsBridge.modal-keybinding-id = item.id;
                        SettingsBridge.modal-keybinding-name = item.action-name;
                        SettingsBridge.modal-keybinding-key = item.primary-key;
                        SettingsBridge.is-keybinding-modal-open = true;
                    }
                }

                // 备用按键 (若有)
                if item.secondary-key != "": HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "/";
                        font-size: 10px;
                        color: AppTheme.disabled-foreground;
                        vertical-alignment: center;
                    }
                    KeyBadge {
                        key-text: item.secondary-key;
                    }
                }

                // 修改按钮
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: edit-btn-touch.has-hover ? AppTheme.hover-background : transparent;
                    edit-btn-touch := TouchArea {
                        clicked => {
                            SettingsBridge.modal-keybinding-id = item.id;
                            SettingsBridge.modal-keybinding-name = item.action-name;
                            SettingsBridge.modal-keybinding-key = item.primary-key;
                            SettingsBridge.is-keybinding-modal-open = true;
                        }
                        mouse-cursor: pointer;
                    }
                    Image {
                        source: @image-url("../../../assets/icons/pencil.svg");
                        width: 12px;
                        height: 12px;
                        colorize: edit-btn-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // 若已自定义，显示单项恢复默认按钮
                if item.is-customized: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: rst-btn-touch.has-hover ? AppTheme.hover-background : transparent;
                    rst-btn-touch := TouchArea {
                        clicked => {
                            SettingsBridge.reset-keybinding(item.id);
                        }
                        mouse-cursor: pointer;
                    }
                    Image {
                        source: @image-url("../../../assets/icons/refresh.svg");
                        width: 12px;
                        height: 12px;
                        colorize: rst-btn-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}
