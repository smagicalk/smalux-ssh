// -----------------------------------------------------------------------------
// 文件管理器业务领域数据结构模型 (File Explorer Domain Models)
// -----------------------------------------------------------------------------

/// 文件或目录条目 Slint 结构模型
export struct FileItemData {
    /// 节点全局唯一标识 (通常为文件绝对路径)
    id: string,
    /// 显示文件名
    name: string,
    /// 完整绝对路径
    path: string,
    /// 是否为目录文件夹
    is-dir: bool,
    /// 格式化后的文件大小 (如 "2.4 MB", 目录为 "-")
    size-formatted: string,
    /// 格式化后的修改时间 (如 "2026-08-31 18:30")
    modified-formatted: string,
    /// Unix 文件权限字符串 (如 "drwxr-xr-x")
    permissions: string,
    /// 树形视图下目录是否展开
    is-expanded: bool,
    /// 树形层级深度
    level: int,
}

/// 文件传输会话 Tab 数据结构
export struct FileTabData {
    /// 会话 Tab 唯一标识 ID
    id: string,
    /// 关联的主机资产 ID ("local" 代表本地目录)
    host-id: string,
    /// 标签标题 (主机名或本地工作区名)
    title: string,
    /// 标签副标题 (当前路径或主机 IP)
    subtitle: string,
    /// 连接状态 ("online" | "warning" | "offline")
    status: string,
    /// 当前是否处于激活选中状态
    is-active: bool,
}

/// 文件传输队列任务数据结构 (支持单文件与文件夹树形展开)
export struct TransferItemData {
    /// 传输任务唯一 ID
    id: string,
    /// 所属父任务 ID (若为文件夹下的子文件任务)
    parent-id: string,
    /// 传输文件名或目录名
    filename: string,
    /// 源文件绝对路径
    source-path: string,
    /// 目标文件绝对路径
    target-path: string,
    /// 是否为目录文件夹传输任务
    is-dir: bool,
    /// 文件夹任务在队列中是否展开
    is-expanded: bool,
    /// 嵌套缩进层级 (0 为顶层任务)
    level: int,
    /// 子项数量说明文本 (如 "4 项")
    item-count-text: string,
    /// 传输方向 ("upload" | "download")
    direction: string,
    /// 传输进度百分比 (0.0 ~ 1.0)
    progress: float,
    /// 实时传输速率文本 (如 "1.2 MB/s")
    speed-text: string,
    /// 任务状态 ("pending" | "transferring" | "completed" | "failed" | "paused")
    status: string,
    /// 传输大小文本 (如 "14.2 MB / 25.0 MB")
    size-text: string,
}
