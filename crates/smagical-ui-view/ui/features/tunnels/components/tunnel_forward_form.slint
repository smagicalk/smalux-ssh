// -----------------------------------------------------------------------------
// 端口转发专属配置表单 (Tunnel Forward Form)
// 适配 Local (-L), Remote (-R), Dynamic (-D), ReverseDynamic 4 大模式
// -----------------------------------------------------------------------------

import { AppTheme } from "../../../themes/app-theme.slint";
import { AppFormItem } from "../../../shared/base/app-form-item.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppTextArea } from "../../../shared/base/app-text-area.slint";

export component TunnelForwardForm inherits VerticalLayout {
    in-out property <string> form-type: "Local";
    in property <bool> is-create-mode: false;
    in property <bool> is-editing: false;
    in-out property <string> form-name: "";
    in-out property <string> form-ssh-host-id: "";
    in-out property <string> form-ssh-host-name: "";
    in-out property <string> form-local-bind: "";
    in-out property <string> form-local-port: "8080";
    in-out property <string> form-remote-host: "";
    in-out property <string> form-remote-port: "80";
    in-out property <string> form-run-mode: "FollowTerminal";
    in-out property <bool> form-auto-start: false;
    in-out property <bool> form-auto-reconnect: true;
    in-out property <bool> form-remote-dns: false;
    in-out property <bool> form-compression: false;
    in-out property <string> form-notes: "";

    callback open-host-picker();

    alignment: start;
    spacing: 12px;

    // 1. 转发模式单选组
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        Text {
            text: @tr("端口转发工作模式");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }

        HorizontalLayout {
            height: 28px;
            spacing: 8px;

            // 本地转发 Local
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-type == "Local" ? AppTheme.accent.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-type == "Local" ? AppTheme.accent : AppTheme.border;

                Text {
                    text: @tr("本地正向 (-L)");
                    font-size: 11px;
                    font-weight: root.form-type == "Local" ? 700 : 400;
                    color: root.form-type == "Local" ? AppTheme.accent : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => { root.form-type = "Local"; }
                    mouse-cursor: pointer;
                }
            }

            // 远程转发 Remote
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-type == "Remote" ? #e67e22.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-type == "Remote" ? #e67e22 : AppTheme.border;

                Text {
                    text: @tr("远程反向 (-R)");
                    font-size: 11px;
                    font-weight: root.form-type == "Remote" ? 700 : 400;
                    color: root.form-type == "Remote" ? #e67e22 : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => { root.form-type = "Remote"; }
                    mouse-cursor: pointer;
                }
            }

            // 动态转发 Dynamic (SOCKS5)
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-type == "Dynamic" ? #9b59b6.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-type == "Dynamic" ? #9b59b6 : AppTheme.border;

                Text {
                    text: @tr("动态网关 (-D)");
                    font-size: 11px;
                    font-weight: root.form-type == "Dynamic" ? 700 : 400;
                    color: root.form-type == "Dynamic" ? #9b59b6 : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => { root.form-type = "Dynamic"; }
                    mouse-cursor: pointer;
                }
            }

            // 反向动态 ReverseDynamic (远端 SOCKS5 网关)
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.form-type == "ReverseDynamic" ? #16a085.transparentize(80%) : AppTheme.control-background;
                border-width: 1px;
                border-color: root.form-type == "ReverseDynamic" ? #16a085 : AppTheme.border;

                Text {
                    text: @tr("反向动态 (-R)");
                    font-size: 11px;
                    font-weight: root.form-type == "ReverseDynamic" ? 700 : 400;
                    color: root.form-type == "ReverseDynamic" ? #16a085 : AppTheme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => { root.form-type = "ReverseDynamic"; }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // 2. 规则描述名称
    AppFormItem {
        label: @tr("规则描述名称");
        required: true;

        AppTextInput {
            text <=> root.form-name;
            placeholder: @tr("例如: 生产数据库正向代理");
            enabled: root.is-create-mode || root.is-editing;
        }
    }

    // 3. 关联 SSH 宿主主机 (点击弹出树形选择主机)
    VerticalLayout {
        alignment: start;
        spacing: 4px;
        width: 100%;

        Text {
            text: @tr("关联 SSH 宿主主机");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }
        Rectangle {
            height: 32px;
            width: 100%;
            border-radius: AppTheme.radius-medium;
            background: (root.is-create-mode || root.is-editing) && host-picker-btn-touch.has-hover
                ? AppTheme.hover-background
                : AppTheme.control-background;
            border-width: 1px;
            border-color: (root.is-create-mode || root.is-editing) && host-picker-btn-touch.has-hover
                ? AppTheme.accent
                : AppTheme.border;

            animate background { duration: 100ms; }
            animate border-color { duration: 100ms; }

            HorizontalLayout {
                width: 100%;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/icons/server.svg");
                        width: 14px;
                        height: 14px;
                        colorize: root.form-ssh-host-name != "" ? AppTheme.accent : AppTheme.secondary-foreground;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.form-ssh-host-name != ""
                        ? (root.form-ssh-host-name + (root.form-remote-host != "" ? (" (" + root.form-remote-host + ")") : ""))
                        : ((root.is-create-mode || root.is-editing) ? @tr("点击选择关联的 SSH 宿主主机...") : @tr("未关联主机 (直连网关)"));
                    font-size: 12px;
                    font-weight: root.form-ssh-host-name != "" ? 600 : 400;
                    color: root.form-ssh-host-name != "" ? AppTheme.foreground : AppTheme.secondary-foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.is-create-mode || root.is-editing: VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/icons/chevron-down.svg");
                        width: 12px;
                        height: 12px;
                        colorize: host-picker-btn-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                    }
                }
            }

            host-picker-btn-touch := TouchArea {
                enabled: root.is-create-mode || root.is-editing;
                clicked => { root.open-host-picker(); }
                mouse-cursor: pointer;
            }
        }
    }

    // 4. 端口转发配置 (Local / Remote / Dynamic / ReverseDynamic)
    if root.form-type == "Local": HorizontalLayout {
        width: 100%;
        spacing: 12px;

        AppFormItem {
            horizontal-stretch: 1;
            label: @tr("本地监听端口 (Local Port)");
            required: true;
            AppTextInput {
                text <=> root.form-local-port;
                font-size: 12px;
                monospace: true;
                placeholder: "8080";
                enabled: root.is-create-mode || root.is-editing;
            }
        }

        AppFormItem {
            horizontal-stretch: 1;
            label: @tr("远端目标服务端口 (Remote Port)");
            required: true;
            AppTextInput {
                text <=> root.form-remote-port;
                font-size: 12px;
                monospace: true;
                placeholder: "80";
                enabled: root.is-create-mode || root.is-editing;
            }
        }
    }

    if root.form-type == "Remote": HorizontalLayout {
        width: 100%;
        spacing: 12px;

        AppFormItem {
            horizontal-stretch: 1;
            label: @tr("本地目标服务端口 (Local Port)");
            required: true;
            AppTextInput {
                text <=> root.form-local-port;
                font-size: 12px;
                monospace: true;
                placeholder: "8080";
                enabled: root.is-create-mode || root.is-editing;
            }
        }

        AppFormItem {
            horizontal-stretch: 1;
            label: @tr("远程公网监听端口 (Remote Port)");
            required: true;
            AppTextInput {
                text <=> root.form-remote-port;
                font-size: 12px;
                monospace: true;
                placeholder: "80";
                enabled: root.is-create-mode || root.is-editing;
            }
        }
    }

    if root.form-type == "Dynamic": AppFormItem {
        label: @tr("本地 SOCKS5 网关监听端口 (Local Port)");
        required: true;
        AppTextInput {
            text <=> root.form-local-port;
            font-size: 12px;
            monospace: true;
            placeholder: "1080";
            enabled: root.is-create-mode || root.is-editing;
        }
    }

    if root.form-type == "ReverseDynamic": AppFormItem {
        label: @tr("远程 SOCKS5 网关监听端口 (Remote Port)");
        required: true;
        AppTextInput {
            text <=> root.form-remote-port;
            font-size: 12px;
            monospace: true;
            placeholder: "1080";
            enabled: root.is-create-mode || root.is-editing;
        }
    }

    // 5. 启动与运行策略
    VerticalLayout {
        alignment: start;
        spacing: 6px;

        Text {
            text: @tr("启动与运行策略");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }

        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            // 模式 1: 伴随终端 (默认)
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "")
                    ? AppTheme.accent.transparentize(85%)
                    : AppTheme.control-background;
                border-width: 1px;
                border-color: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "")
                    ? AppTheme.accent
                    : AppTheme.border;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/terminal.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "") ? AppTheme.accent : AppTheme.secondary-foreground;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("伴随终端启闭 (默认)");
                            font-size: 11px;
                            font-weight: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "") ? 700 : 400;
                            color: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "") ? AppTheme.accent : AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => {
                        root.form-run-mode = "FollowTerminal";
                        root.form-auto-start = false;
                    }
                    mouse-cursor: (root.is-create-mode || root.is-editing) ? pointer : default;
                }
            }

            // 模式 2: 常驻后台
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: (root.form-run-mode == "FollowApp")
                    ? AppTheme.accent.transparentize(85%)
                    : AppTheme.control-background;
                border-width: 1px;
                border-color: (root.form-run-mode == "FollowApp")
                    ? AppTheme.accent
                    : AppTheme.border;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/server.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: (root.form-run-mode == "FollowApp") ? AppTheme.accent : AppTheme.secondary-foreground;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("常驻后台 (随应用自启)");
                            font-size: 11px;
                            font-weight: (root.form-run-mode == "FollowApp") ? 700 : 400;
                            color: (root.form-run-mode == "FollowApp") ? AppTheme.accent : AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                TouchArea {
                    enabled: root.is-create-mode || root.is-editing;
                    clicked => {
                        root.form-run-mode = "FollowApp";
                        root.form-auto-start = true;
                    }
                    mouse-cursor: (root.is-create-mode || root.is-editing) ? pointer : default;
                }
            }
        }

        // 策略说明文字
        Text {
            text: (root.form-run-mode == "FollowTerminal" || root.form-run-mode == "")
                ? @tr("💡 伴随终端：打开对应主机终端时自动打通隧道，所有终端关闭后自动释放端口，避免端口被长期霸占。")
                : @tr("💡 常驻后台：只要开关开启，随软件启动始终保持后台监听，无论是否连接终端均可使用。");
            font-size: 10px;
            color: AppTheme.secondary-foreground;
            wrap: word-wrap;
        }
    }

    // 6. 高级选项复选框行
    HorizontalLayout {
        height: 22px;
        spacing: 20px;
        alignment: start;

        // 复选框 1: 自动重连
        Rectangle {
            background: transparent;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 3px;
                        background: root.form-auto-reconnect ? AppTheme.accent : AppTheme.control-background;
                        border-width: 1px;
                        border-color: root.form-auto-reconnect ? AppTheme.accent : AppTheme.border;
                        if root.form-auto-reconnect: Image {
                            source: @image-url("../../../assets/icons/check.svg");
                            width: 9px;
                            height: 9px;
                            image-fit: contain;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    Text {
                        text: @tr("断线自动重连");
                        font-size: 11px;
                        color: AppTheme.foreground;
                        vertical-alignment: bottom;
                    }
                }
            }
            TouchArea {
                enabled: root.is-create-mode || root.is-editing;
                clicked => { root.form-auto-reconnect = !root.form-auto-reconnect; }
                mouse-cursor: pointer;
            }
        }

        // 复选框 3: 压缩传输
        Rectangle {
            background: transparent;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 3px;
                        background: root.form-compression ? AppTheme.accent : AppTheme.control-background;
                        border-width: 1px;
                        border-color: root.form-compression ? AppTheme.accent : AppTheme.border;
                        if root.form-compression: Image {
                            source: @image-url("../../../assets/icons/check.svg");
                            width: 9px;
                            height: 9px;
                            image-fit: contain;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    Text {
                        text: @tr("启用传输压缩 (-C)");
                        font-size: 11px;
                        color: AppTheme.foreground;
                        vertical-alignment: bottom;
                    }
                }
            }
            TouchArea {
                enabled: root.is-create-mode || root.is-editing;
                clicked => { root.form-compression = !root.form-compression; }
                mouse-cursor: pointer;
            }
        }

        // 复选框 4: SOCKS5 远程 DNS
        if root.form-type == "Dynamic": Rectangle {
            background: transparent;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 3px;
                        background: root.form-remote-dns ? AppTheme.accent : AppTheme.control-background;
                        border-width: 1px;
                        border-color: root.form-remote-dns ? AppTheme.accent : AppTheme.border;
                        if root.form-remote-dns: Image {
                            source: @image-url("../../../assets/icons/check.svg");
                            width: 9px;
                            height: 9px;
                            image-fit: contain;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    Text {
                        text: @tr("由代理服务器远程解析 DNS");
                        font-size: 11px;
                        color: AppTheme.foreground;
                        vertical-alignment: bottom;
                    }
                }
            }
            TouchArea {
                enabled: root.is-create-mode || root.is-editing;
                clicked => { root.form-remote-dns = !root.form-remote-dns; }
                mouse-cursor: pointer;
            }
        }
    }

    // 6. 备注说明
    AppFormItem {
        label: @tr("备注说明与业务用途");
        AppTextArea {
            text <=> root.form-notes;
            font-size: 11px;
            placeholder: @tr("可在此记录转发用途、访问白名单或对应服务文档...");
            enabled: root.is-create-mode || root.is-editing;
            min-height: 50px;
        }
    }
}
