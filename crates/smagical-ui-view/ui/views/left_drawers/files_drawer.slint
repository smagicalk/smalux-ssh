import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { AppVScrollBar } from "../../components/base/app-scroll-bar.slint";

/// 常用目录书签结构
export struct BookmarkItemData {
    id: string,
    path: string,
    description: string,
}

/// 文件管理抽屉 (Files Drawer)
export component FilesDrawer inherits DrawerContainer {
    title: @tr("文件管理");
    collapse-icon: "◀";

    in property <[BookmarkItemData]> bookmarks: [];


    callback open-path(string /* path */);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 书签分类标题
        HorizontalLayout {
            padding-left: 4px;
            Text {
                text: @tr("▤ 常用远程目录书签");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
            }
        }

        // 目录列表
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            scroll-area := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: list-content.preferred-height;

                list-content := VerticalLayout {
                    spacing: 4px;

                    for bm in root.bookmarks: Rectangle {
                        height: 48px;
                        border-radius: AppTheme.radius-medium;
                        background: bm-touch.has-hover ? AppTheme.hover-background : transparent;

                        bm-touch := TouchArea {
                            clicked => { root.open-path(bm.path); }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "▤";
                                font-size: 14px;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: bm.path;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    overflow: elide;
                                }

                                Text {
                                    text: bm.description;
                                    font-size: 10px;
                                    color: AppTheme.secondary-foreground;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            AppVScrollBar {
                viewport-height: scroll-area.viewport-height;
                visible-height: scroll-area.height;
                viewport-y <=> scroll-area.viewport-y;
            }
        }
    }
}
