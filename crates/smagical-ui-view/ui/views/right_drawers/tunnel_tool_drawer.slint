import { AppTheme } from "../../themes/app-theme.slint";
import { DrawerContainer } from "../../components/drawer-container.slint";
import { StatusDot } from "../../components/status-dot.slint";
import { AppButton } from "../../components/base/app-button.slint";
import { AppIconButton } from "../../components/base/app-icon-button.slint";
import { AppEmptyState } from "../../shared/base/app-empty-state.slint";
import { TunnelItemData } from "../tunnels_view.slint";
import { AppVScrollBar } from "../../components/base/app-scroll-bar.slint";
import { TunnelsBridge } from "../../features/tunnels/tunnels_bridge.slint";

export { TunnelItemData }

/// 主机专属端口转发与隧道伴生右侧抽屉组件 (Host Tunnel Tool Drawer)
///
/// 紧随当前活动终端主机，呈现归属于该主机的端口转发规则，支持抽屉内一键启停开关与极速新建。
export component TunnelToolDrawer inherits DrawerContainer {
    title: @tr("主机端口转发");
    collapse-icon: "▶";

    in property <string> active-host-name: TunnelsBridge.active-host-name;
    in property <[TunnelItemData]> tunnels: TunnelsBridge.host-tunnels;
    in property <bool> is-local-terminal: TunnelsBridge.is-local-terminal;
    in property <bool> has-active-terminal: true;

    callback toggle-tunnel-running(string /* id */);
    callback open-tunnels-hub();
    callback start-create-tunnel();

    Rectangle {
        width: 100%;
        height: 100%;

        // 无活跃终端时的占位空状态
        if !root.has-active-terminal: Rectangle {
            width: 100%;
            height: 100%;
            background: AppTheme.panel-background;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/server.svg");
                        width: 36px;
                        height: 36px;
                        colorize: AppTheme.disabled-foreground;
                    }
                }
                Text {
                    text: @tr("未连接主机");
                    font-size: 13px;
                    font-weight: 700;
                    color: AppTheme.foreground;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("请在中央终端打开或连接远程主机\n端口转发规则将自动关联");
                    font-size: 10px;
                    color: AppTheme.disabled-foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.has-active-terminal: VerticalLayout {
            padding: 8px;
            spacing: 8px;

        // 1. 顶部上下文提示与快捷新建栏
        Rectangle {
            height: 32px;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                alignment: space-between;

                // 当前聚焦主机提示
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.is-local-terminal ? @image-url("../../assets/icons/terminal.svg") : @image-url("../../assets/icons/server.svg");
                            width: 12px;
                            height: 12px;
                            colorize: root.is-local-terminal ? AppTheme.secondary-foreground : AppTheme.accent;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: start;

                            Text {
                                text: root.is-local-terminal ? (root.active-host-name != "" ? root.active-host-name : @tr("本地终端")) : (root.active-host-name != "" ? root.active-host-name : @tr("未连接主机"));
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.foreground;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            if root.is-local-terminal: Rectangle {
                                height: 14px;
                                border-radius: 3px;
                                background: AppTheme.hover-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: @tr("本地环境");
                                        font-size: 8px;
                                        font-weight: 600;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 快速新建按钮 (仅在远程 SSH 会话时支持使用，本地终端不展示)
                if !root.is-local-terminal: VerticalLayout {
                    alignment: center;
                    AppButton {
                        text: @tr("+ 新建");
                        variant: "primary";
                        height: 22px;
                        clicked => { root.start-create-tunnel(); }
                    }
                }
            }
        }

        // 2. 本地终端专有提示卡片 (本地终端不支持端口转发，无需转发)
        if root.is-local-terminal: Rectangle {
            vertical-stretch: 1;
            background: transparent;

            AppEmptyState {
                icon: @image-url("../../assets/icons/tunnel.svg");
                title: @tr("本地终端不支持端口转发");
                subtitle: @tr("端口转发专用于远程 SSH 隧道网络端口映射。\n当前终端为本机系统环境，无需建立网络端口转发。");
                show-action: false;
            }
        }

        // 3. 远程主机空状态 (暂无专属规则)
        if !root.is-local-terminal && root.tunnels.length == 0: Rectangle {
            vertical-stretch: 1;
            background: transparent;

            AppEmptyState {
                icon: @image-url("../../assets/icons/tunnel.svg");
                title: @tr("当前主机暂无专属端口转发规则");
                subtitle: @tr("可为当前远程主机快速配置本地、远程或动态 SOCKS5 端口转发。");
                show-action: true;
                action-text: @tr("配置端口映射");
                action-clicked => { root.start-create-tunnel(); }
            }
        }

        // 4. 远程主机隧道列表
        if !root.is-local-terminal && root.tunnels.length > 0: Rectangle {
            vertical-stretch: 1;
            clip: true;

            scroll-area := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: list-content.preferred-height;

                list-content := VerticalLayout {
                    spacing: 6px;
                    padding-right: 2px;

                for tun in root.tunnels: Rectangle {
                    height: 58px;
                    border-radius: AppTheme.radius-medium;
                    background: item-touch.has-hover ? AppTheme.hover-background : AppTheme.panel-background;
                    border-width: 1px;
                    border-color: tun.is-running
                        ? AppTheme.success.transparentize(70%)
                        : ((tun.enabled && tun.run-mode == "FollowTerminal") ? #f39c12.transparentize(70%) : AppTheme.border);
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    item-touch := TouchArea {
                        // 预留点击
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        // 信息区 (靠最左端对齐)
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;

                                Text {
                                    text: tun.name;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.foreground;
                                    overflow: elide;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 14px;
                                    border-radius: 2px;
                                    background: tun.tunnel-type == "Local"
                                        ? AppTheme.accent.transparentize(80%)
                                        : (tun.tunnel-type == "Remote"
                                            ? #e67e22.transparentize(80%)
                                            : #9b59b6.transparentize(80%));

                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        Text {
                                            text: tun.type-badge;
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: tun.tunnel-type == "Local"
                                                ? AppTheme.accent
                                                : (tun.tunnel-type == "Remote" ? #e67e22 : #9b59b6);
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 启停运行策略徽章 (展示提示是应用启动还是伴随终端)
                                Rectangle {
                                    height: 14px;
                                    border-radius: 2px;
                                    background: tun.run-mode == "FollowApp"
                                        ? AppTheme.warning.transparentize(85%)
                                        : AppTheme.control-background;
                                    border-width: 1px;
                                    border-color: tun.run-mode == "FollowApp"
                                        ? AppTheme.warning.transparentize(60%)
                                        : AppTheme.border;

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: tun.run-mode == "FollowApp" ? @tr("随应用启动") : @tr("伴随终端");
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: tun.run-mode == "FollowApp" ? AppTheme.warning : AppTheme.secondary-foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 端口映射摘要 (两个 IP 之间带有专门的矢量箭头图标，100% 渲染显示)
                            HorizontalLayout {
                                alignment: start;
                                spacing: 5px;

                                if tun.tunnel-type == "Local" || tun.tunnel-type == "Remote": HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;

                                    Text {
                                        text: (tun.tunnel-type == "Local" ? tun.local-bind : tun.remote-host) + ":" + (tun.tunnel-type == "Local" ? tun.local-port : tun.remote-port);
                                        font-size: 10px;
                                        font-family: "Cascadia Code, Consolas, monospace";
                                        color: tun.is-running ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../../assets/icons/arrow-right.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: tun.is-running ? AppTheme.accent : AppTheme.secondary-foreground;
                                        }
                                    }

                                    Text {
                                        text: (tun.tunnel-type == "Local" ? tun.remote-host : tun.local-bind) + ":" + (tun.tunnel-type == "Local" ? tun.remote-port : tun.local-port);
                                        font-size: 10px;
                                        font-family: "Cascadia Code, Consolas, monospace";
                                        color: tun.is-running ? AppTheme.foreground : AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }

                                if tun.tunnel-type != "Local" && tun.tunnel-type != "Remote": Text {
                                    text: tun.route-summary;
                                    font-size: 10px;
                                    font-family: "Cascadia Code, Consolas, monospace";
                                    color: tun.is-running ? AppTheme.foreground : AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // 启停 Switch 开关按钮 (右端垂直居中)
                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 32px;
                                height: 18px;
                                border-radius: 9px;
                                background: tun.enabled ? AppTheme.success : AppTheme.border;
                                animate background { duration: 150ms; }

                                // 拨动圆点
                                Rectangle {
                                    x: tun.enabled ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: #ffffff;
                                    animate x { duration: 150ms; }
                                }

                                TouchArea {
                                    clicked => {
                                        root.toggle-tunnel-running(tun.id);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }
        }

        AppVScrollBar {
            viewport-height: scroll-area.viewport-height;
            visible-height: scroll-area.height;
            viewport-y <=> scroll-area.viewport-y;
        }
        }

        // 3. 底部快捷跳转全屏大盘入口
        Rectangle {
            height: 30px;
            border-radius: AppTheme.radius-medium;
            background: hub-touch.has-hover ? AppTheme.hover-background : transparent;
            border-width: 1px;
            border-color: AppTheme.border;
            animate background { duration: 120ms; }

            hub-touch := TouchArea {
                clicked => { root.open-tunnels-hub(); }
                mouse-cursor: pointer;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: @tr("进入网络与隧道管理中心 ➔");
                    font-size: 11px;
                    font-weight: 600;
                    color: AppTheme.accent;
                    vertical-alignment: center;
                }
            }
        }
    }
    }
}
