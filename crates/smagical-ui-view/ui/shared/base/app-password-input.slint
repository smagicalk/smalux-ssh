import { AppTheme } from "../../themes/app-theme.slint";

/// 标准安全密码输入框组件 (AppPasswordInput)
///
/// 核心特性：
/// 1. 默认密码掩码显示 (input-type: password)；
/// 2. 右侧一键明文/密文切换小眼睛按钮 (eye/eye-off)；
/// 3. 底置全域焦点代理层，点击输入框内边距或空白区域 100% 聚焦；
/// 4. 继承统一的主题高亮描边与悬停交互。
export component AppPasswordInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: @tr("请输入密码...");
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <string> size: "md";
    in-out property <bool> is-visible: false;
    in property <length> input-height: root.size == "sm" ? 24px : (root.size == "lg" ? 32px : 28px);
    out property <bool> has-focus: input.has-focus;

    callback accepted(string);
    callback edited(string);
    forward-focus: input;

    height: root.input-height;
    border-radius: AppTheme.radius-medium;
    background: !root.enabled ? AppTheme.control-background.transparentize(50%) : AppTheme.control-background;
    border-width: 1px;
    border-color: input.has-focus ? AppTheme.accent : AppTheme.border;

    animate border-color { duration: 120ms; }

    // 底置全域焦点代理层
    TouchArea {
        enabled: root.enabled && !root.read-only;
        clicked => { input.focus(); }
        mouse-cursor: MouseCursor.text;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;

        // 密码输入与占位符包裹区
        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // 内层全域点击聚焦代理
            TouchArea {
                enabled: root.enabled && !root.read-only;
                clicked => { input.focus(); }
                mouse-cursor: MouseCursor.text;
            }

            if input.text == "" && !input.has-focus && root.placeholder != "": Text {
                text: root.placeholder;
                font-size: 11px;
                color: AppTheme.disabled-foreground;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                width: 100%;
                height: 100%;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: AppTheme.foreground;
                selection-background-color: AppTheme.selected-background;
                selection-foreground-color: AppTheme.selected-foreground;
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                read-only: root.read-only;
                input-type: root.is-visible ? InputType.text : InputType.password;

                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }

        // 明密文切换小眼睛按钮
        VerticalLayout {
            alignment: center;
            width: 18px;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: btn-eye.has-hover ? AppTheme.hover-background : transparent;

                btn-eye := TouchArea {
                    clicked => {
                        root.is-visible = !root.is-visible;
                    }
                    mouse-cursor: pointer;
                }

                Image {
                    source: root.is-visible ? @image-url("../../assets/icons/eye-off.svg") : @image-url("../../assets/icons/eye.svg");
                    width: 12px;
                    height: 12px;
                    image-fit: contain;
                    colorize: btn-eye.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
