import { AppTheme } from "../../../themes/app-theme.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { AppPasswordInput } from "../../../shared/base/app-password-input.slint";

export component CreateHostNetworkTab inherits VerticalLayout {
    spacing: 12px;

    in-out property <string> keepalive-interval-str: "30";
    in-out property <string> connect-timeout-str: "10";
    in-out property <string> proxy-mode: "direct"; // "direct" | "tunnel" | "custom"
    in-out property <string> selected-tunnel-proxy-id: "";
    in-out property <string> selected-tunnel-proxy-name: "";
    in-out property <string> selected-tunnel-proxy-proto: "SOCKS5";
    in-out property <string> selected-tunnel-proxy-host: "";
    in-out property <int> selected-tunnel-proxy-port: 1080;
    in-out property <string> selected-tunnel-proxy-user: "";

    in-out property <string> custom-proxy-proto: "socks5"; // "socks5" | "http" | "https"
    in-out property <string> custom-proxy-host: "";
    in-out property <string> custom-proxy-port-str: "";
    in-out property <string> custom-proxy-username: "";
    in-out property <string> custom-proxy-password: "";

    callback open-proxy-picker();
    callback clear-tunnel-proxy();

    // 心跳保活与超时
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: @tr("心跳保活间隔 (ServerAliveInterval):");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
            }
            AppTextInput {
                text <=> root.keepalive-interval-str;
                placeholder: "30";
                suffix-text: @tr("秒");
                input-height: 32px;
                font-size: 11px;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: @tr("连接超时时间 (ConnectTimeout):");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
            }
            AppTextInput {
                text <=> root.connect-timeout-str;
                placeholder: "10";
                suffix-text: @tr("秒");
                input-height: 32px;
                font-size: 11px;
            }
        }
    }

    // 代理设置卡片 (严格三段互斥模式：直连 / 引用隧道代理 / 手动自定义)
    VerticalLayout {
        spacing: 8px;

        Text {
            text: @tr("外置网络代理模式 (Network Proxy Mode):");
            font-size: 11px;
            font-weight: 600;
            color: AppTheme.secondary-foreground;
        }

        // 三段模式切换胶囊
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                // 模式 1: 直连
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: root.proxy-mode == "direct" ? AppTheme.surface-background : (pm-dir-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: root.proxy-mode == "direct" ? 1px : 0px;
                    border-color: root.proxy-mode == "direct" ? AppTheme.border : transparent;

                    pm-dir-touch := TouchArea {
                        clicked => { root.proxy-mode = "direct"; }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/radio.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.proxy-mode == "direct" ? AppTheme.accent : AppTheme.secondary-foreground;
                            }
                        }

                        Text {
                            text: @tr("直连 (无代理)");
                            font-size: 11px;
                            font-weight: root.proxy-mode == "direct" ? 700 : 500;
                            color: root.proxy-mode == "direct" ? AppTheme.accent : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                // 模式 2: 引用隧道中心代理
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: root.proxy-mode == "tunnel" ? AppTheme.surface-background : (pm-tun-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: root.proxy-mode == "tunnel" ? 1px : 0px;
                    border-color: root.proxy-mode == "tunnel" ? AppTheme.border : transparent;

                    pm-tun-touch := TouchArea {
                        clicked => {
                            root.proxy-mode = "tunnel";
                            if root.selected-tunnel-proxy-id == "" {
                                root.open-proxy-picker();
                            }
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/tunnel.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.proxy-mode == "tunnel" ? AppTheme.accent : AppTheme.secondary-foreground;
                            }
                        }

                        Text {
                            text: @tr("引用隧道中心代理");
                            font-size: 11px;
                            font-weight: root.proxy-mode == "tunnel" ? 700 : 500;
                            color: root.proxy-mode == "tunnel" ? AppTheme.accent : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }

                        if root.selected-tunnel-proxy-id != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #10b981; // 绿点表示已选定
                            }
                        }
                    }
                }

                // 模式 3: 手动自定义代理
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: root.proxy-mode == "custom" ? AppTheme.surface-background : (pm-cust-touch.has-hover ? AppTheme.hover-background : transparent);
                    border-width: root.proxy-mode == "custom" ? 1px : 0px;
                    border-color: root.proxy-mode == "custom" ? AppTheme.border : transparent;

                    pm-cust-touch := TouchArea {
                        clicked => { root.proxy-mode = "custom"; }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/settings.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.proxy-mode == "custom" ? AppTheme.accent : AppTheme.secondary-foreground;
                            }
                        }

                        Text {
                            text: @tr("手动自定义代理");
                            font-size: 11px;
                            font-weight: root.proxy-mode == "custom" ? 700 : 500;
                            color: root.proxy-mode == "custom" ? AppTheme.accent : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------
        // 模式 1 视图：直连模式说明
        // ---------------------------------------------------------
        if root.proxy-mode == "direct": Rectangle {
            height: 64px;
            border-radius: AppTheme.radius-medium;
            background: AppTheme.control-background;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/icons/info-circle.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                        colorize: AppTheme.secondary-foreground;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;

                    Text {
                        text: @tr("网络直连模式 (Direct Connection)");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.foreground;
                    }

                    Text {
                        text: @tr("当前主机直接发起 TCP 建立 SSH 握手，不经过任何外部代理。多跳中继请在【跳板机链路】中配置。");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }
                }
            }
        }

        // ---------------------------------------------------------
        // 模式 2 视图：引用隧道中心代理 (只读展示 + 弹窗选择)
        // ---------------------------------------------------------
        if root.proxy-mode == "tunnel": VerticalLayout {
            spacing: 8px;

            if root.selected-tunnel-proxy-id == "": Rectangle {
                height: 72px;
                border-radius: AppTheme.radius-medium;
                background: pick-tun-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: pick-tun-touch.has-hover ? AppTheme.accent : AppTheme.border;

                pick-tun-touch := TouchArea {
                    clicked => {
                        root.open-proxy-picker();
                    }
                    mouse-cursor: pointer;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/tunnel.svg");
                                width: 14px;
                                height: 14px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("点击从网络与隧道中心选择已有代理通道...");
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: @tr("自动关联隧道中心已保存的代理服务，中心配置更新时多主机自动同步生效");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.selected-tunnel-proxy-id != "": Rectangle {
                height: 52px;
                border-radius: AppTheme.radius-medium;
                background: AppTheme.accent.transparentize(90%);
                border-width: 1px;
                border-color: AppTheme.accent.transparentize(40%);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: AppTheme.accent.transparentize(80%);
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: root.selected-tunnel-proxy-proto;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                Text {
                                    text: root.selected-tunnel-proxy-name;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: AppTheme.foreground;
                                    vertical-alignment: center;
                                }

                                if root.selected-tunnel-proxy-user != "": Text {
                                    text: "@" + root.selected-tunnel-proxy-user;
                                    font-size: 10px;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.selected-tunnel-proxy-host + ":" + root.selected-tunnel-proxy-port;
                                font-size: 11px;
                                font-family: "Cascadia Code, Consolas, monospace";
                                color: AppTheme.secondary-foreground;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: change-proxy-touch.has-hover ? AppTheme.hover-background : AppTheme.surface-background;
                                border-width: 1px;
                                border-color: AppTheme.border;

                                change-proxy-touch := TouchArea {
                                    clicked => {
                                        root.open-proxy-picker();
                                    }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: @tr("更换代理");
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppTheme.foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: clear-proxy-touch.has-hover ? AppTheme.hover-background : transparent;

                                clear-proxy-touch := TouchArea {
                                    clicked => {
                                        root.clear-tunnel-proxy();
                                    }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("清除");
                                        font-size: 10px;
                                        color: AppTheme.danger;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------
        // 模式 3 视图：手动自定义代理 (独立输入表单)
        // ---------------------------------------------------------
        if root.proxy-mode == "custom": VerticalLayout {
            spacing: 8px;

            // 协议选择
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: root.custom-proxy-proto == "socks5" ? AppTheme.surface-background : transparent;
                        border-width: root.custom-proxy-proto == "socks5" ? 1px : 0px;
                        border-color: root.custom-proxy-proto == "socks5" ? AppTheme.border : transparent;

                        TouchArea {
                            clicked => { root.custom-proxy-proto = "socks5"; }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "SOCKS5";
                            font-size: 11px;
                            font-weight: root.custom-proxy-proto == "socks5" ? 700 : 500;
                            color: root.custom-proxy-proto == "socks5" ? AppTheme.accent : AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: root.custom-proxy-proto == "http" ? AppTheme.surface-background : transparent;
                        border-width: root.custom-proxy-proto == "http" ? 1px : 0px;
                        border-color: root.custom-proxy-proto == "http" ? AppTheme.border : transparent;

                        TouchArea {
                            clicked => { root.custom-proxy-proto = "http"; }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "HTTP";
                            font-size: 11px;
                            font-weight: root.custom-proxy-proto == "http" ? 700 : 500;
                            color: root.custom-proxy-proto == "http" ? AppTheme.accent : AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: root.custom-proxy-proto == "https" ? AppTheme.surface-background : transparent;
                        border-width: root.custom-proxy-proto == "https" ? 1px : 0px;
                        border-color: root.custom-proxy-proto == "https" ? AppTheme.border : transparent;

                        TouchArea {
                            clicked => { root.custom-proxy-proto = "https"; }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "HTTPS";
                            font-size: 11px;
                            font-weight: root.custom-proxy-proto == "https" ? 700 : 500;
                            color: root.custom-proxy-proto == "https" ? AppTheme.accent : AppTheme.secondary-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 地址与端口 (严格 1:1 平分整行)
            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 4px;
                    Text {
                        text: @tr("代理服务器地址 (Host / IP):");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                        overflow: elide;
                    }
                    AppTextInput {
                        text <=> root.custom-proxy-host;
                        placeholder: @tr("127.0.0.1 或 proxy.example.com");
                        input-height: 32px;
                        font-size: 11px;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 4px;
                    Text {
                        text: @tr("代理端口 (Port):");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                        overflow: elide;
                    }
                    AppTextInput {
                        text <=> root.custom-proxy-port-str;
                        placeholder: "1080";
                        input-height: 32px;
                        font-size: 11px;
                    }
                }
            }

            // 认证用户名与密码 (严格 1:1 平分整行)
            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 4px;
                    Text {
                        text: @tr("认证用户名 (可选 Username):");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                        overflow: elide;
                    }
                    AppTextInput {
                        text <=> root.custom-proxy-username;
                        placeholder: @tr("无认证可留空");
                        input-height: 32px;
                        font-size: 11px;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 4px;
                    Text {
                        text: @tr("认证密码 (可选 Password):");
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                        overflow: elide;
                    }
                    AppPasswordInput {
                        text <=> root.custom-proxy-password;
                        placeholder: @tr("密码认证可留空");
                        input-height: 32px;
                    }
                }
            }

            Text {
                text: @tr("注：此处设置的代理仅针对当前主机有效，完全独立于网络与隧道中心。");
                font-size: 10px;
                color: AppTheme.secondary-foreground;
            }
        }
    }
}
