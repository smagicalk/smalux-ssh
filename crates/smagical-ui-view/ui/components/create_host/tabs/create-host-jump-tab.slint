import { AppTheme } from "../../../themes/app-theme.slint";
import { AppButton } from "../../base/app-button.slint";
import { HostsBridge } from "../../../features/hosts/hosts_bridge.slint";

export component CreateHostJumpTab inherits VerticalLayout {
    spacing: 10px;

    in-out property <string> selected-preset-jump-id: "";
    in-out property <string> selected-preset-jump-name: "";
    in-out property <string> selected-preset-jump-summary: "";
    in-out property <int> selected-preset-jump-hop-count: 0;

    callback open-jump-picker();
    callback clear-jump-chain();

    // 顶部操作栏
    HorizontalLayout {
        alignment: space-between;
        height: 26px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/zap.svg");
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    colorize: AppTheme.accent;
                }
            }

            Text {
                text: @tr("多级 ProxyJump 穿透链路 (从上至下严格有序):");
                font-size: 11px;
                font-weight: 600;
                color: AppTheme.foreground;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            if root.selected-preset-jump-id != "" || HostsBridge.create-host-jump-chain.length > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: clear-chain-touch.has-hover ? AppTheme.hover-background : transparent;
                    border-width: 1px;
                    border-color: clear-chain-touch.has-hover ? AppTheme.danger : AppTheme.border;

                    clear-chain-touch := TouchArea {
                        clicked => {
                            root.clear-jump-chain();
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/trash.svg");
                                width: 10px;
                                height: 10px;
                                image-fit: contain;
                                colorize: clear-chain-touch.has-hover ? AppTheme.danger : AppTheme.secondary-foreground;
                            }
                        }

                        Text {
                            text: root.selected-preset-jump-id != "" ? @tr("解除引用") : @tr("清空链路");
                            font-size: 10px;
                            color: clear-chain-touch.has-hover ? AppTheme.danger : AppTheme.secondary-foreground;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: add-hop-touch.has-hover ? AppTheme.accent.transparentize(80%) : AppTheme.accent.transparentize(90%);
                    border-width: 1px;
                    border-color: AppTheme.accent;

                    add-hop-touch := TouchArea {
                        clicked => {
                            root.open-jump-picker();
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/plus.svg");
                                width: 10px;
                                height: 10px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("添加跳板节点 / 预设串");
                            font-size: 10px;
                            font-weight: 700;
                            color: AppTheme.accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 链路展示区 (分支 1: 引用隧道中心预设串 / 分支 2: 直连空状态 / 分支 3: 自定义单跳列表)
    if root.selected-preset-jump-id != "": Rectangle {
        height: 320px;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: #10b981.transparentize(60%);

        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: center;

            // 预设标识徽章与标题
            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 19px;
                        background: #10b981.transparentize(85%);

                        Image {
                            source: @image-url("../../../assets/icons/zap.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                            colorize: #10b981;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.selected-preset-jump-name;
                            font-size: 15px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: @tr("来源: 网络与隧道中心 (JumpHost 预设)");
                        font-size: 10px;
                        color: AppTheme.secondary-foreground;
                    }
                }
            }

            // 穿透链路走向可视化
            Rectangle {
                height: 38px;
                border-radius: 4px;
                background: AppTheme.surface-background;
                border-width: 1px;
                border-color: AppTheme.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: @tr("链路走向: ") + root.selected-preset-jump-summary;
                        font-size: 11px;
                        font-weight: 600;
                        color: AppTheme.accent;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // 动态引用核心优势提示卡片
            Rectangle {
                border-radius: 4px;
                background: #10b981.transparentize(92%);
                border-width: 1px;
                border-color: #10b981.transparentize(70%);

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: @tr("🔗 已直接引用隧道中心预设：在「网络与隧道中心」对此跳板串修改节点或顺序时，此主机将自动同步生效，无需手动重新配置！");
                        font-size: 11px;
                        color: AppTheme.foreground;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // 底部管理操作按钮
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                AppButton {
                    text: @tr("更换预设串");
                    variant: "secondary";
                    clicked => {
                        root.open-jump-picker();
                    }
                }

                AppButton {
                    text: @tr("解除引用");
                    variant: "secondary";
                    clicked => {
                        root.clear-jump-chain();
                    }
                }
            }
        }
    }

    // 分支 2: 直连空状态 (未引用预设且未配置单跳)
    if root.selected-preset-jump-id == "" && HostsBridge.create-host-jump-chain.length == 0: Rectangle {
        height: 320px;
        border-radius: AppTheme.radius-medium;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: AppTheme.border;

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/zap.svg");
                    width: 32px;
                    height: 32px;
                    image-fit: contain;
                    colorize: AppTheme.secondary-foreground.transparentize(60%);
                }
            }

            Text {
                text: @tr("当前未配置跳板机链路 (目标主机采用直连模式)");
                font-size: 12px;
                font-weight: 600;
                color: AppTheme.secondary-foreground;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("点击右上角『添加跳板节点 / 预设串』可添加已有主机节点或直接引用隧道中心预设链路");
                font-size: 11px;
                color: AppTheme.disabled-foreground;
                horizontal-alignment: center;
            }
        }
    }

    // 分支 3: 自定义单跳列表 (未引用预设且配置了单跳主机)
    if root.selected-preset-jump-id == "" && HostsBridge.create-host-jump-chain.length > 0: Flickable {
        height: 320px;
        viewport-height: Math.max(320px, HostsBridge.create-host-jump-chain.length * 44px);

        VerticalLayout {
            spacing: 4px;

            for hop[idx] in HostsBridge.create-host-jump-chain: Rectangle {
                height: 38px;
                border-radius: 4px;
                background: hop-row-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background;
                border-width: 1px;
                border-color: AppTheme.border;

                hop-row-touch := TouchArea { }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    // 左侧：序号胶囊 + 主机名 + 地址端口
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                border-radius: 3px;
                                background: AppTheme.accent.transparentize(85%);
                                border-width: 1px;
                                border-color: AppTheme.accent;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Hop " + (idx + 1);
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppTheme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: hop.name;
                                font-size: 11px;
                                font-weight: 700;
                                color: AppTheme.foreground;
                            }

                            Text {
                                text: hop.address + ":" + hop.port;
                                font-size: 10px;
                                color: AppTheme.secondary-foreground;
                            }
                        }
                    }

                    // 右侧操作：上移、下移、删除
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        // 上移 ▲
                        if idx > 0: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 3px;
                                background: move-up-touch.has-hover ? AppTheme.hover-background : transparent;

                                move-up-touch := TouchArea {
                                    clicked => { HostsBridge.move-create-host-jump-hop(idx, idx - 1); }
                                    mouse-cursor: pointer;
                                }

                                Image {
                                    source: @image-url("../../../assets/icons/chevron-up.svg");
                                    width: 10px;
                                    height: 10px;
                                    image-fit: contain;
                                    colorize: move-up-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // 下移 ▼
                        if idx < HostsBridge.create-host-jump-chain.length - 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 3px;
                                background: move-down-touch.has-hover ? AppTheme.hover-background : transparent;

                                move-down-touch := TouchArea {
                                    clicked => { HostsBridge.move-create-host-jump-hop(idx, idx + 1); }
                                    mouse-cursor: pointer;
                                }

                                Image {
                                    source: @image-url("../../../assets/icons/chevron-down.svg");
                                    width: 10px;
                                    height: 10px;
                                    image-fit: contain;
                                    colorize: move-down-touch.has-hover ? AppTheme.accent : AppTheme.secondary-foreground;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // 删除 ✕
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 3px;
                                background: hop-del-touch.has-hover ? AppTheme.danger.transparentize(85%) : transparent;

                                hop-del-touch := TouchArea {
                                    clicked => { HostsBridge.remove-create-host-jump-hop(idx); }
                                    mouse-cursor: pointer;
                                }

                                Image {
                                    source: @image-url("../../../assets/icons/window-close.svg");
                                    width: 10px;
                                    height: 10px;
                                    image-fit: contain;
                                    colorize: hop-del-touch.has-hover ? AppTheme.danger : AppTheme.secondary-foreground;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
