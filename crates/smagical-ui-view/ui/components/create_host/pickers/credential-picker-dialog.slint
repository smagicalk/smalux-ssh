import { AppTheme } from "../../../themes/app-theme.slint";
import { AppButton } from "../../base/app-button.slint";
import { AppTextInput } from "../../../shared/base/app-text-input.slint";
import { CredentialOptionData } from "../../../features/hosts/hosts_model.slint";

export { CredentialOptionData }

export component CredentialPickerDialog inherits Rectangle {
    in property <bool> is-open: false;
    in property <[CredentialOptionData]> credential-options: [];
    in-out property <string> cred-filter-category: "all";
    in-out property <string> cred-search-query: "";
    in-out property <string> temp-selected-cred-id: "";
    in-out property <string> temp-selected-cred-name: "";
    in-out property <string> temp-selected-cred-user: "";
    in-out property <string> temp-selected-cred-type: "";
    in-out property <string> temp-selected-cred-alg: "";

    callback close();
    callback filter-credentials(string /* category */, string /* query */);
    callback confirmed(string /* id */, string /* name */, string /* user */, string /* type */, string /* alg */);

    if is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000bf; // 叠层半透明暗色遮罩
        z: 115;

        // 拦截背景穿透
        TouchArea { }

        Rectangle {
            width: 520px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;
            clip: true;

            // 拦截弹窗本体点击
            TouchArea { }

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 16px;
                spacing: 10px;

                // 顶部标题栏与关闭按钮
                HorizontalLayout {
                    alignment: space-between;
                    height: 26px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icons/key.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("选择凭据资产 (Select Credential)");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: cred-close-touch.has-hover ? AppTheme.hover-background : transparent;

                        cred-close-touch := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Image {
                            source: @image-url("../../../assets/icons/window-close.svg");
                            width: 10px;
                            height: 10px;
                            image-fit: contain;
                            colorize: cred-close-touch.has-hover ? AppTheme.foreground : AppTheme.secondary-foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // 实时搜索输入框
                AppTextInput {
                    text <=> root.cred-search-query;
                    placeholder: @tr("🔍 搜索凭据名称、用户名、加密算法...");
                    input-height: 28px;
                    font-size: 11px;
                    clearable: true;
                    edited(q) => {
                        root.filter-credentials(root.cred-filter-category, q);
                    }
                    cleared => {
                        root.cred-search-query = "";
                        root.filter-credentials(root.cred-filter-category, "");
                    }
                }

                // 分类切换 Tab 胶囊 (全部 / 🔑 密钥 / 🔒 密码 / 🤖 Agent)
                Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: AppTheme.control-background;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        // Tab: 全部
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.cred-filter-category == "all" ? AppTheme.surface-background : transparent;
                            border-width: root.cred-filter-category == "all" ? 1px : 0px;
                            border-color: root.cred-filter-category == "all" ? AppTheme.border : transparent;

                            Text {
                                text: @tr("全部");
                                font-size: 10px;
                                font-weight: root.cred-filter-category == "all" ? 700 : 500;
                                color: root.cred-filter-category == "all" ? AppTheme.accent : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.cred-filter-category = "all";
                                    root.filter-credentials("all", root.cred-search-query);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Tab: 密钥
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.cred-filter-category == "key" ? AppTheme.surface-background : transparent;
                            border-width: root.cred-filter-category == "key" ? 1px : 0px;
                            border-color: root.cred-filter-category == "key" ? AppTheme.border : transparent;

                            Text {
                                text: @tr("🔑 密钥");
                                font-size: 10px;
                                font-weight: root.cred-filter-category == "key" ? 700 : 500;
                                color: root.cred-filter-category == "key" ? AppTheme.accent : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.cred-filter-category = "key";
                                    root.filter-credentials("key", root.cred-search-query);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Tab: 密码
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.cred-filter-category == "password" ? AppTheme.surface-background : transparent;
                            border-width: root.cred-filter-category == "password" ? 1px : 0px;
                            border-color: root.cred-filter-category == "password" ? AppTheme.border : transparent;

                            Text {
                                text: @tr("🔒 密码");
                                font-size: 10px;
                                font-weight: root.cred-filter-category == "password" ? 700 : 500;
                                color: root.cred-filter-category == "password" ? AppTheme.accent : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.cred-filter-category = "password";
                                    root.filter-credentials("password", root.cred-search-query);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Tab: Agent
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.cred-filter-category == "agent" ? AppTheme.surface-background : transparent;
                            border-width: root.cred-filter-category == "agent" ? 1px : 0px;
                            border-color: root.cred-filter-category == "agent" ? AppTheme.border : transparent;

                            Text {
                                text: @tr("🤖 Agent");
                                font-size: 10px;
                                font-weight: root.cred-filter-category == "agent" ? 700 : 500;
                                color: root.cred-filter-category == "agent" ? AppTheme.accent : AppTheme.secondary-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.cred-filter-category = "agent";
                                    root.filter-credentials("agent", root.cred-search-query);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // 列表内容展示区
                Flickable {
                    vertical-stretch: 1;
                    min-height: 280px;
                    viewport-height: max(self.height, cred-items-container.preferred-height);

                    cred-items-container := VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        padding-right: 2px;

                        // 空状态提示
                        if root.credential-options.length == 0: Rectangle {
                            height: 180px;
                            border-radius: AppTheme.radius-medium;
                            background: AppTheme.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: @tr("🔍 未检索到匹配的凭据记录");
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.secondary-foreground;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: @tr("可尝试更换搜索关键字、切换上方分类标签，或关闭弹窗后直接录入");
                                    font-size: 10px;
                                    color: AppTheme.disabled-foreground;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // 凭据条目循环展示
                        if root.credential-options.length > 0: VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            for cred in root.credential-options: Rectangle {
                                height: 42px;
                                border-radius: 4px;
                                background: root.temp-selected-cred-id == cred.id ? AppTheme.accent.transparentize(85%) : (cred-row-touch.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                                border-width: 1px;
                                border-color: root.temp-selected-cred-id == cred.id ? AppTheme.accent : AppTheme.border;

                                cred-row-touch := TouchArea {
                                    clicked => {
                                        root.temp-selected-cred-id = cred.id;
                                        root.temp-selected-cred-name = cred.name;
                                        root.temp-selected-cred-user = cred.username;
                                        root.temp-selected-cred-type = cred.cred-type;
                                        root.temp-selected-cred-alg = cred.algorithm;
                                    }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: space-between;

                                    // 左侧：类型图标 + 名称 + 用户名
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: cred.cred-type == "key" ? @image-url("../../../assets/icons/key.svg") : (cred.cred-type == "password" ? @image-url("../../../assets/icons/lock.svg") : @image-url("../../../assets/icons/shield.svg"));
                                                width: 15px;
                                                height: 15px;
                                                image-fit: contain;
                                                colorize: root.temp-selected-cred-id == cred.id ? AppTheme.accent : AppTheme.secondary-foreground;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: cred.name;
                                                font-size: 11px;
                                                font-weight: root.temp-selected-cred-id == cred.id ? 700 : 500;
                                                color: root.temp-selected-cred-id == cred.id ? AppTheme.foreground : AppTheme.secondary-foreground;
                                            }

                                            Text {
                                                text: @tr("用户名: ") + cred.username;
                                                font-size: 9px;
                                                color: AppTheme.secondary-foreground;
                                            }
                                        }
                                    }

                                    // 右侧：算法徽章 + 选中状态指示器
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 18px;
                                                border-radius: 3px;
                                                background: AppTheme.surface-background;
                                                border-width: 1px;
                                                border-color: AppTheme.border;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    Text {
                                                        text: cred.algorithm;
                                                        font-size: 9px;
                                                        color: AppTheme.secondary-foreground;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // 选中指示标记
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                background: root.temp-selected-cred-id == cred.id ? AppTheme.accent : transparent;
                                                border-width: 1px;
                                                border-color: root.temp-selected-cred-id == cred.id ? AppTheme.accent : AppTheme.border;

                                                if root.temp-selected-cred-id == cred.id: Image {
                                                    source: @image-url("../../../assets/icons/check.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #ffffff;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 底部状态与确定操作栏
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    // 左侧：当前选定指示
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            if root.temp-selected-cred-id != "": Text {
                                text: @tr("已选中: ") + root.temp-selected-cred-name;
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.accent;
                                vertical-alignment: center;
                            }
                            if root.temp-selected-cred-id == "": Text {
                                text: @tr("未选定凭据");
                                font-size: 11px;
                                color: AppTheme.secondary-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 右侧：三个操作按键 (清空选择、取消、确定选择)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        AppButton {
                            text: @tr("清空选择");
                            variant: "secondary";
                            enabled: root.temp-selected-cred-id != "";
                            clicked => {
                                root.temp-selected-cred-id = "";
                                root.temp-selected-cred-name = "";
                                root.temp-selected-cred-user = "";
                                root.temp-selected-cred-type = "";
                                root.temp-selected-cred-alg = "";
                            }
                        }

                        AppButton {
                            text: @tr("取消");
                            variant: "secondary";
                            clicked => { root.close(); }
                        }

                        AppButton {
                            text: @tr("确定选择");
                            variant: "primary";
                            enabled: root.temp-selected-cred-id != "";
                            clicked => {
                                root.confirmed(
                                    root.temp-selected-cred-id,
                                    root.temp-selected-cred-name,
                                    root.temp-selected-cred-user,
                                    root.temp-selected-cred-type,
                                    root.temp-selected-cred-alg
                                );
                            }
                        }
                    }
                }
            }
        }
    }
}
