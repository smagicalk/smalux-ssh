import { AppTheme } from "../themes/app-theme.slint";
import { SettingsBridge } from "../features/settings/settings_bridge.slint";
import { AppButton } from "../shared/base/app-button.slint";
import { AppPasswordInput } from "../shared/base/app-password-input.slint";

export component VaultUnlockModal inherits Rectangle {
    visible: SettingsBridge.is-unlock-modal-open;
    width: 100%;
    height: 100%;
    background: #000000d0;
    z: 1800;

    TouchArea { /* 阻止穿透 */ }

    Rectangle {
        width: 440px;
        height: 310px;
        background: AppTheme.modal-background;
        border-radius: AppTheme.radius-large;
        border-width: 1px;
        border-color: AppTheme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000000b0;
        drop-shadow-offset-y: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        TouchArea { /* 阻止穿透 */ }

        VerticalLayout {
            padding: 26px;
            spacing: 16px;
            alignment: center;

            // 顶部图标与标题
            VerticalLayout {
                spacing: 8px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        background: AppTheme.accent.transparentize(85%);

                        Image {
                            source: @image-url("../assets/icons/shield.svg");
                            width: 26px;
                            height: 26px;
                            colorize: AppTheme.accent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Text {
                    text: @tr("保险库已锁定 (Vault Locked)");
                    font-size: 15px;
                    font-weight: 700;
                    color: AppTheme.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("客户端已开启本地凭据主密码保护。请输入主密码以解密密钥、主机与配置。");
                    font-size: 11px;
                    color: AppTheme.secondary-foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // 密码输入与错误提示
            VerticalLayout {
                spacing: 6px;

                AppPasswordInput {
                    text <=> SettingsBridge.unlock-pwd-input;
                    placeholder: @tr("输入主密码解锁...");
                    accepted => {
                        if SettingsBridge.unlock-pwd-input == "" {
                            SettingsBridge.unlock-pwd-error-msg = @tr("请输入主密码！");
                        } else {
                            SettingsBridge.unlock-pwd-error-msg = "";
                            SettingsBridge.unlock-vault(SettingsBridge.unlock-pwd-input);
                        }
                    }
                }

                if SettingsBridge.unlock-pwd-error-msg != "": Text {
                    text: SettingsBridge.unlock-pwd-error-msg;
                    font-size: 10px;
                    color: #EF4444;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            // 解锁操作按钮
            HorizontalLayout {
                alignment: center;

                AppButton {
                    width: 220px;
                    text: @tr("解密并解锁保险库");
                    variant: "primary";
                    has-icon: true;
                    icon: @image-url("../assets/icons/key.svg");
                    clicked => {
                        if SettingsBridge.unlock-pwd-input == "" {
                            SettingsBridge.unlock-pwd-error-msg = @tr("请输入主密码！");
                        } else {
                            SettingsBridge.unlock-pwd-error-msg = "";
                            SettingsBridge.unlock-vault(SettingsBridge.unlock-pwd-input);
                        }
                    }
                }
            }
        }
    }
}
