import { AppTheme } from "../themes/app-theme.slint";
import { AppIconButton } from "base/app-icon-button.slint";
import { DebugHostsTab } from "debug_workbench/debug-hosts-tab.slint";
import { DebugCredentialsTab } from "debug_workbench/debug-credentials-tab.slint";
import { DebugSnippetsTab } from "debug_workbench/debug-snippets-tab.slint";
import { DebugSettingsTab } from "debug_workbench/debug-settings-tab.slint";
import { DebugLogsTab, LogEntryData } from "debug_workbench/debug-logs-tab.slint";
import { DebugRenderingTab } from "debug_workbench/debug-rendering-tab.slint";

import { DebugBridge } from "../features/debug/debug_bridge.slint";
import { WindowBridge } from "../features/window/window_bridge.slint";
import { SettingsBridge } from "../features/settings/settings_bridge.slint";
import { HostsBridge } from "../features/hosts/hosts_bridge.slint";
import { CredentialsBridge } from "../features/credentials/credentials_bridge.slint";
import { SnippetsBridge } from "../features/snippets/snippets_bridge.slint";


export { LogEntryData }

/// 开发者全功能独立调试与批量数据生成模态弹窗 (Debug Modal)
export component DebugModal inherits Rectangle {
    /// 弹窗显隐状态直通 DebugBridge
    in-out property <bool> is-open <=> DebugBridge.is-open;

    /// 实时日志与各领域实时探针直通 Bridges
    in property <[LogEntryData]> logs: DebugBridge.logs;
    in property <int> total-nodes-count: HostsBridge.tree-nodes.length;
    in property <int> visible-nodes-count: HostsBridge.tree-nodes.length;
    in property <int> host-cards-count: HostsBridge.hosts.length;
    in property <int> credential-count: CredentialsBridge.credentials.length;
    in property <int> snippet-count: SnippetsBridge.tree-nodes.length;
    in property <int> snippet-group-count: SnippetsBridge.parent-options.length;
    in property <length> tree-viewport-width: HostsBridge.tree-content-width;
    in property <string> current-theme-name: WindowBridge.current-theme-name;
    in property <bool> is-dark-mode: WindowBridge.is-dark-mode;

    /// 实验特性门控直通 DebugBridge
    in-out property <bool> flag-desktop-notifications <=> DebugBridge.flag-desktop-notifications;
    in-out property <bool> flag-terminal-crt-shader <=> DebugBridge.flag-terminal-crt-shader;
    in-out property <bool> flag-cloud-sync <=> DebugBridge.flag-cloud-sync;
    in-out property <bool> flag-terminal-scratchpad <=> DebugBridge.flag-terminal-scratchpad;
    in-out property <bool> use-mock-storage <=> DebugBridge.use-mock-storage;
    in-out property <bool> is-log-capture-enabled <=> DebugBridge.is-log-capture-enabled;

    /// 核心设置状态实时探针
    in property <bool> setting-always-on-top: SettingsBridge.setting-always-on-top;
    in property <bool> setting-confirm-close-tab: SettingsBridge.setting-confirm-close-tab;
    in property <bool> setting-confirm-close-active: SettingsBridge.setting-confirm-close-active;
    in property <string> wallpaper-mode: "none";
    in property <string> wallpaper-slideshow-interval: SettingsBridge.setting-wallpaper-slideshow;
    in property <int> wallpaper-count: SettingsBridge.setting-wallpaper-list.length;
    in-out property <float> setting-modal-opacity <=> SettingsBridge.setting-modal-opacity;
    in property <string> active-pipeline: WindowBridge.active-rendering-pipeline;

    // 当前激活的子面板: "hosts" | "credentials" | "snippets" | "settings" | "logs" | "rendering"
    property <string> active-subtab: "hosts";

    if is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6; // 半透明暗色背景遮罩

        TouchArea {
            // 拦截遮罩点击，防止穿透底层
        }

        // =========================================================================
        // 主弹窗卡片 (860x560px 居中大窗)
        // =========================================================================
        Rectangle {
            width: 860px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // 1. 标题栏 + 关闭按钮
                HorizontalLayout {
                    alignment: space-between;
                    height: 28px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/bug.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: AppTheme.accent;
                            }
                        }

                        Text {
                            text: @tr("开发者调试工作台 (Workbench)");
                            font-size: 13px;
                            font-weight: 700;
                            color: AppTheme.foreground;
                            vertical-alignment: center;
                        }

                        // 状态胶囊
                        Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: AppTheme.hover-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: @tr("主机数: ") + root.host-cards-count + @tr(" | 可见节点: ") + root.visible-nodes-count;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: AppTheme.secondary-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 关闭按钮
                    AppIconButton {
                        icon: @image-url("../assets/icons/window-close.svg");
                        clicked => { DebugBridge.close(); root.is-open = false; }
                    }
                }

                // 2. 顶部子标签切换导航栏 (按页面与核心功能清晰分类)
                HorizontalLayout {
                    spacing: 6px;
                    height: 32px;

                    // 页面 1: 主机管理调试 (包含批量生成、预设注入、快捷增删、状态治理与树形指标)
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "hosts" ? AppTheme.accent : (b-tab1.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "hosts" ? AppTheme.accent : AppTheme.border;

                        b-tab1 := TouchArea {
                            clicked => { root.active-subtab = "hosts"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/server.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "hosts" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("主机资产调试");
                                font-size: 11px;
                                font-weight: root.active-subtab == "hosts" ? 600 : 500;
                                color: root.active-subtab == "hosts" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 页面 2: 凭据与密钥调试 (包含预设注入、快捷单项、批量造数与清空)
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "credentials" ? AppTheme.accent : (b-tab-cred.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "credentials" ? AppTheme.accent : AppTheme.border;

                        b-tab-cred := TouchArea {
                            clicked => { root.active-subtab = "credentials"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/key.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "credentials" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("凭据密钥调试");
                                font-size: 11px;
                                font-weight: root.active-subtab == "credentials" ? 600 : 500;
                                color: root.active-subtab == "credentials" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 页面 3: 代码片段与脚本调试
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "snippets" ? AppTheme.accent : (b-tab-snip.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "snippets" ? AppTheme.accent : AppTheme.border;

                        b-tab-snip := TouchArea {
                            clicked => { root.active-subtab = "snippets"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/code.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "snippets" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("代码片段调试");
                                font-size: 11px;
                                font-weight: root.active-subtab == "snippets" ? 600 : 500;
                                color: root.active-subtab == "snippets" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 页面 4: 设置与偏好调试 (包含主题配色测试、深浅色翻转与设计令牌)
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "settings" ? AppTheme.accent : (b-tab2.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "settings" ? AppTheme.accent : AppTheme.border;

                        b-tab2 := TouchArea {
                            clicked => { root.active-subtab = "settings"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/settings.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "settings" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("设置外观调试");
                                font-size: 11px;
                                font-weight: root.active-subtab == "settings" ? 600 : 500;
                                color: root.active-subtab == "settings" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 页面 4: 实时日志流 (包含日志等级过滤、清空与测试触发)
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "logs" ? AppTheme.accent : (b-tab3.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "logs" ? AppTheme.accent : AppTheme.border;

                        b-tab3 := TouchArea {
                            clicked => { root.active-subtab = "logs"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/file-text.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "logs" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("实时日志流");
                                font-size: 11px;
                                font-weight: root.active-subtab == "logs" ? 600 : 500;
                                color: root.active-subtab == "logs" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // 页面 6: 图形渲染监控看板 (运行时架构指标、显存图集与诊断压测)
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: AppTheme.radius-medium;
                        background: root.active-subtab == "rendering" ? AppTheme.accent : (b-tab4.has-hover ? AppTheme.hover-background : AppTheme.control-background);
                        border-width: 1px;
                        border-color: root.active-subtab == "rendering" ? AppTheme.accent : AppTheme.border;

                        b-tab4 := TouchArea {
                            clicked => { root.active-subtab = "rendering"; }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            padding-left: 6px;
                            padding-right: 6px;

                            Image {
                                source: @image-url("../assets/icons/activity.svg");
                                width: 12px;
                                height: 12px;
                                image-fit: contain;
                                colorize: root.active-subtab == "rendering" ? AppTheme.selected-foreground : AppTheme.secondary-foreground;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("图形渲染监控");
                                font-size: 11px;
                                font-weight: root.active-subtab == "rendering" ? 600 : 500;
                                color: root.active-subtab == "rendering" ? AppTheme.selected-foreground : AppTheme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                // 3. 内容主体区
                Rectangle {
                    height: 440px;
                    width: 100%;

                    // 1. 主机资产调试 (融合批量、单项、预设、状态与指标)
                    if root.active-subtab == "hosts": DebugHostsTab {
                        total-nodes-count: root.total-nodes-count;
                        visible-nodes-count: root.visible-nodes-count;
                        host-cards-count: root.host-cards-count;
                        tree-viewport-width: root.tree-viewport-width;
                        batch-generate(p, cnt, ip_p, s_ip, port, grp, st, ovr) => { DebugBridge.batch-generate(p, cnt, ip_p, s_ip, port, grp, st, ovr); }
                        batch-update-status(st) => { DebugBridge.batch-update-status(st); }
                        batch-update-port(p) => { DebugBridge.batch-update-port(p); }
                        inject-preset(id) => { DebugBridge.inject-preset(id); }
                        quick-add-host(n, ip, p, g) => { DebugBridge.quick-add-host(n, ip, p, g); }
                        quick-add-group(n, p) => { DebugBridge.quick-add-group(n, p); }
                        reset-default-data => { DebugBridge.reset-default-data(); }
                        clear-all-data => { DebugBridge.clear-all-data(); }
                    }

                    // 2. 凭据密钥调试
                    if root.active-subtab == "credentials": DebugCredentialsTab {
                        credential-count: root.credential-count;
                        batch-generate-credentials(cnt, mode, ovr) => { DebugBridge.batch-generate-credentials(cnt, mode, ovr); }
                        quick-add-credential(ctype, n, d) => { DebugBridge.quick-add-credential(ctype, n, d); }
                        reset-default-credentials => { DebugBridge.reset-default-credentials(); }
                        clear-all-credentials => { DebugBridge.clear-credentials(); }
                    }

                    // 3. 代码片段与脚本调试
                    if root.active-subtab == "snippets": DebugSnippetsTab {
                        snippet-count: root.snippet-count;
                        group-count: root.snippet-group-count;
                        batch-generate-snippets(cnt, ovr) => { DebugBridge.batch-generate-snippets(cnt, ovr); }
                        quick-add-snippet(t, l, c) => { DebugBridge.quick-add-snippet(t, l, c); }
                        reset-default-snippets => { DebugBridge.reset-default-snippets(); }
                        clear-all-snippets => { DebugBridge.clear-snippets(); }
                    }

                    // 4. 设置偏好调试 (实验特性门控、预设配置注入与主题快切)
                    if root.active-subtab == "settings": DebugSettingsTab {
                        flag-desktop-notifications <=> root.flag-desktop-notifications;
                        flag-terminal-crt-shader <=> root.flag-terminal-crt-shader;
                        flag-cloud-sync <=> root.flag-cloud-sync;
                        flag-terminal-scratchpad <=> root.flag-terminal-scratchpad;
                        use-mock-storage <=> root.use-mock-storage;
                        show-system-theme <=> DebugBridge.show-system-theme;
                        current-theme-name: root.current-theme-name;
                        is-dark-mode: root.is-dark-mode;
                        setting-modal-opacity <=> root.setting-modal-opacity;

                        toggle-show-system-theme(c) => { DebugBridge.toggle-show-system-theme(c); }
                        toggle-feature-flag(f, e) => { DebugBridge.toggle-feature-flag(f, e); }
                        toggle-mock-storage(e) => { DebugBridge.toggle-mock-storage(e); }
                        apply-config-preset(p) => { DebugBridge.apply-config-preset(p); }
                        reset-all-settings => { DebugBridge.reset-all-settings(); }
                        switch-theme(id) => { DebugBridge.switch-theme(id); }
                        toggle-color-mode => { DebugBridge.toggle-color-mode(); }
                        change-modal-opacity(op) => { DebugBridge.change-modal-opacity(op); }
                    }

                    // 5. 实时日志流
                    if root.active-subtab == "logs": DebugLogsTab {
                        logs: root.logs;
                        is-log-capture-enabled <=> root.is-log-capture-enabled;
                        toggle-log-capture(e) => { DebugBridge.toggle-log-capture(e); }
                        clear-logs => { DebugBridge.clear-logs(); }
                        emit-test-log(lvl) => { DebugBridge.emit-test-log(lvl); }
                    }

                    // 6. 图形渲染运行时监控看板
                    if root.active-subtab == "rendering": DebugRenderingTab {
                        current-active-pipeline: root.active-pipeline;
                        active-theme-name: root.current-theme-name;
                        is-dark-mode: root.is-dark-mode;
                        setting-always-on-top: root.setting-always-on-top;
                        setting-confirm-close-tab: root.setting-confirm-close-tab;
                        wallpaper-mode: root.wallpaper-mode;
                        setting-modal-opacity: root.setting-modal-opacity;

                        switch-pipeline(id) => { DebugBridge.switch-pipeline(id); }
                        save-pipeline => { DebugBridge.save-pipeline(); }
                        apply-and-restart => { DebugBridge.restart-app(); }
                        force-repaint => { DebugBridge.force-repaint(); }
                        run-benchmark => { DebugBridge.run-benchmark(); }
                        navigate-to-settings(cat) => { root.is-open = false; DebugBridge.navigate-to-settings(cat); }
                    }
                }
            }
        }
    }
}
