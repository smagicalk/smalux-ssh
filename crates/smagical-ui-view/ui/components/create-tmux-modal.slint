import { AppTheme } from "../themes/app-theme.slint";
import { AppButton } from "base/app-button.slint";
import { AppIconButton } from "base/app-icon-button.slint";
import { AppTextInput } from "../shared/base/app-text-input.slint";

/// 新建 tmux 会话模态弹窗组件 (Create Tmux Session Modal)
/// 全屏居中遮罩弹窗，提供独立会话命名与一键创建终端会话
export component CreateTmuxModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> active-host-name: "";
    in-out property <string> session-name: "";

    callback close();
    callback confirm(string /* session_name */);

    if root.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea { } // 阻断点击穿透

        Rectangle {
            width: 380px;
            height: 196px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: AppTheme.radius-large;
            background: AppTheme.modal-background;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.transparentize(0.4);

            TouchArea { } // 阻止事件穿透

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // 标题栏
                HorizontalLayout {
                    alignment: space-between;
                    height: 26px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/layout-grid.svg");
                                width: 15px;
                                height: 15px;
                                colorize: AppTheme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("新建 tmux 会话");
                                font-size: 13px;
                                font-weight: 700;
                                color: AppTheme.foreground;
                            }
                        }

                        if root.active-host-name != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 16px;
                                border-radius: 3px;
                                background: AppTheme.control-background;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: root.active-host-name;
                                        font-size: 9px;
                                        color: AppTheme.secondary-foreground;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        AppIconButton {
                            icon: @image-url("../assets/icons/window-close.svg");
                            icon-size: 12px;
                            clicked => { root.close(); }
                        }
                    }
                }

                // 描述
                Text {
                    text: @tr("在当前活动远程主机上创建独立的后台会话，断开 SSH 也将持久保活。");
                    font-size: 11px;
                    color: AppTheme.secondary-foreground;
                    wrap: word-wrap;
                }

                // 输入框
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: @tr("会话名称 (Session Name)");
                        font-size: 10px;
                        font-weight: 600;
                        color: AppTheme.secondary-foreground;
                    }

                    AppTextInput {
                        text <=> root.session-name;
                        placeholder: @tr("例如: worker-job, compile, dev...");
                        size: "sm";
                        accepted(text) => {
                            if text != "" {
                                root.confirm(text);
                                root.session-name = "";
                            }
                        }
                    }
                }

                // 底部按钮栏
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    height: 28px;

                    AppButton {
                        text: @tr("取消");
                        variant: "secondary";
                        height: 28px;
                        clicked => { root.close(); }
                    }

                    AppButton {
                        text: @tr("确认创建");
                        variant: "primary";
                        height: 28px;
                        enabled: root.session-name != "";
                        clicked => {
                            if root.session-name != "" {
                                root.confirm(root.session-name);
                                root.session-name = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
